{"hymn":"S248","parent":"E1126","quality":"exact","adjust":{"hold":0,"merge":0},"title":"De Tu presencia, oh Señor","subtitle":"La certeza y el gozo de la salvación—Redimidos por la sangre","syl":{"n1":"De","n2":"Tu","n3":["pre","i"],"n4":["sen","m"],"n5":["cia,","t"],"n6":"oh","n7":["Se","i"],"n8":["ñor,","t"],"n9":["Que","i"],"n10":["re","m"],"n11":["mos","t"],"n12":["dis","i"],"n13":["fru","m"],"n14":["tar;","t"],"n16":["En","i"],"n17":["tra","m"],"n18":["mos","t"],"n19":"con","n20":["con","i"],"n21":["fian","m"],"n22":["za‿a","m"],"n23":["quí,","t"],"n24":"Tu","n25":["san","i"],"n26":["gre‿al","t"],"n27":["a","i"],"n28":["pli","m"],"n29":["car.","t"],"n31":["Nues","i"],"n32":["tra","t"],"n33":["jus","i"],"n34":["ti","m"],"n35":["cia","t"],"n36":["pro","i"],"n37":["pia‿en","t"],"n38":"sí,","n39":["Ca","i"],"n40":["re","m"],"n41":["ce","t"],"n42":"de","n43":["va","i"],"n44":["lor;","t"],"n46":["Só","i"],"n47":["lo","t"],"n48":"Tu","n49":["san","i"],"n50":["gre","t"],"n51":["e","i"],"n52":["fi","m"],"n53":["caz","t"],"n54":"Es","n55":["fir","i"],"n56":["me","t"],"n57":["so","i"],"n58":["lu","m"],"n59":["ción.","t"]},"verses":[{"label":"2.","lines":["Tus juicios debo admitir,","Son santos; justos son.","Por mis pecados carmesí,","No hay vindicación.","No puede‿un velo encubrir","Toda nuestra maldad.","Pero Tu sangre, oh Señor,","Podemos aplicar."]},{"label":"3.","lines":["Nuestro pecado, Dios juzgó;","Él no lo ignoró;","Mas sobre Su Cordero fiel,","Su ira derramó.","Camino nuevo‿y vivo‿abrió:","Todo‿es justo‿y legal;","El Sustituto realizó","Perdón y justa paz."]},{"label":"4.","lines":["Con gozo, disfrutamos hoy","Tu redención, Jesús;","Tu sangre vemos otra vez,","Con toda su virtud.","Señor, qué vasta‿es Tu merced;","Es sin limitación.","Te‿alabaremos sin cesar,","Cordero fiel de Dios."]}]}