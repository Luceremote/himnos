3":"plan:","n134":["¡Nue","i"],"n135":["va","t"],"n136":["Je","i"],"n138":["ru","m"],"n139":["sa","m"],"n140":["lén!","t"],"n141":["¡A‿le","i"],"n142":["lu","m"],"n143":["ya!","t"]},"verses":[{"label":"2.","lines":["Es Jesús nuestro modelo,","Él vivió como un Dios-hombre","Obediente hasta la muerte,","Su hombre natural negó.","Era el único Dios-hombre;","Más se duplicó en nosotros","Como granos bien mezclados;","Somos Su reproducción."]},{"label":"3.","lines":["Su resurrección vivimos,","No en la carne ni en el alma;","Nuestro espíritu mezclado,","Niega así lo natural.","Hoy vivimos en el Cuerpo,","Cada día en Él vencemos,","Por llegar a Sión luchamos,","Aguardando Su venida."]},{"label":"4.","lines":["Vivirán Dios y el hombre","En espíritu mezclados,","Siendo‿así incorporados:","¡Una‿orgánica‿entidad!","Tal visión de las edades","Rige‿hoy nuestra vida diaria,","Para que‿Él obtenga‿el Cuerpo,","¡Refulgente ciudad santa!"]}]}