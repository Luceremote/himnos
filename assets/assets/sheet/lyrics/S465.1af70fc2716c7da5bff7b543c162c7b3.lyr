{"hymn":"S465","parent":"E1155","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cuánto te amo, oh mi Cristo","subtitle":"Experiencia de Cristo—Amarlo a Él","syl":{"n1":["Cuán","i"],"n2":["to","t"],"n3":["te‿a","i"],"n4":["mo,","t"],"n5":"oh","n6":"mi","n7":["Cris","i"],"n8":["to,","t"],"n9":"Tu","n10":["a","i"],"n11":["mor","t"],"n12":"me","n13":["con","i"],"n14":["quis","m"],"n15":["tó;","t"],"n16":["Me‿a","i"],"n17":["tra","m"],"n18":["jis","m"],"n19":["te,","t"],"n20":"me","n21":["be","i"],"n22":["sas","m"],"n23":["te,","t"],"n24":"¡Tu","n25":["a","i"],"n26":["ma","m"],"n27":["da‿a","m"],"n28":["ho","m"],"n29":["ra","t"],"n30":"soy!","n31":["Cuán","i"],"n32":["to‿a","m"],"n33":["ma","m"],"n34":["mos","t"],"n35":"al","n36":["A","i"],"n37":["ma","m"],"n38":["do,","t"],"n39":["A","i"],"n40":["tra","m"],"n41":["yen","m"],"n42":["te‿y","t"],"n43":["be","i"],"n44":["llo","t"],"n45":"es,","n46":"Nos","n47":["cau","i"],"n48":["ti","m"],"n49":["va","t"],"n50":"por","n51":["com","i"],"n52":["ple","m"],"n53":["to,","t"],"n54":"Y","n55":["her","i"],"n56":["mo","m"],"n57":["sa","t"],"n58":"Él","n59":"nos","n60":"ve."},"verses":[{"label":"2.","lines":["Me comparas a la yegua","Del carro de Faraón;","Tanta fuerza y‿energía","Natural en mi interior."]},{"label":"3.","lines":["Tengo ojos de paloma,","Fijos solamente en Él;","¡Va cambiando mis conceptos,","Pues en mí hoy crece Él."]},{"label":"4.","lines":["Soy un lirio en el valle,","Con espinos por doquier;","Solo‿en Cristo yo confío,","Pues mi fuerza‿abandoné."]},{"label":"5.","lines":["Cual palomas escondidas","En Tu secreto lugar,","Te deleitan nuestras voces","Y anhelas nuestra faz."]},{"label":"6.","lines":["Como columnas de humo","Tu nos haces, oh Señor.","Nuestra voluntad subyugas","Por muerte‿y resurrección."]},{"label":"7.","lines":["Tu litera‿ahora somos,","Hoy reposas sobre nos;","Nuestra persona Tú eres,","Lo que somos ya menguó."]},{"label":"8.","lines":["Hoy Tu palanquín nos haces,","Cesa ya lo natural.","Tu mover así realizas","Para Tu expresión ganar."]},{"label":"9.","lines":["La madera has provisto,","Y su fondo, oro es;","Púrpura es su asiento,","Para nuestro‿amado Rey."]},{"label":"10.","lines":["Mas nosotros proveemos","Nuestro amor para con Él,","Que por dentro hoy recubre","Ese palanquín del Rey."]},{"label":"11.","lines":["Oh, qué belllo nuestro Amado","Con Su corona nupcial;","Cristo y la‿iglesia‿unidos","¡Oh, qué gloria‿a Él le da!"]}]}