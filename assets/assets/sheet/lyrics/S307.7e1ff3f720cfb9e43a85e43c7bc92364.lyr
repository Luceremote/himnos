{"hymn":"S307","parent":"E393","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tu senda es mi elección","subtitle":"Anhelos—De ser guiados por Cristo","syl":{"n1":"Tu","n2":["sen","i"],"n3":["da‿es","t"],"n4":["mi‿e","i"],"n5":["lec","m"],"n6":["ción,","t"],"n7":["Aun","i"],"n8":["que‿ha","m"],"n9":["ya‿os","m"],"n10":["cu","m"],"n11":["ri","m"],"n12":["dad;","t"],"n13":["Es","i"],"n14":["co","m"],"n15":["ge","t"],"n16":"Tú,","n17":["Se","i"],"n18":["ñor,","t"],"n19":"La","n20":["ru","i"],"n22":["ta","t"],"n23":"que‿he","n25":["de‿an","i"],"n26":["dar.","t"]},"verses":[{"label":"2.","lines":["Si ardua‿o suave es,","No me‿ha de importar;","Si dura‿o fácil es,","Me lleva‿a reposar."]},{"label":"3.","lines":["Yo no me‿atreveré","Mi parte escoger;","Escoge Tu por mí,","Y recto andaré."]},{"label":"4.","lines":["Llena mi copa, Tú,","Con gozo o dolor,","Con penas o con bien;","Tú sabes qué‿es mejor."]},{"label":"5.","lines":["Escoge Tú por mí,","Salud o‿enfermedad,","Pobreza‿o bienestar,","Amigo‿o soledad."]},{"label":"6.","lines":["No‿es mía la‿elección,","En toda situación;","Sé mi guía‿y poder,","Mi todo, Tú, Señor."]}]}