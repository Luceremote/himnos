{"hymn":"S579","parent":"E749","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El Santo Espíritu de Dios","subtitle":"Varios aspectos de la vida interior—El quebrantamiento y la liberación","syl":{"n1":"El","n2":["San","i"],"n4":["to‿Es","m"],"n5":["pí","m"],"n6":["ri","m"],"n7":["tu","t"],"n9":"de","n10":"Dios","n11":"En","n12":["nues","i"],"n14":["tro","t"],"n15":["es","i"],"n17":["pí","m"],"n18":["ri","m"],"n20":["tu‿es","m"],"n21":["tá;","t"],"n22":"Él","n23":["quie","i"],"n25":["re‿en","t"],"n26":["nues","i"],"n27":["tro","t"],"n28":"ser","n30":["flu","i"],"n31":["ir","t"],"n32":"Y‿a","n33":"Dios","n35":"en","n36":["Cris","i"],"n37":["to","t"],"n38":["ex","i"],"n39":["pre","m"],"n40":["sar.","t"]},"verses":[{"label":"2.","lines":["Mas nuestro hombre natural","Lo ha confinado en lo interior;","Y en vez de darle un hogar,","Se constituye una prisión."]},{"label":"3.","lines":["Él es tesoro de valor","Guardado en vaso terrenal;","Se debe el vaso quebrantar","Para el tesoro develar."]},{"label":"4.","lines":["Él debe quebrantar el yo,","¡Qué estorbo es el hombre exterior!","Al quebrantarlo, librará","Al Santo Espíritu de Dios."]},{"label":"5.","lines":["Por esto nos envía Dios","Algún sufrir circunstancial,","Para quebrar en lo exterior","A este hombre natural."]},{"label":"6.","lines":["Que sea consumido el yo,","Que mengüe el alma es menester;","Para que nuestro espíritu","Librado con el Suyo esté"]},{"label":"7.","lines":["No quiero entero siempre estar","Quebrántame, oh mi Señor;","Y que dispuesto yo esté","A recibir Tus tratos hoy."]},{"label":"8.","lines":["Que yo aprecie el quebrantar,","Y toda queja deje atrás;","Concédeme siempre estimar","Más el perder que el ganar."]}]}