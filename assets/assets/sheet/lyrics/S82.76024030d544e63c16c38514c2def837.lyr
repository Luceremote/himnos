{"hymn":"S82","parent":"E108","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh, qué nombre se le dio","subtitle":"Alabanza al Señor—Su redención","syl":{"n1":"Oh,","n2":"qué","n3":["nom","i"],"n4":["bre","t"],"n5":"se","n6":"le","n7":"dio","n8":"¡Al","n9":["san","i"],"n10":["to","t"],"n11":["Hi","i"],"n12":["jo","t"],"n13":"de","n14":"Dios!","n15":["\"Va","i"],"n16":["rón","t"],"n17":"de","n18":["do","i"],"n19":["lo","m"],"n20":["res\"","t"],"n21":"fue","n22":["¡A","i"],"n23":["le","m"],"n24":["lu","m"],"n25":["ya!","t"],"n26":["¡Cris","i"],"n27":["to","t"],"n28":["sal","i"],"n29":["va!","t"]},"verses":[{"label":"2.","lines":["Mofa y desdén sufrió,","Mi condenación llevó,","Él por mi perdón sangró,","¡Aleluya! ¡Cristo salva!"]},{"label":"3.","lines":["Era un débil reo yo,","Mas el Cordero de Dios","Plena redención logró,","¡Aleluya! ¡Cristo salva!"]},{"label":"4.","lines":["Levantado, Él murió,","\"Consumado es! clamó;\"","Dios al cielo le exaltó,","¡Aleluya! ¡Cristo salva!"]},{"label":"5.","lines":["En Su gloria‿el Rey vendrá,","En Su reino nos pondrá,","Y de nuevo‿hay que cantar:","¡Aleluya! ¡Cristo salva!"]}]}