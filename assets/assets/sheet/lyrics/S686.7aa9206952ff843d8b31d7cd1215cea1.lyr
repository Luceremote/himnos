{"hymn":"S686","parent":"E1231","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"¡Oh, aleluya! Dios formó","subtitle":"La iglesia—Como un solo y nuevo hombre","syl":{"n1":"¡Oh,","n2":["a","i"],"n3":["le","m"],"n4":["lu","m"],"n5":["ya!","t"],"n6":"Dios","n7":["for","i"],"n8":["mó","t"],"n9":"Al","n10":["hom","i"],"n11":["bre‿en","t"],"n12":"la","n13":["crea","i"],"n14":["ción,","t"],"n15":["Pa","i"],"n16":["ra‿ex","m"],"n17":["pre","m"],"n18":["sar","t"],"n19":["Su‿au","i"],"n20":["to","m"],"n21":["ri","m"],"n22":["dad,","t"],"n23":["Y‿a","i"],"n24":["sí","t"],"n25":["la‿tie","i"],"n26":["rra","t"],"n27":["so","i"],"n28":["juz","m"],"n30":["gar.","t"],"n31":"¡Qué","n32":["go","i"],"n33":["zo","t"],"n34":["ten","i"],"n35":["go","t"],"n37":"yo,","n38":"En","n40":"Su","n41":["re","i"],"n42":["co","m"],"n43":["bro","t"],"n45":"hoy!","n46":"¡Oh,","n48":["a","i"],"n49":["le","m"],"n50":["lu","m"],"n51":["ya,","t"],"n53":"soy","n54":["Su‿ex","i"],"n55":["pre","m"],"n56":["si","m"],"n57":["ón!","t"]},"verses":[{"label":"2.","lines":["¡Oh, aleluya! Mi Señor","Por mí Su vida dio.","Hoy vive en mi espíritu,","Me da Su vida en plenitud.","Hombre supremo y fiel,","Mi todo en todo es Él,","¡Oh, aleluya, vive en mi ser!"]},{"label":"3.","lines":["¡Oh, aleluya! Me hizo Dios","El centro en Su creación.","Su imagen llevo en dignidad,","Para ejercer Su autoridad.","¡Qué bueno: un hombre ser!","¡Un hombre para Él!","¡Oh, aleluya, un hombre fiel!"]},{"label":"4.","lines":["Un nuevo hombre, ¡gloria a Dios!","Ya lo logró el Señor.","Un hombre colectivo que","Por Él edificado es.","Un hombre sin rival,","Que reina sobre el mal","La iglesia y Cristo: hombre sin par."]}]}