{"hymn":"S501","parent":"E608","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Qué gran misterio es el Dios Tri-u-no","subtitle":"Experiencia de Dios—Por la Trinidad","syl":{"n1":"¡Qué","n2":"gran","n3":["mis","i"],"n4":["te","m"],"n5":["rio","t"],"n6":"es","n7":"el","n8":"Dios","n9":["Tri","i"],"n10":["-u-","m"],"n11":["no!","t"],"n13":["U","i"],"n14":["na","t"],"n15":["e","i"],"n16":["sen","m"],"n17":["cia‿en","t"],"n18":"tres","n19":["hi","i"],"n20":["pós","m"],"n21":["ta","m"],"n22":["sis*;","t"],"n24":"El","n25":["Pa","i"],"n26":["dre","t"],"n27":"en","n28":"el","n29":["Hi","i"],"n30":["jo","t"],"n31":["se‿in","i"],"n32":["tro","m"],"n33":["du","m"],"n34":["ce","t"],"n36":"Por","n37":"el","n38":["Es","i"],"n39":["pí","m"],"n40":["ri","m"],"n41":["tu","t"],"n42":"a","n43":["nues","i"],"n44":["tro","t"],"n45":"ser.","n47":"¡El","n48":["Triu","i"],"n49":["no","t"],"n50":"Dios","n51":"hoy","n52":["nues","i"],"n53":["tro","t"],"n54":["to","i"],"n55":["do","t"],"n56":"es!","n58":["¡Ad","i"],"n59":["mi","m"],"n60":["ra","m"],"n61":["ble!","t"],"n63":["¡Glo","i"],"n64":["rio","m"],"n65":["so‿es","t"],"n66":"Él!","n68":["¡Di","i"],"n69":["vi","m"],"n70":["no","t"],"n71":"Don","n72":["que‿ex","i"],"n73":["ce","m"],"n74":["de‿a","t"],"n75":["to","i"],"n76":["do","t"],"n77":"bien!","n79":"¡Qué","n80":["ex","i"],"n81":["cel","m"],"n82":["so‿es","t"],"n84":"en","n85":["nues","i"],"n86":["tro","t"],"n87":"ser!"},"verses":[{"label":"2.","lines":["¡Oh, qué caudal, el Padre es la fuente","Y Sus riquezas quiere al hombre dar!","¡Esta porción inagotable es nuestra,","Paro apreciar y siempre disfrutar!"]},{"label":"3.","lines":["El Hijo es la expresión del Padre,","Que en carne vino a la humanidad;","¡Qué redención perfecta y efectiva!","¡Hoy disfrutamos con Dios la unidad!"]},{"label":"4.","lines":["El Hijo hoy está transfigurado,","Y como Espíritu vida nos da;","¡Gran hecho es! ¡Su Espíritu viviente","Mezclado con el nuestro en unidad!"]},{"label":"5.","lines":["¡Qué realidad que nuestro Dios ahora,","Es el Espíritu para tocar!","¡Qué gran verdad! ¡En vida somos uno","Con nuestro Dios sin diferir jamás!"]}]}