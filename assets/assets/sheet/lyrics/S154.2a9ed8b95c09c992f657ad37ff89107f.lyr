{"hymn":"S154","parent":"E195","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tú eres las ofrendas","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"Tú","n2":["e","i"],"n3":["res","t"],"n4":"las","n5":["o","i"],"n6":["fren","m"],"n7":["das","t"],"n8":"Que","n9":"Dios","n10":"nos","n11":["pre","i"],"n12":["pa","m"],"n13":["ró;","t"],"n14":"Con","n15":["mu","i"],"n16":["cho","t"],"n17":["sim","i"],"n18":["bo","m"],"n19":["lis","m"],"n20":["mo","t"],"n21":["Te‿ex","i"],"n22":["pre","m"],"n23":["san,","t"],"n24":"oh","n25":["Se","i"],"n26":["ñor.","t"],"n27":"A","n28":"Dios","n29":"le","n30":["a","i"],"n31":["gra","m"],"n32":["da","m"],"n33":["ron,","t"],"n34":["Cum","i"],"n35":["plie","m"],"n36":["ron","t"],"n37":["Su‿in","i"],"n38":["ten","m"],"n39":["ción;","t"],"n41":["Tam","i"],"n42":["bién","t"],"n43":["hi","i"],"n44":["cie","m"],"n45":["ron","t"],"n46":["fren","i"],"n47":["te","t"],"n48":"A","n49":["nues","i"],"n50":["tra","t"],"n51":["con","i"],"n52":["di","m"],"n53":["ción.","t"]},"verses":[{"label":"2.","lines":["Eres el holocausto","Que‿el fuego consumió;","A Dios, un olor grato","Que Su placer cumplió.","En Su presencia‿andabas,","Viviste para El,","Te diste como ofrenda","A Dios por nuestro bien."]},{"label":"3.","lines":["Eres harina fina,","Fragante oblación,","Mezclada con aceite","Y‿olíbano‿en unión.","La ofrenda de paz eres","Para traernos paz;","Con Dios te disfrutamos","Como alimento real."]},{"label":"4.","lines":["Ofrenda de pecado","Para propiciación;","Tu muerte fue‿el rescate","Pagado‿en redención.","Ofrenda por las culpas","Y toda transgresión;","Ganaste por nosotros","Justicia y perdón."]},{"label":"5.","lines":["Como‿ofrenda mecida,","Tú en resurrección,","Lograste la victoria","Sobre la muerte atroz.","Como‿ofrenda‿elevada","Tú ascendiste‿a Dios,","Y como tal nos sacias","Al ser nuestra porción."]}]}