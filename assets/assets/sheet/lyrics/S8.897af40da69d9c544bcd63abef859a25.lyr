{"hymn":"S8","parent":"E12","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Fuente de vida eres, oh Dios","subtitle":"Adoración al Padre—Como fuente de vida","syl":{"n1":["¡Fuen","i"],"n2":["te","t"],"n3":"de","n4":["vi","i"],"n5":["da‿e","m"],"n6":["res,","t"],"n8":"oh","n9":"Dios","n10":"Cuán","n11":["li","i"],"n13":["bre‿es","t"],"n14":"Tu","n15":["cau","i"],"n16":["dal!","t"],"n17":["¡Co","i"],"n18":["mo‿a","m"],"n19":["gua","t"],"n20":["vi","i"],"n22":["va‿es","t"],"n23":"Tu","n25":["flu","i"],"n26":["ir,","t"],"n27":["Has","i"],"n28":["ta","t"],"n30":["la‿e","i"],"n31":["ter","m"],"n32":["ni","m"],"n33":["dad!","t"]},"verses":[{"label":"2.","lines":["Fluiste‿en el Hijo‿en amor,","Entre la‿humanidad;","Hoy fluyes como‿Espíritu,","Con gracia sin igual."]},{"label":"3.","lines":["Aunque‿en pecado y maldad,","Perdido‿en confusión,","Mas en Su Hijo Dios nos dio","La vida‿y redención."]},{"label":"4.","lines":["Te desdeñamos y además,","Te‿hacemos contristar;","Mas vienes como‿Espíritu,","Tu vida‿a todos dar."]},{"label":"5.","lines":["Mezclado en el Hijo‿estás,","Como‿el Espíritu;","En comunión nos ungirás","Para‿aumentarte Tú."]},{"label":"6.","lines":["Fluye‿el amor del Padre Dios,","La gracia de Jesús,","Para de Dios participar","Por el Espíritu."]},{"label":"7.","lines":["Oh Padre, Hijo,‿Espíritu,","Nos cuidas sin cesar;","Te adoramos por Tu‿amor,","Cantando‿en unidad."]}]}