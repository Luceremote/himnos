{"hymn":"S426","parent":"E540","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Qué liberación me ha dado","subtitle":"Experiencia de Cristo—Como emancipador","syl":{"n1":"¡Qué","n2":["li","i"],"n3":["be","m"],"n4":["ra","m"],"n5":["ción","t"],"n6":"me‿ha","n7":["da","i"],"n8":["do!","t"],"n9":["Cris","i"],"n10":["to,","t"],"n11":"sí,","n12":"me","n13":["li","i"],"n14":["be","m"],"n15":["ró!","t"],"n16":["Que","i"],"n17":["bran","m"],"n18":["ta","m"],"n19":["do‿es","m"],"n20":["tá‿el","t"],"n21":["pe","i"],"n22":["ca","m"],"n23":["do,","t"],"n24":["¡Muer","i"],"n25":["te,","t"],"n26":["tu‿a","i"],"n27":["gui","m"],"n28":["jón","t"],"n29":["pa","i"],"n30":["só!","t"],"n31":"Por","n32":"Su","n33":["vic","i"],"n34":["to","m"],"n35":["ria","t"],"n36":"me","n37":["ha‿he","i"],"n38":["cho,","t"],"n39":["Cris","i"],"n40":["to,","t"],"n41":"más","n42":"que","n43":["ven","i"],"n44":["ce","m"],"n45":["dor.","t"],"n46":"En","n47":["mi‿es","i"],"n48":["pí","m"],"n49":["ri","m"],"n50":["tu","t"],"n51":["me‿in","i"],"n52":["fun","m"],"n53":["de","t"],"n54":"Su","n55":["vi","i"],"n56":["tal","t"],"n57":["re","i"],"n58":["su","m"],"n59":["rrec","m"],"n60":["ción.","t"]},"verses":[{"label":"2.","lines":["Cristo a mí me ha liberado,","De la ley y su poder;","Para siempre desatado,","Por Su gracia viviré."]},{"label":"3.","lines":["Cristo condenó el pecado,","Al Calvario lo llevó;","Ya no tiene en mí más base,","Su poder Él destruyó."]},{"label":"4.","lines":["Cristo abolió la muerte","Por la vida inmortal;","El venció sus ataduras,","Con resurrección triunfal."]},{"label":"5.","lines":["Cristo al diablo y los demonios,","Con Su muerte aplastó;","Del poder de las tinieblas","A la luz me trasladó."]},{"label":"6.","lines":["Da Su gracia suficiente,","Y poder tan cubridor;","Aunque débil, me glorío,","En la fuerza del Señor."]}]}