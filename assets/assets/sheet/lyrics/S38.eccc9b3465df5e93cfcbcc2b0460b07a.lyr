{"hymn":"S38","parent":"E48","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Te bendecimos, Padre","subtitle":"Adoración al Padre—Su gracia en la filiación","syl":{"n1":"Te","n2":["ben","i"],"n3":["de","m"],"n4":["ci","m"],"n5":["mos,","t"],"n6":["Pa","i"],"n7":["dre,","t"],"n8":"Con","n9":["go","i"],"n10":["zo","t"],"n11":["ce","i"],"n12":["les","m"],"n13":["tial,","t"],"n14":"Pues","n15":"con","n16":"Tu","n17":["Hi","i"],"n18":["jo‿A","m"],"n19":["ma","m"],"n20":["do","t"],"n21":["Es","i"],"n22":["tá","t"],"n23":["nues","i"],"n24":["tro","t"],"n25":["lu","i"],"n26":["gar.","t"],"n27":"El","n28":["vi","i"],"n29":["ve","t"],"n30":["co","i"],"n31":["mo‿un","t"],"n32":["Hom","i"],"n33":["bre","t"],"n34":["De","i"],"n35":["lan","m"],"n36":["te","t"],"n37":"de","n38":"Tu","n39":"faz,","n40":"En","n41":["glo","i"],"n42":["ria‿in","m"],"n43":["mar","m"],"n44":["ce","m"],"n45":["si","m"],"n46":["ble,","t"],"n47":"En","n48":["Tu‿a","i"],"n49":["mor","t"],"n50":["e","i"],"n51":["ter","m"],"n52":["nal.","t"]},"verses":[{"label":"2.","lines":["Su Padre y nuestro Padre,","Su Dios y nuestro Dios;","Él es Tu buen Amado","Y Tu satisfacción.","Con gozo El nos lleva","A compartir Tu amor,","El brillo de Tu rostro,","Tu gracia y Tu favor."]},{"label":"3.","lines":["Tu amor que nos envuelve","Jamás se enfriará;","En Él Tu amor se centra,","Y Tu favor nos das.","En Él Tu amor y gloria","Encuentran su lugar,","Y todos Sus hermanos,","Tus hijos, dulce hogar."]}]}