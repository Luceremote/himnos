{"hymn":"S414","parent":"E523","quality":"exact","adjust":{"hold":0,"merge":0},"title":"A la Fuente de vida llegué","subtitle":"Experiencia de Cristo—Como aquel que es el todo","syl":{"n1":"A","n2":"la","n3":["Fuen","i"],"n4":["te","t"],"n5":"de","n6":["vi","i"],"n7":["da","t"],"n8":["lle","i"],"n9":["gué,","t"],"n11":"La","n12":["fuen","i"],"n13":["te","t"],"n14":"que","n15":["flu","i"],"n16":["ye","t"],"n17":"de","n18":"Dios.","n20":"Yo","n21":"las","n22":["a","i"],"n23":["guas","t"],"n24":["de‿a","i"],"n25":["fa","m"],"n26":["nes","t"],"n27":["de","i"],"n28":["jé","t"],"n30":"Y","n31":["vi","i"],"n32":["ne‿al","t"],"n33":["E","i"],"n34":["lim","t"],"n35":"del","n36":["a","i"],"n37":["mor;","t"],"n39":"Yo","n40":"del","n41":["po","i"],"n42":["zo","t"],"n43":"de","n44":["lo‿al","i"],"n45":["to","t"],"n46":["be","i"],"n47":["bí","t"],"n49":["Des","i"],"n50":["de","t"],"n51":["lo‿hon","i"],"n52":["do","t"],"n53":"de","n54":"mi","n55":["in","i"],"n56":["te","m"],"n57":["rior.","t"],"n59":"No","n61":["pue","i"],"n62":["de","t"],"n63":["nin","i"],"n64":["gu","m"],"n65":["no","t"],"n66":["de","i"],"n67":["cir","t"],"n69":"El","n70":["go","i"],"n71":["zo","t"],"n72":"del","n73":["Con","i"],"n74":["so","m"],"n75":["la","m"],"n76":["dor.","t"],"n78":"Oh,","n79":"ven","n80":"a","n81":"la","n82":["Fuen","i"],"n83":["te‿a","t"],"n84":["be","i"],"n85":["ber","t"],"n87":"La","n88":["Fuen","i"],"n89":["te","t"],"n90":"de","n91":["vi","i"],"n92":["da‿e","m"],"n93":["ter","m"],"n94":["nal;","t"],"n96":"Ven,","n98":["be","i"],"n99":["be,","t"],"n100":"no","n101":["se‿a","i"],"n102":["go","m"],"n103":["ta","m"],"n104":["rá,","t"],"n106":"Pues","n107":["Cris","i"],"n108":["to‿es","t"],"n109":"la","n110":["Fuen","i"],"n111":["te‿en","t"],"n112":["ver","i"],"n113":["dad.","t"]},"verses":[{"label":"2.","lines":["A la Fuente de sangre llegué","Que fluye por nuestra maldad.","Del pecado, mis ropas lavé;","Más blancas que la nieve están.","Ya no cuenta mi justicia aquí,","Jesús en mi alma vive‿hoy.","Su esencia divina está en mí,","Y en Él sano y salvo yo‿estoy."]},{"label":"3.","lines":["A la Fuente que sana llegué,","Constante, abundante fluir.","Su secreto nadie comprará;","Ni sabio podrá descubrir.","El secreto el Señor reveló","En la fuente que fluye de Él,","En las llagas que pueden curar,","En Él al llenar nuestro ser."]},{"label":"4.","lines":["A la fuente de gozo llegué,","La fuerza de mi corazón.","Do mi sol no se opacará;","Mi gozo es sin aleación.","La higuera se marchitará,","Los placeres se disminuirán,","Mas mis fuentes no se secarán,","Pues tengo porción divinal."]}]}