{"hymn":"S24","parent":"E28","quality":"adapted","adjust":{"hold":0,"merge":4},"title":"¡Oh, amor de Dios! Tu inmensidad","subtitle":"Adoración al Padre—Su amor","syl":{"n1":"¡Oh,","n2":["a","i"],"n3":["mor‿de","t"],"n4":"Dios!","n5":["Tu‿in","i"],"n6":["men","m"],"n7":["si","m"],"n8":["dad","t"],"n10":"No","n11":"se","n12":["po","i"],"n13":["drá","t"],"n14":["ja","i"],"n15":["más","t"],"n16":["con","i"],"n17":["tar;","t"],"n18":["Tras","i"],"n19":["pa","m"],"n20":["sa‿el","t"],"n21":["or","i"],"n22":["be","t"],"n23":["ce","i"],"n24":["les","m"],"n25":["tial","t"],"n27":"Y","n28":["al","i"],"n29":["can","m"],"n30":["za‿has","m"],"n31":["ta‿el","t"],"n32":["hon","i"],"n33":["do","t"],"n34":"mar.","n35":"Al","n36":["fra","i"],"n37":["ca","m"],"n38":["sar","t"],"n39":"el","n40":["pri","i"],"n41":["mer","t"],"n42":"par","n44":["Su‿Hi","i"],"n45":["jo","t"],"n46":"Dios","n47":["pro","i"],"n49":["me","m"],"n50":["tió;","t"],"n51":["A","i"],"n52":["quel","t"],"n53":["que‿e","i"],"n54":["rró","t"],"n55":"lo","n56":["per","i"],"n57":["do","m"],"n58":["nó,","t"],"n60":["Su‿a","i"],"n61":["mor","t"],"n62":["lo‿re","i"],"n63":["con","m"],"n65":["ci","m"],"n66":["lió.","t"],"n67":"¡Oh","n68":["a","i"],"n69":["mor","t"],"n70":"de","n71":"Dios!","n72":["¡Qué‿in","i"],"n73":["men","m"],"n74":["so‿es!","t"],"n76":"Qué","n77":["pu","i"],"n78":["ro‿y‿ri","m"],"n79":["co‿en","t"],"n81":["ver","i"],"n82":["dad!","t"],"n83":"Los","n84":["san","i"],"n85":["tos","t"],"n86":["can","i"],"n87":["ta","m"],"n88":["rán","t"],"n89":"de","n90":"él","n92":["Por‿to","i"],"n93":["da","t"],"n94":["la‿e","i"],"n95":["ter","m"],"n97":["ni","m"],"n98":["dad.","t"]},"verses":[{"label":"2.","lines":["Cuando el tiempo quede atrás","Con todo imperio mundanal,","Y caiga todo trono acá","Y llegue el reino celestial;","El gran amor del Redentor","Aún tan fuerte estará,","Y la canción de salvación","Su pueblo allí cantará."]},{"label":"3.","lines":["Si fuera tinta todo el mar,","Y todo el cielo un gran papel,","Y cada hombre un escritor,","Y cada hoja un pincel,","Al intentar contar Su amor","Se vaciaría el mar;","Y ni los cielos con su anchor","Podría el rollo abarcar."]}]}