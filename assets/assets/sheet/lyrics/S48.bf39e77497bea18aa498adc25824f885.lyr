{"hymn":"S48","parent":"E61","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Hijo de Hombre, Tú, Señor","subtitle":"Alabanza al Señor—Su humanidad","syl":{"n1":["Hi","i"],"n2":["jo","t"],"n3":"de","n4":["Hom","i"],"n5":["bre,","t"],"n6":"Tú,","n8":["Se","i"],"n9":["ñor,","t"],"n10":["E","i"],"n11":["sen","m"],"n12":["cia‿hu","m"],"n13":["ma","m"],"n14":["na","t"],"n16":"te","n18":["vis","i"],"n19":["tió;","t"],"n20":"Fue","n21":["vir","i"],"n22":["gi","m"],"n23":["nal","t"],"n25":"Tu","n26":["con","i"],"n27":["cep","m"],"n28":["ción,","t"],"n30":"Con","n31":["car","i"],"n32":["ne‿y","t"],"n33":["san","i"],"n35":["gre","t"],"n36":"te","n38":["for","i"],"n39":["mó.","t"]},"verses":[{"label":"2.","lines":["Forma de siervo humilde Tú","Llevaste en Tu caminar;","Fue tan humano Tu vivir","Y muy sufrido Tu andar."]},{"label":"3.","lines":["Naciste en un pesebre Tú,","Muy pobre fuiste en Tu niñez;","Un carpintero sin honor;","Que‿en cruz de malhechor murió."]},{"label":"4.","lines":["Venciste Tú la muerte atroz,","Tu humanidad se conservó;","Y como‿un hombre divinal","Entraste en gloria celestial."]},{"label":"5.","lines":["Hoy en el trono riges Tú,","Y como hombre‿en gloria estás;","Allí con Dios en plena luz","Satisfacción total le das."]},{"label":"6.","lines":["Lleno de gloria volverás,","Y como un hombre te verán;","El Rey de reyes con poder,","Y divinal humanidad."]},{"label":"7.","lines":["Serás el centro Tú, Señor,","Del nuevo orden que vendrá;","Por siempre con divinidad","Viviendo en Tu humanidad."]}]}