{"hymn":"S846","parent":"E1004","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Qué preciosa es la sangre","subtitle":"El evangelio—La sangre","syl":{"n1":"Qué","n2":["pre","i"],"n3":["cio","m"],"n4":["sa","t"],"n5":"es","n6":"la","n7":["san","i"],"n8":["gre","t"],"n9":"Del","n10":["Se","i"],"n11":["ñor","t"],"n12":["Je","i"],"n13":["sús;","t"],"n14":"La","n15":["ver","i"],"n16":["tió","t"],"n17":"por","n18":["pe","i"],"n19":["ca","m"],"n20":["do","m"],"n21":["res","t"],"n22":["So","i"],"n23":["bre‿la","t"],"n25":"cruz.","n26":"Qué","n27":["pre","i"],"n28":["cio","m"],"n29":["sa","t"],"n30":"es","n31":"la","n32":["san","i"],"n33":["gre","t"],"n34":"Del","n35":["Se","i"],"n36":["ñor","t"],"n37":["Je","i"],"n38":["sús;","t"],"n39":["Cre","i"],"n40":["e","t"],"n41":"en","n42":["e","i"],"n43":["lla‿y","t"],"n44":["re","i"],"n45":["ci","m"],"n46":["be","t"],"n47":["Ple","i"],"n48":["na‿sa","m"],"n50":["lud.","t"]},"verses":[{"label":"2.","lines":["¡Qué preciosa es la sangre!","Te puede sanar;","Si fluye sobre tu alma,","Te limpiará."]},{"label":"3.","lines":["Aunque sean tus pecados","Como el carmesí,","Puede Su sangre preciosa","Lavarte a ti."]},{"label":"4.","lines":["¡Qué preciosa es la sangre!","Que nos redimió;","Hoy perfecta paz ofrece,","Y el perdón."]},{"label":"5.","lines":["Con confianza a Su presencia","Podemos entrar;","Pues la fuente abierta limpia","De todo mal."]},{"label":"6.","lines":["¡Qué preciosa es la sangre!","La victoria da;","Ella vence al pecado","Y a Satanás."]},{"label":"7.","lines":["¡Qué preciosa es la sangre!","Que nos lleva a Dios;","Un camino nuevo y vivo;","¡Damos loor!"]}]}