{"hymn":"S172","parent":"E220","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tu mesa al contemplar, Señor","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n1":"Tu","n2":["me","i"],"n4":["sa‿al","t"],"n5":["con","i"],"n7":["tem","m"],"n8":["plar,","t"],"n9":["Se","i"],"n10":["ñor,","t"],"n11":["E","i"],"n12":["vo","m"],"n14":["ca‿ad","m"],"n15":["mi","m"],"n16":["ra","m"],"n17":["ción;","t"],"n18":"El","n19":"pan,","n21":"la","n22":["co","i"],"n23":["pa","t"],"n24":["sig","i"],"n26":["nos","t"],"n27":"son","n28":"De","n30":"lo","n31":"que","n32":["quie","i"],"n33":["re","t"],"n34":"Dios."},"verses":[{"label":"2.","lines":["El pan revela que‿eres Tú","Comida celestial;","Y por Tu muerte mística","Tu mismo ser nos das."]},{"label":"3.","lines":["Es esta copa mi porción,","Tu sangre la llenó;","Es copa de gran bendición","Para ganar a Dios."]},{"label":"4.","lines":["De Ti comemos en el pan,","Tu vida‿así nos das;","Al recordarte en amor","Tu ser nos saciará."]},{"label":"5.","lines":["Hoy disfrutamos bendición","Por la copa‿al beber;","Te recordamos con fervor","Hasta llevados ser."]},{"label":"6.","lines":["Al disfrutar del vino‿y pan","Tu muerte se‿expondrá;","Que nuestra vida eres Tu","También se‿anunciara."]},{"label":"7.","lines":["Un día tan glorioso‿habrá","De gran satisfacción,","Para‿en tu mesa disfrutar","Contigo comunión."]}]}