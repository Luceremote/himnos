{"hymn":"S609","parent":"E788","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Antes de que te levantes","subtitle":"Oración—Decirle todo al Señor","syl":{"n1":["An","i"],"n2":["tes","t"],"n3":"de","n4":"que","n5":"te","n6":["le","i"],"n7":["van","m"],"n8":["tes","t"],"n9":"Y","n10":"tu","n11":["dí","i"],"n12":["a","t"],"n13":["co","i"],"n14":["men","m"],"n15":["zar","t"],"n16":["Pa","i"],"n17":["ra‿ha","m"],"n18":["llar","t"],"n19":"lo","n20":"que","n21":["te‿es","i"],"n22":["pe","m"],"n23":["ra","t"],"n24":"En","n25":"tu","n26":["dia","i"],"n27":["ria‿ac","m"],"n28":["ti","m"],"n29":["vi","m"],"n30":["dad,","t"],"n31":["Aun","i"],"n32":["que‿el","t"],"n33":["cie","i"],"n34":["lo‿es","m"],"n35":["te","t"],"n36":["som","i"],"n37":["brí","m"],"n39":["o","t"],"n40":"O","n41":"el","n42":"sol","n43":["i","i"],"n44":["rra","m"],"n45":["die","t"],"n46":"luz,","n47":["Se","i"],"n48":["a","t"],"n49":["tu‿al","i"],"n50":["ba‿a","m"],"n51":["le","m"],"n52":["gre‿o","t"],"n53":["tris","i"],"n54":["te,","t"],"n55":["Di","i"],"n56":["le","t"],"n57":["to","i"],"n58":["do","t"],"n59":"a","n60":["Je","i"],"n61":["sús.","t"]},"verses":[{"label":"2.","lines":["Que tu obra cotidiana","Sea hecha en comunión;","Se disipen tus afanes,","Desahogando tu alma en Dios;","Y si el mundo con encantos","Quiere atar tu espíritu,","Antes de que tú contestes,","Dile todo a Jesús."]},{"label":"3.","lines":["Luego al pasar las horar,","Dios tu senda guiará;","Si tu carga es más ligera,","Tú podrás a otro alzar;","Dando ayuda al cansado,","Y al caído, fortitud,","Mientras haces tu servicio,","Dile todo a Jesús."]},{"label":"4.","lines":["Si al terminar el día,","El cansancio te venció;","Si con tentaciones crueles","Satanás te enfrentó;","Aunque débil o en peligro,","Pide al cielo su virtud;","Salvación y calma vienen","Al decir todo a Jesús."]}]}