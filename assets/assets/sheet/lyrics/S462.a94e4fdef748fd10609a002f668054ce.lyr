{"hymn":"S462","parent":"E1152","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Estamos atraídos cada día a Jesús","subtitle":"Experiencia de Cristo—Disfrutarlo a Él","syl":{"n1":["Es","i"],"n2":["ta","m"],"n3":["mos","t"],"n4":["a","i"],"n5":["tra","m"],"n6":["í","m"],"n7":["dos","t"],"n8":["ca","i"],"n9":["da","t"],"n10":["dí","i"],"n11":["a","t"],"n12":"a","n13":["Je","i"],"n14":["sús,","t"],"n15":"Es","n16":["be","i"],"n17":["llo","t"],"n18":"cual","n19":["nin","i"],"n20":["gu","m"],"n21":["no,","t"],"n22":"más","n23":["ra","i"],"n24":["dian","m"],"n25":["te","t"],"n26":"que","n27":"la","n28":"luz;","n29":"Es","n30":"más","n31":"de","n32":"lo","n33":"que","n34":["di","i"],"n35":["gas","t"],"n36":"o","n37":"que","n38":["pue","i"],"n39":["das","t"],"n40":["com","i"],"n41":["po","m"],"n42":["ner,","t"],"n43":"Y","n44":"Él","n45":"se","n46":["ha","i"],"n47":["ce","t"],"n48":"más","n49":["que","i"],"n50":["ri","m"],"n51":["do‿al","t"],"n52":["ver","i"],"n53":["lo","t"],"n54":["ca","i"],"n55":["da","t"],"n56":"vez.","n57":"No","n58":["pue","i"],"n60":["de","t"],"n61":["des","i"],"n62":["cri","m"],"n63":["bir","m"],"n64":["se,","t"],"n65":["ni‿a","i"],"n66":["ún","t"],"n68":"a","n69":"la","n70":["mi","i"],"n71":["tad;","t"],"n72":"Él","n73":"es","n75":["nues","i"],"n76":["tro","t"],"n77":["te","i"],"n78":["so","m"],"n79":["ro","t"],"n80":"que","n81":["que","i"],"n82":["re","m"],"n83":["mos","t"],"n84":"más","n85":"y","n86":"más."},"verses":[{"label":"2.","lines":["Al verle en la iglesia tanta gloria estalló,","Hallando Sus riquezas, nuestra búsqueda cesó;","Aquí se satisface nuestro espíritu con Él,","Y Él se hace más querido al verlo cada vez."]},{"label":"3.","lines":["Es el viviente Espíritu que mora en nuestro ser,","Ungiendo nuestro espíritu, lo inunda todo Él;","Reunidos con los santos nos rebosa el corazón;","Por eso lo queremos con entera devoción."]},{"label":"4.","lines":["Por Su recobro somos uno hoy con el Señor,","Se exhiben Sus riquezas por la iglesia con fervor;","Todo lo que tenemos nos complace derramar","Para que Su propósito se pueda realizar."]}]}