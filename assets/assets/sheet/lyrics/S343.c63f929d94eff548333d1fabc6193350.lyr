{"hymn":"S343","parent":"E445","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Toma mi vida, Señor","subtitle":"Consagración—Rendirlo todo al Señor","syl":{"n1":["To","i"],"n2":["ma","t"],"n3":"mi","n5":["vi","i"],"n7":["da,","t"],"n8":["Se","i"],"n9":["ñor,","t"],"n10":["Con","i"],"n11":["sa","m"],"n12":["gra","m"],"n14":["da","t"],"n16":"te","n17":"la","n19":"doy;","n20":["To","i"],"n21":["ma","t"],"n22":["to","i"],"n24":["do","t"],"n25":"lo","n26":"que","n28":"soy,","n29":"Te","n30":["lo‿o","i"],"n31":["frez","m"],"n32":["co","t"],"n34":"con","n36":["a","i"],"n38":["mor.","t"],"n39":"Te","n40":["lo‿o","i"],"n41":["frez","m"],"n42":["co","t"],"n44":"con","n45":["a","i"],"n46":["mor.","t"]},"verses":[{"label":"2.","lines":["Toma mis manos, Señor,","Las consagró a Tu labor;","Toma hoy también mis pies","//Para cosechar la mies.//"]},{"label":"3.","lines":["Ten mis labios para hablar","Y Tu grey apacentar;","Ten mi voz y cantaré","//Siempre, sólo, por mi Rey.//"]},{"label":"4.","lines":["Ten mi plata y oro hoy,","Ni una pizca quiero yo;","Ten mi mente y su poder","//Úsala para Tu bien.//"]},{"label":"5.","lines":["Toma aun mi corazón,","Y haz en él Tu trono hoy;","Toma Tú mi voluntad","//A Tus pies postrada está.//"]},{"label":"6.","lines":["Toma, oh Señor, mi amor","Que a Tus pies derramo hoy;","Tómame para que así","//Sea sólo para Ti.//"]}]}