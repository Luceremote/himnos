{"hymn":"S293","parent":"E370","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La noche viene, ¡oh, conmigo sé","subtitle":"Anhelos—De amor por Cristo","syl":{"n1":"La","n2":["no","i"],"n3":["che","t"],"n4":["vie","i"],"n5":["ne,","t"],"n6":"¡oh,","n7":["con","i"],"n8":["mi","m"],"n9":["go","t"],"n10":"sé!","n11":["¡Hon","i"],"n12":["das","t"],"n13":["ti","i"],"n14":["nie","m"],"n15":["blas","t"],"n16":["cu","i"],"n17":["bren","t"],"n18":"por","n19":["do","i"],"n20":["quier!","t"],"n21":"No‿hay","n22":["o","i"],"n23":["tra‿a","m"],"n24":["yu","m"],"n25":["da","t"],"n26":"ni","n27":["con","i"],"n28":["so","m"],"n29":["la","m"],"n30":["ción;","t"],"n31":["Con","i"],"n32":["mi","m"],"n33":["go","t"],"n34":"sé,","n35":["que","i"],"n36":["ri","m"],"n37":["do‿A","m"],"n38":["yu","m"],"n39":["da","m"],"n40":["dor.","t"]},"verses":[{"label":"2.","lines":["Veloz el día declinando va;","Se‿apaga todo gozo terrenal;","Todo‿en mi entorno veo decaer;","Tú, que no cambias, hoy conmigo sé."]},{"label":"3.","lines":["Ven Rey de reyes, sin causar terror;","Trae en Tus alas sanidad, Señor;","Tan compasivo,‿atento, tierno‿y fiel;","Amigo de‿hombres, ven, conmigo sé."]},{"label":"4.","lines":["Yo necesito Tu presencia hoy;","Solo Tu gracia vence‿al tentador;","¿Quién como Tú mi guia puede ser?","En sol o sombra, oh conmigo sé."]},{"label":"5.","lines":["Si‿estás conmigo, nada temeré:","Penas y llantos pierden su poder.","¿Dónde, sepulcro, tu victoria‿está?","Yo triunfaré si Tú conmigo‿estás."]}]}