{"hymn":"S124","parent":"E152","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Qué profundo, tan extenso","subtitle":"Alabanza al Señor—Su amor","syl":{"n1":"¡Qué","n2":["pro","i"],"n5":["fun","m"],"n6":["do,","t"],"n7":"tan","n8":["ex","i"],"n11":["ten","m"],"n13":["so","t"],"n14":"Es,","n15":["Se","i"],"n18":["ñor,","t"],"n20":["Tu‿a","i"],"n21":["mor","t"],"n23":"sin","n24":"par!","n25":"Más","n26":["a","i"],"n29":["llá","t"],"n30":"de","n31":["lo‿in","i"],"n32":["son","m"],"n35":["da","m"],"n37":["ble,","t"],"n38":"Más","n39":["pro","i"],"n42":["fun","m"],"n44":["do","t"],"n45":"que","n47":"la","n48":"mar!","n49":"Te","n50":["cau","i"],"n53":["só","t"],"n54":["su","i"],"n55":["frir","t"],"n56":"la","n59":["muer","i"],"n60":["te,","t"],"n61":["E‿im","i"],"n62":["par","m"],"n65":["tir","t"],"n66":"en","n67":"mí","n68":"Tu","n71":"ser;","n72":"Tal","n73":["a","i"],"n76":["mor","t"],"n77":"que‿a","n78":"Ti","n79":["me‿in","i"],"n82":["jer","m"],"n84":["ta,","t"],"n85":["Par","i"],"n86":["te","t"],"n89":["Tu","i"],"n91":["ya","t"],"n92":["me‿ha","i"],"n94":["ce","t"],"n95":"ser."},"verses":[{"label":"2.","lines":["¿Quién dirá las maravillas","Que logró Tu amor por mí?","La más grande maravilla","Es tenerte siempre‿en mí.","Yo Tu ser he recibido","Por completa provisión;","Como vida te disfruto,","Tus riquezas mías son."]},{"label":"3.","lines":["Tu amor, Señor, expresa,","Tu Persona divinal;","A mi vida da sentido,","La‿armoniza con Tu plan.","Gracia todo-suficiente,","Cada día es mi porción;","Gusto siempre Tu dulzura,","Y de todo Tu favor."]},{"label":"4.","lines":["¿Qué de Ti podrá apartarme?","¡Hasta el fin me amarás!","¡Oh, qué gran amor tan fuerte","Que nos mezcla‿en unidad!","Somos uno para siempre;","¡Mío eres, Tuyo soy!","Este es mi testimonio:","¡Enlazados por Tu amor!"]}]}