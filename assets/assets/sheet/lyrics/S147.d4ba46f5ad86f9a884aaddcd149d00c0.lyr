{"hymn":"S147","parent":"E188","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Hijo de Dios eres, Señor","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":["Hi","i"],"n2":["jo","t"],"n3":"de","n4":"Dios","n5":["e","i"],"n6":["res,","t"],"n7":["Se","i"],"n8":["ñor,","t"],"n9":"Su","n10":["ex","i"],"n11":["pre","m"],"n12":["sión","t"],"n13":["per","i"],"n14":["fec","m"],"n15":["ta;","t"],"n16":"En","n17":"Ti","n18":"nos","n20":["ha","i"],"n21":["bla","t"],"n22":["nues","i"],"n23":["tro","t"],"n25":"Dios","n26":"En","n27":["for","i"],"n28":["ma","t"],"n29":"tan","n30":["com","i"],"n31":["ple","m"],"n33":["ta.","t"]},"verses":[{"label":"2.","lines":["Tu eres nuestro mismo Dios,","Su resplandor de gloria;","La‿imagen de Su‿interno ser,","En Ti está Su‿historia."]},{"label":"3.","lines":["Hiciste‿el universo, Tú,","Y por Ti él subsiste;","Dios Su‿heredero te nombró;","Todo lo recibiste."]},{"label":"4.","lines":["Purgaste los pecados, Tú,","Y‿al cielo ascendiste;","La voluntad de Dios harás;","Todo rival venciste."]},{"label":"5.","lines":["Tu nombre sobre todos es,","De Dios lo heredaste;","En el Espíritu hoy, Tú","El Hijo de Dios eres."]},{"label":"6.","lines":["Tu reino, de justicia es;","Tu trono‿es para siempre;","Dios te ha‿ungido en amor;","Tú nunca envejeces."]},{"label":"7.","lines":["Como hombre tienes Tú también","Naturaleza humana;","Gustaste muerte Tú por mí;","De Ti la vida emana."]},{"label":"8.","lines":["Corona de gloria y‿honor,","Todo‿a Ti está sujeto;","El Capitán de salvación,","Perfecto‿en sufrimientos."]},{"label":"9.","lines":["Tu muerte destruyó a Satán,","Y de‿ella nos libraste;","En vida santificarás,","A gloria nos llamaste."]},{"label":"10.","lines":["Has dado‿a Tus hermanos hoy","El nombre de Tu Padre;","Y en la‿iglesia cantas Tú","Para que‿en Ti lo‿alaben."]},{"label":"11.","lines":["Más que Moisés, tan superior,","Apóstol con más gloria;","Como a la casa‿el constructor","Es digno de más honra."]},{"label":"12.","lines":["Eres nuestro real Josué,","Por Ti‿al descanso entramos;","Nuestra completa salvación,","Nuestra fe‿en Ti hallamos."]},{"label":"13.","lines":["Tú, el descanso celestial,","Hoy en nosotros moras;","Para‿a la buena tierra‿entrar","Y heredarla toda."]},{"label":"14.","lines":["También más digno que Aarón,","La misma ofrenda eres;","Entraste‿al cielo para ser","Tal Sumo Sacerdote."]},{"label":"15.","lines":["Eres nuestro Melquisedec","Que vida‿y fuerza tienes;","Con vino‿y pan ministras Tú","Y siempre nos sostienes."]},{"label":"16.","lines":["Nuestro sacrificio mejor","Por el Espíritu‿eres;","La‿ofrenda única a Dios","Que mérito hoy tiene."]},{"label":"17.","lines":["Lograste un pacto superior","Con tu preciosa sangre;","El nuevo testamento‿así","Por nosotros ganaste."]},{"label":"18.","lines":["Del pacto,‿eres el Hacedor,","Pues mérito Tu tienes;","Hoy tal herencia nuestra es,","Pues el Dador Tú eres."]},{"label":"19.","lines":["El Albacea‿y Mediador","Del pacto hoy Tú eres;","Tú cumples la‿elección de Dios","Y nuestra vida eres."]},{"label":"20.","lines":["Tú eres nuestro Precursor","Que‿estás dentro del velo;","Tu vida nos hace salir","Fuera del campamento."]},{"label":"21.","lines":["Autor y el Consumador","De la fe verdadera,","Nos sujetamos en amor","A Ti con fe sincera."]},{"label":"22.","lines":["Inigualado‿eres, Jesús,","Nuestro‿único tesoro;","Completo y perfecto, Tú,","Precioso más que‿el oro."]}]}