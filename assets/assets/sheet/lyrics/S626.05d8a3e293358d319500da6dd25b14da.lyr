{"hymn":"S626","parent":"E811","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Mi corazón tiene hambre, Señor","subtitle":"El estudio de la palabra—Alimentarnos de la palabra","syl":{"n1":"Mi","n2":["co","i"],"n3":["ra","m"],"n4":["zón","t"],"n5":["tie","i"],"n6":["ne","t"],"n7":["ham","i"],"n8":["bre,","t"],"n9":["Se","i"],"n10":["ñor;","t"],"n11":["Ven","i"],"n12":["go","t"],"n13":"a","n14":"Ti","n15":"a","n16":["bus","i"],"n17":["car","t"],"n18":["pro","i"],"n19":["vi","m"],"n20":["sión;","t"],"n21":"Te","n22":["ne","i"],"n23":["ce","m"],"n24":["si","m"],"n25":["to,","t"],"n26":"no","n27":"hay","n28":["o","i"],"n29":["tro‿i","m"],"n30":["gual,","t"],"n31":["Ham","i"],"n32":["bre","t"],"n33":"y","n34":"sed","n35":"Tú","n36":"las","n37":["pue","i"],"n38":["des","t"],"n39":["sa","i"],"n40":["ciar.","t"],"n41":["Nú","i"],"n42":["tre","m"],"n43":["me","t"],"n44":["Cris","i"],"n45":["to,","t"],"n47":["da","i"],"n48":["me‿a","t"],"n49":["be","i"],"n50":["ber,","t"],"n52":["Sa","i"],"n53":["cia","t"],"n54":"mi","n55":["ham","i"],"n56":["bre,","t"],"n58":["to","i"],"n59":["da","t"],"n60":"mi","n61":"sed;","n63":["Go","i"],"n64":["zo","t"],"n65":"me","n66":"das,","n67":["for","i"],"n68":["ta","m"],"n69":["le","m"],"n70":["za","t"],"n71":["tam","i"],"n72":["bién;","t"],"n74":["Sa","i"],"n75":["cia","t"],"n76":"mi","n77":["ham","i"],"n78":["bre,","t"],"n80":["to","i"],"n81":["da","t"],"n82":"mi","n83":"sed."},"verses":[{"label":"2.","lines":["Agua de vida y comida eres Tú,","Tú me revives, levantas mi ser;","Deseo comer y beber más de Ti,","De Ti gozar al orar y leer."]},{"label":"3.","lines":["Eres la viva Palabra de Dios,","Como Espíritu vida me das;","Como Espíritu mi agua eres Tú,","Y en la Palabra, Tú eres mi pan."]},{"label":"4.","lines":["Desde los cielos bajaste, Señor,","Para ser mi alimento eternal;","Fuiste herido y el agua brotó,","Para abrevarme como un manantial."]},{"label":"5.","lines":["En la Palabra me nutro de Ti;","Eres Espíritu y vida a mí;","Como Espíritu vives en mí,","En mi espíritu bebo de Ti."]},{"label":"6.","lines":["En Tu Palabra te disfruto hoy,","Hasta que el hambre termine‿en mi ser","En mi espíritu me vuelvo a Ti,","Para beber y saciar toda sed."]},{"label":"7.","lines":["Como y bebo de Ti, mi Señor,","Como leyendo y bebo al orar;","Orar-leer es beber y comer,","Mi vivir eres al leer-orar."]},{"label":"8.","lines":["Oh, que festeje en Ti, mi Señor,","Por Tu Palabra y‿Espíritu hoy;","Sé para mí esa fiesta de‿amor,","Que el hombre nunca jamás disfrutó."]}]}