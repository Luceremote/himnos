{"hymn":"S34","parent":"E42","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Por Ti, Dios, invitados","subtitle":"Adoración al Padre—Su redención","syl":{"n1":"Por","n2":"Ti,","n3":"Dios,","n4":["in","i"],"n5":["vi","m"],"n6":["ta","m"],"n7":["dos","t"],"n8":"A","n9":["Tu‿Hi","i"],"n10":["jo","t"],"n11":["con","i"],"n12":["tem","m"],"n13":["plar;","t"],"n14":"En","n15":"Él","n16":"Tú","n17":"te","n18":["com","i"],"n19":["pla","m"],"n20":["ces:","t"],"n21":["Cum","i"],"n22":["plió","t"],"n23":"Tu","n24":["vo","i"],"n25":["lun","m"],"n26":["tad.","t"],"n27":"Al","n28":["dar","i"],"n29":["nos","t"],"n30":["li","i"],"n31":["bre","m"],"n32":["men","m"],"n33":["te","t"],"n34":"Tu","n35":"gran","n36":["te","i"],"n37":["so","m"],"n38":["ro,‿oh","t"],"n39":"Dios,","n41":"Tu","n42":["pu","i"],"n43":["ro‿a","m"],"n44":["mor","t"],"n45":["se‿a","i"],"n46":["pre","m"],"n47":["cia,","t"],"n48":"Tu","n49":"plan","n50":"de","n51":["sal","i"],"n52":["va","m"],"n53":["ción.","t"]},"verses":[{"label":"2.","lines":["¡Oh Dios de gracia: Padre!","Nuestra esperanza es","Jesús, Tu Hijo‿amado,","¡Precioso nombre fiel!","El nombre que te‿agrada","Y que‿amas escuchar,","De culpas y temores","Nos dio la libertad."]},{"label":"3.","lines":["El pecador temía","Juzgado ser por Dios;","Mas un completo pago","La deuda liquidó.","Nadie podía salvarnos","Ni el alma liberar;","Más Cristo, por Su muerte,","Nos pudo rescatar."]},{"label":"4.","lines":["Para los que creemos","No guarda ira Dios;","Todo temor se‿aleja","Al recibir Su‿amor.","Sus pródigos Él besa;","Los viste con primor;","Y Su amor perfecto","Expulsa el temor."]}]}