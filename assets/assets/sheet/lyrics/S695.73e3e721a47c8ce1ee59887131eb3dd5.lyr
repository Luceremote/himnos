{"hymn":"S695","parent":"E1241","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En El Cantar de Cantares","subtitle":"La iglesia—La edificación por el crecimiento en vida","syl":{"n1":"En","n2":"El","n3":["Can","i"],"n4":["tar","t"],"n5":"de","n6":["Can","i"],"n7":["ta","m"],"n8":["res","t"],"n9":["Po","i"],"n10":["de","m"],"n11":["mos","t"],"n12":["a","i"],"n13":["pre","m"],"n15":["ciar","t"],"n16":"La","n17":["vi","i"],"n18":["da","t"],"n19":["y‿e","i"],"n20":["di","m"],"n21":["fi","m"],"n22":["ca","m"],"n23":["ción:","t"],"n25":["Cris","i"],"n26":["to‿y","t"],"n27":"Su","n28":["no","i"],"n29":["via","t"],"n31":"real.","n32":["Cris","i"],"n33":["to‿y","t"],"n34":"Su","n35":["no","i"],"n36":["via","t"],"n38":"real."},"verses":[{"label":"2.","lines":["Cual yegua la amada es,","Muy fuerte es su amor;","Mas este amor es natural","//Y hala el mundo atróz.//"]},{"label":"3.","lines":["Sus ojos, de paloma son,","Cambió ya su pensar;","Hoy nada se compara a Él","//¡Su Amado es sin igual!//"]},{"label":"4.","lines":["Ahora ella lirio es","Para nuestro Señor;","Su fe no es en lo terrenal,","//Mas en el Hijo hoy.//"]},{"label":"5.","lines":["Paloma escondida es,","En la hendidura está;","Con el Señor, en ascensión,","//Su amor perdurará.//"]},{"label":"6.","lines":["De humo, la columna es,","Cesó su deambular;","Subyuga a Él su voluntad,","//¡Fragancia sin igual!//"]},{"label":"7.","lines":["Litera es para su Rey","Cuando oscuro está;","Reposo al Señor le da","//Y ahuyenta a Satán.//"]},{"label":"8.","lines":["¡Contiene ella‿al mismo Rey,","Pues Él en ella está!","Para el mover de Dios será","//Su palanquín real.//"]},{"label":"9.","lines":["De Cristo, la humanidad","En la madera ved.","Sus postes, plata pura son,","//El fondo, oro es.//"]},{"label":"10.","lines":["Su asiento púrpura real","Es digno para Él;","Le damos todo nuestro amor","//¡Pues Rey de reyes es!//"]},{"label":"11.","lines":["El día pronto llegará,","¡Gran gozo Él tendrá!","Su complemento obtendrá,","//¡Corona le será!//"]},{"label":"12.","lines":["Cerrado huerto ella es","¡Su aroma es sin igual!","Y para la edificación,","//Produce el material.//"]},{"label":"13.","lines":["Ciudad hermosa ella es","¡Grandiosa, sin igual!","Mas es ejército también","//Que aterra a Satán.//"]},{"label":"14.","lines":["Comemos al Señor Jesús","Y nos transforma hoy.","¡Su novia Cristo obtiene así","//En tan perfecta unión!//"]}]}