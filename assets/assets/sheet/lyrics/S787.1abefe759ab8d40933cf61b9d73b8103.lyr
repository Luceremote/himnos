{"hymn":"S787","parent":"E949","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Mi vida y esperanza de gloria Cristo es","subtitle":"Esperanza de gloria—Cristo como glorificación","syl":{"n1":"Mi","n2":["vi","i"],"n3":["da","t"],"n4":["y‿es","i"],"n5":["pe","m"],"n6":["ran","m"],"n7":["za","t"],"n8":"de","n9":["glo","i"],"n10":["ria","t"],"n11":["Cris","i"],"n12":["to","t"],"n13":"es,","n15":"Me","n16":"ha","n17":["re","i"],"n18":["ge","m"],"n19":["ne","m"],"n20":["ra","m"],"n21":["do","t"],"n22":"y","n23":["mo","i"],"n24":["ra","t"],"n25":"en","n26":"mi","n27":"ser;","n29":"El","n30":["vie","i"],"n31":["ne","t"],"n32":"a","n33":["cam","i"],"n34":["biar","m"],"n35":["me","t"],"n36":"con","n37":["ven","i"],"n38":["ce","m"],"n39":["dor","t"],"n40":["po","i"],"n42":["der,","t"],"n43":"Mi","n44":["cuer","i"],"n45":["po‿ha","m"],"n46":["rá","t"],"n47":["glo","i"],"n48":["rio","m"],"n49":["so","t"],"n51":["co","i"],"n52":["mo‿el","t"],"n53":"de","n54":"Él!","n56":"¡Él","n58":["vie","i"],"n59":["ne,‿Él","t"],"n61":["vie","i"],"n62":["ne,‿me","t"],"n63":["vie","i"],"n64":["ne‿a","t"],"n65":["glo","i"],"n66":["ri","m"],"n67":["fi","m"],"n68":["car!","t"],"n70":"Mi","n71":["cuer","i"],"n72":["po","t"],"n73":["trans","i"],"n74":["fi","m"],"n75":["gu","m"],"n76":["ra","m"],"n77":["rá,‿i","m"],"n78":["gual","t"],"n79":"al","n80":["Su","i"],"n82":["yo","t"],"n83":["se","i"],"n84":["rá.","t"],"n86":"¡Él","n87":["vie","i"],"n89":["ne,‿Él","t"],"n90":["vie","i"],"n92":["ne‿y","t"],"n93":"nos","n94":["re","i"],"n95":["di","m"],"n96":["mi","m"],"n97":["rá!","t"],"n99":["Co","i"],"n100":["mo‿es","m"],"n101":["pe","m"],"n102":["ran","m"],"n103":["za","t"],"n104":"de","n105":["glo","i"],"n106":["ria,","t"],"n107":"nos","n108":["glo","i"],"n109":["ri","m"],"n110":["fi","m"],"n111":["ca","m"],"n112":["rá.","t"]},"verses":[{"label":"2.","lines":["Mi vida y esperanza de gloria es Jesús,","Me trae al Dios viviente, me da Su plenitud;","Él viene a mezclarme en todo con mi Dios,","Para que participe en Su gloria yo."]},{"label":"3.","lines":["Mi vida y esperanza, mi redención final,","Es Cristo quien mi cuerpo, de muerte librará;","Él viene a saturarlo con gloria y esplendor,","Absorberá la muerte nuestro Señor."]},{"label":"4.","lines":["Mi vida y esperanza de gloria Cristo es,","Su vida es mi experiencia, pues uno soy con Él;","Él viene a llevarme a gloriosa libertad,","Y para siempre unidos hemos de estar."]}]}