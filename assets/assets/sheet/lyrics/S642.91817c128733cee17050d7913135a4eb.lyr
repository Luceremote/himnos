{"hymn":"S642","parent":"E829","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Cristo, semilla de la iglesia es","subtitle":"La iglesia—Su curso","syl":{"n1":["Cris","i"],"n2":["to,","t"],"n4":["se","i"],"n5":["mi","m"],"n6":["lla","t"],"n7":["de‿la‿i","i"],"n8":["gle","m"],"n9":["sia‿es","t"],"n10":["Sem","i"],"n11":["bra","m"],"n12":["da‿en","t"],"n13":["hu","i"],"n14":["ma","m"],"n15":["no","t"],"n16":["co","i"],"n17":["ra","m"],"n18":["zón;","t"],"n19":["El‿tri","i"],"n20":["go,","t"],"n21":"flor","n22":["de‿ha","i"],"n23":["ri","m"],"n24":["na","t"],"n25":["lle","i"],"n26":["ga‿a","t"],"n27":"ser,","n28":"Un","n30":"pan","n31":"que","n32":["sa","i"],"n33":["tis","m"],"n34":["fa","m"],"n35":["ce‿al","t"],"n36":["hom","i"],"n37":["bre","t"],"n38":"y","n40":["Di","i"],"n41":["os.","t"]},"verses":[{"label":"2.","lines":["Falsos creyentes Satanás sembró,","Entre los santos la cizaña entró;","Frustró el crecer y trajo confusión,","Queriendo así impedir el plan de Dios."]},{"label":"3.","lines":["La iglesia, hierba de mostaza es,","Nace de Cristo, su semilla es Él;","Aunque se oculta en su pequeñez,","Puede al hambriento hoy satisfacer."]},{"label":"4.","lines":["Mas esa hierba Satanás cambió;","Él su naturaleza trasmutó;","De ella un grande ábrol él formó,","Do se anidan los malignos hoy."]},{"label":"5.","lines":["La \"iglesia\" caída usó Satan,","El paganismo en ella infiltró;","Con levadura la‿harina mezcló,","El alimento puro así dañó."]},{"label":"6.","lines":["Mas Cristo en vida viene a transformar,","Todos Sus santos quiere edificar;","Piedras preciosas, perlas los hará","Para Su iglesia y reino expresar."]},{"label":"7.","lines":["Crece en Cristo la asamblea hoy,","Él la transforma y edifica así;","Ella es la perla de tan gran valor","Y el tesoro que Él escondió."]},{"label":"8.","lines":["De la \"cizaña\" hoy apártanos;","De tal gran \"árbol\" líbranos, Señor;","De levadura purificanos;","Haznos comida para el hombre y Dios."]},{"label":"9.","lines":["En vida, a diario, haznos Tú crecer,","Transforma y edifícanos así","Como un cuerpo que te exprese a Ti;","Haznos Tu iglesia y Tu reino aquí."]}]}