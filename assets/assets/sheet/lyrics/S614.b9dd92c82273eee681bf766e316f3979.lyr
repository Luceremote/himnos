{"hymn":"S614","parent":"E793","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Cálmate, mi alma, espera en el Señor","subtitle":"Oración—Esperar en Dios","syl":{"n1":["¡Cál","i"],"n2":["ma","m"],"n3":["te,","t"],"n4":["mi‿al","i"],"n5":["ma,‿es","m"],"n6":["pe","m"],"n7":["ra‿en","t"],"n8":"el","n9":["Se","i"],"n10":["ñor!","t"],"n11":"Se","n12":"tú‿el","n13":["ca","i"],"n14":["nal","t"],"n15":["que‿ex","i"],"n16":["pre","m"],"n17":["se","t"],"n18":"Su","n19":["sen","i"],"n20":["tir;","t"],"n21":["De","i"],"n22":["ja","t"],"n23":"que‿Él","n24":["ha","i"],"n25":["ble,","t"],"n26":["lue","i"],"n27":["go","t"],"n28":["ha","i"],"n29":["bla","t"],"n30":"tú;","n31":"Que","n32":"Él","n33":["i","i"],"n34":["ni","m"],"n35":["cie","t"],"n36":["Su‿o","i"],"n37":["ra","m"],"n38":["ción","t"],"n39":"en","n40":"ti."},"verses":[{"label":"2.","lines":["¡Cálmate, mi alma, espera en el Señor!","Niega tu mente y tu voluntad;","Deja que Dios te unja con Su ser;","Que cumpla, por tu oración, Su plan."]},{"label":"3.","lines":["¡Cálmate, mi alma, espera en el Señor!","Calla el llamado a lo terrenal;","Calma tus planes, calma todo afán;","Que Sus demandas pueda en ti lograr."]},{"label":"4.","lines":["¡Cálmate, mi alma, espera en el Señor!","Cede al espíritu tu corazón;","Deja que allí te dé revelación;","Sé obediente a él, sirviendo a Dios."]},{"label":"5.","lines":["¡Cálmate, mi alma, espera en el Señor!","Sigue al Espíritu en Su sentir;","Todo tu ser, movido así por Dios,","Expresará Su oración aquí."]},{"label":"6.","lines":["¡Cálmate, mi alma, espera en el Señor!","Hasta que Él todo pueda poseer;","Hasta que sean uno tú y Dios,","Y confirmada a Su Hijo estés."]},{"label":"7.","lines":["¡Cálmate, mi alma, espera en el Señor!","Hasta que fluya libremente Dios,","Hasta que todo tu hablar y acción,","Cumplan la voluntad de tu Señor."]}]}