{"hymn":"S387","parent":"E501","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Oh Cristo, mi buen Salvador","subtitle":"Experiencia de Cristo—Como vida","syl":{"n1":"Oh","n2":["Cris","i"],"n3":["to,","t"],"n4":"mi","n5":"buen","n6":["Sal","i"],"n7":["va","m"],"n8":["dor,","t"],"n10":"En","n11":["ver","i"],"n12":["dad,","t"],"n13":["ra","i"],"n14":["dian","m"],"n15":["te‿di","m"],"n16":["vi","m"],"n17":["no;","t"],"n20":"El","n21":["in","i"],"n22":["fi","m"],"n23":["ni","m"],"n24":["to,‿e","m"],"n25":["ter","m"],"n26":["no","t"],"n27":["Di","i"],"n28":["os,","t"],"n29":["Fi","i"],"n30":["ni","m"],"n31":["to‿en","t"],"n32":["tiem","i"],"n33":["po,","t"],"n34":["se‿hu","i"],"n35":["ma","m"],"n36":["nó.","t"],"n37":"¡Oh,","n39":["Cris","i"],"n40":["to","t"],"n41":"del","n42":"gran","n43":"Dios:","n44":["la‿ex","i"],"n45":["pre","m"],"n46":["sión!","t"],"n47":["¡A","i"],"n48":["bun","m"],"n49":["dan","m"],"n50":["te,","t"],"n51":"muy","n52":["ri","i"],"n54":["co‿es","t"],"n55":"Él!","n58":"Dios","n59":["mez","i"],"n60":["cla","m"],"n61":["do","t"],"n62":["con‿hu","i"],"n63":["ma","m"],"n64":["ni","m"],"n65":["dad","t"],"n66":["Vi","i"],"n67":["ve‿en","t"],"n68":"mí,","n69":"mi","n70":["to","i"],"n72":["do‿es","t"],"n73":"Él."},"verses":[{"label":"2.","lines":["En Ti mora la plenitud","Del gran Dios y‿expresas Su gloria;","Hiciste en carne redención,","Y, como Espíritu, la unión."]},{"label":"3.","lines":["El Padre Su todo te dio,","En Espíritu te tomamos,","Por el Espíritu en mí,","Yo te experimento así."]},{"label":"4.","lines":["Es por Tu Palabra eficaz","Que el Espíritu me da vida;","Tocándola recibiré","Tu misma esencia en mi ser."]},{"label":"5.","lines":["Te miro en mi espíritu hoy","Y Tu gloria voy reflejando;","Yo transformado así seré,","Tu imagen pura expresaré."]},{"label":"6.","lines":["No hay otra forma de ser","Victorioso y santificado,","Pues por Tu gloria divinal,","Tu vida me hace espiritual."]},{"label":"7.","lines":["Tu Espíritu me impregnará,","Saturando Dios cada parte;","Librándonos del viejo Adán,","Podrás Tu iglesia edificar."]}]}