{"hymn":"S893","parent":"E1079","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Si yo gano el mundo y pierdo a Cristo","subtitle":"El evangelio—General","syl":{"n1":"Si","n2":"yo","n3":["ga","i"],"n4":["no‿el","t"],"n5":["mun","i"],"n6":["do‿y","t"],"n7":["pier","i"],"n8":["do‿a","t"],"n9":["Cris","i"],"n10":["to,","t"],"n11":"¿Qué","n12":["val","i"],"n13":["drí","m"],"n14":["a‿un","t"],"n15":["dí","i"],"n16":["a‿a","m"],"n17":["par","m"],"n18":["te","t"],"n19":"de‿Él?","n22":["¿Ha","i"],"n23":["lla","m"],"n24":["rí","m"],"n25":["a","t"],"n26":"paz","n27":"mi","n28":["al","i"],"n29":["ma‿in","m"],"n30":["quie","m"],"n31":["ta","t"],"n32":"En","n33":"las","n34":["co","i"],"n35":["sas","t"],"n36":"que‿han","n37":"de","n38":["pe","i"],"n39":["re","m"],"n40":["cer?","t"],"n41":"Si","n42":"yo","n43":["ga","i"],"n44":["no‿el","t"],"n45":["mun","i"],"n46":["do‿y","t"],"n47":["pier","i"],"n48":["do‿a","t"],"n49":["Cris","i"],"n51":["to,","t"],"n52":"¿Es","n53":"la","n54":["vi","i"],"n55":["da","t"],"n56":["dig","i"],"n57":["na","t"],"n58":"sin","n59":"Su","n61":"luz?","n63":["¿Pue","i"],"n64":["den","t"],"n65":"los","n66":["pla","i"],"n67":["ce","m"],"n68":["res","t"],"n69":["de‿es","i"],"n70":["te","t"],"n71":["mun","i"],"n73":["do","t"],"n74":["I","i"],"n75":["gua","m"],"n76":["lar","t"],"n77":"a‿un","n78":["dí","i"],"n79":["a","t"],"n80":"con","n81":["Je","i"],"n82":["sús?","t"]},"verses":[{"label":"2.","lines":["Si tuviera fama y riquezas,","Y un nombre‿amado por doquier,","Mas, sin esperanza y sin puerto,","¿Adónde mi barca llevaré?","Si yo gano el mundo y pierdo a Cristo,","Quien la cruz llevó, y murió por mi,","¿Podrá el mundo entero ser refugio","Donde, en mi angustia, pueda ir?"]},{"label":"3.","lines":["¡Oh, qué vaciedad sin este Cristo!","¡Sólo penas y pecado aquí!","Y la eternidad sin Él, ¡qué oscura!","Sólo angustia y noches sin fin.","Si viviera yo sin este Cristo,","Cuando muera al fin, ¿cómo será?","¡Oh, sin Él en el valle de sombras!","¡Y sin Él por la eternidad!"]},{"label":"4.","lines":["¡Oh, qué gozo es tener a Cristo!","¡Es un bálsamo al corazón!","¡No hay ni un pecado que Él no borre!","¡De tristezas, es Consolador!","Si yo tengo a Cristo, sólo a Cristo,","Nada de este mundo, sólo a Él,","Oh, entonces todo es mío en Cristo,","Pues mi todo Él ha de proveer."]}]}