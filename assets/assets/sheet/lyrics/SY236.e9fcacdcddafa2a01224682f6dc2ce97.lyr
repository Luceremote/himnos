"no","n118":["me‿en","i"],"n119":["ga","m"],"n120":["ña","m"],"n121":["ré -","t"],"n122":["Ni‿a","i"],"n123":["tra","m"],"n124":["pa","m"],"n125":["do","t"],"n126":"en","n127":"mi","n128":["mun","i"],"n129":["do‿es","m"],"n130":["ta","m"],"n131":["ré","t"],"n132":["E","i"],"n133":["res","t"],"n134":"el","n135":["me","i"],"n136":["jor","t"],"n137":"y","n138":["mi‿ú","i"],"n139":["ni","m"],"n140":["co‿a","m"],"n141":["mor.","t"],"n142":"Tu","n143":["a","i"],"n144":["mor,","t"],"n145":["pro","i"],"n146":["fun","m"],"n148":["do‿en","t"],"n149":"mí","n150":"ser."},"verses":[{"label":"2.","lines":["Mi Jesús, mi mejor amor,","Aunque es terco mi corazón,","Hazme esclavo hoy de Tu gran amor;","Para amarte y obedecer.","Aunque a veces te rechacé,","Tu guiar siempre seguiré,","Complacerte es mi mayor placer,","Tu amor trae paz a mi ser."]},{"label":"3.","lines":["Mi Jesús, te adoro Señor.","No me apartare más de Ti;","Tu sonriente faz no se aleje de mí,","Tu presencia deseo sentir.","Yo te ofrezco mi corazón,","Eres Tú mi satisfacción,","Mi porción es Tu dulce ser poseer,","Mi deseo único es."]}]}