{"hymn":"SY99","parent":"NS74","quality":"adapted","adjust":{"hold":1,"merge":1},"title":"Palabra viviente, Jesús","subtitle":"","syl":{"n1":["Pa","i"],"n2":["la","m"],"n3":["bra","t"],"n4":["vi","i"],"n5":["vien","m"],"n6":["te,","t"],"n7":["Je","i"],"n8":["sús,","t"],"n9":["Lá","i"],"n10":["va","m"],"n11":["me","t"],"n12":"con","n13":"Tu","n14":["san","i"],"n15":["gre","t"],"n16":"y","n17":["Há","i"],"n18":["bla","m"],"n19":["me‿al","t"],"n20":["co","i"],"n21":["ra","m"],"n22":["zón.","t"],"n28":["Quie","i"],"n29":["ro","t"],"n30":"de","n31":"Tu","n32":["gra","i"],"n33":["cia‿es","m"],"n34":["cu","m"],"n35":["char.","t"],"n36":["Quie","i"],"n37":["ro","t"],"n38":"Tu","n39":["ros","i"],"n40":["tro","t"],"n41":["con","i"],"n42":["tem","m"],"n43":["plar,","t"],"n44":["Mi","i"],"n45":["ran","m"],"n46":["do","t"],"n47":"sin","n48":["ce","i"],"n49":["sar.","t"],"n52":["Je","i"],"n53":["sús,","t"],"n54":"mi","n55":"Dios","n56":"fiel,","n57":["Gá","i"],"n58":["na","m"],"n59":["me‿al","t"],"n60":["com","i"],"n61":["ple‿to;","t"],"n67":["Ú","i"],"n68":["sa","m"],"n69":["me,","t"],"n70":["Se","i"],"n71":["ñor,","t","u"],"n72":0,"n73":["Pa","i"],"n74":["ra","t"],"n75":"Tu","n76":"plan","n77":["lo","i"],"n78":["grar.","t"]},"verses":[{"label":"2.","lines":["Jesús tan precioso para mi,","Quiero besarte sólo a Ti,","Para que te expandas Tú.","Sólo a Tu nombre clamaré,","Me abro a Ti, no temo ya,","Amándote a Ti."]},{"label":"3.","lines":["Eres Tú el Viviente en mí,","Abre mis ojos para ver","Lo que eres para mí.","Quiero en Tu corazón entrar,","Nunca de Ti quiero marchar,","Amándote hasta el fin."]},{"label":"4.","lines":["Señor, haz lo que haya que hacer.","No quiero derrotado ser,","Señor, yo creo en Ti.","Te lo doy todo, mi Señor,","Todo mi ser derramo en Ti,","Te pertenezco a Ti."]}]}