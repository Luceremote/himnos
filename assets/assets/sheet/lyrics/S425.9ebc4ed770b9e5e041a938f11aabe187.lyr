{"hymn":"S425","parent":"E539","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"¡Señor, la vida en mí eres Tú","subtitle":"Experiencia de Cristo—Como aquel que está disponible","syl":{"n1":["¡Se","i"],"n2":["ñor,","t"],"n3":"la","n4":["vi","i"],"n5":["da‿en","t"],"n6":["mí‿e","i"],"n8":["res","t"],"n9":"Tú,","n11":"Y","n12":["to","i"],"n13":["do","t"],"n14":["pa","i"],"n15":["ra","t"],"n16":"mí!","n18":"Tan","n19":["ac","i"],"n20":["ce","m"],"n21":["si","m"],"n22":["ble‿y","t"],"n23":["sub","i"],"n25":["je","m"],"n26":["ti‿vo,","t"],"n28":["Te‿ex","i"],"n29":["pe","m"],"n30":["ri","m"],"n31":["men","m"],"n32":["tó‿a","m"],"n33":["sí.","t"],"n35":"Tú,","n36":"el","n37":["Es","i"],"n38":["pí","m"],"n40":["ri","m"],"n41":["tu‿e","m"],"n42":["res,","t"],"n43":["Que","i"],"n44":["ri","m"],"n45":["do‿y","t"],"n46":["cer","i"],"n47":["ca‿a","t"],"n48":"mí;","n50":["¡Có","i"],"n51":["mo","t"],"n52":["dis","i"],"n53":["fru","m"],"n54":["to","t"],"n55":"que","n56":["es","i"],"n57":["tás","t"],"n59":"Tan","n60":["dis","i"],"n61":["po","m"],"n62":["ni","m"],"n63":["ble‿a","t"],"n64":"mí!"},"verses":[{"label":"2.","lines":["Tú suples abundantemente","Lo que me falta aquí;","Muy suficiente y preparado","Para aplicarte en mí."]},{"label":"3.","lines":["Tu unción tan dulce con Tu poder,","Sostiene al débil hoy;","Al impartirme Tu energía,","Fortalecido soy."]},{"label":"4.","lines":["Tu ley de vida en mi corazón,","Regula mi andar;","Y con Tu rica realidad","Me vas a saturar."]},{"label":"5.","lines":["Conmigo uno siempre eres Tú,","¡Perfecta unidad!","¡Un solo espíritu conmigo","Por la eternidad!"]}]}