{"hymn":"S563","parent":"E734","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La ley de Dios muy santa es","subtitle":"Varios aspectos de la vida interior—Las cuatro leyes","syl":{"n1":"La","n2":"ley","n4":"de","n5":"Dios","n6":"muy","n7":["san","i"],"n8":["ta","t"],"n9":"es,","n10":["E","i"],"n11":["xi","m"],"n13":["ge","t"],"n14":["prac","i"],"n15":["ti","m"],"n16":["car","t"],"n17":"el","n18":"bien;","n19":"Nos","n20":["mues","i"],"n22":["tra","t"],"n23":["que‿im","i"],"n24":["po","m"],"n25":["si","m"],"n26":["ble","t"],"n27":"es","n28":"A","n29":"sus","n31":["de","i"],"n32":["man","m"],"n33":["das","t"],"n34":["res","i"],"n36":["pon","m"],"n37":["der.","t"]},"verses":[{"label":"2.","lines":["Mas en la mente hay una ley","Que siempre intenta hacer el bien;","Pero en la carne otra ley","Subyuga a ésta cada vez."]},{"label":"3.","lines":["La mente humana tiene en sí","La ley interna para el bien;","Por el Señor creada fue","Para un buen porte mantener."]},{"label":"4.","lines":["La ley en nuestros miembros es","La ley satánica del mal;","Entró en Adán cuando cayó","Por esa astucia de Satán."]},{"label":"5.","lines":["La ley maligna de Satán","Es de pecado y de maldad;","Más fuerte que la ley del bien","La lleva siempre a fracasar."]},{"label":"6.","lines":["Mas hoy en nuestro espíritu","La misma ley de vida está;","Al renacer nos la impartió","El mismo Espíritu eternal."]},{"label":"7.","lines":["Divina y poderosa es,","Trasciende a todas las demás,","Nos libra de la esclavitud,","Para la ley de Dios lograr."]},{"label":"8.","lines":["Por eso siempre hay que ocupar","La mente en el espíritu,","Y no en la carne que está","Corrupta y en esclavitud."]},{"label":"9.","lines":["La mente puesta en la carne es","Pecado, muerte, oscuridad;","La mente en el espíritu","Trae vida, luz, y dulce paz."]},{"label":"10.","lines":["Así tendremos libertad,","Así victoria se obtendrá;","Señor, que en el espíritu","Contigo siempre pueda andar."]}]}