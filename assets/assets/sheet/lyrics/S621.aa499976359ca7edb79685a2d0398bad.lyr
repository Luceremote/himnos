{"hymn":"S621","parent":"E802","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tú la Palabra eres, Señor","subtitle":"El estudio de la palabra—La función de la palabra","syl":{"n1":"Tú","n2":"la","n3":["Pa","i"],"n4":["la","m"],"n5":["bra‿e","m"],"n6":["res,","t"],"n7":["Se","i"],"n8":["ñor,","t"],"n9":"Y","n10":"el","n11":["Es","i"],"n12":["pí","m"],"n13":["ri","m"],"n14":["tu","t"],"n15":["tam","i"],"n16":["bién;","t"],"n17":"En","n18":"Él","n19":"te","n20":["a","i"],"n21":["do","m"],"n22":["ra","m"],"n23":["mos","t"],"n24":"hoy,","n25":"Y","n26":["e","i"],"n27":["lla","t"],"n28":"te","n29":"da‿a","n30":["co","i"],"n31":["no","m"],"n32":["cer.","t"]},"verses":[{"label":"2.","lines":["Ya que uno somos Tú y yo","Mi todo eres, oh Señor;","Palabra y Espíritu","Tú eres como mi porción."]},{"label":"3.","lines":["Si no fueras Palabra Tú,","¿Yo te podría conocer?","Y sin ser el Espíritu,","¿Podría yo contacto hacer?"]},{"label":"4.","lines":["En la Palabra puedo ver","Tu ser, te puedo conocer;","Es Tu sustancia Espíritu,","Para tocar Tu mismo ser."]},{"label":"5.","lines":["Mi vida y senda eres Tú,","Mi alimento, fuerza y luz;","Tú, la Palabra, te haces real","A mí como el Espíritu."]},{"label":"6.","lines":["Es Tu Palabra Tu expresión,","Tu Espíritu mora en mi seŕ;","Tu Palabra en mi espíritu,","Espíritu y vida es."]},{"label":"7.","lines":["Para Tu Palabra entender","Debo Tu Espíritu tocar;","No con la mente he de captar,","Sino en mi espíritu al orar."]},{"label":"8.","lines":["Tu preciosa Palabra es","El gozo de mi corazón;","Mi espíritu en el Tuyo da","Alabanzas en comunión."]}]}