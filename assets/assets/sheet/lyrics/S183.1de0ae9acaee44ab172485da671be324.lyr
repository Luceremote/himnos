{"hymn":"S183","parent":"E1108","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Come el pan, oh pueblo del Señor","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n1":["Co","i"],"n2":["me‿el","t"],"n3":"pan,","n5":"oh","n6":["pue","i"],"n7":["blo","t"],"n8":"del","n9":["Se","i"],"n10":["ñor,","t"],"n11":["A","i"],"n12":["la","m"],"n13":["bad","t"],"n14":"Su","n15":["nom","i"],"n16":["bre‿en","t"],"n17":["u","i"],"n18":["ni","m"],"n19":["dad.","t"],"n20":"Hoy","n21":["ve","i"],"n22":["ni","m"],"n24":["mos","t"],"n25":["pa","i"],"n26":["ra‿a","m"],"n27":["sí","t"],"n28":["co","i"],"n29":["mer","t"],"n30":"Con","n31":["la‿i","i"],"n32":["gle","m"],"n33":["sia","t"],"n34":"de","n35":"Su","n36":["he","i"],"n37":["re","m"],"n38":["dad.","t"],"n39":"¡Con","n40":"el","n41":["vi","i"],"n42":["no","t"],"n43":["co","i"],"n44":["me","t"],"n45":["de‿es","i"],"n46":["te","t"],"n47":"pan!","n50":["So","i"],"n51":["mos","t"],"n52":["u","i"],"n53":["no","t"],"n54":["siem","i"],"n55":["pre‿en","t"],"n56":"Él.","n59":["So","i"],"n60":["bre","t"],"n61":"el","n62":["te","i"],"n63":["rre","m"],"n64":["no","t"],"n65":["fir","i"],"n66":["me‿es","m"],"n67":["tad","t"],"n68":"Hoy","n69":"en","n70":"la","n71":["lo","i"],"n72":["ca","m"],"n73":["li","m"],"n75":["dad.","t"]},"verses":[{"label":"2.","lines":["Bebe el vino, pueblo del Señor,","Somos la iglesia que El compró;","Redimidos para uno ser,","Es la meta que Él siempre buscó."]},{"label":"3.","lines":["Uno sed, oh pueblo del Señor,","No seáis un grano individual.","Somos uno, amasados bien,","Como un pan en la localidad."]},{"label":"4.","lines":["Somos uno, oh pueblo del Señor,","Declaramos hoy nuestra unidad;","Testifica lo que Dios obró;","No palabras, sino realidad."]},{"label":"5.","lines":["Come el pan, oh pueblo del Señor,","Alabad Su nombre en unidad.","Hoy venimos para así comer","Con la iglesia de Su heredad."]}]}