{"hymn":"S160","parent":"E201","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El Paracleto eres, Señor","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"El","n2":["Pa","i"],"n4":["ra","m"],"n5":["cle","m"],"n7":["to‿e","m"],"n8":["res,","t"],"n9":["Se","i"],"n10":["ñor,","t"],"n11":"Y","n12":"fiel","n14":["Con","i"],"n15":["so","m"],"n16":["la","m"],"n17":["dor;","t"],"n18":["Nues","i"],"n19":["tro‿A","m"],"n21":["bo","m"],"n22":["ga","m"],"n23":["do","t"],"n24":["an","i"],"n26":["te","t"],"n27":"Dios","n28":"Y","n29":["nues","i"],"n31":["tro","t"],"n32":["De","i"],"n33":["fen","m"],"n34":["sor.","t"]},"verses":[{"label":"2.","lines":["El Consejero‿eres también,","Y nuestro‿Intercesor;","Defiendes nuestro caso Tú,","Perfecto Ayudador."]},{"label":"3.","lines":["Tú llevas, con poder, Señor,","Nuestros asuntos hoy;","Así‿en los cielos, como‿aquí,","Quedamos bien con Dios."]},{"label":"4.","lines":["Con gracia intercedes Tú,","Señor Espíritu;","Tú gimes en nuestro‿interior","Y‿en lo‿alto ruegas Tú."]},{"label":"5.","lines":["Tú, el Viviente, ayuda das","Conforme‿al plan de Dios;","Resurrección impartes hoy","Al hombre interior."]},{"label":"6.","lines":["Al débil, el Espíritu","Da vida y sostén;","Y nuestro espíritu así","Mantienes con poder."]},{"label":"7.","lines":["Tu mismo ser nos das, Señor,","Con compasión y‿amor;","Al ser el todo‿en todos hoy,","Tendrás Tu expresión."]}]}