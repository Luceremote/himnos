{"hymn":"S18","parent":"E22","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Padre Santo, te alabamos","subtitle":"Adoración al Padre—Su santidad","syl":{"n1":["Pa","i"],"n2":["dre","t"],"n3":["San","i"],"n4":["to,","t"],"n5":["te‿a","i"],"n6":["la","m"],"n7":["ba","m"],"n8":["mos","t"],"n9":"Con","n10":["re","i"],"n11":["ve","m"],"n12":["ren","m"],"n13":["te","t"],"n14":["can","i"],"n15":["ción;","t"],"n16":["San","i"],"n17":["to","t"],"n18":["e","i"],"n19":["res","t"],"n20":"y","n21":["ex","i"],"n22":["cel","m"],"n23":["so,","t"],"n24":["Dig","i"],"n25":["no","t"],"n26":"de","n27":["a","i"],"n28":["do","m"],"n29":["ra","m"],"n30":["ción.","t"]},"verses":[{"label":"2.","lines":["Padre, Tú eres amoroso,","Justos Tus caminos son;","Tu naturaleza santa","Nos da‿a Cristo por porción."]},{"label":"3.","lines":["Separaste pecadores","Por la sangre de Jesús;","Tu verdad nos santifica","Por su divinal virtud."]},{"label":"4.","lines":["Por Tu Espíritu Santo","Nos separas para Ti;","Nuestro espíritu, alma y cuerpo","Santificarás así."]},{"label":"5.","lines":["De Jesús, la vida santa,","Por Tu gracia hoy nos das;","Nos harás participantes","De Tu misma santidad."]},{"label":"6.","lines":["Cuando en la Ciudad Santa,","Llenos de Tu santidad,","\"Tú eres santo\", por los siglos","Siempre se declarará."]}]}