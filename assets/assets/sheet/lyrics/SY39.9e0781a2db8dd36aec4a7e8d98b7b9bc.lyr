{"hymn":"SY39","parent":"NS10069","quality":"adapted","adjust":{"hold":1,"merge":1},"title":"¿Existe alguien, un amigo","subtitle":"","syl":{"n1":["¿E","i"],"n2":["xis","m"],"n3":["te‿al","m"],"n4":["guien,","t"],"n6":"un","n7":["a‿mi","i"],"n8":["go,","t"],"n10":"A","n11":"quien","n12":"me","n13":["pue","i"],"n14":["da‿a","m"],"n15":["brir;","t"],"n17":["Al","i"],"n18":["guien,","t"],"n19":"que","n21":["en","i"],"n22":["ti","m"],"n23":["en","m"],"n24":["de","t"],"n26":"Lo","n27":"que","n28":["su","i"],"n29":["ce","m"],"n30":["de‿en","t"],"n31":"mí.","n33":["Al","i"],"n34":["guien,","t"],"n35":["cuan","i"],"n37":["do","t"],"n38":"no","n39":["ha","i"],"n40":["y","t"],"n42":["Na","i"],"n43":["die","t"],"n44":"a","n45":"quien","n46":["pue","i"],"n47":["da‿ir?","t"],"n48":"No","n49":["e","i"],"n50":["xis","m"],"n51":["te","t"],"n52":["na","i"],"n54":["die,","t"],"n55":["co","i"],"n56":["mo‿Él.","t"],"n58":["Cris","i"],"n59":["to‿es","t"],"n60":"el","n61":["\"Al","i"],"n62":["guien\"","t"],"n64":"Que","n65":"te","n66":["pue","i"],"n67":["de","t"],"n68":["con","i"],"n69":["mo","m"],"n70":["ver;","t"],"n72":["Cris","i"],"n73":["to‿es","t"],"n74":"el","n75":["\"Al","i"],"n76":["guien\"","t"],"n78":"Que","n79":"te","n80":["pue","i"],"n81":["de‿ha","m"],"n82":["cer","t"],"n83":["can","i"],"n84":["tar;","t"],"n86":["Cris","i"],"n87":["to‿es","t"],"n88":"el","n89":["\"Al","i"],"n90":["guien\"","t"],"n92":["Cris","i"],"n93":["to","t"],"n94":["pre","i"],"n95":["cio","m"],"n97":["so‿es.","t"],"n98":"A","n99":["Cris","i"],"n100":["to","t"],"n101":["a","i"],"n102":["ma,‿el","t"],"n104":["Ad","i"],"n105":["mi","m"],"n106":["ra","m"],"n107":["ble.","t","u"],"n108":0},"verses":[{"label":"2.","lines":["¿Existe alguien, que me cuide","En los momentos duros;","Alguien, siempre allí,","Aunque haga sol o llueva;","Alguien, un apoyo,","Bajo la tempestad?","No existe nadie, como Él."]},{"label":"3.","lines":["¿Existe alguien, que me acepte,","Acepte tal como soy;","Alguien que no huya,","En quien confiar hasta el fin;","Uno que me conoce,","Y aun me quiere así?","No existe nadie, como Él."]},{"label":"4.","lines":["¿Existe alguien que si llegue","A lo profundo en mi ser;","Alguien que afine","Las cuerdas rotas en mí;","Alguien que me ame,","Cuando no hay más amor?","No existe nadie, como Él."]}]}