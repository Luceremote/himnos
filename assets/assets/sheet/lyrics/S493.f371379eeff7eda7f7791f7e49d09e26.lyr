{"hymn":"S493","parent":"E600","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Mi Dios, mi amor y mi porción","subtitle":"Experiencia de Dios—Como porción eterna","syl":{"n1":"Mi","n2":"Dios,","n3":["mi‿a","i"],"n4":["mor","t"],"n5":"y","n6":"mi","n7":["por","i"],"n8":["ción,","t"],"n9":"Mi","n10":["he","i"],"n11":["ren","m"],"n12":["cia‿e","m"],"n13":["ter","m"],"n14":["nal,","t"],"n16":"En","n17":["to","i"],"n18":["do‿el","t"],"n19":["u","i"],"n20":["ni","m"],"n21":["ver","m"],"n22":["so","t"],"n23":"no‿hay","n24":["Nin","i"],"n26":["gu","m"],"n27":["no","t"],"n28":"que","n29":["sea‿i","i"],"n30":["gual.","t"],"n32":["Nin","i"],"n33":["gu","m"],"n34":["no","t"],"n35":"que","n36":["sea‿i","i"],"n37":["gual.","t"]},"verses":[{"label":"2.","lines":["¡Oh, qué vacío el cielo está!","La tierra es vanidad,","No llena nada el corazón,","Mi Dios es realidad.","Mi Dios es realidad."]},{"label":"3.","lines":["Riquezas y prosperidad,","Salud o amigo fiel,","De Ti todo lo recibí,","Mas eres Tú mi bien.","Mas eres Tú mi bien."]},{"label":"4.","lines":["Qué vano es mi bienestar,","Al compararlo a Ti;","Así es mi paz y protección,","O algún amigo aquí.","O algún amigo aquí."]},{"label":"5.","lines":["Si fuera mío el orbe hoy","Y las estrellas mil,","Yo sin Tu gracia y Tu ser","Sería un infeliz.","Sería un infeliz."]},{"label":"6.","lines":["Que sigan otros la ambición","De abarcar el mar;","Visítame en Tu gracia hoy,","Y no te pido más.","Y no te pido más."]}]}