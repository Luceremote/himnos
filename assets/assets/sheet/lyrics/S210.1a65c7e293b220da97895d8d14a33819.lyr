{"hymn":"S210","parent":"E1120","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Es sello el Santo Espíritu","subtitle":"La plenitud del Espíritu—La unción, el sello y las arras","syl":{"n1":"Es","n2":["se","i"],"n3":["llo‿el","t"],"n4":["San","i"],"n5":["to‿Es","m"],"n6":["pí","m"],"n7":["ri","m"],"n8":["tu,","t"],"n9":"El","n10":["an","i"],"n11":["ti","m"],"n12":["ci","m"],"n13":["po","t"],"n14":["y‿a","i"],"n15":["rras","t"],"n16":"es.","n17":["De","i"],"n18":["sig","m"],"n19":["na","t"],"n20":"que","n21":["so","i"],"n22":["mos","t"],"n23":"de","n24":"Dios;","n25":["Su‿he","i"],"n26":["ren","m"],"n27":["cia","t"],"n28":["ga","i"],"n29":["ran","m"],"n30":["ti","m"],"n31":["za","t"],"n32":"Él."},"verses":[{"label":"2.","lines":["Nos selló‿el Santo‿Espíritu","Después de nosotros creer","En Cristo‿y Su‿evangelio fiel;","Nos muestra que somos de Dios."]},{"label":"3.","lines":["Nos da la‿imagen del gran Dios,","Viviente sello hoy es Él;","Al Hijo nos conforma‿así,","Lo‿imprime Él en nuestro ser."]},{"label":"4.","lines":["Espíritu las arras es,","El anticipo, fianza fiel.","Confirma que‿hijos somos hoy,","Y nuestro Dios, herencia es."]},{"label":"5.","lines":["Por el Espíritu, hoy Dios","Se‿extiende‿a todo nuestro ser;","Nos sella en nuestro‿interior,","Y cada parte llena Él."]},{"label":"6.","lines":["Señor, queremos cooperar","Con Tu mover, Tu‿Espíritu;","Obra maestra nos harás,","Tu plan eterno logra ya."]}]}