{"hymn":"S663","parent":"E852","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tu habitación amo, Señor","subtitle":"La iglesia—Su atracción","syl":{"n1":["Tu‿ha","i"],"n2":["bi","m"],"n3":["ta","m"],"n4":["ción","t"],"n5":["a","i"],"n6":["mo,","t"],"n7":["Se","i"],"n8":["ñor;","t"],"n9":["Ben","i"],"n10":["di","m"],"n11":["ta‿i","m"],"n12":["gle","m"],"n13":["sia","t"],"n14":"es,","n15":"El","n16":["go","i"],"n17":["zo","t"],"n18":"de","n19":"Tu","n20":["co","i"],"n21":["ra","m"],"n22":["zón","t"],"n23":"Y","n24":"Tu","n25":["des","i"],"n26":["can","m"],"n27":["so","t"],"n28":"es."},"verses":[{"label":"2.","lines":["Por ella, te entregaste Tú,","Para ella Tuya ser;","Por ella, yo mi cuerpo doy,","Para Tu buen placer."]},{"label":"3.","lines":["Por ella, vida eres en mí,","Por ella es mi vivir;","Por ella yo me negaré,","Se llenará de Ti."]},{"label":"4.","lines":["La iglesia es Tu Novia fiel,","Tu Cuerpo, Tu expresión,","Ella mi anhelo y gozo es,","Toda mi protección."]},{"label":"5.","lines":["Tu suministro en ella está,","Para impartirlo a mí;","En ella me posees Tú,","Para agradarte a Ti."]},{"label":"6.","lines":["Tu habitación amo, Señor,","La iglesia, Tu hogar;","En ella siempre viviré,","No vagaré jamás."]}]}