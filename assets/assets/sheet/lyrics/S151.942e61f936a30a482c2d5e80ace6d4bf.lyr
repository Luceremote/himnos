{"hymn":"S151","parent":"E192","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Venimos hoy a Ti","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":["Ve","i"],"n2":["ni","m"],"n3":["mos","t"],"n4":"hoy","n5":"a","n6":"Ti,","n7":"Fiel","n8":["hom","i"],"n9":["bre,‿Hi","m"],"n10":["jo","t"],"n11":"de","n12":"Dios;","n13":["Sub","i"],"n14":["sis","m"],"n15":["te","t"],"n16":["to","i"],"n17":["do‿en","t"],"n18":"Ti,","n19":["Au","i"],"n20":["tor","t"],"n21":"de","n22":["vi","i"],"n23":["da,","t"],"n24":"Tú:","n25":"Hoy","n26":["só","i"],"n27":["lo‿en","t"],"n28":"Ti","n29":["vi","i"],"n30":["vi","m"],"n31":["mos","t"],"n32":"y","n33":["Te","i"],"n34":["ne","m"],"n35":["mos","t"],"n36":["to","i"],"n37":["do","t"],"n38":["nues","i"],"n39":["tro","t"],"n40":"ser."},"verses":[{"label":"2.","lines":["Tú, el camino‿a Dios","Nos diste redención;","En Tí, no hay temor","Al ver a nuestro Juez.","Absueltos hoy, delante de","Tu trono‿estamos, por Tu‿amor."]},{"label":"3.","lines":["¡Verdad viviente, Tú!","Sabiduria real,","Fuente de todo don,","¡La eternal verdad!","¡El gran Yo Soy! ¡Reposo real!","Respuesta‿a todo mi afán."]},{"label":"4.","lines":["Tú eres, oh Señor,","La vida de verdad:","Vida‿abundante que","La tierra no nos da;","¡Resucitó nuestro Señor!","¡Morada mutua somos hoy!"]},{"label":"5.","lines":["Recibe‿adoración","Señor, Rey, Salvador;","Nuestra fuerza y vigor","Te damos con loor;","¡Oh, llénanos! ¡Que por nuestro","Vivir ganes a otros hoy!"]}]}