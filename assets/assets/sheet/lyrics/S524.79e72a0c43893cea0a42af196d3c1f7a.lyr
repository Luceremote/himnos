{"hymn":"S524","parent":"E639","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Muerte no impide la resurrección","subtitle":"La vida de resurrección—Cristo mismo","syl":{"n1":["Muer","i"],"n2":["te","t"],"n3":["no‿im","i"],"n4":["pi","m"],"n5":["de","t"],"n6":"la","n7":["re","i"],"n8":["su","m"],"n9":["rrec","m"],"n10":["ción,","t"],"n11":"La","n12":["vi","i"],"n13":["da‿e","m"],"n14":["ter","m"],"n15":["na","t"],"n16":"que","n17":["se‿en","i"],"n18":["cuen","m"],"n19":["tra‿en","t"],"n20":"Dios,","n21":["In","i"],"n22":["des","m"],"n23":["truc","m"],"n24":["ti","m"],"n25":["ble","t"],"n26":["e‿in","i"],"n27":["cre","m"],"n28":["a","m"],"n29":["da,","t"],"n30":"es","n31":"El","n32":["Cris","i"],"n33":["to‿in","m"],"n34":["vic","m"],"n35":["to","t"],"n36":"en","n37":"Su","n38":["ex","i"],"n39":["pre","m"],"n40":["sión.","t"]},"verses":[{"label":"2.","lines":["Muerte no impide la resurrección,","Aunque su fuerza contra ella esté;","Sólo le da la oportunidad,","De que la vida muestre Su poder."]},{"label":"3.","lines":["Muerte no impide la resurrección,","Al enterrarla, se acrecentará;","Los sufrimientos la hacen crecer más,","Y muchos frutos de vida llevar."]},{"label":"4.","lines":["Muerte no impide la resurrección,","Cada barrera puede penetrar;","Vence al infierno y todo su poder,","Sorbe la muerte y triunfa sobre el mal."]},{"label":"5.","lines":["Muerte no impide la resurrección,","La plenitud de Dios expresará;","Justicia y santidad producirá,","De Dios la imagen manifestará."]},{"label":"6.","lines":["Oh, que conozca la resurrección,","En cualquier muerte grande es su poder,","Que en mi experiencia pueda realizar,","Que el Cristo vivo esta vida es."]}]}