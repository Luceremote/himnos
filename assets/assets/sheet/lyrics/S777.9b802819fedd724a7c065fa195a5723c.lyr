{"hymn":"S777","parent":"E943","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Requiere el reino mucho más","subtitle":"El reino—Sus requisitos","syl":{"n1":["Re","i"],"n2":["quie","m"],"n3":["re‿el","t"],"n4":["rei","i"],"n5":["no","t"],"n7":["mu","i"],"n8":["cho","t"],"n10":"más","n11":"Que","n12":"los","n13":["de","i"],"n14":["cre","m"],"n15":["tos","t"],"n16":"de","n17":"la","n18":"ley;","n19":"Más","n20":["al","i"],"n21":["to","t"],"n22":"y","n23":["es","i"],"n25":["tric","m"],"n26":["to","t"],"n28":"es","n29":"Que","n30":"lo","n31":"que","n32":["pro","i"],"n33":["mul","m"],"n35":["gó","t"],"n36":["Moi","i"],"n37":["sés.","t"]},"verses":[{"label":"2.","lines":["\"Arrepentíos para entrar\",","Es la primera condición;","Un cambio así debemos dar","Y firme estar por nuestro Dios."]},{"label":"3.","lines":["Para poder al reino entrar","Nuestra justicia debe ser","Mayor que aquella de la ley,","Y de la vida proceder."]},{"label":"4.","lines":["Para poder al reino entrar","La voluntad del Padre obrad;","No actuemos por nuestra elección","Sino para cumplir Su plan."]},{"label":"5.","lines":["Para poder al reino entrar","Debemos como un niño ser,","Flexible y manso en actitud,","Y todo lo del yo vencer."]},{"label":"6.","lines":["Requiere el reino perfección","Tal como el Padre celestial;","A tal nivel hay que llegar","Para en su éxtasis entrar."]},{"label":"7.","lines":["El reino es el regir de Dios,","Y para entrar hay que tener","Su misma vida y expresión","Con la naturaleza de Él."]},{"label":"8.","lines":["El reino que hemos de acatar","Es el gobierno celestial,","El cual, por vida divinal,","Con el Señor se gozará."]}]}