{"hymn":"S157","parent":"E198","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El Árbol de la vida, Tú","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"El","n2":["Ár","i"],"n3":["bol","t"],"n5":"de","n6":"la","n8":["vi","i"],"n9":["da,","t"],"n10":"Tú;","n11":"La","n12":["vi","i"],"n14":["da‿o","m"],"n15":["fre","m"],"n16":["ces","t"],"n17":"hoy;","n18":"Tu","n19":["vi","i"],"n21":["da‿a","m"],"n22":["sí","t"],"n23":["pue","i"],"n24":["de","t"],"n26":["sa","i"],"n27":["ciar","t"],"n28":["Nues","i"],"n29":["tra‿ham","m"],"n31":["bre,","t"],"n32":"oh","n33":["Se","i"],"n34":["ñor.","t"]},"verses":[{"label":"2.","lines":["La verdadera Vid, Señor,","Tú‿eres, que vida das;","Si permanecesmos en Tí,","Tendremos vida‿y paz."]},{"label":"3.","lines":["El Árbol de manzano, Tú,","¡Disfrute‿y bendición!","Tu fruto‿es dulce‿al paladar;","Tu sombra‿es protección."]},{"label":"4.","lines":["Tú eres Árbol sanador","Que la muerte sorbió;","Al padecer la cruenta cruz,","Tu muerte nos curó."]},{"label":"5.","lines":["Eres el Vástago de Dios;","Su gracia‿en Ti nos da;","Habita en Ti Su plenitud,","También Su realidad."]},{"label":"6.","lines":["Como Renuevo de David,","Te hiciste carne, Tú.","En Tu humanidad se vio","La gracia‿y la virtud."]},{"label":"7.","lines":["La Vara que reverdeció","Con vida eternal:","Tal como Tu resurrección","La muerte‿anulará."]},{"label":"8.","lines":["Eres el Palo que flotó","Y‿el hacha levantó;","Tu vida con Tu gran poder,","De muerte nos sacó."]},{"label":"9.","lines":["La \"Planta de renombre\", Tú;","¡Qué rico‿es compartir!","Te recordamos con amor","Para‿expresarte‿aquí."]}]}