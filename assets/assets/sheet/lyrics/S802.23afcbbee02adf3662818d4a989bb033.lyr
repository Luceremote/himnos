{"hymn":"S802","parent":"E970","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La creación está aguardando","subtitle":"Esperanza de gloria—La manifestación de los hijos de Dios","syl":{"n1":"La","n2":["crea","i"],"n3":["ción","t"],"n5":["es","i"],"n7":["tá‿a","m"],"n8":["guar","m"],"n9":["dan","m"],"n11":["do","t"],"n12":"Su","n13":["to","i"],"n14":["tal","t"],"n15":["li","i"],"n17":["be","m"],"n18":["ra","m"],"n19":["ción.","t"],"n20":["Cuan","i"],"n22":["do","t"],"n24":"sean","n25":["ma","i"],"n26":["ni","m"],"n28":["fes","m"],"n30":["ta","m"],"n31":["dos","t"],"n32":["To","i"],"n34":["dos","t"],"n36":"los","n38":["hi","i"],"n40":["jos","t"],"n41":"de","n42":"Dios."},"verses":[{"label":"2.","lines":["La creación gime a una,","Sujeta a vanidad;","De la esclavitud corrupta","Busca plena libertad."]},{"label":"3.","lines":["Gemimos también nosotros","Esperando madurar;","En la filiación creciendo","Con Cristo en conformidad."]},{"label":"4.","lines":["Es por esto que hoy gime","El Espíritu de Dios;","Todo para el bien coopera","De nuestra transformación."]},{"label":"5.","lines":["Dios nos lleva a Su gloria,","Y nos glorificará;","Saturándonos consigo,","Él nos santificará."]},{"label":"6.","lines":["Toda la creación Él lleva","A gloriosa libertad;","El cabrito y el leopardo","Conviviendo en unidad."]},{"label":"7.","lines":["Hemos de ser herederos","Junto con nuestro Señor;","Se verá en Sus hermanos","Su glorioso resplandor."]}]}