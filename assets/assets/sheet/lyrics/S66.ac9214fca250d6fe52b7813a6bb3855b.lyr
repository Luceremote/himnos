{"hymn":"S66","parent":"E81","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, por siempre existes Tú","subtitle":"Alabanza al Señor—Su eternidad","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":"por","n4":["siem","i"],"n6":["pre‿e","m"],"n7":["xis","m"],"n9":["tes","t"],"n10":"Tú,","n11":["Des","i"],"n12":["de","t"],"n13":"lo","n14":["an","i"],"n15":["ta","m"],"n17":["ño‿e","m"],"n18":["res","t"],"n19":"Dios;","n20":["E","i"],"n21":["res","t"],"n22":"el","n23":["Pa","i"],"n25":["dre","t"],"n26":["e","i"],"n29":["ter","m"],"n30":["nal,","t"],"n32":"El","n33":["in","i"],"n34":["cre","m"],"n35":["a","m"],"n37":["do","t"],"n39":"gran","n40":"YO","n41":"SOY."},"verses":[{"label":"2.","lines":["Aunque te‿hiciste un hombre fiel,","Tu ser con Dios eterno es;","Completo‿en todo como Él,","E infinito‿eres también."]},{"label":"3.","lines":["La misma fuente, Tú y Dios,","Precedes toda la creación;","Antes del delantero, Tú;","Antes de Ti nada‿existió."]},{"label":"4.","lines":["El tiempo no te cambiará,","Tus años son la eternidad,","Nada perdura como Tú,","De todo eres el final."]},{"label":"5.","lines":["Tal como‿el Padre, oh Jesús,","Perfecto‿en todo como Él;","Alfa y‿Omega eres Tú,","Primero‿y Ultimo también."]},{"label":"6.","lines":["A Ti, Señor, hay que‿alabar,","Y admirar Tu vastedad;","Se debe‿honrar Tu perfección,","Y elogiar Tu‿eternidad."]}]}