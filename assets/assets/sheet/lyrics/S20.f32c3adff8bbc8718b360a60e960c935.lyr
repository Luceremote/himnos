{"hymn":"S20","parent":"E24","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tu gran saber y gracia, oh Dios","subtitle":"Adoración al Padre—Su sabiduria","syl":{"n1":"Tu","n2":"gran","n3":["sa","i"],"n4":["ber","t"],"n5":"y","n6":["gra","i"],"n7":["cia,‿oh","t"],"n8":"Dios,","n9":["Cen","i"],"n10":["tra","m"],"n11":["do‿en","t"],"n12":["Cris","i"],"n13":["to‿es","m"],"n14":["tá;","t"],"n15":"Y","n16":"nos","n17":"ha","n18":["si","i"],"n19":["do","t"],"n20":["he","i"],"n22":["cho","t"],"n24":"Él","n25":["Sa","i"],"n26":["bi","m"],"n27":["du","m"],"n28":["ria","t"],"n29":["re","i"],"n31":["al.","t"],"n32":"Y","n33":"nos","n34":"ha","n35":["si","i"],"n36":["do","t"],"n37":["he","i"],"n39":["cho","t"],"n41":"Él","n42":["Sa","i"],"n43":["bi","m"],"n44":["du","m"],"n45":["ria","t"],"n48":["re","i"],"n49":["al.","t"]},"verses":[{"label":"2.","lines":["Todo Tu plan en Cristo está;","Tu gracia nos da El,","//Sabiduría y santidad,","Para Tu gloria ser.//"]},{"label":"3.","lines":["En Cristo, nuestra rectitud,","Dios nos justificó;","//En Cristo, nuestra santidad","Nos santifica Dios.//"]},{"label":"4.","lines":["Es nuestra redención también,","Conforme‿a Tu intención;","//Perfectos hombres nos hará,","La nueva creación.//"]},{"label":"5.","lines":["El en Tu‿economía,‿oh Dios,","Sabiduría es;","//Te alabamos hoy por El,","Glorificándote.//"]},{"label":"6.","lines":["Se ve sabiduría‿en Él,","Inescrutable es!","//Mas por nosotros se hallará","Más rica cada vez.//"]}]}