{"hymn":"S829","parent":"E981","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Dios en Su economía","subtitle":"La máxima manifestación—Cristo reune todo bajo una cabeza","syl":{"n1":"Dios","n2":"en","n3":"Su","n4":["e","i"],"n5":["co","m"],"n6":["no","m"],"n7":["mí","m"],"n8":["a","t"],"n9":["Quie","i"],"n10":["re","t"],"n11":"a","n12":"Su","n13":["Cris","i"],"n14":["to","t"],"n15":"ver","n16":["Co","i"],"n17":["mo‿el","t"],"n18":["Cen","i"],"n19":["tro‿y","t"],"n20":"la","n21":["Ca","i"],"n22":["be","m"],"n23":["za,","t"],"n24":["To","i"],"n25":["do‿ar","m"],"n26":["mo","m"],"n27":["ni","m"],"n28":["za","m"],"n29":["do‿en","t"],"n30":"Él."},"verses":[{"label":"2.","lines":["Cristo, la Cabeza y Centro.","Dios en Él, luz eternal;","Cristo al trono exaltado,","Con substancia divinal."]},{"label":"3.","lines":["Cristo, el contenido y vida,","Encabeza todo en luz;","Y los santos como el vaso","Manifiestan Su virtud."]},{"label":"4.","lines":["Satanás se ha inyectado","En el hombre y lo arruinó;","Trajo corrupción y sombras","Para interferir con Dios."]},{"label":"5.","lines":["Cristo vino y se imparte","Como vida al mortal;","Ya la muerte y las tinieblas","No lo pueden dominar."]},{"label":"6.","lines":["Por la iglesia, que es Su Cuerpo,","Cristo todo reunirá;","Todo en Cristo concertado,","En Sí mismo se unirá."]},{"label":"7.","lines":["Bajo Cristo, la Cabeza,","Todo subsistiendo está;","Por la luz que trae la iglesia","Todo existe en unidad."]},{"label":"8.","lines":["Cristo, la Cabeza y centro,","Todo armonizará;","Por el brillo de Su Cuerpo","Todo se libertará."]},{"label":"9.","lines":["No más corrupción ni sombras,","No más muerte y vanidad;","De la esclavitud librado","Todo, por la eternidad."]}]}