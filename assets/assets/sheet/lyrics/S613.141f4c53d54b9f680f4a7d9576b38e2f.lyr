{"hymn":"S613","parent":"E792","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Espero en Ti, Señor, sólo en Ti","subtitle":"Oración—Esperar en Dios","syl":{"n1":["Es","i"],"n2":["pe","m"],"n3":["ro‿en","t"],"n4":"Ti,","n5":["Se","i"],"n6":["ñor,","t"],"n7":["só","i"],"n8":["lo‿en","t"],"n9":"Ti;","n10":"Que","n11":"hoy","n12":["des","i"],"n13":["can","m"],"n14":["se‿en","t"],"n15":"Ti;","n16":"Que","n17":["pue","i"],"n18":["da","t"],"n19":["per","i"],"n20":["ci","m"],"n21":["bir","t"],"n22":"Tu","n23":["vo","i"],"n24":["lun","m"],"n25":["tad","t"],"n26":"en","n27":"mí;","n28":["Es","i"],"n29":["pe","m"],"n30":["ro‿en","t"],"n31":"Ti;","n32":["só","i"],"n33":["lo","t"],"n34":"en","n35":"Ti."},"verses":[{"label":"2.","lines":["Espero en Ti, Señor, sólo en Ti;","Quiero permanecer,","Orando hasta ver","Tu senda esclarecer;","Espero‿en Ti; sólo en Ti."]},{"label":"3.","lines":["Espero en Ti, Señor, sólo en Ti;","Mézclate con mi ser","Hasta poder tener","Tu misma imagen fiel;","Espero‿en Ti; sólo en Ti."]},{"label":"4.","lines":["Espero en Ti, Señor, sólo en Ti;","Muestra Tu voluntad;","Hazme en Tu senda andar,","Y vida rebosar:","Espero‿en Ti; sólo en Ti."]},{"label":"5.","lines":["Espero en Ti, Señor, sólo en Ti;","Que toda mi oración","Sea Tu expresión;","Dame el secreto hoy:","Espero‿en Ti; sólo en Ti."]}]}