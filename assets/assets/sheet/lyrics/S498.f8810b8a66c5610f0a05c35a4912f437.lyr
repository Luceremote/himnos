{"hymn":"S498","parent":"E1195","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La vida es misteriosa, vida es Dios","subtitle":"Experiencia de Dios—Como vida","syl":{"n1":"La","n2":["vi","i"],"n3":["da‿es","t"],"n4":["mis","i"],"n5":["te","m"],"n6":["rio","m"],"n7":["sa,","t"],"n8":["vi","i"],"n9":["da‿es","t"],"n10":"Dios;","n11":["To","i"],"n12":["do","t"],"n13":["Su‿en","i"],"n14":["fo","m"],"n15":["que","t"],"n16":"con","n17":"el","n18":["hom","i"],"n19":["bre","t"],"n20":"es.","n21":"El","n22":["ár","i"],"n23":["bol","t"],"n24":"de","n25":"la","n26":["vi","i"],"n27":["da","t"],"n28":"Dios","n29":"lo","n30":"dio,","n31":["Pa","i"],"n32":["ra","t"],"n33":"un","n34":["hom","i"],"n35":["bre","t"],"n36":"de","n37":["vi","i"],"n38":["da‿ob","m"],"n39":["te","m"],"n40":["ner.","t"]},"verses":[{"label":"2.","lines":["Fue seducido el hombre y pecó,","De otra fuente, recibió el saber;","Por tal conocimiento, él cayó;","Así el hombre dominado fue."]},{"label":"3.","lines":["Trajo‿el saber a la humanidad","Toda cultura que en la tierra está;","El hombre que era para el plan de Dios","Por su caída, expresa a Satanás."]},{"label":"4.","lines":["Más tarde como Hijo vino Dios,","Vivió en la tierra, se llamó Jesús;","Fue un modelo vivo para que","La vida el hombre obtenga en plenitud"]},{"label":"5.","lines":["Este Dios-hombre en la cruz murió,","Y‿al viejo hombre‿allí aniquiló;","Lo negativo así crucificó,","Y una nueva vida comenzó."]},{"label":"6.","lines":["Venció a la muerte y resucitó","Como el Espíritu que vida da;","Cuando se creé en Su nombre al invocar","El entra a nuestro ser para morar."]},{"label":"7.","lines":["De este modo el mismo Triuno Dios","Como Espíritu al nuestro entró.","Los dos se unen y se mezclan hoy,","Así un solo espíritu ellos son."]},{"label":"8.","lines":["Por este Espíritu es nuestro andar,","Nuestro vivir hacer proviene de Él.","¡En este Espíritu estamos hoy!","Y Él la plenitud de Dios nos da."]},{"label":"9.","lines":["Por eso hay que poner la mente en Él.","Y ocuparla en Él sin distracción.","Para que por la vida que Él nos da,","Reinemos y gocemos salvación."]},{"label":"10.","lines":["Por este Espíritu hay liberación","De muerte, del pecado, y de su ley;","La vida hasta el cuerpo llegará,","Santificando todo nuestro ser."]},{"label":"11.","lines":["Este Espíritu nos salvará","Del yo, y el Cuerpo edificará;","Al transformarnos, nos conformará","A Cristo para así cumplir Su plan."]},{"label":"12.","lines":["Vida es Dios, y Cristo vida es,","Vida es el Espíritu también.","Hasta que llegue nuestra redención","Sólo esta vida la manera es."]}]}