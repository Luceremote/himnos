{"hymn":"S161","parent":"E202","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, eres el Alfa","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":["e","i"],"n4":["res","t"],"n5":"el","n6":["Al","i"],"n7":["fa,","t"],"n8":["La‿O","i"],"n9":["me","m"],"n10":["ga","t"],"n11":"y‿el","n12":["A","i"],"n13":["mén;","t"],"n14":["E","i"],"n15":["res","t"],"n16":["Pri","i"],"n17":["me","m"],"n18":["ro‿en","t"],"n19":["to","i"],"n20":["do,","t"],"n21":"Y‿el","n22":["Úl","i"],"n23":["ti","m"],"n24":["mo","t"],"n25":["tam","i"],"n26":["bién,","t"],"n27":"Tú","n28":["e","i"],"n29":["res","t"],"n30":"el","n31":["Prin","i"],"n32":["ci","m"],"n33":["pio,","t"],"n34":"Y‿el","n35":["ú","i"],"n36":["ni","m"],"n37":["co","t"],"n38":["Fi","i"],"n39":["nal;","t"],"n40":"En","n42":"Ti","n43":["se‿in","i"],"n44":["clu","m"],"n45":["ye","t"],"n46":["to","i"],"n47":["do","t"],"n48":"Lo","n49":"que","n50":["cre","i"],"n51":["a","m"],"n52":["do‿es","m"],"n53":["tá.","t"]},"verses":[{"label":"2.","lines":["Ya que Tú‿eres el Alfa,","Todo comienza‿en Ti;","Y por ser Tú la‿Omega,","Todo termina en Ti.","Por ser el Alfabeto,","Toda composición","De Ti está compuesta,","Hasta la conclusión."]},{"label":"3.","lines":["Como el Primero eres","Cabeza en la creación;","Por Ti todo consiste,","Eres la‿iniciación.","Como Último Tú eres","La gran consumación;","Y para Ti subsiste","La‿entera creación."]},{"label":"4.","lines":["Ya que eres el Principio,","Precedes la creación;","Y como el Fin heredas","Todo como porción.","El único Principio","Que todo originó,","El fin de todo eres","Y la terminación."]},{"label":"5.","lines":["Señor, te alabamos","Por ser Principio‿y Fin;","Como‿Alfa‿y como‿Omega","Se rinde todo a Ti.","Como el Primero‿en todo,","Recibe nuestro amor;","Como‿Último mereces","Eterna adoración."]}]}