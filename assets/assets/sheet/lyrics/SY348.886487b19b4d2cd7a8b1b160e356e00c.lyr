{"hymn":"SY348","parent":"E166","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Gloria al Señor porque","subtitle":"","syl":{"n1":["Glo","i"],"n2":["ria","t"],"n3":"al","n4":["Se","i"],"n5":["ñor","t"],"n6":["por","i"],"n7":["que","t"],"n8":"Rey","n9":"es","n10":["po","i"],"n11":["ten","m"],"n12":["te‿de","t"],"n13":["glo","i"],"n14":["ria.","t"],"n15":"De","n16":"Sus","n17":["mer","i"],"n18":["ce","m"],"n19":["des","t"],"n20":["Es","i"],"n21":["té","t"],"n22":["vi","i"],"n23":["va‿en","t"],"n24":"ti","n25":"la","n26":["me","i"],"n27":["mo","m"],"n28":["ria.","t"],"n29":"Oh","n30":["¡des","i"],"n31":["per","m"],"n32":["tad!","t"],"n33":"En","n34":"Su","n35":["pre","i"],"n36":["sen","m"],"n37":["cia:‿¡En","m"],"n38":["to","m"],"n39":["nad","t"],"n40":["Him","i"],"n41":["nos","t"],"n42":["de‿ho","i"],"n43":["nor","t"],"n44":"y","n45":["vic","i"],"n46":["to","m"],"n47":["ria!","t"]},"verses":[{"label":"2.","lines":["Gloria al Señor porque‿Él es","Quien los orbes gobierna;","Y te sostiene, te guarda‿y","Protege‿en Sus alas.","¿No has de mirar","Como‿en todo‿Él supo obrar","Y siempre actuar por tu causa?"]},{"label":"3.","lines":["Mi alma, bendice al Señor,","De mi vida la fuente-","Él me dio vida,","En salud me sostiene fielmente.","En aflicción, en todo trance y dolor,","Tus alas siempre presentes."]},{"label":"4.","lines":["Gloria al Señor que","Prospera mi obra y defiende;","Lluvias de amor, paz, bondad,","Desde‿el cielo Él extiende.","Con Su poder","Maravillas puede hacer;","Más con Su amor Él me‿entiende."]},{"label":"5.","lines":["Gloria al Señor:","Todo lo que hay en nos Te bendice.","Por Tus proezas","También por Tu inmensa grandeza.","Que nuestro \"Amén\"","Resuene fuerte también.","¡Seas por siempre bendito!"]}]}