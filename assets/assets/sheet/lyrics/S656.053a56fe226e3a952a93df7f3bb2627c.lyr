{"hymn":"S656","parent":"E844","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Sopla, Señor! ¡Oh, háblanos","subtitle":"La iglesia—Su edificación","syl":{"n1":["¡So","i"],"n2":["pla,","t"],"n3":["Se","i"],"n4":["ñor!","t"],"n5":"¡Oh,","n6":["há","i"],"n7":["bla","m"],"n8":["nos!","t"],"n9":["Rei","i"],"n10":["na","t"],"n11":"la","n12":["muer","i"],"n13":["te‿al","m"],"n14":["re","m"],"n15":["de","m"],"n16":["dor;","t"],"n17":"Hay","n18":["hue","i"],"n19":["sos","t"],"n20":["se","i"],"n21":["cos","t"],"n22":"por","n23":["do","i"],"n24":["quier.","t"],"n25":["¡So","i"],"n26":["pla‿en","t"],"n27":["no","i"],"n28":["so","m"],"n29":["tros,","t"],"n30":["Se","i"],"n31":["ñor!","t"]},"verses":[{"label":"2.","lines":["¡Sopla, Señor! ¡Oh, háblanos!","Revive nuestros huesos hoy;","De nuestras tumbas sácanos.","¡Sopla en nosotros, Señor!"]},{"label":"3.","lines":["¡Sopla, Señor! ¡Oh, háblanos!","Tu pueblo aviva con vigor;","Haznos las huestes contra el mal.","¡Sopla en nosotros, Señor!"]},{"label":"4.","lines":["¡Sopla, Señor! Oh, háblanos","Para que el pueblo esté en unión,","Sumisos a Tu autoridad.","¡Sopla en nosotros, Señor!"]},{"label":"5.","lines":["¡Sopla, Señor! Oh, háblanos","Para acoplarnos en Tu amor,","Y hacernos Tu habitación.","¡Sopla en nosotros, Señor!"]},{"label":"6.","lines":["¡Hoy háblame! ¡Sopla, Señor!","Avívame y edifícame;","Del Cuerpo ya no aislado esté.","¡Sopla, Señor en mi ser!"]},{"label":"7.","lines":["¡Hoy háblame! Sopla, Señor,","Para en el Cuerpo combatir","Y Tu enemigo destruir.","¡Sopla, Señor en mi ser!"]}]}