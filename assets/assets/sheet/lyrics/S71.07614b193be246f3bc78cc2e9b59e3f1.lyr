{"hymn":"S71","parent":"E90","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Nuestro débil canto acepta","subtitle":"Alabanza al Señor—Su humillación","syl":{"n1":["Nues","i"],"n2":["tro‿dé","m"],"n3":["bil","t"],"n4":["can","i"],"n5":["to‿a","m"],"n6":["cep","m"],"n7":["ta","t"],"n9":["Glo","i"],"n10":["ria‿y","t"],"n11":["fuer","i"],"n12":["za","t"],"n13":["Tu","i"],"n14":["yas","t"],"n15":"son.","n16":["Re","i"],"n17":["cor","m"],"n18":["da","m"],"n19":["mos","t"],"n20":"hoy","n21":["Tu‿gra","i"],"n22":["cia,","t"],"n24":["Nues","i"],"n25":["tro‿a","m"],"n26":["ma","m"],"n27":["do","t"],"n28":["Sal","i"],"n29":["va","m"],"n30":["dor.","t"]},"verses":[{"label":"2.","lines":["Rico‿en gloria, te‿humillaste,","¡Nuestra esperanza aquí!","Fuiste pobre para hacernos","Ricos en Tu gloria‿así."]},{"label":"3.","lines":["¿Por qué desdeñaste‿el cielo","Para‿en esta tierra‿andar?","¿Por qué padeciste muerte,","Mofa,odio‿y soledad?"]},{"label":"4.","lines":["En los cielos: El Glorioso;","Pero en la tierra, Tú","Enfrentaste‿el sufrimiento","Por Tu‿amor y gran virtud."]},{"label":"5.","lines":["Cuando‿en tal amor pensamos,","Gozo‿y vergüenza se ven;","Por Tu compasión: el gozo;","Vengüenza: por nuestro‿hacer."]},{"label":"6.","lines":["Esperamos ver el día,","Sin ninguna restricción,","Cuando‿en gloria te sirvamos","Con entera devoción."]},{"label":"7.","lines":["Nuestro anhelo y‿esperanza","Es vivir por Ti, Señor;","Y ser fieles hasta verte","Con Tus santos en amor."]}]}