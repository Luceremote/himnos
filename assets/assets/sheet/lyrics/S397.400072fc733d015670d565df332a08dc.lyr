{"hymn":"S397","parent":"E1145","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Su Hijo a todo hombre, Dios","subtitle":"Experiencia de Cristo—Como comida y bebida","syl":{"n1":"Su","n2":["Hi","i"],"n3":["jo‿a","t"],"n4":["to","i"],"n5":["do","t"],"n6":["hom","i"],"n7":["bre,","t"],"n8":"Dios,","n9":["Có","i"],"n10":["mo‿ár","m"],"n11":["bol","t"],"n12":"de","n13":"la","n14":["vi","i"],"n15":["da","t"],"n16":"dio,","n17":["Pa","i"],"n18":["ra","t"],"n19":"que","n20":["prue","i"],"n22":["be‿y","t"],"n23":["ve","i"],"n24":["a","t"],"n25":"hoy","n26":"Que","n27":"Dios","n28":["co","i"],"n29":["mi","m"],"n30":["da","t"],"n31":"es.","n33":["Gra","i"],"n34":["tui","m"],"n35":["ta","m"],"n36":["men","m"],"n37":["te","t"],"n38":"de‿Él,","n40":["Gra","i"],"n41":["tui","m"],"n42":["ta","m"],"n43":["men","m"],"n44":["te","t"],"n45":"de‿Él,","n47":"Dios","n48":"nos","n49":["in","i"],"n50":["vi","m"],"n52":["ta","t"],"n53":"a","n54":["co","i"],"n55":["mer","t"],"n56":["Gra","i"],"n57":["tui","m"],"n58":["ta","m"],"n59":["men","m"],"n60":["te","t"],"n61":"de‿Él."},"verses":[{"label":"2.","lines":["Es nuestro Dios rico manjar,","Comiendo de Él, nos sostendrá;","Así el hombre vivirá","Por este rico Dios."]},{"label":"3.","lines":["Jesús nuestra comida es,","Él es el pan: nos nutre Él;","Su vida imparte a nuestro ser","Comiendo a diario de Él."]},{"label":"4.","lines":["¡Qué disfrutable es tal festín!","Y Dios lo ofrece hoy a ti,","Pues nos invita a comer","Gratuitamente de Él."]}]}