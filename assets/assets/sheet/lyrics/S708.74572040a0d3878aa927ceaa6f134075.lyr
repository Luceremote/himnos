{"hymn":"S708","parent":"E863","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En las reuniones y diario vivir","subtitle":"Las reuniones—Cristo como centro","syl":{"n1":"En","n2":"las","n3":["reu","i"],"n4":["nio","m"],"n5":["nes","t"],"n6":"y","n7":["dia","i"],"n8":["rio","t"],"n9":["vi","i"],"n10":["vir,","t"],"n11":["Cris","i"],"n12":["to‿es","t"],"n13":"el","n14":["cen","i"],"n15":["tro,","t"],"n16":["Cris","i"],"n17":["to","t"],"n18":["to","i"],"n19":["do","t"],"n20":"es;","n21":"No","n22":"por","n23":["doc","i"],"n24":["tri","m"],"n25":["nas","t"],"n26":"ni","n27":"por","n28":"un","n29":["ri","i"],"n30":["tual,","t"],"n31":["Só","i"],"n32":["lo","t"],"n33":"por","n34":["Cris","i"],"n35":["to‿es","t"],"n36":["nues","i"],"n37":["tro","t"],"n38":["con","i"],"n39":["gre","m"],"n40":["gar.","t"]},"verses":[{"label":"2.","lines":["La luz de vida y el camino es,","En Él andamos, guía nuestros pies;","Cristo agua viva y comida es,","Cristo nos nutre y sacia nuestra sed."]},{"label":"3.","lines":["Cristo es verdad, testificamos de Él,","Cristo es Señor, magnifiquémosle;","Cristo, la vida, ministrado es,","Como Cabeza, ¡exaltémosle!"]},{"label":"4.","lines":["Cristo es el todo para el hombre y Dios,","A Dios y al hombre satisface Él;","Para Su iglesia es la realidad,","Por Él la vida en ella crecerá."]},{"label":"5.","lines":["En cada himno y en cada oración,","Se expresa a Cristo como realidad;","Todo servicio en la comunión","Exhibe a Cristo en Su operación."]},{"label":"6.","lines":["Es en Su Nombre y en Espíritu","Que nos reunimos sin formalidad;","Le alabaremos con poder y unción","Con nuestro espíritu y en oración."]},{"label":"7.","lines":["A Cristo asidos, todo hay que olvidar,","Lo aplicaremos hasta madurar;","Todo estimemos pérdida por Él,","Eternamente el todo en todo es."]}]}