{"hymn":"S845","parent":"E1003","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¿Por qué ansiedad, duda y temor","subtitle":"El evangelio—La redención","syl":{"n1":"¿Por","n2":["qué‿an","i"],"n3":["sie","m"],"n4":["dad,","t"],"n5":["du","i"],"n6":["da‿y","t"],"n7":["te","i"],"n8":["mor?","t"],"n9":["To","i"],"n10":["do","t"],"n11":["pe","i"],"n12":["ca","m"],"n13":["do,","t"],"n14":"¿no","n15":["car","i"],"n16":["gó","t"],"n17":["So","i"],"n18":["bre","t"],"n19":"Su","n20":["Hi","i"],"n21":["jo,","t"],"n22":"Dios?","n23":["Cris","i"],"n24":["to‿en","t"],"n25":"la","n26":"cruz","n27":["mu","i"],"n28":["rió","t"],"n29":"por","n30":"mí.","n32":["¿Pu","i"],"n33":["die","m"],"n34":["ra","t"],"n35":"Dios","n36":["lue","i"],"n37":["go‿e","m"],"n38":["xi","m"],"n39":["gir","t"],"n40":["O","i"],"n41":["tro","t"],"n42":["pa","i"],"n43":["go","t"],"n44":"de","n45":"mí?"},"verses":[{"label":"2.","lines":["Completa redención logró","Mis deudas el Señor pagó,","De la ley libre soy.","No temo más la ira de Dios,","Pues con Su sangre me roció,","Cubierto ahora estoy."]},{"label":"3.","lines":["El mi perdón aseguró,","Obtuvo plena absolución","Mis deudas, las saldó.","Dios no reclamará de dos,","De Su Hijo, mi buen Fiador,","Y otra vez de mí."]},{"label":"4.","lines":["Descanso y paz hoy míos son;","Mi Salvador me liberó,","Él todo consumó;","Sé que por Su sangre eficaz,","Dios ya no me condenará,","Pues, ¡Él por mí murió!"]}]}