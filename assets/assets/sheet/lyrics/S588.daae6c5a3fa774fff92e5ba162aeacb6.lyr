{"hymn":"S588","parent":"E764","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Guardo silencio frente a Ti, Señor","subtitle":"Oración—Su significado","syl":{"n1":["Guar","i"],"n2":["do","t"],"n3":["si","i"],"n4":["len","m"],"n5":["cio","t"],"n6":["fren","i"],"n7":["te‿a","t"],"n8":"Ti,","n9":["Se","i"],"n10":["ñor,","t"],"n11":"Y‿en","n12":"lo","n13":["pro","i"],"n14":["fun","m"],"n15":["do","t"],"n16":["ven","i"],"n17":["go","t"],"n18":["an","i"],"n19":["te","t"],"n20":"Ti;","n21":"No","n22":["o","i"],"n23":["ra","m"],"n24":["ré","t"],"n25":"mi","n26":["pro","i"],"n27":["pia","t"],"n28":["o","i"],"n29":["ra","m"],"n30":["ción","t"],"n32":"Mas","n33":["o","i"],"n34":["ra","m"],"n35":["ré","t"],"n36":"Tu","n37":["o","i"],"n38":["ra","m"],"n39":["ción","t"],"n40":"en","n41":"mí."},"verses":[{"label":"2.","lines":["Parece que en el cielo escuchas Tú,","Mas en mi espíritu habitas hoy;","Parece que yo estoy orando á Ti","Mas de Ti mismo sale la oración."]},{"label":"3.","lines":["Cuando mi carga no puedo expresar,","Gime Tu Espíritu en mí, Señor;","Y, sin mi petición verbalizar,","Tú mismo oras desde mi interior."]},{"label":"4.","lines":["Quisiera inhalarte, mi Señor,","Comer, beber de Ti, mi provisión,","Y en una comunión más honda entrar","Para que tengas en mí Tu expresión."]},{"label":"5.","lines":["Brilla Tu luz en esta comunión,","Me limpia Tu preciosa sangre aquí;","No sólo quiero apreciar Tu luz,","Mas expresarte claramente en mí."]},{"label":"6.","lines":["Me unge aquí Tu aceite celestial","Ungiéndome contigo sin cesar,","Mientras yo mengüo, Tú creciendo estás,","Así Tu plena expresión tendrás."]},{"label":"7.","lines":["Abro mi ser, Señor, a Tu fluir,","Este fluir a otros llevaré;","Y en la corriente siempre en comunión,","Señor, por vida yo te expresaré."]}]}