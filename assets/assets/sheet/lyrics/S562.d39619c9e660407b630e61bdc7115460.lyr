{"hymn":"S562","parent":"E733","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Dios puso al hombre en frente de","subtitle":"Varios aspectos de la vida interior—Los dos árboles","syl":{"n1":"Dios","n2":["pu","i"],"n3":["so‿al","t"],"n4":["hom","i"],"n5":["bre‿en","t"],"n6":["fren","i"],"n7":["te","t"],"n8":"de","n9":"Dos","n10":["ár","i"],"n11":["bo","m"],"n12":["les","t"],"n13":"en","n14":"el","n15":["E","i"],"n16":["dén:","t"],"n17":"El","n18":"de","n19":"la","n20":["vi","i"],"n21":["da","t"],"n22":["mues","i"],"n23":["tra‿a","t"],"n24":"Dios,","n25":"El","n26":"de","n27":"la","n28":["cien","i"],"n29":["cia;‿a","t"],"n30":["Sa","i"],"n31":["ta","m"],"n32":["nás.","t"]},"verses":[{"label":"2.","lines":["El centro del eterno plan","El árbol de la vida es:","El mismo Dios que en Cristo está","Quiere la vida al hombre ser."]},{"label":"3.","lines":["El árbol de la ciencia es","Una advertencia y precaución:","La fuente que hay fuera de Dios","Trae muerte a aquel que la escogió."]},{"label":"4.","lines":["Para cumplir el plan de Dios","El hombre tiene que comer","Del árbol de la vida que","Transformará todo su ser."]},{"label":"5.","lines":["Si escoge el de la ciencia hoy,","Entra en el hombre Satanás,","Quien es pecado y muerte trae,","Para frustrar de Dios, el plan."]},{"label":"6.","lines":["Todo lo cual nos hace ver","Que Dios la fuente debe ser","Para nosotros, pues tocar","Toda otra fuente muerte es."]},{"label":"7.","lines":["Conocimiento, muerte trae,","Ya sea malo o luzca bien;","Pues todo lo que no es de Dios","Es artimaña de Satán."]},{"label":"8.","lines":["No sólo el mal, también el bien","Con Cristo está en oposición;","El mal y el bien son, a la vez,","Con Cristo gran contradicción."]},{"label":"9.","lines":["Señor, enséñame a tocar","Sólo la vida que hay en Ti,","Y no tocar el bien o el mal","O lo que no viene de Ti."]}]}