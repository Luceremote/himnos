{"hymn":"S287","parent":"E358","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh, amor divino, excelso","subtitle":"Anhelos—De Cristo","syl":{"n1":"Oh,","n2":["a","i"],"n3":["mor","t"],"n4":["di","i"],"n5":["vi","m"],"n6":["no,‿ex","m"],"n8":["cel","m"],"n9":["so,","t"],"n10":"A","n11":"la","n12":["tie","i"],"n13":["rra","t"],"n14":["ba","i"],"n15":["ja","t"],"n17":"ya;","n18":["Fi","i"],"n19":["ja","t"],"n20":"Tu","n21":["mo","i"],"n22":["ra","m"],"n23":["da‿hu","m"],"n25":["mil","m"],"n26":["de,","t"],"n27":"En","n28":["no","i"],"n29":["so","m"],"n30":["tros","t"],"n31":"haz","n32":["Tu‿ho","i"],"n34":["gar.","t"],"n35":["E","i"],"n36":["res","t"],"n37":["com","i"],"n38":["pa","m"],"n39":["sión,","t"],"n40":"oh","n42":["Cris","i"],"n43":["to;","t"],"n44":["In","i"],"n45":["fi","m"],"n46":["ni","m"],"n47":["to‿y","t"],"n48":["pu","i"],"n49":["ro‿a","m"],"n51":["mor;","t"],"n52":"Que","n53":"Tu","n54":["sal","i"],"n55":["va","m"],"n56":["ción","t"],"n57":"de","n59":["gra","i"],"n60":["cia","t"],"n61":["En","i"],"n62":["tre‿al","t"],"n63":["frá","i"],"n64":["gil","t"],"n65":["co","i"],"n66":["ra","m"],"n68":["zón.","t"]},"verses":[{"label":"2.","lines":["En el pecho tan herido,","Sopla‿el tierno‿Espíritu;","Que‿heredemos, Señor, todos,","Tu descanso‿en plenitud.","Del pecar, quita‿el encanto;","Alfa y Omega sé;","Líbranos de ataduras,","Tú,‿el Principio‿y Fin de fe."]},{"label":"3.","lines":["Ven, oh Todopoderoso,","Tu poder y vida da;","Tu presencia‿esté por siempre","En Tus templos sin cesar.","Que nuestro servicio‿aceptes","Con Tu santa‿aprobación,","Alabándote‿y orando","Con entera devoción."]},{"label":"4.","lines":["Haznos puros y sin mancha","Como Tu nueva creación,","Restaurados y perfectos","Por Tu grande salvación;","Llévanos de gloria‿en gloria","Hasta contigo reinar,","Hasta‿echar nuestras coronas","Ante Ti y exultar."]}]}