{"hymn":"S767","parent":"E1295","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La comunión en el evangelio","subtitle":"Predicar el evangelio—La comunión del evangelio","syl":{"n1":"La","n2":["co","i"],"n3":["mu","m"],"n4":["nión","t"],"n5":"en","n6":"el","n7":["e","i"],"n8":["van","m"],"n9":["ge","m"],"n10":["lio","t"],"n11":"Es","n12":["u","i"],"n13":["na","t"],"n14":["ben","i"],"n15":["di","m"],"n16":["ción;","t"],"n18":"Nos","n19":["con","i"],"n20":["sa","m"],"n21":["gra","m"],"n22":["mos","t"],"n23":"por","n24":"su","n25":["pro","i"],"n26":["gre","m"],"n27":["so","t"],"n28":"Y","n29":"su","n30":["pro","i"],"n31":["pa","m"],"n32":["ga","m"],"n33":["ción.","t"],"n35":"Por","n36":"su","n37":["con","i"],"n38":["fir","m"],"n39":["ma","m"],"n40":["ción","t"],"n41":"y","n42":["de","i"],"n43":["fen","m"],"n44":["sa","t"],"n45":["Gra","i"],"n46":["cia‿el","t"],"n47":["Se","i"],"n48":["ñor","t"],"n49":"nos","n51":"da;","n53":"El","n54":["que‿em","i"],"n55":["pe","m"],"n56":["zó","t"],"n57":"la","n58":["o","i"],"n59":["bra‿en","t"],"n60":["no","i"],"n61":["so","m"],"n62":["tros","t"],"n63":"La","n64":["per","i"],"n65":["fec","m"],"n66":["cio","m"],"n67":["na","m"],"n68":["rá.","t"]},"verses":[{"label":"2.","lines":["Todas las cosas que nos suceden","Por esta causa son:","Que todos oigan el evangelio","Y del amor de Dios;","Que con denuedo hablemos todos","Hoy Su Palabra fiel;","Hazlo viviendo en Jesucristo,","Hazlo con Su poder."]},{"label":"3.","lines":["Danos, Señor, el atrevimiento","Para testificar,","Sea por vida o sea por muerte a","Cristo magnificar.","Pues no queremos ni para nada","Avergonzados ser,","Para nosotros vivir es Cristo,","Y nuestro todo es Él."]},{"label":"4.","lines":["Que nuestras vidas puedan ser dignas","Para evangelizar.","En nuestro espíritu combatimos,","Guardando la unidad.","Anunciaremos el evangelio","Dándonos al Señor;","Cristo es la vida, proclamaremos,","La iglesia, Su expresión."]}]}