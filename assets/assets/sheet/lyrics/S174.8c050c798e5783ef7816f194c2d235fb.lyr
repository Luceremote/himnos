{"hymn":"S174","parent":"E222","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Gracias, Señor, por este pan","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n1":["Gra","i"],"n3":["cias,","t"],"n4":["Se","i"],"n5":["ñor,","t"],"n6":"por","n7":["es","i"],"n9":["te","t"],"n11":"pan,","n12":["Se","i"],"n13":["ñal","t"],"n15":["di","i"],"n16":["vi","m"],"n18":["na","t"],"n19":"es;","n20":"De","n21":"los","n22":["mis","i"],"n23":["te","m"],"n24":["rios","t"],"n25":"de","n27":"Tu","n29":"plan","n30":"De","n31":"Tu","n33":["de","i"],"n34":["sig","m"],"n36":["nio","t"],"n37":"fiel."},"verses":[{"label":"2.","lines":["El pan un bello signo es,","Tu cuerpo nos da‿a ver;","Lo diste para‿infundir","Tu vida‿en nuestro ser."]},{"label":"3.","lines":["Tu cuerpo quebrantado fue","Para vida impartir;","Así nosotros somos hoy","Tu complemento aquí."]},{"label":"4.","lines":["El pan también nos hace ver","Tu Cuerpo místico;","Los miembros vivos somos de‿él,","A Ti idénticos."]},{"label":"5.","lines":["Los muchos granos somos, más","Un solo pan se ve;","Al recordarte en tal unión,","Nos nutres con tu ser."]},{"label":"6.","lines":["Al compartir de este pan","¡Qué gran satisfacción!","Tu testimonio, es Senor,","Y nuestra comunión."]}]}