{"hymn":"S576","parent":"E746","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Que yo mi espíritu discierna","subtitle":"Varios aspectos de la vida interior—Discernir el Espíritu","syl":{"n1":"Que","n2":"yo","n4":["mi‿es","i"],"n5":["pí","m"],"n7":["ri","m"],"n8":["tu","t"],"n10":["dis","i"],"n11":["cier","m"],"n12":["na","t"],"n13":"De","n14":["mi‿al","i"],"n15":["ma,","t"],"n16":["rue","i"],"n18":["go‿a","t"],"n19":"Ti,","n20":["Se","i"],"n21":["ñor;","t"],"n22":"Pues","n23":"con","n25":["mi‿es","i"],"n26":["pí","m"],"n28":["ri","m"],"n29":["tu","t"],"n31":"el","n32":["Tu","i"],"n33":["yo","t"],"n34":["Es","i"],"n35":["tá","t"],"n37":["mez","i"],"n38":["cla","m"],"n40":["do","t"],"n41":"en","n43":["u","i"],"n44":["nión.","t"]},"verses":[{"label":"2.","lines":["Que yo mi espíritu discierna","Para mi alma hoy negar,","Así en mi espíritu te puedo","Seguir y‿en todo aplicar."]},{"label":"3.","lines":["Que yo mi espíritu discierna,","Mi mente así podré fijar","No en la carne de pecado,","Sino en mi espíritu vital."]},{"label":"4.","lines":["Que yo mi espíritu discierna","Para en mi alma no vivir,","Sino, en mi espíritu andando,","Yo todo pueda discernir."]},{"label":"5.","lines":["Que yo mi espíritu discierna,","Oh, hazme ver el yo sutil;","Para que yo la cruz aplique","Y pueda así por Ti vivir."]},{"label":"6.","lines":["Que yo mi espíritu discierna","Hasta mi alma transformar,","Y, conformado a Tu‿imagen,","A madurez he de llegar."]},{"label":"7.","lines":["Parte el espíritu y el alma","Por Tu Palabra eficaz;","Señor, que viva así por siempre","En el Santísimo Lugar."]}]}