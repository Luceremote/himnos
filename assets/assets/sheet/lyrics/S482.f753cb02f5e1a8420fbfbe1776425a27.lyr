{"hymn":"S482","parent":"E1176","quality":"check","adjust":{"hold":0,"merge":0},"title":"Oh, qué gran poder Dios nos demostró","subtitle":"Experiencia de Cristo—El poder de su resurrección","syl":{"n1":"Oh,","n2":"qué","n3":"gran","n4":["po","i"],"n5":["der","t"],"n6":"Dios","n7":"nos","n8":["de","i"],"n9":["mos","m"],"n10":["tró","t"],"n11":["Cuan","i"],"n12":["do‿al","t"],"n13":["Hi","i"],"n14":["jo‿Él","t"],"n15":["re","i"],"n16":["su","m"],"n17":["ci","m"],"n19":["tó.","t"],"n20":"Que","n21":["po","i"],"n22":["da","m"],"n23":["mos","t"],"n24":"ver","n25":["es","i"],"n26":["te","t"],"n27":"gran","n28":["po","i"],"n29":["der","t"],"n30":"Y","n31":["vi","i"],"n32":["vir","t"],"n33":"en","n34":"la","n35":["re","i"],"n36":["su","m"],"n37":["rrec","m"],"n38":["ción.","t"],"n39":"¡Tal","n40":["po","i"],"n41":["der","t"],"n42":"que","n43":["so","i"],"n44":["bre","t"],"n45":["to","i"],"n46":["do","t"],"n47":["rei","i"],"n48":["na,","t"],"n49":["Rei","i"],"n50":["na‿en","t"],"n51":["lo‿ex","i"],"n52":["te","m"],"n53":["rior","t"],"n54":"y","n55":["lo‿in","i"],"n56":["te","m"],"n57":["rior!","t"],"n58":"¡Tal","n59":["po","i"],"n60":["der","t"],"n61":"que","n62":["so","i"],"n63":["bre","t"],"n64":["to","i"],"n65":["do","t"],"n66":["rei","i"],"n67":["na,","t"],"n68":["Rei","i"],"n69":["na","t"],"n70":"por","n71":"el","n72":["hom","i"],"n73":["bre","t"],"n74":["in","i"],"n75":["te","m"],"n76":["rior!","t"]},"verses":[{"label":"2.","lines":["Alto‿es el poder que Dios desplegó,","sobre todos al Hijo alzó.","Principados, poderes, majestad;","Ante Cristo, postrados caerán."]},{"label":"3.","lines":["Cristo recibió gran poder de Dios;","Con poder, Él todo subyugó.","Y Su Cuerpo hoy somos, ¡gloria‿a Dios!","¡Todo bajo nuestros pies está!"]},{"label":"4.","lines":["Pero lo mejor es que‿a Cristo, Dios","Por Cabeza‿a la‿iglesia lo dio.","Este gran poder sobre todo es;","A la cumbre hoy nos lleva Él."]}]}