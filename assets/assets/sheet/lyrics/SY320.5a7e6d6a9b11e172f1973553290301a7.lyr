{"hymn":"SY320","parent":"NS805","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh Jesús, te anhelamos","subtitle":"","syl":{"n1":"¡Oh","n2":["Je","i"],"n3":["sús,","t"],"n4":["te‿an","i"],"n5":["he","m"],"n6":["la","m"],"n7":["mos!","t"],"n8":"Con","n9":["no","i"],"n10":["so","m"],"n11":["tros","t"],"n12":"ven","n13":"ya.","n14":["Nues","i"],"n15":["tro","t"],"n16":["No","i"],"n17":["vio","t"],"n18":["y‿A","i"],"n19":["ma","m"],"n20":["do,","t"],"n21":["Só","i"],"n22":["lo","t"],"n23":"Tú","n24":["pue","i"],"n25":["des","t"],"n26":["lle","i"],"n27":["nar.","t"],"n29":"Sí,","n30":"Tú,","n31":["Se","i"],"n32":["ñor.","t"],"n33":["Só","i"],"n34":["lo","t"],"n35":"Tú","n36":["pue","i"],"n37":["des","t"],"n38":["lle","i"],"n39":["nar.","t"]},"verses":[{"label":"2.","lines":["¡Tómame, Amado mío!","Y que Tu compasión","Todo mi ser atraiga;","Quema los ídolos.","Quema, quema,","Quema los ídolos."]},{"label":"3.","lines":["Guárdame en Tu afecto;","Sencillo, en castidad.","En todo el universo,","Como Tú no hay otro igual.","¡Sólo Cristo!","Como Tú no hay otro igual."]},{"label":"4.","lines":["Cada día, más cerca","De Ti estamos, Señor.","Nuestro corazón ruega:","¡Ven pronto, ven hoy, Señor!","Señor, amén,","¡Ven pronto, ven hoy, Señor!"]}]}