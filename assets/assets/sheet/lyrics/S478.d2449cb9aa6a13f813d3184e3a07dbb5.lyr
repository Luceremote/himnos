{"hymn":"S478","parent":"E1171","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Mira el arca del ayer","subtitle":"Experiencia de Cristo—Su humanidad","syl":{"n1":["Mi","i"],"n2":["ra‿el","t"],"n3":["ar","i"],"n4":["ca","t"],"n5":"del","n6":["a","i"],"n7":["yer,","t"],"n8":"De","n9":["a","i"],"n10":["ca","m"],"n11":["cia‿y","t"],"n12":["o","i"],"n13":["ro","t"],"n14":"es;","n15":"¡Tal","n16":["hu","i"],"n17":["ma","m"],"n18":["ni","m"],"n19":["dad","t"],"n20":"se","n21":"ve!","n22":["¡Glo","i"],"n23":["ria","t"],"n24":"a‿Él!","n25":["¡Glo","i"],"n26":["ria","t"],"n27":"a‿Él!","n28":["¡Glo","i"],"n29":["ria","t"],"n30":"a‿Él!"},"verses":[{"label":"2.","lines":["Es Jesús la acacia real;","¡Hombre tan fino y cabal!","Resistió a todo mal.","¡Gloria a Él! ¡Gloria a Él!","¡Gloria a Él!"]},{"label":"3.","lines":["El Dios-hombre es Jesús,","¡Qué misterio! ¡Qué virtud!","Un nuevo hombre trajo a luz.","¡Gloria a Él! ¡Gloria a Él!","¡Gloria a Él!"]},{"label":"4.","lines":["Por Adán la muerte entró,","Mas Jesús vida nos dio;","Dios al hombre recobró.","¡Gloria a Él! ¡Gloria a Él!","¡Gloria a Él!"]},{"label":"5.","lines":["Muchos tipos dan a ver","Que‿a Jesús hay que tener,","Debe en nosotros crecer;","¡Digo amén! ¡Oh, Señor!","¡Digo amén!"]},{"label":"6.","lines":["Que Tu humanidad, Señor,","Nos sature y, por Tu amor,","Que vean muchos Tu valor;","¡Digo amén! ¡Oh, Señor!","¡Digo amén!"]}]}