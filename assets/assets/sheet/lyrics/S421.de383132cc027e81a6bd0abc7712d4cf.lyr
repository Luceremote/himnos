{"hymn":"S421","parent":"E535","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Todo es posible para aquel","subtitle":"Experiencia de Cristo—Como aquel que es todo-suficiente","syl":{"n1":["To","i"],"n2":["do‿es","t"],"n3":["po","i"],"n4":["si","m"],"n6":["ble","t"],"n7":["pa","i"],"n9":["ra‿a","m"],"n10":["quel","t"],"n11":"Que","n12":"en","n13":["Je","i"],"n14":["sús","t"],"n15":["pue","i"],"n16":["da","t"],"n18":["cre","i"],"n19":["er;","t"],"n20":"Tu","n21":["nom","i"],"n22":["bre","t"],"n23":"ya","n25":["no‿in","i"],"n26":["sul","m"],"n28":["ta","m"],"n29":["ré,","t"],"n30":"Hoy","n31":"Tu","n32":["ver","i"],"n33":["dad","t"],"n34":["re","i"],"n35":["ci","m"],"n37":["bi","m"],"n38":["ré.","t"],"n39":["Cre","i"],"n40":["o,","t"],"n41":["Se","i"],"n42":["ñor,","t"],"n43":"yo","n44":["cre","i"],"n45":["o‿en","t"],"n46":"Ti,","n47":["To","i"],"n48":["do‿es","t"],"n49":["po","i"],"n50":["si","m"],"n51":["ble","t"],"n52":["pa","i"],"n53":["ra","t"],"n54":"mí."},"verses":[{"label":"2.","lines":["Lo más difícil de lograr","Es que el pecado cese en mí;","Mas por Tu gran fidelidad","Yo sé que ha de ser así.","Si nada es arduo para Ti,","Todo es posible para mí."]},{"label":"3.","lines":["Aunque se opone el mundo hoy,","No falla la Palabra fiel;","Pues la verdad de nuestro Dios","Puede el pecado en mí vencer.","Aunque imposible, sólo en Ti","Todo es posible para mí."]},{"label":"4.","lines":["Todo es posible para Dios","Y para Cristo en mi ser;","Todo es posible para mí","Cuando renueva Su poder.","Del vil pecado libre al fin,","Todo es posible para mí."]},{"label":"5.","lines":["Todo es posible para Dios,","Y para Cristo en mi interior;","Derrama en mí Tu propio ser,","No viva yo, mas Tú, Señor,","Para que pueda comprobar","La omnipotencia de Tu amor."]}]}