{"hymn":"S506","parent":"E614","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Más cerca quiero estar","subtitle":"Experiencia de Dios—Comunión con Él","syl":{"n1":"Más","n2":["cer","i"],"n3":["ca","t"],"n4":["quie","i"],"n5":["ro‿es","m"],"n6":["tar,","t"],"n7":"Mi","n8":"Dios,","n9":"de","n10":"Ti;","n11":["Aun","i"],"n12":["que","t"],"n13":"sea","n14":"por","n15":"la","n16":"cruz,","n17":["Llé","i"],"n19":["va","m"],"n20":["me‿a","t"],"n21":"Ti.","n22":"Que","n23":["se","i"],"n24":["a","t"],"n25":"mi","n26":["can","i"],"n27":["ción;","t"],"n28":"Más","n29":["cer","i"],"n30":["ca","t"],"n31":"de","n32":"mi","n33":"Dios,","n34":"Más","n35":["cer","i"],"n36":["ca","t"],"n37":"de","n38":"mi","n39":"Dios,","n40":["Cer","i"],"n42":["ca","t"],"n43":"de","n44":"Ti."},"verses":[{"label":"2.","lines":["Como un errante soy;","El sol se fue.","Sobre una piedra hoy","Descansaré;","Mas soñaré que‿estoy","Más cerca de mi Dios,","Más cerca de mi Dios,","Cerca de Ti."]},{"label":"3.","lines":["Del cielo abierto aquí,","Dame visión;","Todo me das a mí","Con compasión.","Me llamas en Tu amor","Más cerca de mi Dios,","Más cerca de mi Dios,","Cerca de Ti."]},{"label":"4.","lines":["Luego, al salir el sol,","Te alabaré;","De mi tribulación,","Bet-el haré.","Me lleve la aflicción","Más cerca de mi Dios,","Más cerca de mi Dios,","Cerca de Ti."]}]}