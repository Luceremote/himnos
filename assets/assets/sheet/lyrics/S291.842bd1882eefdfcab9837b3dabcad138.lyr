{"hymn":"S291","parent":"E367","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Supremo sé, Señor Jesús","subtitle":"Anhelos—De la supremacía de Cristo","syl":{"n1":["Su","i"],"n2":["pre","m"],"n3":["mo","t"],"n5":"sé,","n6":["Se","i"],"n7":["ñor","t"],"n8":["Je","i"],"n9":["sús;","t"],"n11":["Nin","i"],"n12":["gún","t"],"n14":["cre","i"],"n15":["do‿o","t"],"n17":["ri","i"],"n18":["tual,","t"],"n20":["Ni‿i","i"],"n21":["gle","m"],"n23":["sia","t"],"n25":["san","i"],"n26":["ta‿o‿hu","m"],"n27":["ma","m"],"n28":["no‿a","m"],"n29":["mor","t"],"n30":"A","n31":"Ti","n33":["se‿i","i"],"n34":["gua","m"],"n35":["la","m"],"n36":["rá.","t"]},"verses":[{"label":"2.","lines":["Supremo sé, Señor Jesús,","Tu‿amor me conquistó;","Mi ego muere‿al ver Tu cruz;","Por Ti hoy vivo yo."]},{"label":"3.","lines":["Supremo sé, Señor Jesús,","Oh, llena Tú mi ser;","Así, tal como Tú seré","Y te complaceré."]},{"label":"4.","lines":["Supremo sé, Señor Jesús,","Transforma hoy mi ser;","Tu vida‿en mi carne mortal","Pueda resplandecer."]},{"label":"5.","lines":["Supremo sé, Señor Jesús;","Exulta mi‿alma‿en Ti;","Yo quiero‿hacer Tu voluntad,","Tu‿esclavo ser, feliz."]}]}