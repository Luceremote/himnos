{"hymn":"S617","parent":"E798","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Avíva Tu obra, oh Dios","subtitle":"Oración—Para ser avivados","syl":{"n1":["¡A","i"],"n3":["ví","m"],"n4":["va","t"],"n6":["Tu‿o","i"],"n7":["bra,‿oh","t"],"n8":"Dios!","n9":"Tu","n10":["bra","i"],"n11":["zo‿ex","m"],"n12":["tien","m"],"n13":["de","t"],"n14":"hoy;","n16":"Que","n17":"Tu","n18":["pre","i"],"n20":["sen","m"],"n21":["cia","t"],"n23":"real","n24":["es","i"],"n26":["té","t"],"n27":"En","n28":["nues","i"],"n29":["tro","t"],"n30":["co","i"],"n31":["ra","m"],"n32":["zón.","t"],"n33":["¡A","i"],"n35":["ví","m"],"n36":["va","t"],"n37":["Tu‿o","i"],"n38":["bra,‿oh","t"],"n39":"Dios!","n40":["Ex","i"],"n42":["hi","m"],"n43":["be","t"],"n44":"Tu","n45":["po","i"],"n46":["der,","t"],"n47":"En","n49":"Tu","n50":["i","i"],"n52":["gle","m"],"n53":["sia","t"],"n55":["co","i"],"n56":["mo","t"],"n58":"en","n59":["A","i"],"n60":["quel","t"],"n61":["Pen","i"],"n62":["te","m"],"n63":["cos","m"],"n64":["tés.","t"]},"verses":[{"label":"2.","lines":["¡Avíva Tu obra, oh Dios!","Termina el estupor;","Inflama el fuego de Tu amor","En cada corazón."]},{"label":"3.","lines":["¡Avíva Tu obra, oh Dios!","La sed despierta, Tú,","Y hambre para Tu verdad","En nuestro espíritu."]},{"label":"4.","lines":["¡Avíva Tu obra, oh Dios!","Que abunde el gozo aquí;","Llenando el corazón de amor,","La escoria quema así."]},{"label":"5.","lines":["¡Avíva Tu obra, oh Dios!","Repite Tu obra hoy;","Tu nombre ensalzado esté","Con gloria y honor."]}]}