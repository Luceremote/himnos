{"hymn":"S370","parent":"E486","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Muero con Cristo, con Él yo morí","subtitle":"Unión con Cristo—Identificados con su muerte y resurrección","syl":{"n1":["Mue","i"],"n2":["ro","t"],"n3":"con","n4":["Cris","i"],"n5":["to,","t"],"n6":"con","n7":"Él","n8":"yo","n9":["mo","i"],"n10":["rí;","t"],"n12":["Vi","i"],"n13":["vo","t"],"n14":"con","n15":["Cris","i"],"n16":["to,","t"],"n17":"Él","n18":"es","n19":"mi","n20":["vi","i"],"n21":["vir;","t"],"n22":["Has","i"],"n23":["ta","t"],"n24":"que","n25":["bri","i"],"n26":["lle","t"],"n27":"Su","n28":["glo","i"],"n29":["ria‿en","t"],"n30":"mi","n31":"ser,","n33":["Ca","i"],"n34":["da","t"],"n35":["mo","i"],"n36":["men","m"],"n37":["to","t"],"n39":"yo","n40":["Su","i"],"n41":["yo","t"],"n42":["se","i"],"n43":["ré.","t"],"n44":["Ca","i"],"n45":["da","t"],"n46":["mo","i"],"n47":["men","m"],"n48":["to","t"],"n49":"Su","n50":["vi","i"],"n51":["da","t"],"n52":"me","n53":"da,","n55":["Ca","i"],"n56":["da","t"],"n57":["mo","i"],"n58":["men","m"],"n59":["to","t"],"n60":"Él","n61":"me","n62":["guar","i"],"n63":["da","m"],"n64":["rá;","t"],"n65":["Has","i"],"n66":["ta","t"],"n67":"que","n68":["bri","i"],"n69":["lle","t"],"n70":"Su","n71":["glo","i"],"n72":["ria‿en","t"],"n73":"mi","n74":"ser,","n76":["Ca","i"],"n77":["da","t"],"n78":["mo","i"],"n79":["men","m"],"n80":["to","t"],"n82":"yo","n83":["Su","i"],"n84":["yo","t"],"n85":["se","i"],"n86":["ré.","t"]},"verses":[{"label":"2.","lines":["Toda batalla‿o contienda aquí","Ha de pelear y ganar Él por mí;","Sobre nosotros bandera‿alzará,","Cada momento me vigilará."]},{"label":"3.","lines":["En cada prueba, muy cerca‿Él está,","Lleva mis cargas, alivio me da;","En aflicciones, me muestra Su‿amor,","Cada momento me cuida‿el Señor."]},{"label":"4.","lines":["Si hay angustias o si hay temor,","O‿abatimiento, me‿inspira Su‿amor;","Desde Su trono me salva‿Él aquí,","Cada momento se‿acuerda de mí."]},{"label":"5.","lines":["Tenga flaquezas o enfermedad,","Cristo me dice: \"Mi‿amparo tendrás\";","Cada momento,‿en tinieblas o luz,","Mora conmigo aún mi Jesús."]}]}