{"hymn":"S54","parent":"E68","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"¡Oh Jesús, glorioso nombre","subtitle":"Alabanza al Señor—Su nombre","syl":{"n1":"¡Oh","n2":["Je","i"],"n3":["sús,","t"],"n4":["glo","i"],"n5":["rio","m"],"n6":["so","t"],"n7":["nom","i"],"n8":["bre!","t"],"n9":["Ad","i"],"n10":["mi","m"],"n11":["ra","m"],"n12":["ble","t"],"n13":["Sal","i"],"n14":["va","m"],"n16":["dor,","t"],"n17":"Tu","n18":["na","i"],"n19":["cis","m"],"n22":["te","t"],"n23":["de‿u","i"],"n25":["na","t"],"n26":["vir","i"],"n27":["gen;","t"],"n28":["Hi","i"],"n29":["jo","t"],"n30":["de‿Hom","i"],"n33":["bre","t"],"n34":["e","i"],"n36":["res","t"],"n37":"hoy.","n38":"E‿res","n39":"Tú","n40":["Je","i"],"n41":["ho","m"],"n42":["vá","t"],"n44":"quien","n45":["sal","i"],"n46":["va;","t"],"n47":"Del","n48":["pe","i"],"n49":["ca","m"],"n50":["do","t"],"n51":["li","i"],"n52":["bras","t"],"n53":"Tú.","n54":["Cuan","i"],"n55":["do‿a","t"],"n56":"Ti","n57":"te","n58":["re","i"],"n60":["ci","m"],"n61":["bi","m"],"n62":["mos,","t"],"n63":"Nos","n64":["im","i"],"n65":["par","m"],"n66":["tes","t"],"n67":["vi","i"],"n68":["da‿y","t"],"n69":"luz."},"verses":[{"label":"2.","lines":["Es también Tu nombre \"Cristo\",","Has venido a ministrar;","El Ungido de Dios eres,","Desde la eternidad.","El Mesías de Dios eres;","En amor Él te‿eligió","Para exhibir Tu gloria","Y cumplir el plan de Dios."]},{"label":"3.","lines":["Por ser Tú \"Dios con nosotros\"","Es Tu nombre \"Emanuel\";","Dios en gracia‿así mezclado","Con la humanidad se ve.","Se mostró Dios en la carne","Lleno de gracia y verdad;","Vemos hoy en Ti Su gloria,","Y por fe lo haces real."]},{"label":"4.","lines":["¡Cuán preciados son Tus nombres!","¡Cuánto ellos dejan ver!","Su valor y su dulzura,","¡Qué deleite‿a nuestro ser!","Te‿adoramos, te honramos,","Oh precioso Salvador;","Emanuel, te alabamos;","Te‿exaltamos con loor."]}]}