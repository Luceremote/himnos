{"hymn":"S335","parent":"E435","quality":"adapted","adjust":{"hold":0,"merge":3},"title":"Oh, qué pena amarga y triste","subtitle":"Consagración—Constreñidos por el amor del Señor","syl":{"n1":"Oh,","n2":"qué","n3":["pe","i"],"n4":["na‿a","m"],"n5":["mar","m"],"n7":["ga‿y","t"],"n8":["tris","i"],"n9":["te,","t"],"n11":"Que","n12":["hu","i"],"n13":["bié","m"],"n15":["se‿un","t"],"n16":["tiem","i"],"n18":["po‿en","t"],"n19":"mí","n20":["Cuan","i"],"n21":["do‿al","t"],"n22":["Sal","i"],"n23":["va","m"],"n24":["dor","t"],"n26":["re","i"],"n27":["hu","m"],"n28":["í‿a","t"],"n30":"Y‿en","n31":["mi‿or","i"],"n32":["gu","m"],"n33":["llo","t"],"n34":["res","i"],"n36":["pon","m"],"n37":["dí","m"],"n38":["a;","t"],"n40":["\"To","i"],"n42":["do","t"],"n43":"del","n45":"yo,‿y","n46":["na","i"],"n48":["da‿de","t"],"n49":"Ti\".","n50":["\"To","i"],"n52":["do","t"],"n53":"del","n55":"yo,‿y","n56":["na","i"],"n58":["da‿de","t"],"n59":"Ti\"."},"verses":[{"label":"2.","lines":["Él me‿halló y pude verlo","En la cruz sangrando‿allí;","Al oir: \"Perdónalos, Padre\",","Compungida, mi‿alma dijo:","//\"Algo del yo, y algo de Ti\".//"]},{"label":"3.","lines":["Día‿a día Su ternura,","Comprensión y Su favor","Me‿humillaban con dulzura,","Mientras que yo susurraba:","//\"Menos del yo, y aún más de Ti\"//"]},{"label":"4.","lines":["Es más alto que los cielos,","Hondo como‿el mar sin fin;","Tu amor me‿ha conquistado,","Oh, Jesús, hoy te suplico:","//Nada del yo, y todo de Ti.//"]}]}