{"hymn":"S843","parent":"E999","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Mi soberano Salvador","subtitle":"El evangelio—La redención","syl":{"n1":"Mi","n2":["so","i"],"n3":["be","m"],"n4":["ra","m"],"n5":["no","t"],"n6":["Sal","i"],"n7":["va","m"],"n8":["dor","t"],"n9":"¿Por","n10":"mí","n11":["san","i"],"n12":["gró‿y","t"],"n13":["mu","i"],"n14":["rió?","t"],"n15":"¿Sus","n16":["sie","i"],"n17":["nes","t"],"n18":["san","i"],"n19":["tas","t"],"n20":["o","i"],"n21":["fre","m"],"n22":["ció","t"],"n23":"Por","n24":"un","n25":"vil","n26":["co","i"],"n27":["mo","t"],"n28":"yo?","n29":"En","n30":"la","n31":"cruz,","n32":"en","n33":"la","n34":"cruz","n35":"do","n36":["pri","i"],"n37":["me","m"],"n39":["ro","t"],"n40":"vi","n41":"la","n42":"luz,","n43":"Y","n44":"la","n45":["car","i"],"n46":["ga","t"],"n47":"de","n48":["mi‿al","i"],"n49":["ma","t"],"n50":"se","n51":"fue;","n52":"En","n53":"la","n54":"cruz","n55":"por","n56":"fe","n57":"yo","n58":"ví","n59":"a","n60":["Je","i"],"n62":["sús,","t"],"n63":"Y","n64":["siem","i"],"n65":["pre","t"],"n66":["fe","i"],"n67":["liz","t"],"n68":"con","n69":"Él","n70":["se","i"],"n71":["ré.","t"]},"verses":[{"label":"2.","lines":["¿Por los pecados que hice yo,","En una cruz gimió?","¡Gracia asombrosa, qué piedad,","E inmensurable amor!"]},{"label":"3.","lines":["El sol por eso se escondió,","Su gloria encubrió","Cuando Jesús, el gran Creador,","Por el hombre murió."]},{"label":"4.","lines":["Aunque mi rostro escondo yo,","Al contemplar la cruz;","Se me derrita el corazón","En honda gratitud."]},{"label":"5.","lines":["Jamás mis lágrimas podrán","Pagar por tal amor;","Lo único que puedo hacer","Es darme a Ti, Señor."]}]}