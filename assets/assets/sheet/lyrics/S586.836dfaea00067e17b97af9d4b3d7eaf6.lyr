{"hymn":"S586","parent":"E754","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"A los que temen a Jehová","subtitle":"Sanidad divina—Las alas sanadoras","syl":{"n1":"A","n2":"los","n3":"que","n4":["te","i"],"n5":["men‿a","t"],"n6":["Je","i"],"n7":["ho","m"],"n8":["vá,","t"],"n9":"En","n10":"la","n11":["Pa","i"],"n12":["la","m"],"n13":["bra","t"],"n14":["di","i"],"n15":["cho‿es","m"],"n16":["tá:","t"],"n17":"El","n18":"Sol","n19":"de","n20":"la","n21":["jus","i"],"n22":["ti","m"],"n23":["cia","t"],"n24":"trae","n25":["A","i"],"n26":["las","t"],"n27":"de","n28":["sa","i"],"n29":["ni","m"],"n30":["dad.","t"]},"verses":[{"label":"2.","lines":["A los que el nombre temen hoy,","El Salvador poder les da;","Al contristado corazón,","Sus alas sanarán."]},{"label":"3.","lines":["El Sol de la justicia es Él;","Mas, al asirnos del pecar,","No obtendremos sanidad,","Ni en Sus alas, paz."]},{"label":"4.","lines":["Sus alas sanan el dolor,","Hasta el veneno disipar;","Mas en Su seno hay que estar","Para hallar sanidad."]},{"label":"5.","lines":["Sus alas sanadoras hoy","Mi corazón hacen cantar;","El Sol de la justicia trae","Alas de sanidad."]}]}