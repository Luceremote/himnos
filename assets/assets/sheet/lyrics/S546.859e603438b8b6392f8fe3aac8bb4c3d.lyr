{"hymn":"S546","parent":"E701","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Siempre el Salvador me guía","subtitle":"Consuelo en las pruebas—Por el guiar del Señor","syl":{"n1":["Siem","i"],"n2":["pre‿el","t"],"n3":["Sal","i"],"n4":["va","m"],"n5":["dor","t"],"n6":"me","n7":["guí","i"],"n8":["a;","t"],"n9":"¿Qué","n10":"más","n11":["pue","i"],"n12":["do","t"],"n13":["pe","i"],"n14":["dir","t"],"n15":"yo?","n16":"¿No","n17":["ten","i"],"n18":["drá","t"],"n19":["mi","i"],"n20":["se","m"],"n21":["ri","m"],"n22":["cor","m"],"n23":["dia","t"],"n24":"Quien","n25":"por","n26":["vi","i"],"n27":["da","t"],"n28":"me","n29":["gui","i"],"n30":["ó?","t"],"n31":"¡Paz","n32":["di","i"],"n33":["vi","m"],"n34":["na!","t"],"n35":"¡Qué","n36":["con","i"],"n37":["sue","m"],"n38":["lo","t"],"n39":"Es,","n40":"por","n41":"fe,","n42":["an","i"],"n43":["dar","t"],"n44":"en","n45":"luz!","n46":["Ven","i"],"n47":["ga‿el","t"],"n48":"bien","n49":"o‿el","n50":"mal,","n51":["com","i"],"n52":["pren","m"],"n53":["do:","t"],"n54":["To","i"],"n55":["do","t"],"n56":["lo‿ha","i"],"n57":["ce","t"],"n58":"bien","n59":["Je","i"],"n60":["sús;","t"],"n61":["Ven","i"],"n62":["ga‿el","t"],"n63":"bien","n64":"o‿el","n65":"mal,","n66":["com","i"],"n67":["pren","m"],"n68":["do:","t"],"n69":["To","i"],"n70":["do","t"],"n71":["lo‿ha","i"],"n72":["ce","t"],"n73":"bien","n74":["Je","i"],"n75":["sús;","t"]},"verses":[{"label":"2.","lines":["Siempre el Salvador me guía;","Gozo tra a mi andar;","Gracia da con cada prueba;","Nutre con viviente pan.","Si mis torpes pies se cansan","Y mi alma seca está,","//Brotan de la Roca‿hendida","Aguas de gozo eternal.//"]},{"label":"3.","lines":["Siempre el Salvador me guía;","¡Oh, Su gracia plena es!","En los brazos de mi Padre,","¡Qué descanso yo tendré!","Cuando a ese día eterno","Vuele mi espíritu,","//Cantaré yo por los siglos;","\"Me guió siempre Jesús\".//"]}]}