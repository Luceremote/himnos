{"hymn":"S150","parent":"E191","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tú, Señor, naciste como","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"Tú,","n2":["Se","i"],"n3":["ñor,","t"],"n4":["na","i"],"n5":["cis","m"],"n6":["te","t"],"n7":["co","i"],"n9":["mo","t"],"n10":"La","n11":["si","i"],"n12":["mien","m"],"n13":["te","t"],"n14":"de","n15":["mu","i"],"n16":["jer","t"],"n18":["Pa","i"],"n19":["ra‿ho","m"],"n20":["llar","t"],"n21":"a","n22":["Tu‿e","i"],"n23":["ne","m"],"n24":["mi","m"],"n26":["go","t"],"n27":"Y","n28":["vic","i"],"n29":["to","m"],"n31":["ria","t"],"n33":["ob","i"],"n34":["te","m"],"n35":["ner.","t"],"n36":["Sien","i"],"n37":["do","t"],"n38":"Dios,","n39":"te","n40":["en","i"],"n41":["car","m"],"n42":["nas","m"],"n44":["te","t"],"n45":["Pa","i"],"n46":["ra","t"],"n47":"Tu","n48":["san","i"],"n49":["gre","t"],"n50":["ver","i"],"n51":["ter;","t"],"n53":"Por","n54":"Tu","n55":["muer","i"],"n56":["te","t"],"n57":["a","i"],"n58":["plas","m"],"n59":["tas","m"],"n61":["te","t"],"n62":"La","n63":["ser","i"],"n65":["pien","m"],"n66":["te‿y","t"],"n68":"su","n69":["po","i"],"n70":["der.","t"]},"verses":[{"label":"2.","lines":["De‿Abraham, la descendecia,","La cual Dios nos prometió;","Tú, a todas las naciones","Les serás por bendición.","Antes de‿Abraham, Tú eres,","Pues eres el gran \"Yo Soy\",","Mas te‿hiciste su simiente,","Nuestro Cordero de Dios."]},{"label":"3.","lines":["De David, la descendencia,","Quien el reino estableció;","En el trono Dios te‿ha puesto","Y Tú‿harás Su‿habitación.","\"Hijo de David\" Tú eres,","Mas él te llamó \"Señor\";","Eres su raíz y fuente","De todos eres Señor."]},{"label":"4.","lines":["Aunque \"un niño es nacido\",","El \"Dios Fuerte\" se llamó;","Aunque‿\"un Hijo\" nos es dado,","\"Padre‿Eterno\" se nombró.","Todas las promesas dadas","Por fe‿en Ti son realidad;","Eres \"Sí\" y‿\"Amén\" a ellas,","Contenido y final."]}]}