{"hymn":"S710","parent":"E865","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Reunidos, adoramos en","subtitle":"Las reuniones—Adorar a Dios","syl":{"n1":["Reu","i"],"n2":["ni","m"],"n3":["dos,","t"],"n4":["a","i"],"n5":["do","m"],"n6":["ra","m"],"n7":["mos","t"],"n8":"en","n9":["Es","i"],"n10":["pí","m"],"n11":["ri","m"],"n12":["tu‿y","t"],"n13":["ver","i"],"n14":["dad;","t"],"n15":"Nos","n16":["a","i"],"n17":["cer","m"],"n18":["ca","m"],"n19":["mos","t"],"n20":"hoy","n21":"a","n22":"Dios,","n23":["Co","i"],"n24":["mo‿Él","t"],"n25":"nos","n26":["en","i"],"n27":["se","m"],"n28":["ñó.","t"]},"verses":[{"label":"2.","lines":["Gracias que, como Espíritu,","Muy cerca Dios está;","Podemos adorarlo a Él","Al Su vida tocar."]},{"label":"3.","lines":["Creó Dios nuestro espíritu","Para adorarlo a Él;","Buscamos de Él en lo interior,","Sin nada externo hacer."]},{"label":"4.","lines":["Su vida el Señor nos dio,","La mente renovó;","Morando en nuestro interior,","Incita adoración."]},{"label":"5.","lines":["Lo adoramos en verdad","Con conciencia interior;","Ungidos por Su Espíritu,","Hoy somos Su expresión."]},{"label":"6.","lines":["Servimos con veracidad,","En sombras nunca más;","En Cristo, nuestra realidad,","Al Padre hay que adorar."]},{"label":"7.","lines":["Hoy ofrecemos Cristo a Dios","Con la experiencia de Él;","Nos deleitamos de Él con Dios,","Con dulzura y placer."]},{"label":"8.","lines":["En realidad y espíritu","Gozamos comunión;","En el propiciatorio así,","Se ofrece adoración."]}]}