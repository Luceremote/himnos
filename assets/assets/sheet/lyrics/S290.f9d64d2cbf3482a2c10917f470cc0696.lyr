{"hymn":"S290","parent":"E365","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús, habita en mí","subtitle":"Anhelos—De Cristo como vida","syl":{"n1":["Je","i"],"n2":["sús,","t"],"n3":["ha","i"],"n4":["bi","m"],"n6":["ta‿en","t"],"n7":"mí,","n8":"Tu","n9":["vi","i"],"n10":["da","t"],"n11":["mí","i"],"n13":["a","t"],"n14":"es;","n15":["Dé","i"],"n16":["ja","m"],"n17":["me","t"],"n18":"ver","n20":["Que‿in","i"],"n21":["se","m"],"n22":["pa","m"],"n23":["ra","m"],"n25":["ble","t"],"n26":"es","n28":"Tu","n29":["vi","i"],"n30":["da‿en","t"],"n31":"mí."},"verses":[{"label":"2.","lines":["Tu vida‿exhibe‿en mí;","Señor, yo quiero hablar","Y aun pensar","Lo que viene de Ti,","Y no de mí."]},{"label":"3.","lines":["Tu‿amor, Tu gozo‿y paz","Imparte‿al corazón;","¡Hazlo Señor!","Que fluya sin cesar","Tu manantial."]},{"label":"4.","lines":["La vida‿y realidad","De Tu resurrección","Con bendición","En la iglesia están;","Oh, ¡dame más!"]},{"label":"5.","lines":["En Tu palabra hoy,","Reclamo yo Tu don,","Oh, mi Señor;","En plena‿exhultación","Te doy loor."]},{"label":"6.","lines":["Mi vida Tuya es,","Y siempre‿así será,","Sin desligar;","Por siempre se‿ha de ver","Nuestra‿unidad."]}]}