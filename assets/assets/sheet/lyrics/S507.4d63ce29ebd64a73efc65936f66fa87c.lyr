{"hymn":"S507","parent":"E617","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tú, dulce voluntad de Dios","subtitle":"Experiencia de Dios—Obediencia a su voluntad","syl":{"n1":"Tú,","n2":["dul","i"],"n3":["ce","t"],"n4":["vo","i"],"n5":["lun","m"],"n6":["tad","t"],"n8":"de","n10":"Dios,","n11":"Mi","n12":["for","i"],"n13":["ta","m"],"n14":["le","m"],"n15":["za,","t"],"n17":["mi‿an","i"],"n19":["cla","t"],"n21":"fiel,","n22":["Mo","i"],"n23":["ra","m"],"n24":["da","t"],"n25":"a","n26":["mi‿es","i"],"n27":["pí","m"],"n29":["ri","m"],"n31":["tu","t"],"n32":"En","n33":"Ti","n34":["me‿es","i"],"n35":["con","m"],"n36":["do‿y","t"],"n37":["quie","i"],"n38":["to‿es","m"],"n39":["toy.","t"]},"verses":[{"label":"2.","lines":["Tu voluntad es sólo el bien,","Tú, el mejor, condúceme;","Un niño soy, te seguiré,","Confiando en Ti descansaré."]},{"label":"3.","lines":["Su voluntad endulzará","Lo amargo, y triunfa al final;","Sin la aprobación de Dios,","Gloria en los gozos no habrá."]},{"label":"4.","lines":["Tu dulce voluntad, mi Dios,","Es un abrazo protector;","Mi voluntad cautiva está,","En ámbito de gracia real."]},{"label":"5.","lines":["En este plácido lugar","Extiende alas el amor,","O anida en Tu elección,","Que siempre agrada al corazón."]},{"label":"6.","lines":["Carga ligera ésta es;","Qué dulce el yugo en verdad;","Da alas a mi corazón,","Pues Tu control es libertad."]},{"label":"7.","lines":["Reposo en Tu voluntad,","Cual niño en seno maternal;","No existe un lecho que podrá","Darme descanso tan real."]},{"label":"8.","lines":["Oh, Tu grandiosa voluntad,","Triunfante, la hago mía ya;","¡Amén!, mi fe responderá","A cada orden que Tú das."]}]}