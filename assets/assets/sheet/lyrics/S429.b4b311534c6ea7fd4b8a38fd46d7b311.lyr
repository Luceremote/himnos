{"hymn":"S429","parent":"E544","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús, yo te amo, y mío eres Tú","subtitle":"Experiencia de Cristo—Sus riquezas","syl":{"n1":["Je","i"],"n2":["sús,","t"],"n3":"yo","n4":"te","n5":["a","i"],"n7":["mo,‿y","t"],"n8":["mí","i"],"n9":["o","t"],"n10":["e","i"],"n11":["res","t"],"n12":"Tú,","n13":"Mi","n14":"buen","n15":["Sal","i"],"n16":["va","m"],"n17":["dor,","t"],"n19":["Re","i"],"n20":["den","m"],"n21":["tor,","t"],"n22":"mi","n23":["Je","i"],"n24":["sús;","t"],"n25":"Por","n26":"Ti","n27":"yo","n28":["re","i"],"n29":["nun","m"],"n31":["cio‿al","t"],"n32":["pla","i"],"n33":["cer","t"],"n35":["ten","i"],"n36":["ta","m"],"n37":["dor;","t"],"n39":["Ja","i"],"n40":["más","t"],"n41":"te‿he","n42":["a","i"],"n43":["ma","m"],"n45":["do","t"],"n46":["co","i"],"n47":["mo‿hoy,","t"],"n49":"mi","n50":["Se","i"],"n51":["ñor.","t"]},"verses":[{"label":"2.","lines":["Ya que Tu me‿amaste, te amo yo hoy;","Tu muerte‿en la cruz me compró el perdón;","Tus sienes cargaron espinas de amor;","Jamás te‿he amado como‿hoy, mi Señor."]},{"label":"3.","lines":["En vida y muerte, Señor, te amaré,","Y mientras respire te bendeciré;","Y cuando la muerte su frío me dé,","\"Jamás te‿he amado como‿hoy\", te diré."]},{"label":"4.","lines":["Deleites sin fin en la era‿eternal;","En gloria brillante te he de‿alabar;","Luciendo corona, yo te‿adoraré;","\"Jamás te‿he amado como‿hoy\", cantaré."]}]}