{"hymn":"S245","parent":"E306","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Pertenezco a Cristo","subtitle":"La certeza y el gozo de la salvación—Redimidos por la sangre","syl":{"n1":["Per","i"],"n2":["te","m"],"n3":["nez","m"],"n4":["co‿a","t"],"n5":["Cris","i"],"n6":["to,","t"],"n8":"No‿a","n9":"mi","n10":["pro","i"],"n11":["pio","t"],"n12":"yo;","n14":["To","i"],"n15":["do","t"],"n16":"lo","n17":"que","n18":["ten","i"],"n19":["go‿y","t"],"n20":"soy","n21":["Per","i"],"n22":["te","m"],"n23":["ne","m"],"n24":["ce‿a","t"],"n25":"Dios."},"verses":[{"label":"2.","lines":["Pertenezco‿a Cristo;","Mi Señor y Rey,","Reina en mi corazón,","Sobre todo es."]},{"label":"3.","lines":["Pertenezco‿a Cristo;","¿Qué podrá pasar?","Si‿abrazando mi‿alma‿está","Su brazo‿eternal."]},{"label":"4.","lines":["Pertenezco‿a Cristo;","¡Qué gran bendición!","Con Su propia sangre fue","Que mi‿alma compró."]},{"label":"5.","lines":["Pertenezco‿a Cristo;","El por mí murió;","Suyo soy y mío‿es Él,","Para‿Él vivo yo."]},{"label":"6.","lines":["Pertenezco‿a Cristo;","Mi‿alma‿El guardará,","Si por muerte‿he de pasar,","Él me cuidará."]},{"label":"7.","lines":["Pertenezco‿a Cristo;","Y pronto‿he de‿estar","Con mi‿amado Salvador,","En Su majestad."]}]}