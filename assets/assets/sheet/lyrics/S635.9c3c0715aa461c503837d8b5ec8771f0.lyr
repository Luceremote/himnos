{"hymn":"S635","parent":"E818","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo, el misterio es de Dios","subtitle":"La iglesia—El misterio de Cristo","syl":{"n1":["Cris","i"],"n2":["to,‿el","t"],"n3":["mis","i"],"n4":["te","m"],"n5":["rio","t"],"n6":"es","n8":"de","n10":"Dios;","n11":"Dios","n12":["in","i"],"n13":["vi","m"],"n14":["si","m"],"n15":["ble","t"],"n16":["siem","i"],"n18":["pre","t"],"n20":"fue,","n21":["Su‿i","i"],"n22":["ma","m"],"n23":["gen","t"],"n24":["nun","i"],"n25":["ca‿el","t"],"n27":["hom","i"],"n28":["bre","t"],"n30":"vio,","n31":"Mas","n33":["Cris","i"],"n34":["to‿el","t"],"n35":["Hi","i"],"n36":["jo","t"],"n37":"lo","n39":["mos","i"],"n41":["tró.","t"]},"verses":[{"label":"2.","lines":["Cristo es la explicación de Dios,","Es Su Palabra eternal;","Es Su corporificación,","Su misma imagen en verdad."]},{"label":"3.","lines":["Imagen del oculto Dios","Con Su glorioso resplandor;","Morando en Él Su plenitud,","Su testimonio y expresión."]},{"label":"4.","lines":["La iglesia, el misterio es","Del Cristo que hoy no se ve;","Aunque escondido Él está,","La iglesia lo da a conocer."]},{"label":"5.","lines":["La iglesia expresa a Cristo aquí,","En ella está Su habitación;","El hombre así lo puede ver,","Pues ella es Su duplicación."]},{"label":"6.","lines":["La iglesia es Su imagen fiel,","Es Su aumento y extensión;","Cabeza de ella Cristo es,","Y ella el Cuerpo para Él."]},{"label":"7.","lines":["Ya que en el Hijo el Padre está,","Y Espíritu el Hijo es,","La iglesia tiene al Triuno Dios","Como Espíritu en su ser."]}]}