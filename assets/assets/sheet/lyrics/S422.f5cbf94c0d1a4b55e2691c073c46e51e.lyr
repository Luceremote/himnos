{"hymn":"S422","parent":"E536","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo es objetivo y subjetivo a mí","subtitle":"Experiencia de Cristo—Como aquel que es subjetivo","syl":{"n1":["Cris","i"],"n2":["to‿es","t"],"n3":["ob","i"],"n4":["je","m"],"n5":["ti","m"],"n6":["vo‿y","t"],"n7":["sub","i"],"n8":["je","m"],"n9":["ti","m"],"n10":["vo‿a","t"],"n11":"mí,","n12":["Ro","i"],"n13":["gan","m"],"n14":["do‿en","t"],"n15":"los","n16":["cie","i"],"n17":["los","t"],"n18":["ob","i"],"n19":["je","m"],"n20":["ti","m"],"n21":["vo","t"],"n22":"es;","n23":["Vi","i"],"n24":["vien","m"],"n25":["do‿en","t"],"n26":"Sus","n27":["miem","i"],"n28":["bros,","t"],"n29":["sub","i"],"n31":["je","m"],"n32":["ti","m"],"n33":["vo‿es","t"],"n34":"Él","n35":"E","n36":["in","i"],"n38":["ter","m"],"n39":["na","m"],"n41":["men","m"],"n42":["te","t"],"n43":"les","n44":["brin","i"],"n45":["da","t"],"n46":"Su","n47":"ser."},"verses":[{"label":"2.","lines":["Arriba se sienta a la diestra de Dios;","Como Sacerdote Su sangre mostró;","Como Abogado intercede hoy,","Y siempre nos cuida nuestro Fiador."]},{"label":"3.","lines":["Él es el Espíritu en nuestro ser,","Él es nuestra vida y el todo es El;","Él es nuestra fuerza y gracia también,","Nuestro Paracleto que nos da poder."]},{"label":"4.","lines":["Un Hombre en los cielos en gloria está,","Como Precursor, Él cumplió con Su plan;","Al hombre introdujo en el mismo Dios,","Con Él lo hizo uno, mostrando Su amor."]},{"label":"5.","lines":["Toda la plenitud de Dios está en Él","Como el Espíritu en nuestro ser;","Revela a Dios y nos lo hace real,","Su vida nos une al Dios eternal."]},{"label":"6.","lines":["El Cristo ascendido en el cielo está,","Y Él por Su pueblo pronto volverá.","Hoy vive en nosotros el Libertador,","Y nos cambiará con Su gran resplandor."]},{"label":"7.","lines":["Muy pronto veremos la mezcla total","Del cielo y la tierra en esa Ciudad;","Todo lo objetivo mezclado será","Con lo subjetivo en gloria eternal."]}]}