{"hymn":"S134","parent":"E171","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Se endulza el corazón, Señor","subtitle":"Alabanza al Señor—Su belleza","syl":{"n1":["Se‿en","i"],"n2":["dul","m"],"n3":["za‿el","t"],"n4":["co","i"],"n5":["ra","m"],"n6":["zón,","t"],"n7":["Se","i"],"n8":["ñor,","t"],"n10":["Cuan","i"],"n11":["do‿an","m"],"n12":["he","m"],"n13":["lo","t"],"n15":"ver","n16":"Tu","n18":["glo","i"],"n19":["ria‿y","t"],"n20":"Tu","n21":["pre","i"],"n22":["sen","m"],"n23":["cia","t"],"n24":["vi","i"],"n25":["va,","t"],"n27":["Y‿a","i"],"n28":["rre","m"],"n29":["ba","m"],"n30":["ta","m"],"n31":["do","t"],"n32":"ser.","n34":["Se","i"],"n35":["ñor,","t"],"n36":"cual","n37":["lin","i"],"n38":["da","t"],"n39":"flor","n40":["de‿al","i"],"n41":["he","m"],"n42":["ña*,","t"],"n43":"Que‿en","n44":["vi","i"],"n45":["ña","t"],"n46":["flo","i"],"n47":["re","m"],"n48":["cien","m"],"n49":["do‿es","m"],"n50":["tá,","t"],"n52":["In","i"],"n53":["com","m"],"n54":["pa","m"],"n55":["ra","m"],"n56":["ble‿es‿Tu","t"],"n57":["be","i"],"n58":["lle","m"],"n59":["za","t"],"n61":"A","n62":["nues","i"],"n63":["tro","t"],"n64":["co","i"],"n65":["ra","m"],"n66":["zón.","t"]},"verses":[{"label":"2.","lines":["Toda Tu gracia en canción","No se podrá cantar;","Ni‿existe un corazón que pueda","Todo Tu amor gozar."]},{"label":"3.","lines":["No es Tu gracia o Tu amor","Que nos deleitará,","Sino Tu mismo Ser amado","Quien nos satisfará."]},{"label":"4.","lines":["Tú, el más dulce‿y lo más bello,","No hay comparación;","Eres el único en el mundo,","Que colma‿el corazón."]}]}