{"hymn":"S655","parent":"E843","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Señor, exhala en mí Tu vida","subtitle":"La iglesia—Su edificación","syl":{"n1":["Se","i"],"n3":["ñor,","t"],"n4":["ex","i"],"n6":["ha","m"],"n7":["la‿en","t"],"n8":"mí","n10":"Tu","n11":["vi","i"],"n12":["da,","t"],"n13":["Pues‿se","i"],"n14":["co","m"],"n15":["mo","t"],"n16":["co","i"],"n18":["mo","t"],"n19":["hue","i"],"n20":["so‿es","m"],"n21":["toy;","t"],"n22":"Que","n23":"me","n25":["a","i"],"n27":["vi","m"],"n28":["ves","t"],"n29":"y","n31":["res","i"],"n32":["tau","m"],"n33":["res,","t"],"n34":"Oh,","n35":["ú","i"],"n37":["ne","m"],"n38":["me","t"],"n40":"al","n41":["Cuer","i"],"n43":["po","t"],"n44":"hoy."},"verses":[{"label":"2.","lines":["Señor, exhala en mí Tu vida,","Mi espíritu atado está;","Oh, líbrame, rompe mis grillos,","Quiero al fluir del Cuerpo entrar."]},{"label":"3.","lines":["Señor, exhala en mí Tu vida,","Mi espíritu caído está;","Que Tu aliento me reviva,","¡Del Cuerpo dame su caudal!"]},{"label":"4.","lines":["Señor, exhala en mí Tu vida,","Mi espíritu sin gozo está;","Que me consueles y bendigas,","Para en Tu Cuerpo disfrutar."]},{"label":"5.","lines":["Señor, exhala en mí Tu vida,","De Ti yo quiero depender;","Da fin a mi aislamiento y muerte,","Y en Tu Cuerpo viviré."]}]}