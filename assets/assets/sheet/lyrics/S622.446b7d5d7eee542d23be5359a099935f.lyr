{"hymn":"S622","parent":"E804","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Granero Tu Palabra es","subtitle":"El estudio de la palabra—La función de la palabra","syl":{"n1":["Gra","i"],"n2":["ne","m"],"n3":["ro","t"],"n4":"Tu","n5":["Pa","i"],"n6":["la","m"],"n7":["bra","t"],"n8":"es,","n9":["Lle","i"],"n10":["no","t"],"n11":"de","n12":["pro","i"],"n13":["vi","m"],"n14":["sión,","t"],"n15":"Do‿el","n16":["bus","i"],"n17":["ca","m"],"n18":["dor","t"],"n19":["pue","i"],"n20":["de‿en","m"],"n21":["con","m"],"n22":["trar","t"],"n23":["Te","i"],"n24":["so","m"],"n25":["ros","t"],"n26":"de","n27":["va","i"],"n28":["lor.","t"],"n29":["Co","i"],"n30":["mo","t"],"n31":["pro","i"],"n32":["fun","m"],"n33":["da","t"],"n34":["mi","i"],"n35":["na","t"],"n36":"es","n37":"Con","n38":["jo","i"],"n39":["yas","t"],"n40":["de‿es","i"],"n41":["plen","m"],"n42":["dor,","t"],"n44":["Que‿o","i"],"n45":["cul","m"],"n46":["tas","t"],"n47":"en","n48":"el","n49":["fon","i"],"n50":["do‿es","m"],"n51":["tán","t"],"n52":["Pa","i"],"n53":["ra‿el","t"],"n54":"buen","n55":["bus","i"],"n56":["ca","m"],"n57":["dor.","t"]},"verses":[{"label":"2.","lines":["Cual astros Tu Palabra es","Con rayos que, al brillar,","Al peregrino guiarán;","Su senda alumbrarán.","Cual armería ella es,","Do el soldado podrá","Sus armas reparar y hallar","Poder para pelear."]},{"label":"3.","lines":["Más quiero Tu Palabra amar,","Y su mina excavar.","Que saque sus riquezas yo,","Al ver su luz brillar.","Mi armadura hallo aquí;","Mi espada ella es;","Aprenderé a combatir","La guerra de mi Rey."]},{"label":"4.","lines":["Palabra del viviente Dios;","De Su Hijo, pactor es;","Sin ella, ¿cómo aquí andar,","O a Cristo y Dios ganar?","Señor, Tu celestial verdad","Queremos entender,","Y como simples niños ser","Para de ella aprender."]}]}