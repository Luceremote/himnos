{"hymn":"S40","parent":"E51","quality":"exact","adjust":{"hold":0,"merge":0},"title":"A Ti venimos, nuestro Padre Dios","subtitle":"Adoración al Padre—Alabanza a Él de parte de sus muchos hijos","syl":{"n1":"A","n2":"Ti","n3":["ve","i"],"n4":["ni","m"],"n5":["mos,","t"],"n6":["nues","i"],"n7":["tro","t"],"n8":["Pa","i"],"n9":["dre","t"],"n10":"Dios,","n11":"Tus","n12":["hi","i"],"n13":["jos","t"],"n14":"hoy,","n15":["Jus","i"],"n16":["tos","t"],"n17":"en","n18":["san","i"],"n19":["ta","t"],"n20":["li","i"],"n21":["ber","m"],"n22":["tad","t"],"n23":["y‿a","i"],"n24":["mor,","t"],"n25":"¡Qué","n26":["ben","i"],"n27":["di","m"],"n28":["ción!","t"],"n29":["Be","i"],"n30":["llo‿es","t"],"n31":["pen","i"],"n32":["sar","t"],"n33":"que","n34":["mu","i"],"n35":["chos","t"],"n36":"han","n37":"de","n38":"ser","n39":"Tal","n40":["co","i"],"n41":["mo","t"],"n42":["Cris","i"],"n43":["to,","t"],"n44":["Tu‿e","i"],"n45":["ter","m"],"n46":["nal","t"],"n47":["pla","i"],"n48":["cer.","t"]},"verses":[{"label":"2.","lines":["Él, Tu deleite, por la gracia es","Nuestra porción;","Siendo el objeto de Tu‿eterno‿amor","Y corazón.","Su gloria‿en Tu presencia hoy se ve","En agradable‿amor, allí con Él."]},{"label":"3.","lines":["Disfruta‿el Hijo al cantar loor,","Te‿alaba hoy.","Tus hijos unen mente‿y corazón","A una voz","Para‿adorarte, nuestro Padre Dios,","Por la economía de Tu amor."]}]}