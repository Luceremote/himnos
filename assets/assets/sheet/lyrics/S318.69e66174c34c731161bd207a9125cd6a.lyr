{"hymn":"S318","parent":"E412","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, revélate, Señor","subtitle":"Anhelos—Del conocer la carne","syl":{"n1":"¡Oh,","n2":["re","i"],"n3":["vé","m"],"n4":["la","m"],"n5":["te,","t"],"n6":["Se","i"],"n7":["ñor!","t"],"n9":"Y","n10":"mi","n11":["car","i"],"n12":["ne","t"],"n13":["haz","i"],"n14":["me","t"],"n15":"ver;","n18":"Que","n19":"Tu","n20":["gra","i"],"n21":["cia","t"],"n22":["o","i"],"n23":["bre‿en","t"],"n24":"mí,","n26":["Has","i"],"n27":["ta","t"],"n28":["re","i"],"n29":["du","m"],"n30":["ci","m"],"n31":["do","t"],"n32":"ser.","n35":["¡Cuán","i"],"n36":["to","t"],"n37":["quie","i"],"n38":["ro","t"],"n39":"yo","n40":["ven","i"],"n41":["cer!","t"],"n44":"Mas","n45":"en","n46":"mi","n47":["de","i"],"n48":["bi","m"],"n49":["li","m"],"n50":["dad,","t"],"n53":"Yo","n54":"no","n55":["lo","i"],"n56":["gro‿ha","m"],"n57":["cer","t"],"n58":"el","n59":"bien,","n61":"Ni","n62":["tam","i"],"n63":["po","m"],"n64":["co","t"],"n65":["ven","i"],"n66":["zo‿el","t"],"n67":"mal."},"verses":[{"label":"2.","lines":["Busco‿a Dios en mi‿interior,","Mas mi porte es atroz;","Aunque trato de cambiar,","Como esclavo vivo yo.","La ley del pecado en mí,","Me mantiene en sujeción;","Aunque libre anhelo ser","Mi alma sigue en opresión."]},{"label":"3.","lines":["Altibajos tengo yo,","Caigo y me levanto bien;","Hago una resolución,","Mas aún vuelvo a caer.","En verdad pecado soy,","Por completo y sin poder;","En mi carne hay maldad,","Nada bueno deja ver."]},{"label":"4.","lines":["Me conozco‿en parte hoy,","Veo mi debilidad;","Mi vivir corrupto‿está,","Rara‿es mi mentalidad.","Falso es mi yo sutil,","Odio mi fuerza carnal;","Mi esperanza Cristo es,","Sólo‿en Él puedo confiar."]},{"label":"5.","lines":["Quiero‿en Cristo hoy vivir","Manteniéndome‿en la cruz,","Para poderlo‿aplicar,","Por Su Santo‿Espíritu.","Que Su muerte‿opere‿en mí","Más profundo cada vez,","Hasta destruir el yo,","Y Su vida dar a ver."]},{"label":"6.","lines":["¡Oh, qué caso‿amargo soy!","Miserable‿y pecador.","¿Quién a mí me librará","Para hacerme un vencedor?","Mi Jesús por mi sangró,","Cristo es mi santidad;","Él ahora es mi porción","Y mi vida eternal."]},{"label":"7.","lines":["Ya santificado estoy,","Te obedezco, sin mi yo;","No me he de‿avergonzar","Cuando‿acuda‿a mi Señor.","¡Esta vida trascendió!","Por fe gracia recibí;","Hoy te‿alabo, mi Señor,","Libre Tú me‿hiciste‿al fin."]}]}