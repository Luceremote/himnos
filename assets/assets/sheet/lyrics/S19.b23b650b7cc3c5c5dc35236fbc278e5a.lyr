{"hymn":"S19","parent":"E23","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En Tu sabiduría oh Dios","subtitle":"Adoración al Padre—Su sabiduria","syl":{"n1":"En","n2":"Tu","n3":["sa","i"],"n4":["bi","m"],"n5":["du","m"],"n6":["rí","m"],"n7":["a‿oh","t"],"n8":"Dios,","n9":["Y‿ex","i"],"n10":["cel","m"],"n11":["sa","t"],"n12":["vo","i"],"n13":["lun","m"],"n14":["tad,","t"],"n15":"Tu","n16":["Hi","i"],"n17":["jo","t"],"n18":["to","i"],"n19":["do‿ha","t"],"n20":"de","n21":["lle","i"],"n22":["nar","t"],"n23":["Se","i"],"n24":["gún","t"],"n25":["Tu‿e","i"],"n26":["ter","m"],"n27":["no","t"],"n28":"plan.","n29":["¡Sa","i"],"n30":["bi","m"],"n31":["du","m"],"n32":["rí","m"],"n33":["a","t"],"n34":["in","i"],"n35":["men","m"],"n36":["sa‿es!","t"],"n37":"¿Quién","n38":"la","n39":["po","i"],"n40":["drá‿en","m"],"n41":["ten","m"],"n42":["der?","t"],"n43":"Oh,","n44":["Pa","i"],"n45":["dre","t"],"n46":"Dios,","n47":"en","n48":["e","i"],"n49":["lla‿es","m"],"n50":["tá","t"],"n51":"Tu","n52":["gra","i"],"n53":["cia‿y","t"],"n54":"Tu","n55":["mer","i"],"n56":["ced.","t"]},"verses":[{"label":"2.","lines":["Cuán admirable‿es Tu creación!","No se podrá sondear;","Es para Ti, por Ti y de Ti,","Qué sabio‿es Tu pensar!"]},{"label":"3.","lines":["No tiene escape‿el pecador,","Requiere Tu merced;","En nada se puede gloriar","Mas que en Tu propio ser."]},{"label":"4.","lines":["Tú sabiamente por la cruz","Lograste redención;","Para que en nuestro espíritu","Estés como porción."]},{"label":"5.","lines":["Tu gran sabiduría en","Los cielos hoy se ve;","La iglesia a toda potestad","La da a conocer."]},{"label":"6.","lines":["Alabaremos tal merced","En la Santa Ciudad;","Por Tu sabiduría fiel","Se te conocerá."]}]}