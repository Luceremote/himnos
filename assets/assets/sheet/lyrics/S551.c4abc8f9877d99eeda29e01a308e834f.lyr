{"hymn":"S551","parent":"E713","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Diá a día, en cada momento","subtitle":"Consuelo en las pruebas—Al confiar en el Señor","syl":{"n1":["Di","i"],"n2":["á‿a","t"],"n3":["dí","i"],"n4":["a,","t"],"n5":"en","n6":["ca","i"],"n7":["da","t"],"n8":["mo","i"],"n9":["men","m"],"n10":["to,","t"],"n12":["Ha","i"],"n13":["llo","t"],"n14":["fuer","i"],"n15":["za‿en","t"],"n16":["to","i"],"n17":["da","t"],"n18":["prue","i"],"n19":["ba‿a","m"],"n20":["quí;","t"],"n22":"Al","n23":["con","i"],"n24":["fiar","t"],"n25":"en","n26":"lo","n27":"que‿el","n28":["Pa","i"],"n29":["dre‿a","m"],"n30":["sig","m"],"n31":["na,","t"],"n33":"No‿hay","n34":"por","n35":"qué","n36":["te","i"],"n37":["mor","t"],"n38":["o‿a","i"],"n39":["fán","t"],"n40":["su","i"],"n41":["frir.","t"],"n43":"El","n44":["Se","i"],"n45":["ñor,","t"],"n46":"con","n47":["co","i"],"n48":["ra","m"],"n49":["zón","t"],"n50":"tan","n51":["tier","i"],"n52":["no,","t"],"n54":"Nos","n55":["a","i"],"n56":["sig","m"],"n57":["na‿a","t"],"n58":["dia","i"],"n59":["rio","t"],"n60":"lo","n61":["me","i"],"n62":["jor;","t"],"n64":"En","n65":["fa","i"],"n66":["ti","m"],"n67":["ga","t"],"n68":"nos","n69":["man","i"],"n70":["da‿el","t"],"n71":["des","i"],"n72":["can","m"],"n73":["so;","t"],"n75":["En‿an","i"],"n76":["gus","m"],"n77":["tia","t"],"n78":"nos‿da","n80":"paz","n81":["y‿a","i"],"n83":["mor.","t"]},"verses":[{"label":"2.","lines":["El Señor a diario está tan cerca;","Gracia da para cada ocasión;","Quita todo‿afán, también anima;","Poderoso Consejero es Dios.","Proteger Sus hijos, Su tesoro,","Es la carga que lleva el Señor;","\"Como tus días serán tus fuerzas\";","Tal promesa el Señor nos dio."]},{"label":"3.","lines":["Oh, Señor, en mis tribulaciones,","Quiero‿en Tus promesas descansar;","Que jamás yo pierda el consuelo","Que, por fe, Tu fiel Palabra da.","Que me ayudes, ruego, en las tormentas,","A enfrentarlas con aceptación","Una a una, al pasar los días,","Hasta que contigo esté, Señor."]}]}