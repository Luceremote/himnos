{"hymn":"S752","parent":"E913","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Sirve y obra en el Cuerpo","subtitle":"El servicio—En el cuerpo","syl":{"n1":["Sir","i"],"n2":["ve","t"],"n3":"y","n4":["o","i"],"n5":["bra‿en","t"],"n6":"el","n7":["Cuer","i"],"n8":["po,","t"],"n9":"El","n10":["Se","i"],"n11":["ñor","t"],"n12":"nos","n13":["in","i"],"n14":["di","m"],"n15":["có;","t"],"n17":"Que","n18":"Su","n19":["me","i"],"n20":["ta","t"],"n21":"es","n22":"el","n23":["Cuer","i"],"n24":["po,","t"],"n25":["A","i"],"n26":["ca","m"],"n27":["te","m"],"n28":["mos","t"],"n29":"tal","n30":["vi","i"],"n31":["sión.","t"],"n32":["Sir","i"],"n33":["ve","t"],"n34":"y","n35":["o","i"],"n36":["bra‿en","t"],"n37":"el","n38":["Cuer","i"],"n39":["po,","t"],"n40":["Nun","i"],"n41":["ca‿en","t"],"n42":["for","i"],"n43":["ma‿in","m"],"n44":["di","m"],"n45":["vi","m"],"n46":["dual,","t"],"n48":["Co","i"],"n49":["mo‿un","t"],"n50":["miem","i"],"n51":["bro","t"],"n52":["de‿es","i"],"n53":["te","t"],"n54":["Cuer","i"],"n55":["po,","t"],"n56":["Sir","i"],"n57":["ve‿en","t"],"n58":["u","i"],"n59":["na","m"],"n60":["ni","m"],"n61":["mi","m"],"n62":["dad.","t"]},"verses":[{"label":"2.","lines":["Nos dio vida como miembros,","No en forma individual;","Prosigamos al servicio","Todos en mutualidad."]},{"label":"3.","lines":["Somos hoy las piedras vivas,","Una casa para Dios;","Siendo un sacerdocio santo","Armonioso en su labor."]},{"label":"4.","lines":["Hay que ser edificados","Para entonces ministrar;","Ver que el Cuerpo es la base","Del servicio, es crucial."]},{"label":"5.","lines":["Si servimos en el Cuerpo","Hallaremos provisión;","Separados o aislados,","Moriremos sin función."]},{"label":"6.","lines":["Al servirle en el Cuerpo","Sus riquezas nos dará;","Funcionando como miembros","Cristo en pleno se verá."]},{"label":"7.","lines":["Sólo a la Cabeza asidos","Creceremos en unión;","Nos dará el suministro","Para el Cuerpo en comunión."]},{"label":"8.","lines":["Oh Señor, a Ti nos damos","Para transformados ser;","Al servirte así en el Cuerpo","Tu intención podremos ver."]}]}