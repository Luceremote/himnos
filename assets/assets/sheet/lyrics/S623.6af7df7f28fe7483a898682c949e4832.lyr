{"hymn":"S623","parent":"E806","quality":"adapted","adjust":{"hold":1,"merge":1},"title":"Hoy parte el pan, Señor","subtitle":"El estudio de la palabra—Buscar la palabra","syl":{"n1":"Hoy","n2":["par","i"],"n3":["te‿el","t"],"n4":"pan,","n5":["Se","i"],"n6":["ñor,","t"],"n7":["Pa","i"],"n8":["ra","t"],"n9":"mi","n10":"bien,","n11":["Co","i"],"n12":["mo","t"],"n13":["par","i"],"n14":["tis","m"],"n15":["te‿el","t"],"n16":"pan","n17":"El","n18":["dí","i"],"n19":["a‿a","m"],"n20":["quel.","t"],"n21":"Tras","n22":["la‿Es","i"],"n23":["cri","m"],"n24":["tu","m"],"n25":["ra","t"],"n26":"yo","n27":"Te","n28":["bus","i"],"n29":["co‿a","t"],"n30":"Ti,","n31":["E","i"],"n32":["res","t"],"n33":"el","n34":"Pan","n35":["de‿Vi","i"],"n36":["da","t"],"n37":["Pa","i"],"n38":["ra","t"],"n39":["mí.",null,"u"],"n40":0},"verses":[{"label":"2.","lines":["El Pan de vida a mí,","Eres, Señor,","Santa Palabra que","Me salva hoy.","Nútreme para que","Pueda vivir","Pon Tu verdad, Señor,","Dentro de mí."]},{"label":"3.","lines":["Manda Tu Espíritu","Ahora‿a mí,","Para que pueda ver","Aún más de Ti.","Lo que escondido está","De Tu amor","En Tu Palabra quiero","Ver, Señor."]},{"label":"4.","lines":["Bendice Tu verdad","Como aquel pan","Que Tú partiste un día","Junto al mar.","Mis grillos se caerán,","Mi esclavitud,","Y así serás, Señor,","Mi todo, Tú."]}]}