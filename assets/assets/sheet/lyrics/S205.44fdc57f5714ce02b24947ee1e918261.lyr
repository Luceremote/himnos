{"hymn":"S205","parent":"E264","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús, Tu victorioso amor","subtitle":"La plenitud del Espíritu—Como fuego","syl":{"n1":["Je","i"],"n2":["sús,","t"],"n3":"Tu","n4":["vic","i"],"n5":["to","m"],"n6":["rio","m"],"n7":["so‿a","m"],"n8":["mor","t"],"n9":"Fue","n10":["de","i"],"n11":["rra","m"],"n12":["ma","m"],"n13":["do‿en","t"],"n14":"mí.","n16":"No","n17":["va","i"],"n18":["ga","m"],"n19":["rá","t"],"n20":"mi","n21":["co","i"],"n22":["ra","m"],"n23":["zón","t"],"n25":"Si","n26":["fi","i"],"n27":["jo‿es","m"],"n28":["tá","t"],"n29":"en","n30":"Ti,","n32":"Si","n33":["fi","i"],"n34":["jo‿es","m"],"n35":["tá","t"],"n36":"en","n37":"Ti."},"verses":[{"label":"2.","lines":["Oh, que Tu santo fuego‿en mí","Comience a arder,","Quemado‿así la‿escoria vil;","Que fluyas en mi ser,","Que fluyas en mi ser."]},{"label":"3.","lines":["Él, quien bajó en Pentecostés,","Calcine mi maldad.","Te‿invoco: Santo:Espíritu,","Trae fuego del altar,","Trae fuego del altar."]},{"label":"4.","lines":["Que brille‿en mi‿alma‿intensa luz,","Fuego refinador;","Tu vida‿esparce‿y Tu virtud","En santificación,","En santificación."]},{"label":"5.","lines":["Entonces mi‿alma ha de ser","Constante, firme‿y fiel,","Cuando de Cristo llena‿esté","Y sea su todo Él,","Y sea su todo Él."]}]}