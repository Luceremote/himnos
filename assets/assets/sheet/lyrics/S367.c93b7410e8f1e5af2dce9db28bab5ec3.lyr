{"hymn":"S367","parent":"E483","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Muerto con Cristo, Él me levantó","subtitle":"Unión con Cristo—Identificados con su muerte y resurrección","syl":{"n1":["Muer","i"],"n2":["to","t"],"n3":"con","n4":["Cris","i"],"n5":["to,‿Él","t"],"n6":"me","n7":["le","i"],"n8":["van","m"],"n9":["tó;","t"],"n10":"Qué","n11":"más","n12":"me","n13":["que","i"],"n14":["da‿a","t"],"n15":"mí","n17":["por‿ha","i"],"n18":["cer?","t"],"n19":"No","n20":"más","n21":["es","i"],"n22":["fuer","m"],"n23":["zos,","t"],"n24":"no","n25":"más","n26":["lu","i"],"n27":["char,","t"],"n28":"En","n29":["no","i"],"n30":["ve","m"],"n31":["dad","t"],"n32":"de","n33":["vi","i"],"n34":["da‿he","t"],"n35":["de‿an","i"],"n36":["dar.","t"],"n37":["¡Glo","i"],"n38":["ria","t"],"n39":["se","i"],"n40":["a‿a","t"],"n41":"Dios!"},"verses":[{"label":"2.","lines":["Resucitado con Cristo estoy,","Él mi Cabeza gloriosa es,","Mi senda ahora es santidad,","Muerto al pecado, libre en verdad.","¡Gloria sea‿a Dios!"]},{"label":"3.","lines":["Vivo con Cristo, Él no muere más.","Sigo a Cristo, delante Él va.","Del cautiverio ya libre soy,","Tengo por muerto mi ego hoy.","¡Gloria sea‿a Dios!"]},{"label":"4.","lines":["Vivo por Cristo, me rindo a Él,","Todos mis miembros pongo a Sus pies;","Hoy por Su gracia, no por la ley,","Venzo el pecado, ¡Cristo es mi Rey!","¡Gloria sea‿a Dios!"]},{"label":"5.","lines":["Creciendo en Cristo, no se verá","Lo vergonzoso de mi pecar;","Llevaré fruto de santidad,","La vida eterna florecerá.","¡Gloria sea‿a Dios!"]}]}