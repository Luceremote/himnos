{"hymn":"S295","parent":"E372","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Nada entre el Salvador y mi alma","subtitle":"Anhelos—De tener comunión con Cristo","syl":{"n1":["Na","i"],"n2":["da‿en","m"],"n3":["tre‿el","t"],"n4":["Sal","i"],"n5":["va","m"],"n6":["dor","t"],"n7":"y","n8":"mi","n9":["al","i"],"n10":["ma,","t"],"n11":["Na","i"],"n12":["da","t"],"n13":"del","n14":["mun","i"],"n15":["do‿en","m"],"n16":["ga","m"],"n18":["ña","m"],"n19":["dor;","t"],"n20":"Ya","n21":["re","i"],"n22":["nun","m"],"n23":["cié‿a","t"],"n24":["vi","i"],"n25":["les","t"],"n27":["pla","i"],"n28":["ce","m"],"n29":["res;","t"],"n30":["Na","i"],"n31":["da‿en","m"],"n32":["tre","t"],"n33":["mi‿al","i"],"n34":["ma","t"],"n35":"y","n36":"mi","n37":["Se","i"],"n38":["ñor.","t"],"n40":["Na","i"],"n41":["da‿en","m"],"n42":["tre‿el","t"],"n43":["Sal","i"],"n44":["va","m"],"n45":["dor","t"],"n46":"y","n47":"mi","n48":["al","i"],"n49":["ma,","t"],"n51":["Pa","i"],"n52":["ra","t"],"n53":"Su","n54":"faz","n55":["ben","i"],"n56":["di","m"],"n57":["ta‿a","m"],"n58":["pre","m"],"n59":["ciar;","t"],"n60":["Na","i"],"n61":["da","t"],"n62":["im","i"],"n63":["pi","m"],"n64":["da","t"],"n66":"Su","n67":["gra","i"],"n68":["cia‿a","m"],"n69":["bun","m"],"n70":["dan","m"],"n71":["te;","t"],"n73":["En","i"],"n74":["tre","t"],"n75":["no","i"],"n76":["so","m"],"n77":["tros,","t"],"n78":["na","i"],"n79":["da","t"],"n80":["ja","i"],"n81":["más.","t"]},"verses":[{"label":"2.","lines":["Nada de los placeres mundanos,","Aunque‿inocentes parezcan ser;","Mi corazón jamás se desvíe;","No‿hay nada más, mi todo es Él."]},{"label":"3.","lines":["Nada de orgullos y pretenciones;","El yo no se ha de‿interponer,","Aunque me cueste tribulaciones,","Estoy resuelto, lo‿escojo‿a Él."]},{"label":"4.","lines":["Nada, ni‿aún las pruebas y luchas,","Ni‿el mundo‿entero‿en oposición;","Negándome, velando‿y orando,","He de triunfar sin separación."]}]}