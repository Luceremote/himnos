{"hymn":"S760","parent":"E923","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Ve a ganar las almas para Dios","subtitle":"Predicar el evangelio—Recoger los materiales","syl":{"n1":"Ve","n2":"a","n3":["ga","i"],"n4":["nar","t"],"n5":"las","n6":["al","i"],"n7":["mas","t"],"n8":["pa","i"],"n9":["ra","t"],"n10":"Dios,","n11":"Trae","n12":["ma","i"],"n13":["te","m"],"n14":["ria","m"],"n15":["les","t"],"n16":["de‿e","i"],"n17":["di","m"],"n18":["fi","m"],"n19":["ca","m"],"n20":["ción,","t"],"n21":["Tra","i"],"n22":["e","t"],"n23":"a","n24":"la","n25":["ca","i"],"n26":["sa‿al","m"],"n27":["mas","t"],"n28":"que‿Él","n29":["cre","i"],"n30":["ó,","t"],"n31":"Las","n32":["al","i"],"n33":["mas","t"],"n34":"que","n35":"el","n36":["pe","i"],"n37":["ca","m"],"n38":["do‿u","m"],"n40":["sur","m"],"n41":["pó.","t"]},"verses":[{"label":"2.","lines":["Ve a ganar las almas para Dios,","Ve a librarlos de este mundo atroz,","De todo engaño y densa oscuridad,","De atracciones que usa Satanás."]},{"label":"3.","lines":["Ve a ganar las almas para Dios,","Tráelas a casa, son para el Señor;","Ve a vencer a Su mortal rival,","Ve coordinando todo en unidad."]},{"label":"4.","lines":["Ve a ganar las almas para Dios,","Ve, como el Cuerpo, proclama al Señor;","Ve, con los fieles y uno sé con Él,","Que el evangelio suene por doquier."]}]}