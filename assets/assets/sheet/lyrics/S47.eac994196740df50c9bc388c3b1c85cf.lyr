{"hymn":"S47","parent":"E58","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Palabra viva eres, Señor","subtitle":"Alabanza al Señor—Su divinidad","syl":{"n1":["Pa","i"],"n2":["la","m"],"n3":["bra","t"],"n4":["vi","i"],"n5":["va‿e","m"],"n6":["res,","t"],"n7":["Se","i"],"n8":["ñor,","t"],"n9":["Des","i"],"n10":["de","t"],"n11":["la‿e","i"],"n12":["ter","m"],"n13":["ni","m"],"n14":["dad;","t"],"n15":"De","n16":"Dios,","n17":"la","n18":["glo","i"],"n19":["ria‿en","t"],"n20":["ple","i"],"n21":["ni","m"],"n22":["tud","t"],"n23":["Mos","i"],"n24":["tras","m"],"n25":["te","t"],"n26":"en","n27":["Tu‿an","i"],"n28":["dar.","t"],"n29":"Te","n30":["a","i"],"n31":["la","m"],"n32":["ba","m"],"n33":["mos,","t"],"n34":"oh","n35":["Se","i"],"n36":["ñor,","t"],"n37":"En","n38":"Ti","n39":["ve","i"],"n41":["mos","t"],"n42":"a","n44":"Dios.","n45":"Su","n47":["glo","i"],"n48":["ria","t"],"n49":"y","n50":["ca","i"],"n51":["rác","m"],"n52":["ter","t"],"n53":"Tú","n54":"Nos","n56":["mues","i"],"n57":["tras,","t"],"n58":"oh","n59":["Se","i"],"n60":["ñor.","t"]},"verses":[{"label":"2.","lines":["La gloria del viviente Dios,","Sus rasgos y poder,","Por medio de la creación","Todo‿hombre puede ver."]},{"label":"3.","lines":["¡Qué rica Tu Palabra es!","Da testimonio fiel","De la realidad de Dios","Que das a conocer."]},{"label":"4.","lines":["Te encarnaste para‿andar","Como‿hombre‿aquí, Señor,","Y Tu conducta nos mostró","La expresión de Dios."]},{"label":"5.","lines":["Palabra viva, eres luz","Y nuestra vida; Tú","Nos iluminas para ver","Al Padre‿en Su virtud."]},{"label":"6.","lines":["El juicio del viviente Dios","Tú ejecutarás;","Esto‿a la vez es la expresión","Que‿a Dios nos mostrará."]},{"label":"7.","lines":["La expresión de Dios, Señor,","Al hombre‿hiciste ver;","Él ya oculto no está,","Lo diste‿a conocer."]}]}