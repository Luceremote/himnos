{"hymn":"SY206","parent":"NS117","quality":"adapted","adjust":{"hold":2,"merge":1},"title":"Dios en Cristo me ha unido a ti","subtitle":"","syl":{"n1":"Dios","n2":"en","n3":["Cris","i"],"n4":["to","t"],"n5":["me‿ha‿u","i"],"n6":["ni","m"],"n7":["do‿a","t"],"n8":"ti","n10":["Pa","i"],"n11":["ra","t"],"n12":"Su","n13":["cuer","i"],"n14":["po‿e","m"],"n15":["di","m"],"n16":["fi","m"],"n17":["car.","t"],"n19":["¡Cris","i"],"n20":["to","t"],"n21":"en","n22":"ti,","n23":["mi‿es","i"],"n24":["pe","m"],"n25":["ran","m"],"n26":["za‿es!","t"],"n29":["Cris","i"],"n30":["to‿en","t"],"n31":"mí,","n32":"tu","n33":["ne","i"],"n34":["ce","m"],"n35":["si","m"],"n36":["dad.","t"],"n38":"Si","n39":["fir","i"],"n40":["me‿en","t"],"n41":["Cris","i"],"n42":["to‿es","m"],"n43":["tás,","t"],"n44":["vi","i"],"n45":["vo","t"],"n46":"yo.","n47":"Si","n48":["fir","i"],"n49":["me‿en","t"],"n50":["Cris","i"],"n51":["to‿es","m"],"n52":["toy,","t"],"n53":["vi","i"],"n54":["ves","t"],"n55":"tú.","n56":["Pro","i"],"n57":["si","m"],"n58":["go","t"],"n59":"yo","n60":"por","n61":["ti,",null,"u"],"n62":0,"n63":["Pro","i"],"n64":["si","m"],"n65":["gues","t"],"n66":"tu","n67":"por","n68":["mí.",null,"u"],"n69":0,"n70":["Jun","i"],"n71":["tos","t"],"n72":"y‿en","n73":["u","i"],"n74":["ni","m"],"n75":["dad","t"],"n76":"¡Con‿los","n77":["san","i"],"n78":["tos","t"],"n79":"yo","n80":["quie","i"],"n81":["ro‿es","m"],"n82":["tar!","t"]},"verses":[{"label":"2.","lines":["¡La iglesia en dulce comunión!","¡Su novia edificada en Él!","Persevero en Dios por ti;","Me anima ver a Cristo en ti."]},{"label":"3.","lines":["Prosigo por tu fe en el Señor;","¡Progreso por causa de ti!","Y rebosa mi corazón,","Orando a Cristo por ti."]},{"label":"4.","lines":["Con los santos hoy busco al Señor,","Es éste el anhelo de Dios.","A los santos me brindaré;","Pues por ti vivo y tú por mí."]},{"label":"5.","lines":["Hermano, te quiero alentar;","Sin ti no sobreviviré,","No menosprecies tu porción.","Cristo y yo precisamos de ti."]}]