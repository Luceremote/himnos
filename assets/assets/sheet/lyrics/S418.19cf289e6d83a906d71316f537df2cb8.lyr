{"hymn":"S418","parent":"E530","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo es todo para mí","subtitle":"Experiencia de Cristo—Como aquel que es el todo","syl":{"n1":["Cris","i"],"n2":["to","t"],"n3":"es","n4":["to","i"],"n5":["do","t"],"n6":["pa","i"],"n7":["ra","t"],"n8":"mí;","n9":"Mi","n10":["vi","i"],"n11":["da‿y","t"],"n12":["go","i"],"n13":["zo‿es","t"],"n14":"Él;","n16":["Dí","i"],"n17":["a","t"],"n18":"por","n19":["dí","i"],"n20":["a‿es","t"],"n21":"mi","n22":["sos","i"],"n23":["tén;","t"],"n24":"Sin","n25":"Él","n26":"he","n27":"de","n29":["ca","i"],"n30":["er.","t"],"n33":"Si","n34":["tris","i"],"n35":["te‿es","m"],"n36":["toy,","t"],"n37":"a","n38":"Él","n39":"yo","n40":"voy;","n41":["So","i"],"n42":["lo‿Él","t"],"n43":["a","i"],"n44":["le","m"],"n45":["gra‿el","t"],"n46":["co","i"],"n47":["ra","m"],"n48":["zón;","t"],"n49":"Si","n50":["tris","i"],"n51":["te‿es","m"],"n52":["toy,","t"],"n53":"con","n54":["go","i"],"n55":["zo","t"],"n56":"voy","n57":"A","n58":["Je","i"],"n59":["sús.","t"]},"verses":[{"label":"2.","lines":["Cristo es todo para mí,","Mi‿amigo‿en el dolor;","Y cada vez que voy a Él,","Me da gran bendición.","Manda la lluvia y el sol;","Madura‿el grano nuestro Dios;","Lluvia y sol manda‿el Señor:","Mi Jesús."]},{"label":"3.","lines":["Cristo es todo para mí,","Y fiel a Él seré;","¿Cómo podré negar a‿Aquel","Que tal amigo es?","Justo‿es seguirlo, bien lo sé;","Cuida de mí a diario Él,","Sigo a‿Aquél que es mi bien;","Mi Jesús."]},{"label":"4.","lines":["Cristo es todo para mí,","No‿hay otro‿amigo‿así;","Confío hoy y confiaré","Cuando me llegue‿el fin.","Bella‿es la vida junto‿a Él,","Bella con tal amigo fiel;","Gozo‿eternal, vida‿eternal:","Mi Jesús."]}]}