{"hymn":"S366","parent":"E482","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"En la cruz estoy con Cristo","subtitle":"Unión con Cristo—Identificados con su muerte y resurrección","syl":{"n1":"En","n2":"la","n3":"cruz","n4":["es","i"],"n5":["toy","t"],"n6":["con‿Cris","i"],"n8":["to,","t"],"n10":"Y","n11":"me","n12":["li","i"],"n14":["ber","m"],"n15":["tó","t"],"n16":"la","n17":"cruz,","n18":"Fui","n19":"con","n20":"El","n21":["re‿su","i"],"n22":["ci","m"],"n23":["ta","m"],"n25":["do,","t"],"n26":["Vi","i"],"n27":["ve","t"],"n28":"en","n30":["mi‿es","i"],"n31":["pí","m"],"n32":["ri","m"],"n33":["tu.","t"],"n35":"¡Oh,","n36":"qué","n37":["dul","i"],"n38":["ce‿es","t"],"n40":["mo","i"],"n41":["rir","t"],"n42":"con","n43":["Cris","i"],"n44":["to!","t"],"n46":["Pa","i"],"n47":["ra‿el","t"],"n48":["mun","i"],"n49":["do,‿el","t"],"n50":"mal","n51":"y‿el","n52":"yo;","n53":"¡Oh,","n54":"qué","n55":["dul","i"],"n56":["ce‿es","t"],"n57":["vi","i"],"n58":["vir","t"],"n59":"con","n60":["Cris","i"],"n62":["to!","t"],"n63":["Mien","i"],"n64":["tras","t"],"n65":["rei","i"],"n67":["na‿en","t"],"n68":["mi‿in","i"],"n69":["te","m"],"n70":["rior.","t"]},"verses":[{"label":"2.","lines":["El misterio de los siglos,","Por la fe se reveló;","La‿esperanza de la gloria:","Cristo‿en mí, proclamo yo."]},{"label":"3.","lines":["El secreto de la siega:","Muerto‿el grano, vida da;","Y el árbol injertado,","Rica vida obtendrá."]},{"label":"4.","lines":["Un secreto tiene‿el santo:","No es la santidad, mas Él;","¡Oh, Señor, ven a vaciarnos,","Y‿a llenarnos con Tu ser!"]},{"label":"5.","lines":["Es un bálsamo‿a la pena,","El morir a nuestro yo,","Y‿encontrar la vida‿eterna,","Que nos suple nuestro Dios."]},{"label":"6.","lines":["Es la‿historia de mi Amo:","Por la cruz al trono fue;","Como Él yendo‿a la gloria,","Por la muerte entraré."]}]}