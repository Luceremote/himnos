{"hymn":"S46","parent":"E57","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Habita en Ti, Señor Jesús","subtitle":"Alabanza al Señor—Su divinidad","syl":{"n1":["Ha","i"],"n3":["bi","m"],"n4":["ta‿en","t"],"n5":"Ti,","n6":["Se","i"],"n7":["ñor","t"],"n8":["Je","i"],"n9":["sús,","t"],"n11":"En","n12":["for","i"],"n13":["ma","t"],"n14":["cor","i"],"n15":["po","m"],"n16":["ral,","t"],"n19":["La‿i","i"],"n20":["ma","m"],"n21":["gen","t"],"n22":"del","n23":["vi","i"],"n24":["vien","m"],"n25":["te","t"],"n26":"Dios","n28":"Y","n29":["to","i"],"n30":["da","t"],"n31":"la","n32":["Dei","i"],"n33":["dad.","t"]},"verses":[{"label":"2.","lines":["Palabra de Dios eres Tú","Con vida divinal;","En Ti Su gracia nuestra es,","También Su realidad."]},{"label":"3.","lines":["Eres el resplandor de Dios,","El Hijo de Su amor;","Y Su substancia divinal","Habita‿en Ti, Señor."]},{"label":"4.","lines":["Tú, la corporificación","De Dios y Su expresión;","En Ti, Señor, nos muestra Dios","Su manifestación."]},{"label":"5.","lines":["Al disfrutar en Ti a Dios,","Su vida y lo demás,","Le damos gracias y loor,","Y te‿apreciamos más."]}]}