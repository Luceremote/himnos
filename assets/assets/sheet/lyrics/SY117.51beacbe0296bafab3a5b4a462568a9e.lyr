{"hymn":"SY117","parent":"NS47","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Me conoció el Padre eras atrás","subtitle":"","syl":{"n1":"Me","n2":["co","i"],"n3":["no","m"],"n4":["ció‿el","t"],"n5":["Pa","i"],"n6":["dre‿e","m"],"n7":["ras","t"],"n8":["a","i"],"n9":["trás,","t"],"n10":"Y","n11":"me","n12":["la","i"],"n13":["vó","t"],"n14":"con","n16":"Su","n17":["san","i"],"n18":["gre‿el","t"],"n19":["Se","i"],"n20":["ñor.","t"],"n21":"Soy","n22":"un","n23":["Dios-","i"],"n24":["hom","m"],"n25":["bre‿en","t"],"n26":"el","n27":["es","i"],"n28":["pí","m"],"n29":["ri","m"],"n30":["tu.","t"],"n31":["¡A","i"],"n33":["le","m"],"n34":["lu","m"],"n36":["ya!","t"],"n37":["¡A","i"],"n38":["le","m"],"n39":["lu","m"],"n40":["ya!","t"],"n41":["¡A","i"],"n42":["le","m"],"n43":["lu","m"],"n46":["ya,","t"],"n49":["a","i"],"n51":["le","m"],"n52":["lu","m"],"n54":["ya,","t"],"n55":["a","i"],"n56":["le","m"],"n57":["lu","m"],"n58":["ya!","t"],"n60":["¡A","i"],"n61":["le","m"],"n62":["lu","m"],"n65":["ya,","t"],"n68":["a","i"],"n70":["le","m"],"n71":["lu","m"],"n73":["ya,","t"],"n74":["a","i"],"n75":["le","m"],"n76":["lu","m"],"n77":["ya!","t"]},"verses":[{"label":"2.","lines":["En Su presciencia el Padre me eligió,","Para Su misericordia mostrar,","Y de Su gloria poder disfrutar.","¡Aleluya! ¡Aleluya!"]},{"label":"3.","lines":["Tú, con Tu sangre preciosa, Jesús,","Me redimiste y salvaste también.","Hoy clamo así por Tu resurrección:","¡Aleluya! ¡Aleluya!"]},{"label":"4.","lines":["Me santifica el Espíritu hoy.","Él me dio fe al yo ciego estar.","Mi vida es, hoy en mi Él está.","¡Aleluya! ¡Aleluya!"]},{"label":"5.","lines":["Eres mi Padre, yo tengo Tu gen,","Ya redimido y comprado estoy.","¡Oh, cuán real es Su Espíritu en mí!","¡Aleluya! ¡Aleluya!"]}]}