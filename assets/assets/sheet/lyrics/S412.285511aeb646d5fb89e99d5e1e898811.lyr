{"hymn":"S412","parent":"E521","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Gracias, Señor, que empiezo a ver","subtitle":"Experiencia de Cristo—Como aquel que es el todo","syl":{"n1":["Gra","i"],"n2":["cias,","t"],"n3":["Se","i"],"n4":["ñor,","t"],"n5":["que‿em","i"],"n6":["pie","m"],"n7":["zo‿a","t"],"n8":"ver","n9":["Es","i"],"n10":["ta","t"],"n11":["re","i"],"n12":["ve","m"],"n13":["la","m"],"n14":["ción:","t"],"n15":"Lo","n16":"que‿a","n17":"los","n18":["Tu","i"],"n19":["yos","t"],"n20":["pue","i"],"n21":["des","t"],"n22":"ser,","n23":"Lo","n24":"que","n25":["pa","i"],"n26":["ra","t"],"n27":"Ti","n28":"son.","n29":"Si","n30":["e","i"],"n31":["llos","t"],"n32":"dan","n33":"a","n34":"Ti","n35":"su","n36":"ser","n37":["Dis","i"],"n38":["pues","m"],"n39":["tos","t"],"n40":["siem","i"],"n41":["pre‿a‿o","m"],"n42":["be","m"],"n43":["de","m"],"n44":["cer.","t"]},"verses":[{"label":"2.","lines":["Maravilloso es descubrir","Que puedo en Ti confiar!","Que eres tanto para mí.","En todo mi andar.","Tú llenas mi necesidad,","Y Tú aplacas todo‿afán."]},{"label":"3.","lines":["Te tomo hoy, mi fiel Guardián,","Me comprometo‿aquí:","Mi alma, causa, andar y obrar.","Yo todo te ofrecí;","Y mi depósito, lo sé,","Contigo‿está guardado bien."]},{"label":"4.","lines":["Te tomo a Ti como la paz","Que llena el corazón;","Tú calmas toda tempestad,","En Ti yo firme estoy.","Como Tu reino aumenta, así","También Tu paz hoy crece en mí."]},{"label":"5.","lines":["Sabiduría para mí,","El más sabio eres Tú;","Lo necio escogiste aquí,","Me trajiste a Tu luz.","Que pueda hablar y obrar por Ti,","Y Tú, hablar y obrar en mí."]},{"label":"6.","lines":["Por ser mi todo, Tú, Señor,","Lo Tuyo es mío hoy;","Yo nada tengo y nada soy,","Mi \"nada\" a Ti te doy.","Tú eres todo para mí,","Mi suficiencia en todo aquí."]}]}