{"hymn":"S811","parent":"E1310","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Su novia anhela el Señor","subtitle":"Esperanza de gloria—Prepararnos para el regreso de Cristo","syl":{"n1":"Su","n2":["no","i"],"n3":["via‿an","m"],"n4":["he","m"],"n5":["la","t"],"n6":"el","n7":["Se","i"],"n8":["ñor","t"],"n9":["Glo","i"],"n10":["rio","m"],"n11":["sa","t"],"n12":"ha","n13":"de","n14":"ser.","n15":"Su","n16":["co","i"],"n17":["ra","m"],"n18":["zón","t"],"n19":["sa","i"],"n20":["tis","m"],"n21":["fa","m"],"n22":["rá","t"],"n23":["Cuan","i"],"n24":["do‿e","m"],"n25":["lla","t"],"n26":["lis","i"],"n27":["ta‿es","m"],"n28":["té.","t"]},"verses":[{"label":"2.","lines":["Por Su Palabra ella es","Santa, tal como Él;","Manchas y arrugas lavará,","Hasta Su novia ser."]},{"label":"3.","lines":["Los días hay que redimir,","Y la Palabra orar","Comiéndola, diciendo \"Amén\";","Listos así hay que estar."]},{"label":"4.","lines":["Cortante la Palabra es;","Sí, puede dividir","El alma del espíritu,","Y todo discernir."]},{"label":"5.","lines":["Gracias por Tu Palabra fiel","Tan viva y eficaz;","Por ella hemos de vivir,","Hasta mirar Tu faz."]},{"label":"6.","lines":["Los que te traigan, haznos hoy:","Tu complemento aquí.","Por Tu Palabra, oh Señor,","Danos aún más de Ti."]}]}