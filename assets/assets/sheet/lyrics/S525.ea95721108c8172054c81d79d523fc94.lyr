{"hymn":"S525","parent":"E640","quality":"adapted","adjust":{"hold":1,"merge":2},"title":"De muerte, ¡vida! ¿Para cuándo es esto","subtitle":"La vida de resurrección—La vida que surge de la muerte","syl":{"n1":"De","n2":["mu","i"],"n3":["er","m"],"n4":["te,","t"],"n5":["¡vi","i"],"n6":["da!","t","u"],"n7":0,"n8":["¿Pa","i"],"n9":["ra","t"],"n10":["cu","i"],"n11":["án","m"],"n12":["do","t"],"n13":"es","n14":["es","i"],"n15":["to?","t"],"n16":"¿Es","n17":["pa","i"],"n18":["ra‿a","m"],"n19":["ho‿ra,‿o‿el","t"],"n20":["más‿a","i"],"n21":["llá?","t"],"n22":"¿Por","n23":["qué‿es","i"],"n24":["pe","m"],"n25":["rar?","t"],"n26":"El","n27":["va","i"],"n28":["so","t"],"n29":["que","i"],"n30":["bran","m"],"n31":["ta","m"],"n32":["do","t"],"n33":"El","n34":["Al","i"],"n35":["fa","m"],"n36":["re","m"],"n37":["ro","t"],"n38":["pue","i"],"n39":["de‿hoy","t"],"n40":["mol","i"],"n41":["de","m"],"n42":["ar.","t"]},"verses":[{"label":"2.","lines":["De muerte, ¡vida! ¡Qué resurrección es!","El grano muerto dando su poder;","Tu vida en mí vivida en aflicciones,","No yo, mas vive Cristo en mi ser."]},{"label":"3.","lines":["De muerte, ¡vida! Senda solitaria","De los que se glorían en la cruz.","Viven con Cristo en comunión tan dulce","Dejando todo sólo por Jesús."]},{"label":"4.","lines":["De muerte, ¡vida! ¡Qué misión bendita!","El agua viva a todos llevar;","Vida abundante de ese río puro,","Para el que quiera su sed apagar."]}]}