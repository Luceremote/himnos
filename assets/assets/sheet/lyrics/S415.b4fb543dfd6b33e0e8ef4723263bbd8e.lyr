{"hymn":"S415","parent":"E525","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Fuente de mis días, Tú","subtitle":"Experiencia de Cristo—Como aquel que es el todo","syl":{"n1":["Fuen","i"],"n2":["te","t"],"n3":"de","n5":"mis","n6":["dí","i"],"n7":["as,","t"],"n8":"Tú,","n9":["Go","i"],"n10":["zo","t"],"n11":"de","n13":"mi","n14":["co","i"],"n15":["ra","m"],"n16":["zón,","t"],"n17":["E","i"],"n19":["res","t"],"n20":["res","i"],"n21":["plan","m"],"n22":["dor","t"],"n23":"de","n24":"luz,","n25":"Mi","n26":["re","i"],"n27":["fu","m"],"n28":["gio‿en","t"],"n29":["no","i"],"n30":["che‿a","m"],"n31":["tróz;","t"],"n32":"Al","n33":["mi","i"],"n34":["rar","m"],"n36":["te,","t"],"n37":"Tú","n38":"me","n39":"das","n40":["Es","i"],"n42":["pe","m"],"n43":["ran","m"],"n45":["za‿y","t"],"n46":["cla","i"],"n47":["ri","m"],"n48":["dad.","t"]},"verses":[{"label":"2.","lines":["Arduos años yo pasé","Antes de hallar Tu faz,","Con temores por doquier,","Desaliento‿y soledad;","La tormenta arreció","Hasta que llegó‿el Señor."]},{"label":"3.","lines":["Tu presencia sobre‿el mar","Disipó la tempestad;","Vino la tranquilidad,","Reposé al ver Tu faz;","Y mi terca voluntad","Te‿escuchó decir: \"Ten paz\"."]},{"label":"4.","lines":["Uno soy contigo ya:","Corazón y voluntad;","¡Qué tranquilo‿el cielo está!","¡Tierra firme‿hallamos ya!","Pues me dijo Tu amor:","¡Ya no‿hay noche ni turbión!"]}]}