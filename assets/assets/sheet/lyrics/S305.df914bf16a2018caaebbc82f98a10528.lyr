{"hymn":"S305","parent":"E389","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, que en Tu presencia yo viva, Señor","subtitle":"Anhelos—De vivir en la presencia del Señor","syl":{"n1":"¡Oh,","n2":"que‿en","n3":"Tu","n4":["pre","i"],"n6":["sen","m"],"n7":["cia","t"],"n8":"yo","n9":["vi","i"],"n10":["va,","t"],"n11":["Se","i"],"n12":["ñor!","t"],"n13":"Del","n14":["al","i"],"n15":["ba‿al","t"],"n16":["o","i"],"n17":["ca","m"],"n18":["so","t"],"n19":"mi","n20":["mun","i"],"n21":["do‿e","m"],"n22":["res","t"],"n23":"Tú;","n24":"No","n25":["de","i"],"n26":["jes","t"],"n27":["con","i"],"n29":["ten","m"],"n30":["to","t"],"n31":"a","n32":"mi","n33":["co","i"],"n34":["ra","m"],"n35":["zón","t"],"n36":["Cuan","i"],"n37":["do","t"],"n38":["bus","i"],"n39":["que","t"],"n40":["al","i"],"n41":["go","t"],"n42":"que","n43":"no","n44":["se","i"],"n45":["as","t"],"n46":"Tú.","n48":"A","n49":["dia","i"],"n50":["rio","t"],"n51":"en","n52":["to","i"],"n53":["do","t"],"n54":["su","i"],"n55":["frir","t"],"n56":"y","n57":["pe","i"],"n58":["sar,","t"],"n60":"Si","n61":["na","i"],"n62":["da‿en","t"],"n63":"el","n64":["mun","i"],"n65":["do","t"],"n66":["con","i"],"n68":["sue","m"],"n70":["lo","t"],"n71":"me","n73":"da,","n74":["Es","i"],"n75":["tan","m"],"n76":["do","t"],"n78":["gi","i"],"n79":["mien","m"],"n80":["do","t"],"n81":"con","n82":["llan","i"],"n83":["to‿y","t"],"n84":["do","i"],"n85":["lor,","t"],"n86":["Se","i"],"n87":["ñor,","t"],"n88":["cal","i"],"n89":["ma‿el","t"],"n90":["llan","i"],"n91":["to,","t"],"n92":["a","i"],"n93":["li","m"],"n94":["via‿el","t"],"n95":["pe","i"],"n96":["sar.","t"]},"verses":[{"label":"2.","lines":["En cuanto yo piense en mi bienestar,","Te pido que‿en él estés Tú, oh Señor;","No dejes que escoja yo solo sin Ti,","Ni busque placeres fuera de Ti yo.","Si solo‿acostado‿en silencio yo‿estoy,","Te ruego, Señor, que te‿acerques a mí;","Y antes del alba, durmiendo aún","Susurra‿en mi oído, llamándome‿así."]},{"label":"3.","lines":["En cuanto yo abra Tu libro, Señor,","Que Tu gloria en cada línea pueda ver,","Que vea en claro a mi Salvador,","Y qué salvación me has hecho obtener.","Si débil me acercó a Tu trono, Señor,","Me oigas te pido y Tu gracia me des;","Si por mis defectos no escuchas mi orar,","No escondas Tu rostro, ni alejes Tu ser."]},{"label":"4.","lines":["En cuanto medite en Tu bendición,","Que anhele muy pronto contigo estar;","Que espere orando que vuelvas, Señor,","Pues en Tu presencia mi gozo será.","Enséñame a diario contigo a vivir,","Del alba al ocaso andar en Tu luz;","No dejes contento a mi corazón","Cuando busque algo que no seas Tú."]}]}