{"hymn":"S380","parent":"E494","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo en el testimonio real","subtitle":"Experiencia de Cristo—Como testimonio de Dios","syl":{"n1":["Cris","i"],"n2":["to‿en","t"],"n3":"el","n4":["tes","i"],"n5":["ti","m"],"n7":["mo","m"],"n8":["nio","t"],"n10":"real","n11":"De","n12":"Dios","n13":"en","n14":["vi","i"],"n15":["da‿y","t"],"n16":["pro","i"],"n17":["ce","m"],"n18":["der;","t"],"n19":"La","n20":["glo","i"],"n21":["ria","t"],"n22":"de","n24":"Dios","n26":"Él","n28":["mos","i"],"n30":["tró","t"],"n31":"En","n32":"Su","n33":["e","i"],"n34":["sen","m"],"n35":["cia","t"],"n36":"y‿en","n37":"Su","n38":"ser."},"verses":[{"label":"2.","lines":["Su testimonio es mejor","Que‿el testimonio de la ley,","Que sólo muestra‿en letra‿a Dios,","Mas no‿el poder viviente de‿Él."]},{"label":"3.","lines":["La plenitud de la Deidad","Mora en Él, Su‿habitación;","Su residencia‿y vaso es;","Coorporifica‿al mismo Dios."]},{"label":"4.","lines":["El manifiesta‿al Padre Dios,","Muestra los rasgos de Su ser;","Perfectamente‿en Él se ve","Su corazón y proceder."]},{"label":"5.","lines":["Cristo como‿el Espíritu","Siempre será nuestra porción;","Tomamos en espíritu","Todo su ser en comunión."]}]}