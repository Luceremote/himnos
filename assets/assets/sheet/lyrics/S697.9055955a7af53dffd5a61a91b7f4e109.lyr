{"hymn":"S697","parent":"E1246","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Vamos siguiendo a las iglesias","subtitle":"La iglesia—Seguir a otros","syl":{"n1":["Va","i"],"n2":["mos","t"],"n3":["si","i"],"n4":["guien","m"],"n5":["do","t"],"n6":"a","n7":"las","n8":["i","i"],"n9":["gle","m"],"n10":["sias","t"],"n11":["Guar","i"],"n12":["dan","m"],"n13":["do","t"],"n14":["la‿u","i"],"n15":["ni","m"],"n16":["dad;","t"],"n17":"En","n18":"Su","n19":["mo","i"],"n20":["ver","t"],"n21":"hoy","n22":"en","n23":"las","n24":["i","i"],"n25":["gle","m"],"n26":["sias","t"],"n27":"En","n28":"Su","n29":["ca","i"],"n30":["mi","m"],"n31":["no‿an","m"],"n32":["dad.","t"],"n33":"Al","n34":["Es","i"],"n35":["pí","m"],"n36":["ri","m"],"n37":["tu","t"],"n38":["si","i"],"n39":["gue,","t"],"n40":"Tú,","n41":"en","n42":["sim","i"],"n43":["pli","m"],"n44":["ci","m"],"n45":["dad;","t"],"n47":["Nues","i"],"n48":["tro‿es","m"],"n49":["pí","m"],"n50":["ri","m"],"n51":["tu","t"],"n52":["tie","i"],"n53":["ne","t"],"n54":"A","n55":["Cris","i"],"n56":["to","t"],"n57":"en","n58":["ver","i"],"n59":["dad.","t"]},"verses":[{"label":"2.","lines":["Vamos siguiendo a los que siguen","Para hoy aprender;","No codiciando el liderato,","Mas descansando en Él."]},{"label":"3.","lines":["Vamos siguiendo a Su rebaño,","Bajo el buen Pastor;","En las iglesias Él nos dirige,","Aquí nos habla Dios."]},{"label":"4.","lines":["A Ti nos damos, oh Jesucristo,","Nunca mirando atrás;","Siempre siguiendo fiel al Cordero","Por dondequiera va."]},{"label":"5.","lines":["Nos damos para entrar en el reino,","Fiesta matrimonial;","Persecuciones, penas y pruebas","Nunca nos detendrán."]},{"label":"6.","lines":["Cristo anhela ver seguidores","En las iglesias hoy","Que cumplan Su propósito, fieles;","¡Haznos así, Señor!"]}]}