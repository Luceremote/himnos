{"hymn":"S300","parent":"E380","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh, Pan de peregrinos","subtitle":"Anhelos—De alimentarnos de Cristo","syl":{"n1":"Oh,","n2":"Pan","n3":"de","n4":["pe","i"],"n5":["re","m"],"n6":["gri","m"],"n7":["nos,","t"],"n8":"Oh,","n9":["Ce","i"],"n10":["les","m"],"n11":["tial","t"],"n12":["Ma","i"],"n13":["ná;","t"],"n15":["Pa","i"],"n17":["ra","t"],"n18":"los","n19":["re-","i"],"n20":["na","m"],"n21":["ci","m"],"n22":["dos:","t"],"n23":["Co","i"],"n24":["mi","m"],"n25":["da","t"],"n26":["di","i"],"n27":["vi","m"],"n29":["nal.","t"],"n31":["Co","i"],"n32":["me","m"],"n33":["mos","t"],"n34":"Tus","n35":["ri","i"],"n37":["que","m"],"n38":["zas;","t"],"n39":"Nos","n40":["lle","i"],"n41":["nas","t"],"n42":"en","n43":["ver","i"],"n45":["dad;","t"],"n47":"El","n49":["mun","i"],"n50":["do","t"],"n51":"ya","n52":["no‿a","i"],"n53":["tra","m"],"n54":["e;","t"],"n55":"Tu","n56":"ser","n57":"nos","n58":["sa","i"],"n59":["cia","m"],"n61":["rá.","t"]},"verses":[{"label":"2.","lines":["Oh, Agua, que trae vida","Del corazón de Dios;","Señor, eres la fuente","Que fluye con amor.","Probamos libremente,","Saciando nuestra sed,","De Tu dulzura‿eterna","Que fresca siempre es."]},{"label":"3.","lines":["Gozamos tal banquete","Sin verte‿aquí, Señor,","Creyendo‿en Tu Palabra","Sin dudas ni temor.","Oh, que aquí vivamos","En Ti, Amado fiel,","Hasta quitarse‿el velo","Y‿al fin Tu rostro ver."]}]}