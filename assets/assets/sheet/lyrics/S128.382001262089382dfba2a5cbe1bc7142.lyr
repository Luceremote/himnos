{"hymn":"S128","parent":"E160","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Rey de mi vida, mi Señor","subtitle":"Alabanza al Señor—Su amor","syl":{"n1":"Rey","n2":"de","n3":"mi","n4":["vi","i"],"n5":["da,","t"],"n6":"mi","n7":["Se","i"],"n8":["ñor,","t"],"n9":"Yo","n10":"te","n11":["co","i"],"n12":["ro","m"],"n13":["no","t"],"n14":"hoy;","n16":"Que","n17":["nun","i"],"n18":["ca‿ol","m"],"n19":["vi","m"],"n20":["de","t"],"n21":"Tu","n22":["vir","i"],"n23":["tud,","t"],"n24":["Guí","i"],"n25":["a","m"],"n26":["me","t"],"n27":"a","n28":"tu","n29":"cruz.","n31":"Que","n32":["nun","i"],"n33":["ca‿ol","m"],"n34":["vi","m"],"n35":["de","t"],"n36":"tu","n37":["su","i"],"n38":["frir,","t"],"n39":"Ni","n40":["Tu‿a","i"],"n41":["go","m"],"n42":["ní","m"],"n43":["a","t"],"n44":"al","n45":["mo","i"],"n46":["rir,","t"],"n47":"Ni","n48":["Tu‿in","i"],"n49":["fi","m"],"n50":["ni","m"],"n51":["to‿a","m"],"n52":["mor","t"],"n53":"por","n54":"mi,","n55":["Guí","i"],"n56":["a","m"],"n57":["me","t"],"n58":"a","n59":"tu","n60":"cruz."},"verses":[{"label":"2.","lines":["Donde yaciste, muéstrame,","Donde se te lloró,","Do vigilaron ángeles,","Do mi Señor durmió."]},{"label":"3.","lines":["Que, cuál María, traiga un don,","Aunque en lobreguez;","La tumba‿abierta muéstrame,","Guíame a Tu cruz."]},{"label":"4.","lines":["Por Ti mi cruz deseo llevar","A diario, mi Señor;","La copa‿amarga aun tomar,","Siguiéndote‿en amor."]},{"label":"5.","lines":["Con Tu deseo lléname","Para llevar Tu luz;","Purga mis labios para‿hablar","A todos de Tu cruz."]}]}