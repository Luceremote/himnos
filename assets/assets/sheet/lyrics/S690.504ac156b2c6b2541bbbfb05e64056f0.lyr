{"hymn":"S690","parent":"E1235","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Escucha al errante que","subtitle":"La iglesia—Como nuestro hogar y descanso","syl":{"n1":["Es","i"],"n2":["cu","m"],"n3":["cha","t"],"n4":"al","n5":["e","i"],"n6":["rran","m"],"n7":["te","t"],"n8":"que","n9":["Ca","i"],"n10":["ren","m"],"n11":["te","t"],"n12":["se‿en","i"],"n13":["con","m"],"n14":["tró;","t"],"n16":"Y","n17":["pon","i"],"n18":["le‿o","m"],"n19":["í","m"],"n20":["do‿a","t"],"n21":"su","n22":["can","i"],"n23":["ción","t"],"n24":"Sus","n25":["hue","i"],"n26":["lla","t"],"n27":["si","i"],"n28":["gue","t"],"n29":"hoy.","n32":["¡Glo","i"],"n33":["ria‿a","t"],"n34":"Dios!","n36":["¡Glo","i"],"n37":["ria‿a","t"],"n38":"Dios!","n40":["¡Glo","i"],"n41":["ria","t"],"n42":"a","n44":"Dios!","n45":["¡A","i"],"n46":["le","m"],"n47":["lu","m"],"n48":["ya,‿a","m"],"n49":["le","m"],"n50":["lu","m"],"n51":["ya!","t"],"n52":["¡Glo","i"],"n53":["ria‿a","t"],"n54":"Dios!","n56":["¡Glo","i"],"n57":["ria‿a","t"],"n58":"Dios!","n60":"¡El","n61":["mis","i"],"n62":["mo","t"],"n63":"no","n64":["se","i"],"n65":["ré!","t"]},"verses":[{"label":"2.","lines":["Busca el errante el placer","Que este mundo da;","Mas si lo halla ha de saber","Que es pura vanidad."]},{"label":"3.","lines":["Muchos castillos levanté","Para mi ego yo;","Mas, gloria á Dios, Él los tumbó","Y lo mejor me dio."]},{"label":"4.","lines":["Confuso y solo estaba yo,","Mucha vergüenza hallé;","Mas hoy en la iglesia local","El mismo no seré."]},{"label":"5.","lines":["¡Hoy soy un miembro tan feliz","En la iglesia local!","Aquel errante que encontró","Descanso y dulce hogar."]},{"label":"6.","lines":["Un individualista fui,","Como una isla yo;","Mas con los santos en Su amor","Me edifica Dios."]},{"label":"7.","lines":["Siento una grande atracción","A estar en comunión;","He aprendido a recibir","De Cristo en la reunión."]},{"label":"8.","lines":["Ya he cesado de vagar","¡La iglesia yo encontré!","Muy grande es mi felicidad","¡En Dios descansó hallé!"]}]}