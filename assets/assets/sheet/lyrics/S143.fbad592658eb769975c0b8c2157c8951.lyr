{"hymn":"S143","parent":"E183","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Con canto alegre hoy venid","subtitle":"Alabanza al Señor—Su dignidad","syl":{"n1":"Con","n2":["can","i"],"n3":["to‿a","m"],"n4":["le","m"],"n5":["gre","t"],"n6":"hoy","n7":["ve","i"],"n8":["nid","t"],"n9":"Al","n10":["tro","i"],"n11":["no","t"],"n13":["ce","i"],"n14":["les","m"],"n15":["tial;","t"],"n16":["Mi","i"],"n17":["les","t"],"n19":"de","n21":["vo","i"],"n22":["ces,","t"],"n24":["en","i"],"n25":["to","m"],"n26":["nad","t"],"n27":"El","n28":["te","i"],"n29":["ma","t"],"n31":["sin","i"],"n32":["gu","m"],"n33":["lar.","t"]},"verses":[{"label":"2.","lines":["¡Digno‿el Cordero que‿ascendió","Para‿exaltado ser!","¡Digno‿el Cordero que murió!","Sufrió por nuestro bien."]},{"label":"3.","lines":["Jesús es deigno de‿aceptar","Gloria, poder y honor;","Por siempre se le cantará","Con toda bendición."]},{"label":"4.","lines":["Los santos pronto,‿en ascención,","Un himno cantarán;","Y los que en la tierra estén","Tu gloria‿anunciarán."]},{"label":"5.","lines":["La redimida creación","Adora‿el nombre fiel","De‿Aquel que en el trono está,","Y‿al Cordero también."]}]}