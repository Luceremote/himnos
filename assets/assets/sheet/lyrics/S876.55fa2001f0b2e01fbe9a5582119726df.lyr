{"hymn":"S876","parent":"E1054","quality":"exact","adjust":{"hold":0,"merge":0},"title":"No pases de mí, oh Cristo","subtitle":"El evangelio—Clamar al Señor","syl":{"n1":"No","n2":["pa","i"],"n3":["ses","t"],"n4":"de","n5":"mí,","n6":"oh","n7":["Cris","i"],"n8":["to,","t"],"n9":["Tier","i"],"n10":["no","t"],"n11":["Sal","i"],"n12":["va","m"],"n13":["dor;","t"],"n15":["Mien","i"],"n16":["tras","t"],"n17":"hoy","n18":"a","n19":["o","i"],"n20":["tros","t"],"n21":["lla","i"],"n22":["mas,","t"],"n23":["O","i"],"n24":["ye","t"],"n25":"mi","n26":["cla","i"],"n27":["mor.","t"],"n29":["Je","i"],"n30":["su","m"],"n31":["cris","m"],"n33":["to,","t"],"n34":["Cla","i"],"n35":["mo","t"],"n36":"hoy","n37":"a","n38":"Ti;","n40":["Mien","i"],"n41":["tras","t"],"n42":"hoy","n43":"a","n44":["o","i"],"n45":["tros","t"],"n46":["lla","i"],"n47":["mas,","t"],"n48":"No","n49":["pa","i"],"n50":["ses","t"],"n51":"de","n52":"mí."},"verses":[{"label":"2.","lines":["Que en el trono de Tu gracia","Halle dulce paz;","Que, al postrarme, Tú me ayudes","Mi incredulidad."]},{"label":"3.","lines":["En Tu mérito confiando,","Buscaré Tu faz;","Vengo herido, mas Tu gracia","Me puede salvar."]},{"label":"4.","lines":["Tú, mi fuente de consuelo,","Eres vida en mí;","¿A quién tengo en cielo o tierra","Sino solo a Ti?"]}]}