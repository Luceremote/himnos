{"hymn":"S120","parent":"E147","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, Dios te ha ungido","subtitle":"Alabanza al Señor—Su reino","syl":{"n2":["Se","i"],"n3":["ñor,","t"],"n4":"Dios","n5":"te","n6":["ha‿un","i"],"n7":["gi","m"],"n9":["do;","t"],"n10":"De","n11":["re","i"],"n12":["yes,","t"],"n13":["Tú‿e","i"],"n15":["res","t"],"n16":"Rey.","n18":["La‿a","i"],"n19":["do","m"],"n20":["ra","m"],"n21":["ción","t"],"n23":"que","n24":["da","i"],"n25":["mos","t"],"n26":"Es","n28":["can","i"],"n29":["to","t"],"n30":"de","n32":"Tu","n33":"grey.","n35":"Tu","n37":["rei","i"],"n38":["no‿es","t"],"n39":["pa","i"],"n40":["ra","t"],"n41":["siem","i"],"n42":["pre;","t"],"n43":"Tu","n45":["tro","i"],"n46":["no,","t"],"n47":["fir","i"],"n48":["me","t"],"n49":"es.","n51":"Tu","n52":["rei","i"],"n53":["no‿y","t"],"n54":"su","n56":["jus","i"],"n57":["ti","m"],"n58":["cia,","t"],"n59":"Con","n61":["gra","i"],"n62":["cia‿y","t"],"n63":["glo","i"],"n65":["ria","t"],"n66":"es."},"verses":[{"label":"2.","lines":["En Sion, el monte santo,","Ya Dios te‿estableció,","Y todas las naciones","A Ti Dios las legó.","A Ti Dios ha entregado","Total autoridad","Para regir los pueblos","Por la eternidad."]},{"label":"3.","lines":["Señor, antes que vuelvas,","Hay densa oscuridad;","Diez mil voces a diario","Te‿aclaman con lealtad.","De costa‿a costa‿un pueblo","Te sirve y te‿es fiel;","¡Te aman y te adoran!","¡Tú, su amado Rey!"]},{"label":"4.","lines":["Cuando se cumpla el tiempo,","Con esplendor vendrás;","La tierra y las naciones","Tu reino formarán.","En majestad y gloria,","Oh Rey, te servirán;","Las tribus y los pueblos","Loores te darán."]}]}