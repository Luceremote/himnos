{"hymn":"S322","parent":"E423","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tú, insondable amor de Dios","subtitle":"Anhelos—De obtener reposo","syl":{"n1":"Tú,","n2":["in","i"],"n3":["son","m"],"n4":["da","m"],"n6":["ble‿a","m"],"n7":["mor","t"],"n9":"de","n10":"Dios,","n11":["Ex","i"],"n12":["ce","m"],"n13":["des","t"],"n14":["to","i"],"n15":["da","t"],"n16":["com","i"],"n18":["pren","m"],"n19":["sión;","t"],"n20":["Cuan","i"],"n21":["do‿a","t"],"n22":"lo","n23":["le","i"],"n25":["jos","t"],"n26":"veo","n28":"Tu","n29":"luz,","n30":"Por","n31":"Tu","n32":["re","i"],"n33":["po","m"],"n34":["so","t"],"n35":["gi","i"],"n37":["mo","t"],"n38":"hoy;","n39":["Su","i"],"n40":["fre","t"],"n41":["do","i"],"n42":["lor","t"],"n43":"mi","n44":["co","i"],"n45":["ra","m"],"n46":["zón","t"],"n47":["Has","i"],"n48":["ta","t"],"n49":"que‿en","n50":"Ti","n51":["re","i"],"n52":["po","m"],"n53":["se","t"],"n54":"yo."},"verses":[{"label":"2.","lines":["Me‿invita Tu‿apacible voz,","Tu dulce yugo‿a conllevar;","Quisiera tal, más tengo aún","Pasiones que me‿hacen vagar;","Aunque mi meta‿eres, Señor,","Me‿enfoco‿en Ti, más lejos voy."]},{"label":"3.","lines":["Por Tu bondad yo pude ver","Que sólo‿en Ti descanso hay;","Si no te‿encuentro‿en mi buscar,","Mi alma‿errante no‿halla paz;","Oh, ¿cuándo‿acabará el vagar?","Solo‿hacia Ti yo quiero‿andar."]},{"label":"4.","lines":["¿Acaso‿hay algo bajo‿el sol","Que por mí sea‿a Ti rival?","Quítalo ya, sé mi Señor;","En mi sentir debes reinar;","Cuando reposo‿encuentre‿en Ti,","Seré del mundo libre‿al fin."]},{"label":"5.","lines":["De mi mirada‿esconde‿el yo,","No viva yo, más Cristo‿en mí;","Por a morir mi‿afecto vil,","Todo pecado haz morir;","Que‿en todo nada vea‿aquí,","Ni busque nada, sólo‿a Ti."]},{"label":"6.","lines":["Sálvame del mundano‿afán","Y de mi terquedad, Señor;","Caza‿en mi ser la rebelión,","Llega‿hasta‿el último rincón.","Hijo‿obediente hazme‿aquí,","Que clame \"Abba, Padre\"‿a Ti."]},{"label":"7.","lines":["Aleja‿el mundo hoy de mí","Al atraer mi corazón;","Habla‿a mi alma‿y dile así:","\"Yo soy tu todo, soy tu Dios\".","Oír Tu voz, gustar Tu‿amor,","Sean por siempre mi‿elección."]}]}