{"hymn":"S235","parent":"E295","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo el Señor, justicia es","subtitle":"La certeza y el gozo de la salvación—Amados por el Señor","syl":{"n1":["Cris","i"],"n2":["to‿el","t"],"n3":["Se","i"],"n4":["ñor,","t"],"n5":["jus","i"],"n6":["ti","m"],"n8":["cia","t"],"n9":"es;","n10":"Mi","n11":["be","i"],"n12":["lla","t"],"n13":["ves","i"],"n14":["ti","m"],"n15":["du","m"],"n18":["ra‿es","t"],"n19":"Él;","n20":["Aun","i"],"n21":["que","t"],"n22":"el","n23":["mun","i"],"n25":["do‿ar","m"],"n26":["dien","m"],"n27":["do‿es","m"],"n28":["té,","t"],"n30":"Mi","n31":["ros","i"],"n32":["tro‿a","m"],"n33":["le","m"],"n35":["gre","t"],"n36":["al","i"],"n38":["za","m"],"n39":["ré.","t"]},"verses":[{"label":"2.","lines":["Creo‿en Tu sangre eficaz;","En el propiciatorio‿está;","Habla‿en virtud del pecador;","Por mí, por mi‿alma, se vertió."]},{"label":"3.","lines":["Los pecadores, ¿cuántos son?","Más que la‿arena de la mar;","El gran rescate se pagó,","Lograste‿así su redención."]},{"label":"4.","lines":["Confiado‿y firme puedo‿estar,","Nadie me puede condenar;","Pues yo por Ti absuelto‿estoy,","De culpas, penas y temor."]},{"label":"5.","lines":["Tal vestidura se verá","Resplandeciente‿y singular;","Su gloria nunca cambiará,","Es nueva por la‿eternidad."]},{"label":"6.","lines":["Oh, Dios de‿amor, Dios de poder,","Prueben los santos Tu merced;","Nuestro vestido‿y nuestro‿honor,","Nuestra justicia: Tú, Señor."]}]}