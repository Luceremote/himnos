{"hymn":"S745","parent":"E904","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tenemos un glorioso Rey","subtitle":"El servicio—Al morar con el Señor","syl":{"n1":["Te","i"],"n2":["ne","m"],"n3":["mos","t"],"n4":"un","n5":["glo","i"],"n6":["rio","m"],"n7":["so","t"],"n8":"Rey,","n9":"Su","n10":["tro","i"],"n11":["nó‿en","t"],"n12":"los","n13":["cie","i"],"n14":["los","t"],"n15":["es","i"],"n16":["tá;","t"],"n17":"Los","n18":["mun","i"],"n19":["dos","t"],"n20":"son","n21":["to","i"],"n22":["dos","t"],"n23":"de","n24":"Él,","n25":"Los","n26":["rei","i"],"n27":["nos,","t"],"n28":"Su","n29":["ce","i"],"n30":["tro","t"],"n31":["ve","i"],"n32":["rán.","t"],"n33":"Él","n34":["mo","i"],"n35":["ra","t"],"n36":"con","n37":"Su","n38":["pue","i"],"n39":["blo‿a","m"],"n40":["quí,","t"],"n41":"En","n42":["prue","i"],"n43":["bas","t"],"n44":["so","i"],"n45":["co","m"],"n46":["rro","t"],"n47":"les","n48":"da;","n49":"Por","n50":["Su‿o","i"],"n51":["bra","t"],"n52":["mo","i"],"n53":["ra","m"],"n54":["mos","t"],"n55":"con","n56":"Él,","n57":"Su","n58":["car","i"],"n59":["ga","t"],"n60":"nos","n61":["gus","i"],"n62":["ta","t"],"n63":["lle","i"],"n64":["var.","t"]},"verses":[{"label":"2.","lines":["Yo moro con mi Rey Jesús;","Junto con los Suyos está;","Abriéndole mí corazón,","Su templo y Su trono será.","Así cual María a Sus pies,","Me inclino en Su pecho cual Juan;","¡Qué gozo Su presencia trae!","Su seno es descanso eternal."]},{"label":"3.","lines":["Por Su obra yo moro con El;","Comparto en Su glorioso plan,","Su reino a la tierra traer","Y Su salvación proclamar.","El mundo con Su galardón","Por pérdida lo he de contar;","Su obra es mi único afán,","Su cruz mi mensaje total."]},{"label":"4.","lines":["Por Su obra yo moro con Él,","Es Suya y mía no es;","La traza y prepara por mí,","Llenándome con Su poder.","En gozo se cambia el deber,","Se hace alabanza el orar;","Por Su obra yo moro con Él","Obrando en la fuerza del Rey."]},{"label":"5.","lines":["Por Su obra moramos con Él","Y obramos con Èl sin cesar;","Muy pronto vendrá nuestro Rey,","En gloria se aparecerá.","Y así en más íntima unión","La obra más noble será;","Moraremos con nuestro Rey","Por Su obra en un gozo eternal."]}]}