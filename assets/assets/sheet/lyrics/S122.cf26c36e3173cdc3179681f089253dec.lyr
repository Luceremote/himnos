{"hymn":"S122","parent":"E149","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Diez mil voces celestiales","subtitle":"Alabanza al Señor—Su reino","syl":{"n1":"Diez","n2":"mil","n3":["vo","i"],"n4":["ces","t"],"n5":["ce","i"],"n6":["les","m"],"n7":["tia","m"],"n8":["les,","t"],"n9":["Se‿o","i"],"n10":["yen","t"],"n11":["to","i"],"n12":["das","t"],"n13":["a‿u","i"],"n14":["na","t"],"n15":"voz;","n17":["Cris","i"],"n18":["to","t"],"n19":["rei","i"],"n20":["na,‿el","t"],"n21":["cie","i"],"n22":["lo","t"],"n23":["can","i"],"n24":["ta:","t"],"n25":["\"Cris","i"],"n26":["to","t"],"n27":["rei","i"],"n28":["na,‿el","t"],"n29":"Dios","n30":["de‿a","i"],"n31":["mor\".","t"],"n34":"Ved,","n35":["Je","i"],"n36":["sús","t"],"n37":["es","i"],"n38":["tá‿en","t"],"n39":["el‿tro","i"],"n41":["no","t"],"n42":["Y‿go","i"],"n43":["bier","m"],"n44":["na‿al","t"],"n45":["mun","i"],"n46":["do‿Él","t"],"n47":["so","i"],"n48":["lo.","t"],"n50":["A","i"],"n51":["le","m"],"n52":["lu","m"],"n53":["ya,","t"],"n54":["a","i"],"n55":["le","m"],"n56":["lu","m"],"n57":["ya,","t"],"n58":["A","i"],"n59":["le","m"],"n60":["lu","m"],"n61":["ya,","t"],"n62":["a","i"],"n63":["mén.","t"]},"verses":[{"label":"2.","lines":["Canta, que‿Él bajó del cielo","Y cargó aquí la cruz;","Recibió poder de lo‿alto","Y reina‿en gloriosa luz.","Es un tema‿inagotable:","Dulce nombre‿incomparable."]},{"label":"3.","lines":["Ven Jesús, ven con Tu gloria","Que da‿al cielo su valor.","Tu sonrisa nos alumbra,","Nos da ánimo, Señor.","Cuando en Tu‿amor pensamos,","¡Tan divino!, te‿alabamos."]},{"label":"4.","lines":["Rey de gloria, reina siempre;","Tu corona‿eterna es.","Nada de Tu‿amor separa","A los que‿has de poseer;","Por Tu gracia, ¡qué glorioso!","¡Ellos han de ver Tu rostro!"]},{"label":"5.","lines":["Apresura Tu venida,","Salvador, ven a reinar;","En el tiempo señalado,","Cielo y tierra pasarán.","Cantaremos con gran gozo,","Alabando al Rey glorioso."]}]}