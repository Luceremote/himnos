{"hymn":"S651","parent":"E839","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Alfarero eres, Señor","subtitle":"La iglesia—Su edificación","syl":{"n1":["Al","i"],"n2":["fa","m"],"n3":["re","m"],"n4":["ro‿e","m"],"n5":["res,","t"],"n6":["Se","i"],"n7":["ñor,","t"],"n8":"Que","n9":"Tu","n10":["va","i"],"n11":["so","t"],"n12":["mol","i"],"n13":["dea","m"],"n14":["rás;","t"],"n15":["Tam","i"],"n16":["bién","t"],"n17":["e","i"],"n18":["di","m"],"n19":["fi","m"],"n20":["ca","m"],"n21":["dor,","t"],"n22":"Que","n23":["Tu‿ho","i"],"n24":["gar","t"],"n25":["cons","i"],"n26":["tru","m"],"n27":["i","m"],"n28":["rás.","t"],"n29":"Yo","n30":"de","n31":["ba","i"],"n32":["rro","t"],"n33":["he","i"],"n34":["cho","t"],"n35":"fui,","n36":["Pie","i"],"n37":["dra","t"],"n38":["vi","i"],"n39":["va‿a","m"],"n40":["ho","m"],"n41":["ra","t"],"n42":"soy,","n43":["Pa","i"],"n44":["ra","t"],"n45":"yo","n46":"Tu","n47":["va","i"],"n48":["so","t"],"n49":"ser","n50":["Y‿a","i"],"n51":["de","m"],"n52":["más","t"],"n53":"Tu","n54":["tem","i"],"n55":["plo","t"],"n56":"hoy."},"verses":[{"label":"2.","lines":["Tu creación de barro fue,","Mas la quieres transformar","En preciosas piedras hoy","Por Tu vida divinal.","Es por la edificación","Que Tu Novia obtendrás,","Como un Cuerpo unido a Ti,","Satisfecho estarás."]},{"label":"3.","lines":["No la piedra individual","Quiere ver Tu corazón;","Por Tu gloria, por Tu hogar,","Quieres la edificación.","Tú, el Cristo sin igual,","Tal iglesia quieres ver,","Donde puedas expresar","Las riquezas de Tu ser."]},{"label":"4.","lines":["No el hombre espiritual","En su forma individual,","Mas la vida corporal,","Tu deseo cumplirá.","Separados no podrán","Hoy Tus miembros realizar","Tu completa expresión,","Sólo el Cuerpo la obtendrá."]},{"label":"5.","lines":["Libre de lo individual,","Concertado quiero estar;","Edifícame, Señor,","Con los santos en Tu plan.","Mi experiencia y mi don","No me han de envanecer,","Para Tu edificación","Quiero todo a Ti ceder."]}]}