{"hymn":"S185","parent":"E1110","quality":"check","adjust":{"hold":0,"merge":0},"title":"Señor Jesús, presentes en Tu mesa","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n1":["Se","i"],"n2":["ñor","t"],"n3":["Je","i"],"n4":["sús,","t"],"n5":["pre","i"],"n6":["sen","m"],"n7":["tes","t"],"n8":"en","n9":"Tu","n10":["me","i"],"n11":["sa,","t"],"n13":"El","n14":["vi","i"],"n15":["no‿y","t"],"n16":"pan","n17":["po","i"],"n18":["de","m"],"n19":["mos","t"],"n20":["con","i"],"n21":["tem","m"],"n22":["plar;","t"],"n24":"Te","n25":["a","i"],"n26":["la","m"],"n27":["ba","m"],"n28":["mos","t"],"n29":"por","n30":"ser","n31":["a","i"],"n32":["li","m"],"n33":["men","m"],"n34":["to","t"],"n36":"Que","n37":["to","i"],"n38":["do","t"],"n39":["hom","i"],"n40":["bre","t"],"n41":["pue","i"],"n42":["de","t"],"n43":["dis","i"],"n44":["fru","m"],"n45":["tar.","t"],"n47":["To","i"],"n48":["do","t"],"n49":"mi","n50":"ser","n51":["can","i"],"n52":["ta‿a","m"],"n53":["la","m"],"n54":["ban","m"],"n55":["za‿a","t"],"n56":"Ti,","n58":"¡Oh,","n59":"cuán","n60":["pe","i"],"n61":["que","m"],"n63":["ño‿e","m"],"n64":["res,","t"],"n65":["Se","i"],"n66":["ñor!","t"],"n68":"Te","n69":["co","i"],"n70":["me","m"],"n71":["re","m"],"n72":["mos","t"],"n73":"por","n74":["la‿e","i"],"n75":["ter","m"],"n76":["ni","m"],"n77":["dad,","t"],"n79":"¡Oh,","n80":"cuán","n81":["pe","i"],"n82":["que","m"],"n84":["ño‿e","m"],"n85":["res,","t"],"n86":["Se","i"],"n87":["ñor!","t"]},"verses":[{"label":"2.","lines":["Qué triste es que Cristo vino‿al mundo,","Con Sus riquezas para vida dar;","Mas vive‿el hombre por las enseñanzas,","Y Sus riquezas no quiere‿aplicar."]},{"label":"3.","lines":["Señor Jesús, Tú no viniste al mundo,","Para reinar externamente aquí;","Más Tú viniste como el alimento","Que en vida nutre y nos guía así."]},{"label":"4.","lines":["Señor Jesús, Tu grandeza admiramos,","Y te alabamos por Tu gran poder;","Pero especiales gracias hoy te damos,","Pues lo que eres se puede comer."]}]}