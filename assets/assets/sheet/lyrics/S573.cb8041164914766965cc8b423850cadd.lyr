{"hymn":"S573","parent":"E743","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Nos creó Dios como vasos","subtitle":"Varios aspectos de la vida interior—El nuevo corazón y el nuevo Espíritu","syl":{"n1":"Nos","n2":["cre","i"],"n3":["ó","t"],"n4":"Dios","n5":["co","i"],"n6":["mo","t"],"n7":["va","i"],"n8":["sos","t"],"n9":["Pa","i"],"n10":["ra","t"],"n11":["Su‿ex","i"],"n13":["pre","m"],"n14":["sión","t"],"n15":["lo","i"],"n16":["grar,","t"],"n18":"Con","n19":"un","n20":["co","i"],"n21":["ra","m"],"n22":["zón","t"],"n23":"que","n24":["lo‿a","i"],"n25":["me","t"],"n26":"Y‿un","n27":["es","i"],"n28":["pí","m"],"n30":["ri","m"],"n31":["tu","t"],"n32":"sin","n33":"par."},"verses":[{"label":"2.","lines":["Debe el corazón amarlo,","Y el espíritu aceptar","Al Señor como su vida","Para poderlo expresar."]},{"label":"3.","lines":["Nos hirió Satán con muerte,","Corrompiendo el corazón,","Para que en el yo vivamos","Y aislarnos del Señor."]},{"label":"4.","lines":["Mas la salvación de Cristo","Renueva el espíritu,","Y del corazón recobra","Su amante aptitud."]},{"label":"5.","lines":["Con tal corazón buscamos","En amor a nuestro Dios,","Y en espíritu avivados","Contactamos al Señor."]},{"label":"6.","lines":["Siempre puro y verdadero","Debe ser el corazón,","Y en espíritu ser pobres","Para contactar a Dios."]},{"label":"7.","lines":["Guarda nuestros corazones","En lo fresco de Tu amor,","Y al espíritu da fuerzas","Para tocarte, Señor."]}]}