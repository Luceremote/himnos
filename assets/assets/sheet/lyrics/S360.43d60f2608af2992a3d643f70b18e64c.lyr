{"hymn":"S360","parent":"E1138","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La consagración Tú eres","subtitle":"Consagración—Cristo como nuestro holocausto","syl":{"n1":"La","n2":["con","i"],"n3":["sa","m"],"n4":["gra","m"],"n5":["ción","t"],"n6":"Tú","n7":["e","i"],"n8":["res","t"],"n9":["Con","i"],"n10":["sa","m"],"n11":["gra","m"],"n12":["do‿es","m"],"n13":["tás,","t"],"n14":["Se","i"],"n15":["ñor;","t"],"n16":["Sa","i"],"n17":["tis","m"],"n18":["fe","m"],"n19":["cho‿es","m"],"n20":["tá","t"],"n21":"el","n22":["Pa","i"],"n23":["dre:","t"],"n24":["Es","i"],"n25":["to‿es","t"],"n26":"la","n27":["con","i"],"n28":["sa","m"],"n29":["gra","m"],"n30":["ción.","t"],"n31":["Na","i"],"n32":["da","t"],"n34":["te‿a","i"],"n35":["gra","m"],"n36":["dó‿en","t"],"n37":"la","n38":["tie","i"],"n40":["rra,","t"],"n41":["Sal","i"],"n42":["vo‿ha","m"],"n44":["cer","t"],"n45":"Su","n46":["vo","i"],"n47":["lun","m"],"n48":["tad.","t"],"n49":"Hoy","n50":"Tu","n51":["vi","i"],"n52":["ves","t"],"n53":"en","n54":["no","i"],"n55":["so","m"],"n56":["tros;","t"],"n57":["Con","i"],"n58":["sa","m"],"n59":["gra","m"],"n60":["dos","t"],"n61":"nos","n62":["ha","i"],"n63":["rás.","t"]},"verses":[{"label":"2.","lines":["Te‿alabamos por el cuadro,","De aquel carnero que","Fue‿inmolado y quemado,","Y Dios satisfecho fue.","Tal carnero eres, Cristo,","Ofrecido para Dios;","Tu consagración nos lleva","A seguir Tus pasos hoy."]},{"label":"3.","lines":["Al comerte, Jesucristo,","Consagrados nos harás;","Por Tu vida en nosotros,","Tu‿obediencia‿es nuestra ya.","Ya no hay que esforzarnos","Para consagrados ser;","En nosotros hoy Tú vives,","Solo debemos comer."]},{"label":"4.","lines":["Te‿alabamos, pues comerte","Es real consagración;","Al comer y disfrutarte,","Somos uno hoy con Dios;","Al comerte, uno somos","Con Tu meta‿y voluntad:","Sí, Señor, pues al comerte","Consagrados nos harás."]}]}