{"hymn":"S374","parent":"E490","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El Padre no se conoció","subtitle":"Experiencia de Cristo—En el Espíritu","syl":{"n1":"El","n2":["Pa","i"],"n3":["dre","t"],"n4":"no","n5":"se","n6":["co","i"],"n7":["no","m"],"n8":["ció,","t"],"n9":["Has","i"],"n10":["ta","t"],"n11":"que","n12":["vi","i"],"n13":["no‿en","t"],"n14":"Ti,","n15":["Se","i"],"n16":["ñor;","t"],"n17":["Nues","i"],"n18":["tra‿ig","m"],"n19":["no","m"],"n20":["ran","m"],"n21":["cia","t"],"n22":"ya","n23":["ce","i"],"n24":["só,","t"],"n25":"El","n26":["Pa","i"],"n27":["dre‿en","t"],"n28":"Ti","n29":"se","n30":["re","i"],"n31":["ve","m"],"n32":["ló.","t"]},"verses":[{"label":"2.","lines":["Mas cuando anduviste aquí,","Pocos te conocieron bien;","Aún un velo te encubrió,","No te pudieron entender."]},{"label":"3.","lines":["Tal como el Padre vino en Ti,","Viniste como Espíritu;","El Padre en Ti se conoció,","Y Tú, por el Espíritu."]},{"label":"4.","lines":["Hoy en la carne ya no estás,","Con toda su limitación;","Mas como el Espíritu","Te impartes libre al corazón."]},{"label":"5.","lines":["\"Padre\" una vez se te llamó,","Ahora el Santo Espíritu;","Y como tal en nuestro ser,","Nos llenas con Tu plenitud."]},{"label":"6.","lines":["Como el Espíritu, Señor,","Tu vida das a conocer,","Tu gloria y Tu integridad,","Y Tu maravilloso ser."]},{"label":"7.","lines":["Te alabamos sin cesar,","Con rebosante corazón,","Pues Tú nos eres tan real,","El más hermoso eres, Señor."]}]}