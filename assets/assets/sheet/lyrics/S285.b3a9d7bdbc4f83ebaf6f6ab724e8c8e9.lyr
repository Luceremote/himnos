{"hymn":"S285","parent":"E356","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Tú, de mi alma, Imán","subtitle":"Anhelos—De Cristo","syl":{"n1":"¡Tú,","n2":"de","n3":"mi","n4":["al","i"],"n5":["ma,‿I","m"],"n6":["mán!","t"],"n7":["A","i"],"n8":["cér","m"],"n9":["ca","m"],"n10":["me‿has","m"],"n11":["ta","t"],"n12":"que","n13":"Ya","n14":"no","n15":["pal","i"],"n16":["pi","m"],"n17":["te‿en","t"],"n18":"mí","n19":"el","n20":"yo,","n21":"Y","n22":"en","n24":["quie","i"],"n25":["tud","t"],"n26":["es","i"],"n27":["té.","t"]},"verses":[{"label":"2.","lines":["¡Sol de mi corazón!","Satura todo‿allí","Para que brinde Tu jardín","Fragancia dulce‿a Ti."]},{"label":"3.","lines":["¡Tú, mi Rescatador!","A poseerme, ven;","Me redimiste, úsame","Conforme‿a Tu placer."]},{"label":"4.","lines":["¡Señor de vida‿y luz!","Me postro ante Ti;","Un santo privilegio es","Obedecerte‿aquí."]},{"label":"5.","lines":["¡Tú, inefable Don!","Llenas mi corazón;","Al quebrantarlo, pruebo yo","Lo dulce de Tu‿amor."]}]}