{"hymn":"S140","parent":"E180","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor Jesús, te adoramos con gozo","subtitle":"Alabanza al Señor—Su dignidad","syl":{"n1":["Se","i"],"n2":["ñor","t"],"n3":["Je","i"],"n4":["sús,","t"],"n5":["te‿a","i"],"n6":["do","m"],"n7":["ra","m"],"n8":["mos","t"],"n9":"con","n10":["go","i"],"n11":["zo,","t"],"n12":["Y‿has","i"],"n13":["ta","t"],"n14":"Tu","n15":["tro","i"],"n16":["no‿al","m"],"n17":["za","m"],"n18":["mos","t"],"n19":["can","i"],"n20":["ción;","t"],"n21":"Hoy","n22":["ben","i"],"n23":["de","m"],"n24":["ci","m"],"n25":["dos","t"],"n26":"a","n27":"Ti","n28":["con","i"],"n29":["fe","m"],"n30":["sa","m"],"n31":["mos","t"],"n32":"Que","n33":["só","i"],"n34":["lo","t"],"n35":"Tú","n36":["e","i"],"n37":["res","t"],"n38":["dig","i"],"n39":["no","t"],"n40":"de","n41":["ho","i"],"n42":["nor.","t"],"n43":"Tú","n44":["e","i"],"n45":["res","t"],"n46":["dig","i"],"n47":["no;","t"],"n49":"Tú","n50":["e","i"],"n51":["res","t"],"n52":["dig","i"],"n53":["no;","t"],"n55":["Tú‿e","i"],"n56":["res","t"],"n57":["dig","i"],"n58":["no,","t"],"n60":"muy","n61":["dig","i"],"n62":["no,","t"],"n63":["Se","i"],"n64":["ñor;","t"],"n65":"Hoy,","n66":["ben","i"],"n67":["de","m"],"n68":["ci","m"],"n69":["dos,","t"],"n70":"a","n71":"Ti","n72":["con","i"],"n73":["fe","m"],"n74":["sa","m"],"n75":["mos","t"],"n76":"Que","n77":["só","i"],"n78":["lo","t"],"n79":"Tú","n80":["e","i"],"n81":["res","t"],"n82":["dig","i"],"n83":["no","t"],"n84":"de","n85":["ho","i"],"n86":["nor.","t"]},"verses":[{"label":"2.","lines":["Tú eres Dios, mas llegaste‿a ser hombre,","No como un‿ángel moriste‿en la cruz,","Para‿aplastar la antigua serpiente,","De la mujer la simiente‿eres Tú."]},{"label":"3.","lines":["Te humillaste y fuiste clavado","Por Tus criaturas un día‿en la cruz;","Aún por Dios siendo desamparado,","La maldición no rehuiste Tú."]},{"label":"4.","lines":["Tú has triunfado, triunfado con gloria,","Ondas de muerte pudiste aplastar;","Nadie podrá acallar esa‿historia,","Sobre‿el sepulcro invicto Tú‿estás."]}]}