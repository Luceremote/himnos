{"hymn":"S37","parent":"E47","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Te bendecimos, Padre Dios","subtitle":"Adoración al Padre—Su gracia en la filiación","syl":{"n1":"Te","n2":["ben","i"],"n4":["de","m"],"n5":["ci","m"],"n7":["mos,","t"],"n8":["Pa","i"],"n10":["dre","t"],"n11":"Dios,","n12":"Tus","n13":["hi","i"],"n15":["jos","t"],"n17":"en","n18":["ver","i"],"n19":["dad,","t"],"n20":"Con","n21":["ju","i"],"n22":["bi","m"],"n23":["lo","m"],"n24":["so","t"],"n25":["co","i"],"n27":["ra","m"],"n28":["zón","t"],"n30":"Al","n31":["con","i"],"n33":["tem","m"],"n34":["plar","t"],"n36":"Tu","n37":"faz."},"verses":[{"label":"2.","lines":["Confianza dulce Tu nos das,","Inspira a‿adorar;","Elevas nuestro corazón","Al orbe donde‿estás."]},{"label":"3.","lines":["Tu rica gracia se verá","Por siglos que vendrán,","En los que han de compartir","Con Tu Hijo Su lugar."]},{"label":"4.","lines":["Aunque ausente Él está,","Seguimos; firme‿en pos","De‿Aquel que viene‿a rescatar","De toda muerte atróz."]},{"label":"5.","lines":["Hay gozo‿en Ti; Tu plenitud","Será nuestra porción,","Al disfrutar con Tu Hijo fiel","Tu rica provisión."]},{"label":"6.","lines":["Oh Padre Santo, guárdanos","En Tu nombre‿y amor,","Para cumplir Tu voluntad,","Más sin sentir temor."]}]}