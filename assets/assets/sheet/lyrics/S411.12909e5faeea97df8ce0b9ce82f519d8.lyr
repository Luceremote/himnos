{"hymn":"S411","parent":"E518","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¿A quién tengo en los cielos, yo","subtitle":"Experiencia de Cristo—Como aquel que es el todo","syl":{"n1":"¿A","n2":"quién","n3":["ten","i"],"n4":["go‿en","t"],"n5":"los","n6":["cie","i"],"n7":["los,","t"],"n8":"yo","n9":["Si","i"],"n10":["no,","t"],"n11":["Se","i"],"n12":["ñor,","t"],"n13":"a","n14":"Ti?","n15":"Por","n16":["siem","i"],"n17":["pre","t"],"n18":["can","i"],"n19":["ta","m"],"n20":["rá","t"],"n21":"mi","n22":"voz:","n23":["¡Cris","i"],"n24":["to","t"],"n25":"es","n26":["pa","i"],"n27":["ra","t"],"n28":"mí!","n29":"Él","n30":"la","n31":["ser","i"],"n32":["pien","m"],"n33":["te","t"],"n34":["a","i"],"n35":["plas","m"],"n36":["tó;","t"],"n37":"Su","n38":["san","i"],"n39":["gre‿a","t"],"n40":"mí","n41":"me","n43":["re","i"],"n44":["di","m"],"n45":["mió;","t"],"n46":"Con","n47":"Dios","n48":"Él","n49":"me","n50":["re","i"],"n51":["con","m"],"n52":["ci","m"],"n53":["lió,","t"],"n54":["¡Cris","i"],"n55":["to","t"],"n56":"es","n57":["pa","i"],"n58":["ra","t"],"n59":"mí!"},"verses":[{"label":"2.","lines":["No‿envidio a los ricos de hoy,","¡Cristo‿es para mi!","Ni‿algún juquete‿encantador,","¡Cristo‿es para mi!","Se‿agota‿el gozo terrenal","Y todo se marchitará,","Pero mi gozo‿es eternal,","¡Cristo‿es para mi!"]},{"label":"3.","lines":["Aunque muy pobre sea yo,","¡Cristo‿es para mi!","Él sabe bien lo que‿es mejor;","¡Cristo‿es para mi!","Aunque la‿higuera no‿eche flor,","O pierda la‿oliva vigor","Y haya muerte‿alrededor,","¡Cristo‿es para mi!"]},{"label":"4.","lines":["Aunque estoy en tierra‿hostil,","¡Cristo‿es para mi!","Y me acosa‿el mundo vil,","¡Cristo‿es para mi!","Haya violencia‿o destrucción,","Si urge la persecusión","Y sufre mi‿alma humillación,","¡Cristo‿es para mi!"]},{"label":"5.","lines":["Cuando se‿acerque ya mi fin,","¡Cristo‿es para mi!","Reposaré seguro‿en Él;","¡Cristo‿es para mi!","Cuando adolorido‿esté,","Sin fuerzas propias en mi ser,","Frente‿a la muerte cantaré:","¡Cristo‿es para mi!"]}]}