{"hymn":"S361","parent":"E474","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Uno soy, Señor, contigo","subtitle":"Unión con Cristo—Uno con Él","syl":{"n1":["U","i"],"n2":["no","t"],"n3":"soy,","n4":["Se","i"],"n5":["ñor,","t"],"n6":["con","i"],"n7":["ti","m"],"n8":["go,","t"],"n9":"En","n10":["es","i"],"n11":["pí","m"],"n12":["ri","m"],"n13":["tu‿u","m"],"n14":["no","t"],"n15":"soy;","n16":"Lo","n17":"que","n18":["e","i"],"n19":["res","t"],"n20":"yo","n21":["po","i"],"n22":["se","m"],"n23":["o,","t"],"n24":"En","n25":"mi","n26":"ser","n27":"Tú","n28":["vi","i"],"n29":["ves","t"],"n30":"hoy.","n31":"Tú","n32":"y","n33":"yo,","n34":"en","n35":["u","i"],"n36":["nión,","t"],"n37":"Tú","n38":"y","n39":"yo,","n40":"en","n41":["u","i"],"n42":["nión,","t"],"n43":"Tus","n44":["ri","i"],"n45":["que","m"],"n46":["zas","t"],"n47":["to","i"],"n48":["mo‿a","t"],"n49":["dia","i"],"n50":["rio,","t"],"n51":["E","i"],"n52":["res","t"],"n53":["to","i"],"n54":["da","t"],"n55":"mi","n56":["por","i"],"n57":["ción.","t"]},"verses":[{"label":"2.","lines":["Yo Tu vida humana tengo.","Lleno de Tu humanidad,","Tu completa obediencia,","Disponible ahora está."]},{"label":"3.","lines":["En crucifixión contigo,","En la cruz en Ti morí,","Para‿el mundo estoy muerto,","Y el mundo para mí."]},{"label":"4.","lines":["En resurrección contigo,","Levantado, vivo en Ti;","Esa vida‿eres Tú Mismo,","Ahora‿en mí, Señor, en mí."]},{"label":"5.","lines":["Ascendido yo contigo,","En los cielos ahora estoy,","Escondida en Ti mi vida,","Peregrino al mundo soy."]},{"label":"6.","lines":["Entronado estoy contigo,","Con Tu autoridad en mí,","Participo de Tu vida,","Tú en mí y yo en Ti."]}]}