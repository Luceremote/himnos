{"hymn":"S645","parent":"E832","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo el Hijo amado con Su redención","subtitle":"La iglesia—Su unidad","syl":{"n1":["Cris","i"],"n2":["to‿el","t"],"n3":["Hi","i"],"n4":["jo‿a","m"],"n5":["ma","m"],"n6":["do","t"],"n7":"con","n8":"Su","n9":["re","i"],"n10":["den","m"],"n11":["ción,","t"],"n13":["Es","i"],"n14":["to‿es","t"],"n15":["nues","i"],"n16":["tro","t"],"n17":["cre","i"],"n18":["do,","t"],"n19":"fe","n20":"y","n21":["sal","i"],"n22":["va","m"],"n23":["ción;","t"],"n24":"Las","n25":["de","i"],"n26":["más","t"],"n27":["doc","i"],"n28":["tri","m"],"n29":["nas","t"],"n30":"no","n31":"se","n32":["in","i"],"n33":["clui","m"],"n34":["rán,","t"],"n35":["Só","i"],"n36":["lo","t"],"n37":"Su","n38":["per","i"],"n39":["so","m"],"n40":["na","t"],"n41":["y‿o","i"],"n42":["bra","t"],"n43":["con","i"],"n44":["ta","m"],"n45":["rán.","t"]},"verses":[{"label":"2.","lines":["La‿enseñanza impropia sólo traerá","\"Vientos de doctrina\" contra la‿unidad;","Distrae a los santos de la comunión","Que hay en la Cabeza y edificación."]},{"label":"3.","lines":["Todas las doctrinas hay que‿abandonar,","Mas la fe genuina se debe guardar;","Esta fe nos lleva a ser uno hoy,","Uno en el Espíritu y en el Señor."]},{"label":"4.","lines":["Debemos asirnos sólo a la verdad","Para el yo sectario poder anular,","Para que crezcamos en todo hacia Aquel","Quien es la Cabeza, y Su Cuerpo ver."]},{"label":"5.","lines":["Para a \"la unidad de fe\" llegar,","\"Vientos de doctrinas\" hay que rechazar;","Sólo a Cristo asidos y a Su realidad","Por Su Espíritu el Cuerpo crecerá."]}]}