{"hymn":"S57","parent":"E72","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús, el nombre sin igual","subtitle":"Alabanza al Señor—Su nombre","syl":{"n1":["Je","i"],"n2":["sús,","t"],"n3":"el","n4":["nom","i"],"n5":["bre","t"],"n6":"sin","n7":["i","i"],"n8":["gual,","t"],"n9":"En","n10":["cie","i"],"n11":["lo,","t"],"n12":["tie","i"],"n13":["rra‿y","t"],"n14":"mar;","n15":["To","i"],"n16":["do‿hom","m"],"n17":["bre","t"],"n18":["y‿án","i"],"n19":["gel","t"],"n20":["an","i"],"n21":["te","t"],"n22":"Él","n23":["Pos","i"],"n25":["tra","m"],"n26":["do","t"],"n27":["ca","i"],"n28":["e","m"],"n29":["rá.","t"]},"verses":[{"label":"2.","lines":["Jesús, Tu nombre dulce es","Al pobre pecador;","Quita la culpa, trae paz,","Y libra del temor."]},{"label":"3.","lines":["Jesús libera de prisión;","Aplasta‿a Satanás;","Al alma débil da poder,","Y vida al mortal."]},{"label":"4.","lines":["Oh, si pudiera‿el mundo ver","Su gracia‿y Su bondad!","El mismo‿amor que me‿apresó","Podrían abrazar."]},{"label":"5.","lines":["Hoy Su verdad amo‿anunciar,","Él mi justicia es;","Todo mi‿afán es proclamar:","¡Ved al Cordero fiel!"]},{"label":"6.","lines":["Feliz, si puedo respirar","El dulce nombre de‿Él,","Y que‿al morir pueda gritar:","Ved al Cordero fiel!"]}]}