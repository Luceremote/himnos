{"hymn":"S793","parent":"E958","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Desde aquel día, cuando en Betania","subtitle":"Esperanza de gloria—Anhelar y orar","syl":{"n3":["Des","i"],"n4":["de‿a","m"],"n5":["quel","t"],"n6":["dí","i"],"n7":["a,","t"],"n8":["cuan","i"],"n9":["do","t"],"n10":"en","n11":["Be","i"],"n12":["ta","m"],"n14":["nia,","t"],"n15":"Al","n16":["des","i"],"n17":["pe","m"],"n18":["dir","m"],"n19":["nos","t"],"n20":"un","n21":["va","i"],"n22":["cí","m"],"n23":["o‿en","m"],"n24":["tró;","t"],"n26":["¿Có","i"],"n27":["mo","t"],"n28":["po","i"],"n29":["dré","t"],"n30":["ba","i"],"n31":["jar","t"],"n32":"de","n33":["nue","i"],"n34":["vo‿el","t"],"n35":["ar","i"],"n37":["pa","t"],"n38":"Y","n39":["dis","i"],"n40":["fru","m"],"n41":["tar","t"],"n42":"sin","n43":"Ti","n44":["cual","i"],"n45":["quier","t"],"n46":["can","i"],"n47":["ción?","t"],"n49":"Y","n50":["cuan","i"],"n51":["do‿en","t"],"n52":"las","n53":["vi","i"],"n54":["gi","m"],"n55":["lias","t"],"n56":"de","n57":"la","n58":["no","i"],"n60":["che","t"],"n61":"Soy","n62":["in","i"],"n63":["sen","m"],"n64":["si","m"],"n65":["ble‿al","t"],"n66":["go","i"],"n67":["zo","t"],"n68":"ó‿al","n69":["do","i"],"n70":["lor,","t"],"n72":["Re","i"],"n73":["cuer","m"],"n74":["do","t"],"n75":"Tu","n76":["pro","i"],"n77":["me","m"],"n78":["sa:","t"],"n79":["\"Ven","i"],"n80":["go","t"],"n82":["pron","i"],"n83":["to\",","t"],"n84":"Y","n85":["gi","i"],"n86":["mo‿a","m"],"n87":["sí:","t"],"n88":"¿Por","n89":"qué","n90":"te","n91":["tar","i"],"n92":["das,","t"],"n93":"oh","n94":["Se","i"],"n95":["ñor?","t"]},"verses":[{"label":"2.","lines":["\"No tengo hogar\", me acuerda Tu pesebre;","Tu cruz, de mi alma despojó el placer;","Busco otra patria viendo Tu venida","Tu mismo ser mi meta ahora es.","Con Tu partida se esfumó mi gozo,","No tiene el canto su dulzura hoy;","Tu despedida me llevó al vacío,","¡Oh, cuánto anhelo que vinieras, mi Señor!"]},{"label":"3.","lines":["Aunque yo aquí disfruto Tu presencia,","Falta ese algo en mi corazón;","Tu luz y Tu sostenimiento tiernos","Ya no me bastan, ¡pronto ven, Señor!","Pese a Tu paz, me siento solitario;","Pese a Tu gozo, queda un suspirar;","Cuando estoy muy contento, aun añoro","Y es mi clamor poder Tu rostro contemplar."]},{"label":"4.","lines":["¿Qué exiliado no desea su tierra,","Y anhela ver su pueblo otra vez?","¿O, en lo ajeno, ver su parentela?","¿O dos amantes el volverse a ver?","No pueden los placeres terrenales","Con Tu venida comparados ser;","Si aquí no puedo contemplar Tu rostro,","Debo gemir hasta que en Tu presencia esté."]},{"label":"5.","lines":["¿Podrías olvidar esa promesa","De regresar, llevándome de aquí?","Todos mis días te sigo esperando,","Y todavía no te veo venir.","Recuerda cuánto llevo esperando,","Aunque Tu paso muy lejano está;","¿Oh, cuánto más? ¿Oh, cuánto he de esperarte","Hasta que llegues en gloriosa majestad?"]},{"label":"6.","lines":["Pues, al pasar por las generaciones,","Tus santos vienen y se van sin ver","El cumplimiento de Tu fiel promesa.","Oh, ¿cuánto? ¿Cuánto más te esperaré?","Señor, ¿no hay modo de escuchar Tus pasos?","¿Por qué los cielos tan cerrados son?","Oh, ¿debe aún la espera prolongarse","Hasta que revelado sea Tu esplendor?"]},{"label":"7.","lines":["Señor, recuerda cuánto he esperado","Por Tu venida, mas no sólo yo;","Pues Tus queridos santos desde siempre","Por Tu regreso han hecho petición.","A tantas lágrimas y tantos ruegos","Sea Tu presencia la respuesta fiel;","¡Oh ven! Escucha el eco de los siglos;","Contesta este grito colectivo: \"¡Ven!\"."]}]}