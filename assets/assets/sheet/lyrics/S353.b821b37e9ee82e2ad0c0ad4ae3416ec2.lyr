{"hymn":"S353","parent":"E464","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Glorioso Príncipe, mi Dios","subtitle":"Consagración—Servir al Señor","syl":{"n1":["Glo","i"],"n2":["rio","m"],"n4":["so","t"],"n5":["Prín","i"],"n6":["ci‿pe,","t"],"n7":"mi","n8":["Di","i"],"n9":["os,","t"],"n10":"A","n11":"Ti","n13":"mis","n14":["ma","i"],"n15":["nos","t"],"n17":["rin","i"],"n18":["do","t"],"n20":"hoy;","n21":"Mi","n23":["vo","i"],"n24":["lun","m"],"n25":["tad","t"],"n26":"hoy","n27":["Tu","i"],"n29":["ya","t"],"n30":"es,","n31":["Tu‿es","i"],"n32":["cla","m"],"n34":["vo‿a","m"],"n35":["le","m"],"n36":["gre","t"],"n38":"yo","n39":["se","i"],"n40":["ré.","t"]},"verses":[{"label":"2.","lines":["Oh, a la puerta llévame,","Horada mi oreja bien;","Tus lazos son mi libertad,","Contigo quiero siempre‿obrar."]},{"label":"3.","lines":["Mi‿oreja, manos, voluntad","Son Tuyas por completo ya.","Las libertades de mi yo,","Las rindo a Tus pies, Señor."]},{"label":"4.","lines":["Suprime Tú tal libertad,","Así mis manos llenarás,","Y mis oídos te oirán","Decir que uno somos ya."]}]}