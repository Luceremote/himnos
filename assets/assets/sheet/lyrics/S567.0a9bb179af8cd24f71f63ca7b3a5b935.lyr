{"hymn":"S567","parent":"E737","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Trae la vida eterna","subtitle":"Varios aspectos de la vida interior—La comunión de vida","syl":{"n1":"Trae","n2":"la","n3":["vi","i"],"n4":["da‿e","m"],"n5":["ter","m"],"n6":["na","t"],"n7":["Co","i"],"n8":["mu","m"],"n9":["nión","t"],"n10":"y","n11":"luz,","n12":["Sal","i"],"n13":["va","m"],"n14":["ción","t"],"n15":"y","n16":["vi","i"],"n17":["da,","t"],"n18":"En","n19":["Es","i"],"n20":["pí","m"],"n21":["ri","m"],"n22":["tu.","t"]},"verses":[{"label":"2.","lines":["Por la vida eterna","En la comunión,","El Señor se une","A nosotros hoy."]},{"label":"3.","lines":["Su Espíritu brinda","Vida en comunión;","Comunión que equipa","Con gracia y amor."]},{"label":"4.","lines":["Conlleva la vida","Recta comunión;","Comunión que rinde","Luz y perfección."]},{"label":"5.","lines":["La limpieza externa","Con la interna unción,","Nos guarda y mantiene","En la comunión."]},{"label":"6.","lines":["Comunión más honda","Viene por la cruz;","Comunión más alta","Por Su Espíritu,"]},{"label":"7.","lines":["Comunión que libra","Del malvado yo;","Comunión que lleva","Hasta el mismo Dios."]}]}