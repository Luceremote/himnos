{"hymn":"S591","parent":"E767","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, enseñanos a orar","subtitle":"Oración—La enseñanza","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":["en","i"],"n4":["se","m"],"n5":["ña","m"],"n6":["nos","t"],"n7":["a‿o","i"],"n8":["rar","t"],"n9":"Y‿al","n10":["e","i"],"n11":["ne","m"],"n12":["mi","m"],"n13":["go‿e","m"],"n14":["char,","t"],"n16":["To","i"],"n17":["do‿el","t"],"n18":["po","i"],"n19":["der","t"],"n20":["ma","i"],"n21":["lig","m"],"n22":["no‿a","m"],"n23":["tar","t"],"n24":"Y‿a","n25":"sus","n26":["pre","i"],"n27":["sos","t"],"n28":["sol","i"],"n29":["tar.","t"]},"verses":[{"label":"2.","lines":["Enseñanos a orar y estar","Muy firmes al luchar,","La fortaleza derribar,","Venciendo a Satanás."]},{"label":"3.","lines":["Enseñanos la vara a usar","Con oración triunfal,","Y por Tu sangre sacudir","Hoy toda potestad."]},{"label":"4.","lines":["Obrando en oración con fe,","Deseamos aprender","Que la victoria nuestra es,","Tu autoridad también."]}]}