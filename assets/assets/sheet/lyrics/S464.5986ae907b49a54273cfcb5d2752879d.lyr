{"hymn":"S464","parent":"E1154","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús, te amo","subtitle":"Experiencia de Cristo—Amarlo a Él","syl":{"n1":["Je","i"],"n2":["sús,","t"],"n3":"te","n4":["a","i"],"n5":["mo,","t"],"n6":"Y","n7":"Tu","n8":["gran","i"],"n9":["de‿a","m"],"n10":["mor","t"],"n11":"Me","n12":["a","i"],"n13":["tra","m"],"n14":["e‿a","t"],"n15":["bus","i"],"n16":["car","m"],"n17":["te","t"],"n18":"Con","n19":["to","i"],"n20":["do","t"],"n21":["fer","i"],"n22":["vor,","t"],"n23":"Me","n24":["a","i"],"n25":["tra","m"],"n26":["e‿a","t"],"n27":["bus","i"],"n28":["car","m"],"n29":["te","t"],"n30":"Con","n31":["to","i"],"n32":["do","t"],"n33":["fer","i"],"n34":["vor.","t"],"n35":["E","i"],"n36":["res","t"],"n37":["a","i"],"n38":["ma","m"],"n39":["do,","t"],"n41":"Del","n42":["to","i"],"n43":["do","t"],"n44":["de","i"],"n45":["se","m"],"n46":["a","m"],"n47":["ble,","t"],"n49":"En","n50":"quien","n51":"mi","n52":"ser","n53":"hoy","n54":"se","n55":["de","i"],"n56":["lei","m"],"n57":["ta.","t"],"n59":["E","i"],"n60":["res","t"],"n61":["a","i"],"n62":["ma","m"],"n63":["do,","t"],"n65":"Del","n66":["to","i"],"n67":["do","t"],"n68":["de","i"],"n69":["se","m"],"n70":["a","m"],"n71":["ble,","t"],"n73":"En","n74":"quien","n75":"mi","n76":"ser","n77":"hoy","n78":"se","n79":["de","i"],"n80":["lei","m"],"n81":["ta.","t"]},"verses":[{"label":"2.","lines":["Jesús, mi Amado,","Qué dulce es Tu amor","Y el olor de Tu ungüento","En mi corazón,","Y el olor de Tu ungüento","En mi corazón.","En los jardines","La fuente de agua viva,","Que fluye del Líbano siempre.","En los jardines","La fuente de agua viva,","Que fluye del Líbano siempre."]},{"label":"3.","lines":["Oh ven, mi Amado,","Al huerto a soplar,","Y el olor de su aroma","Se desprenderá,","Y el olor de su aroma","Se desprenderá.","Mi esposa, hermana,","Ya vine a mi huerto","Para ingerir miel, vino y leche.","Mi esposa hermana,","Ya vine a mi huerto","Para ingerir miel, vino y leche."]},{"label":"4.","lines":["Ponme por sello","En Tu corazón;","Pues los celos son duros","Como el cruel Seol;","Y el amor es más fuerte","Que la muerte atroz.","Las muchas aguas","No pueden apagarlo,","Ni fuertes ríos ahogarlo.","Si diese el hombre","Los bienes de su casa","Por este amor, es despreciado."]}]}