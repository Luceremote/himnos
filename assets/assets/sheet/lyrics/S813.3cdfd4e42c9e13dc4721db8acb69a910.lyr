{"hymn":"S813","parent":"E1314","quality":"adapted","adjust":{"hold":0,"merge":3},"title":"Pronto, Señor, vendrás","subtitle":"Esperanza de gloria—El día de las bodas","syl":{"n1":["Pron","i"],"n2":["to,","t"],"n3":["Se","i"],"n4":["ñor,","t"],"n5":["ven","i"],"n6":["drás,","t"],"n7":"Muy","n8":["cer","i"],"n9":["ca‿el","t"],"n10":["dí","i"],"n11":["a‿es","m"],"n12":["tá;","t"],"n13":["¡Re","i"],"n14":["gre","m"],"n15":["sa","t"],"n16":["pron","i"],"n17":["to,‿Se","m"],"n19":["ñor","t"],"n20":["Je","i"],"n21":["sús!","t"],"n22":"No","n23":["te","i"],"n24":["ne","m"],"n25":["mos‿o","m"],"n27":["tro","t"],"n28":"Se‿ñor,","n29":["vi","i"],"n30":["da","t"],"n31":["ni‿a","i"],"n33":["mor","t"],"n34":"Que","n35":["nues","i"],"n36":["tro","t"],"n37":["No","i"],"n38":["vio,","t"],"n39":"Tú,","n40":["Je","i"],"n41":["sús.","t"]},"verses":[{"label":"2.","lines":["La hora cerca está,","Tu voz resonará,","Y en las nubes descenderás.","Qué dulce ha de ser","La novia al Novio ver","Y un amor sin par gozar."]},{"label":"3.","lines":["¡El tiempo vuela ya,","Hemos de ver Tu faz!","¡Amén! ¡Ven pronto, nuestro Señor!","Deseamos verte ya","Y junto a Ti estar,","Dueño de nuestro corazón."]},{"label":"4.","lines":["Sólo un momento más,","El Novio volverá;","Su novia, Él ha de reclamar.","¡Oh, aleluya!","¡Qué gozo nos dará!","Y satisfecho Tú serás."]}]}