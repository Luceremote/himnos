{"hymn":"S800","parent":"E967","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Salvador, Tú pronto vienes","subtitle":"Esperanza de gloria—Cristo viene a reinar","syl":{"n1":["Sal","i"],"n2":["va","m"],"n3":["dor,","t"],"n4":"Tú","n5":["pron","i"],"n6":["to","t"],"n7":["vie","i"],"n8":["nes,","t"],"n9":["Vie","i"],"n10":["nes","t"],"n11":["pron","i"],"n12":["to,","t"],"n13":"mi","n14":["Se","i"],"n15":["ñor,","t"],"n16":"En","n17":["be","i"],"n18":["lle","m"],"n19":["za","t"],"n20":["re","i"],"n21":["ful","m"],"n22":["gen","m"],"n23":["te,","t"],"n24":"En","n25":"Tu","n26":["glo","i"],"n27":["ria","t"],"n28":["tras","i"],"n29":["cen","m"],"n30":["den","m"],"n31":["te;","t"],"n32":"Nos","n33":["go","i"],"n34":["za","m"],"n35":["mos","t"],"n36":"en","n37":["can","i"],"n38":["ción;","t"],"n39":"Del","n40":["o","i"],"n41":["rien","m"],"n42":["te","t"],"n43":["vie","i"],"n44":["nes","t"],"n45":"Tú,","n46":"Nos","n47":"lo","n48":["di","i"],"n49":["ce‿el","t"],"n50":["res","i"],"n51":["plan","m"],"n52":["dor;","t"],"n53":["Sa","i"],"n54":["cer","m"],"n55":["do","m"],"n56":["te‿en","t"],"n57":["es","i"],"n58":["plen","m"],"n59":["dor,","t"],"n60":["Y‿es","i"],"n61":["tás","t"],"n62":["cer","i"],"n63":["ca,","t"],"n64":"mi","n65":["Se","i"],"n66":["ñor.","t"]},"verses":[{"label":"2.","lines":["Pronto vienes, pronto vienes,","Y nos arrebatarás;","Te veremos, te honraremos,","Ese día mostraremos","Todo nuestro amor leal;","Que tonada el corazón","Cantará sólo por Ti,","Y a Tus pies se rendirá","Nuestro ser colmado allí."]},{"label":"3.","lines":["Pronto vienes y en Tu mesa","Bulle esta confesión;","Nuestro corazón conduces","A tan dulce comunión,","Arras de la eterna Sión.","No nos muestra sólo amor","O Tu eterna redención,","Mas Tu reino que vendrá,","Nuestro anhelo y oración."]},{"label":"4.","lines":["¡Oh, el gozo cuando reines","Mi amado y buen Señor!","Toda lengua al fin confiese","Tu nombre que prevalece,","Dándote gloria y honor.","Nuestro Amo, Amigo fiel,","Vindicado te has de ver,","Entronado para ser","Adorado por doquier."]}]}