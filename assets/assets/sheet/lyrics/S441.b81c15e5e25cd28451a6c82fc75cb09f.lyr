{"hymn":"S441","parent":"E1352","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Permaneced en Cristo y en Su amor","subtitle":"Experiencia de Cristo—Comunión con Él","syl":{"n1":["Per","i"],"n2":["ma","m"],"n3":["ne","m"],"n4":["ced","t"],"n5":"en","n6":["Cris","i"],"n7":["to","t"],"n8":"y‿en","n9":["Su‿a","i"],"n10":["mor;","t"],"n11":["Te","i"],"n12":["ned","t"],"n13":"con","n14":"Él","n15":"a","n16":["dia","i"],"n17":["rio","t"],"n18":["co","i"],"n19":["mu","m"],"n20":["nión.","t"],"n21":["Per","i"],"n22":["ma","m"],"n23":["ne","m"],"n24":["cien","m"],"n25":["do","t"],"n26":["siem","i"],"n27":["pre‿en","t"],"n28":"el","n29":["Se","i"],"n30":["ñor","t"],"n31":["No‿ha","i"],"n32":["brá","t"],"n33":["ba","i"],"n34":["rre","m"],"n35":["ras","t"],"n36":["en","i"],"n37":["tre","t"],"n38":"Él","n39":"y","n40":"yo."},"verses":[{"label":"2.","lines":["Permaneciendo en Él la unción fluirá;","En comunión, Su Espíritu guiará.","Obedeciendo, lo disfrutaré;","Y al seguirlo, Su amigo seré."]},{"label":"3.","lines":["Permaneciendo, la luz brillará;","En comunión, las sombras huirán.","Obedeciendo, vida crecerá,","Y mi espíritu se animará."]},{"label":"4.","lines":["Permaneciendo, fuerzas Él me da;","En comunión la muerte pasará.","Permaneciendo, no hay lamentación;","En comunión se alegra el corazón."]},{"label":"5.","lines":["Permaneciendo, huye Satanás;","En comunión, el mundo no me atrae.","Permaneciendo, puedo el mal vencer;","En comunión el ego he de perder."]},{"label":"6.","lines":["Permaneciendo, yo seré como Él;","En comunión, más vida yo tendré.","Permaneciendo, me da Su poder;","En comunión, riquezas obtendré."]},{"label":"7.","lines":["Permaneciendo, anhelo más de Ti;","En comunión, Tu Espíritu arde en mí.","Quiero perderme totalmente en Ti","Para contigo estar mezclado así."]}]}