{"hymn":"S711","parent":"E866","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Tu espíritu aviva","subtitle":"Las reuniones—Ejercitar el Espíritu","syl":{"n1":["¡Tu‿es","i"],"n2":["pí","m"],"n3":["ri","m"],"n4":["tu‿a","m"],"n5":["vi","m"],"n6":["va!","t"],"n7":["Re","i"],"n8":["cha","m"],"n9":["za‿el","t"],"n10":["pen","i"],"n11":["sar;","t"],"n12":"Al","n13":["e","i"],"n14":["jer","m"],"n15":["ci","m"],"n16":["tar","m"],"n17":["lo","t"],"n18":"El","n19":["Cuer","i"],"n20":["po‿hon","m"],"n21":["ra","m"],"n22":["rás.","t"]},"verses":[{"label":"2.","lines":["¡Tu espíritu aviva!","Las formas dejad;","Comparte con otros,","Cristo disfrutad."]},{"label":"3.","lines":["¡Tu espíritu aviva!","Deja el ego atrás;","Sirviendo con otros,","A Cristo anunciad."]},{"label":"4.","lines":["¡Tu espíritu aviva!","Niega tu alma ya;","Al ejercitarlo","En Cristo confiad."]},{"label":"5.","lines":["Tú Espíritu libre","De condenación,","De justicia propia,","De conciencia atroz."]},{"label":"6.","lines":["Tú Espíritu libre,","De la terquedad,","Y sin egoísmo,","Todo vencerá."]},{"label":"7.","lines":["¡Tu espíritu aviva!","Victoria clamad;","Por Su fuerte nombre,","Y sangre eficaz."]},{"label":"8.","lines":["¡Tu espíritu aviva!","Toca a Jesús;","Toma Su Palabra","En espíritu."]},{"label":"9.","lines":["Tu espíritu puede","Expresar a Dios,","Y brindar al hombre","Gran satisfacción."]},{"label":"10.","lines":["¡Oh, que ejercitemos","El espíritu!","Lo necesitamos,","¡Guíanos, Jesús!"]}]}