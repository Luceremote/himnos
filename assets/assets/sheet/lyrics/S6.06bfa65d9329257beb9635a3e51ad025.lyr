{"hymn":"S6","parent":"E10","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh Padre, eterno Dios Tú eres","subtitle":"Adoración al Padre—Como aquel que es eterno","syl":{"n1":"Oh","n2":["Pa","i"],"n4":["dre,‿e","m"],"n5":["ter","m"],"n7":["no","t"],"n8":"Dios","n10":["Tú‿e","i"],"n11":["res","t"],"n12":"El","n13":["in","i"],"n15":["cre","m"],"n16":["a","m"],"n18":["do","t"],"n19":"gran","n21":"YO","n22":"SOY;","n23":"Tú‿el","n24":["An","i"],"n26":["cia","m"],"n27":["no","t"],"n28":"de","n29":"los","n31":["dí","i"],"n32":["as,","t"],"n34":"Por","n35":"las","n36":["e","i"],"n37":["da","m"],"n38":["des","t"],"n39":["has","i"],"n41":["ta","t"],"n42":"hoy."},"verses":[{"label":"2.","lines":["Eternamente Dios Tú eres,","De espacio y tiempo más allá;","La plenitud de lo eterno","Sin un principio y sin final."]},{"label":"3.","lines":["La fuente eterna, Tú de todo,","Aun antes de los cielos, Tú;","De los primeros, el primero,","Y más que todos en virtud."]},{"label":"4.","lines":["La vida eres que perdura,","No tienes fin de edad á edad;","Tú permaneces para siempre,","Después del último Tú estás."]},{"label":"5.","lines":["El Alfa, eres el primero,","La Omega, que viene al final;","Principio y Fin, el todo Tú‿eres,","Perfecto‿y completo en verdad."]},{"label":"6.","lines":["Te alabamos, oh Eterno,","Exaltamos Tu infinidad;","Te alabamos, Inmensurable,","Exaltamos Tu vastedad."]}]}