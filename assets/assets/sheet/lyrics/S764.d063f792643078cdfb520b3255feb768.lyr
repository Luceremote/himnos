{"hymn":"S764","parent":"E1292","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Sin pena hay que proclamar","subtitle":"Predicar el evangelio—El evangelio elevado","syl":{"n1":"Sin","n2":["pe","i"],"n3":["na","t"],"n4":"hay","n5":"que","n6":["pro","i"],"n7":["cla","m"],"n8":["mar","t"],"n9":"El","n10":["al","i"],"n11":["to‿e","m"],"n12":["van","m"],"n13":["ge","m"],"n14":["lio","t"],"n15":"de","n16":"Dios;","n17":"Más","n18":["al","i"],"n19":["to","t"],"n20":["e","i"],"n21":["ven","m"],"n22":["ge","m"],"n23":["lio","t"],"n24":"no‿hay,","n25":"Pues","n26":["ve","i"],"n27":["mos","t"],"n28":"lo","n29":"que","n30":"Dios","n31":["pla","i"],"n32":["neó.","t"],"n33":"No","n34":["co","i"],"n35":["mo","t"],"n36":["lo‿hi","i"],"n37":["ci","m"],"n38":["mos","t"],"n39":["a","i"],"n40":["yer,","t"],"n41":"Tan","n42":["po","i"],"n43":["bres","t"],"n44":"en","n45":["nues","i"],"n46":["tra‿ex","m"],"n47":["pre","m"],"n48":["sión;","t"],"n49":"A","n50":["to","i"],"n51":["dos","t"],"n52":["po","i"],"n53":["de","m"],"n54":["mos","t"],"n55":["ga","i"],"n56":["nar","t"],"n57":"Por","n58":"ser","n59":"hoy","n60":"los","n61":["hi","i"],"n62":["jos","t"],"n63":"de","n64":"Dios."},"verses":[{"label":"2.","lines":["Todo nuestro Hermano heredó;","Toda autoridad Dios le dio;","Nos ha hecho participar","Con Él en Su cargo de honor.","Así Dios nos seleccionó,","Antes de la tierra formar;","Su gloria nos otorgará.","A tal Cristo, ¿cómo rehusar?"]},{"label":"3.","lines":["¡\"Hermanos de Cristo Jesús\"!","¡Qué alto evangelio esto es!","Más alto no puede llegar;","Todo hombre lo debe saber.","¿Pudiera alguien rechazar","Este evangelio sin par?","Con Cristo a la diestra de Dios,","¡Más alto evangelio no hay!"]}]}