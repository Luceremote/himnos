{"hymn":"S885","parent":"E1066","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Mi Salvador en la cruz murió","subtitle":"El evangelio—Testimonio","syl":{"n1":"Mi","n2":["Sal","i"],"n3":["va","m"],"n4":["dor","t"],"n5":"en","n6":"la","n7":"cruz","n8":["mu","i"],"n9":["rió","t"],"n10":"Y","n11":"mis","n12":["pe","i"],"n13":["ca","m"],"n14":["dos","t"],"n15":["a","i"],"n16":["llí","t"],"n17":["bo","i"],"n18":["rró;","t"],"n19":"Por","n20":"mí,","n21":"Su","n22":["san","i"],"n23":["gre","t"],"n24":"Él","n25":["de","i"],"n26":["rra","m"],"n27":["mó,","t"],"n28":["¡Glo","i"],"n29":["ria","t"],"n30":"dad","n31":"a","n32":"Él!","n34":"A","n35":["Su‿nom","i"],"n36":["bre,","t"],"n37":["glo","i"],"n38":["ria,","t"],"n42":"A","n43":["Su‿nom","i"],"n44":["bre,","t"],"n45":["glo","i"],"n46":["ria,","t"],"n50":"Por","n51":"mí,","n52":"Su","n53":["san","i"],"n54":["gre","t"],"n55":"Él","n56":["de","i"],"n57":["rra","m"],"n58":["mó,","t"],"n59":["¡Glo","i"],"n60":["ria","t"],"n61":"dad","n62":"a","n63":"Él!"},"verses":[{"label":"2.","lines":["¡Maravillosa es mi salvación!","Mora Jesús dulcemente en mí;","Me recibió en la cruz allí,","¡Gloria dad a Él!"]},{"label":"3.","lines":["Preciosa fuente de salvación;","Me trae gran gozo y bendición,","Limpio y salvo por ella soy,","¡Gloria dad a Él!"]},{"label":"4.","lines":["Ven a esta fuente, oh pecador;","Ponte a los pies de tu Salvador;","Deja que Cristo te sane hoy,","¡Gloria dad a Él!"]}]}