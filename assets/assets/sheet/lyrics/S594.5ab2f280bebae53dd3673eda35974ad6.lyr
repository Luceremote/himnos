{"hymn":"S594","parent":"E771","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Rasgado el velo, abierto está","subtitle":"Oración—En el lugar santísimo","syl":{"n1":["Ras","i"],"n2":["ga","m"],"n3":["do‿el","t"],"n4":["ve","i"],"n5":["lo,‿a","m"],"n6":["bier","m"],"n7":["to‿es","m"],"n8":["tá,","t"],"n9":"La","n10":["san","i"],"n11":["gre","t"],"n12":"se","n13":["ro","i"],"n14":["ció,","t"],"n15":["Ca","i"],"n16":["mi","m"],"n17":["no","t"],"n18":["vi","i"],"n19":["vo‿y","t"],"n20":["nue","i"],"n21":["vo","t"],"n22":"hay","n23":["Pa","i"],"n24":["ra","t"],"n25":["o","i"],"n26":["rar","t"],"n27":"a","n28":"Dios."},"verses":[{"label":"2.","lines":["Hasta el Santísimo Lugar","Nos trae Tu redención,","Tu Espíritu nos unge aquí","Y gracia nos da Dios."]},{"label":"3.","lines":["En nuestro espíritu, al orar","Nos posees Tú, Señor;","Así, como incienso, Tú","Tendrás Tu expresión."]},{"label":"4.","lines":["Tu gracia como un manantial","Viene del trono aquí,","Para llenar nuestra escasez,","¡Qué rico es su fluir!"]},{"label":"5.","lines":["No oramos por ningún afán,","Mas por Tu Espíritu;","Pues en casa necesidad","Cuidado brindas Tú."]},{"label":"6.","lines":["Aunque con pruebas y dolor,","No tengo ansiedad;","Echando todo en Ti, tendrá,","Mi espíritu la paz."]},{"label":"7.","lines":["Que enfocado esté, Señor,","Contigo en comunión;","Te ofrezco por Tu Espíritu","Mi incienso y oración."]}]}