{"hymn":"S657","parent":"E845","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Libera mi espíritu, Señor","subtitle":"La iglesia—Su edificación","syl":{"n1":["Li","i"],"n2":["be","m"],"n3":["ra","t"],"n4":"mi","n5":["es","i"],"n6":["pí","m"],"n7":["ri","m"],"n8":["tu,","t"],"n9":["Se","i"],"n10":["ñor,","t"],"n11":"Al","n12":"de","n13":"los","n14":["san","i"],"n15":["tos","t"],"n16":["en","i"],"n17":["tre","m"],"n18":["té","m"],"n19":["je","m"],"n20":["lo;","t"],"n21":["Li","i"],"n22":["bre","t"],"n23":"del","n24":"yo","n25":"y","n26":"mi","n27":["pri","i"],"n28":["va","m"],"n29":["ci","m"],"n30":["dad,","t"],"n31":["Po","i"],"n32":["dré","t"],"n33":["ca","i"],"n34":["ber","t"],"n35":"en","n36":["Tu‿e","i"],"n37":["di","m"],"n38":["fi","m"],"n39":["ca","m"],"n40":["ción.","t"]},"verses":[{"label":"2.","lines":["Libera mi espíritu, Señor,","Yo confinado no quiero quedar;","Ahogado estoy en mi ser natural.","Si no me libras, ¿qué me librará?"]},{"label":"3.","lines":["Libera mi espíritu, Señor,","Quiero escaparme de mi propio ser;","Tu Espíritu así ha de fluir","Y Tu presencia manifestaré."]},{"label":"4.","lines":["Libera mi espíritu, Señor,","Mi reclusión hoy quiero abandonar,","Me ha hecho pobre mi privacidad;","Salvo del yo, Tus bienes me darás."]},{"label":"5.","lines":["Libera mi espíritu, Señor,","No quiero en mis prisiones continuar;","Rompe el engaño que usa Satanás,","Del ego líbrame a Tu infinidad."]},{"label":"6.","lines":["Libera mi espíritu, Señor,","Que nunca el ego lo vuelva a atar;","Que con los santos me pueda mezclar,","En vida y Tus riquezas disfrutar."]}]}