{"hymn":"S103","parent":"E1100","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Dios, levántate triunfante","subtitle":"Alabanza al Señor—Su victoria y exaltación","syl":{"n1":"Dios,","n2":["le","i"],"n3":["ván","m"],"n4":["ta","m"],"n5":["te","t"],"n6":["triun","i"],"n7":["fan","m"],"n8":["te,","t"],"n9":"Los","n10":"que","n11":"te","n12":["o","i"],"n13":["dian","t"],"n14":["hui","i"],"n15":["rán;","t"],"n16":["Co","i"],"n17":["mo","t"],"n18":["ce","i"],"n19":["ra","t"],"n20":["an","i"],"n21":["te‿el","t"],"n22":["fue","i"],"n23":["go","t"],"n24":"Los","n25":["im","i"],"n26":["pí","m"],"n27":["os","t"],"n28":["des","i"],"n29":["trui","m"],"n30":["rás.","t"],"n31":"Mas","n32":["los‿jus","i"],"n33":["tos,","t"],"n34":"tan","n35":["glo","i"],"n36":["rio","m"],"n37":["sos,","t"],"n39":"Con","n40":["triun","i"],"n41":["fan","m"],"n42":["te‿voz,","t"],"n43":["go","i"],"n44":["zo","m"],"n45":["sos,","t"],"n47":["Con","i"],"n48":["ti","m"],"n49":["nú","m"],"n50":["an","t"],"n51":["a","i"],"n52":["la","m"],"n53":["ban","m"],"n54":["do,","t"],"n55":["A","i"],"n56":["la","m"],"n57":["ban","m"],"n58":["do","t"],"n59":"a","n60":"su","n61":"Dios."},"verses":[{"label":"2.","lines":["Cabalgando en el desierto,","A sus santos cuidará;","A los huérfanos es Padre,","Y‿un refugio de verdad","En Su santa‿habitación:","¡Qué grandiosa salvación!","¡Aleluya, aleluya!","¡Aleluya, amén!"]},{"label":"3.","lines":["El perdido‿halló su casa,","Y el afligido, hogar;","Prisioneros libertados,","Gozan hoy prosperidad.","Al rebaño - ¡oh qué gracia! -","Dios los trajo a Su casa;","¡Aleluya, aleluya!","¡Aleluya, amén!"]},{"label":"4.","lines":["El Señor las buenas nuevas","Manda con triunfal poder;","Las mujeres las propagan:","\"¡A los reyes venció Él!\"","Sin afán hoy disfrutamos","Del botín que heredamos;","¡Aleluya, aleluya!","¡Aleluya, amén!"]},{"label":"5.","lines":["Ved al Cristo ascendido,","Los cautivos Él llevó;","Él los constituye dones","Para Su habitación.","¡Somos hoy los transformados","Santos que‿Él ha conquistado!","¡Aleluya, aleluya!","¡Aleluya, amén!"]},{"label":"6.","lines":["Bendecid a Dios por siempre;","Diariamente salva Él","Al colmarnos con Él mismo;","¡Proclamadlo por doquier!","Él la muerte ha vencido,","Derrotando‿al enemigo;","¡Aleluya, aleluya!","¡Aleluya, amén!"]},{"label":"7.","lines":["Ellos vieron Tus salidas","En Tu santa‿habitación;","Y, con júbilo, alaban","Tu triunfante procesión.","Los cantores van delante","Con un gozo resonante.","¡Aleluya, aleluya!","¡Aleluya, amén!"]},{"label":"8.","lines":["Benjamín, el joven, guía;","A la diestra‿está, de Dios;","Con Judá y compañía,","Ved el cetro del León.","Zabulón y Neftalí,","Buenas nuevas dan allí.","¡Aleluya, aleluya!","¡Aleluya, amén!"]},{"label":"9.","lines":["Santos, vuestra fortaleza","Desde‿el templo se‿ordenó;","¡Oh, que Dios hoy fortalezca","Lo que Él ya realizó!","Alabemos hasta‿el día","Que la tierra‿en eco diga:","¡Aleluya, aleluya!","¡Aleluya, amén!"]}]}