{"hymn":"S181","parent":"E1106","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Señor, congregados comemos Tu cena","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":["con","i"],"n4":["gre","m"],"n5":["ga","m"],"n6":["dos","t"],"n7":["co","i"],"n8":["me","m"],"n9":["mos","t"],"n10":"Tu","n11":["ce","i"],"n12":["na,","t"],"n13":["Co","i"],"n14":["mien","m"],"n15":["do,","t"],"n16":["be","i"],"n17":["bien","m"],"n18":["do,","t"],"n19":"se","n20":["mues","i"],"n21":["tra","t"],"n22":["la‿u","i"],"n23":["nión;","t"],"n24":"Nos","n25":"das","n26":["Tu‿pre","i"],"n27":["sen","m"],"n28":["cia,","t"],"n29":["nues","i"],"n30":["tra‿u","m"],"n31":["ni","m"],"n32":["dad","t"],"n33":["se‿ex","i"],"n35":["pre","m"],"n36":["sa","t"],"n37":["Co","i"],"n38":["mien","m"],"n39":["do","t"],"n40":"y","n41":["be","i"],"n42":["bien","m"],"n43":["do","t"],"n44":"con","n45":"Tu","n46":["ben","i"],"n47":["di","m"],"n48":["ción.","t"]},"verses":[{"label":"2.","lines":["Comemos del pan que‿es Tu cuerpo partido,","Tu Cuerpo al ser uno se disfruta ya;","Un pan en la mesa, un Cuerpo que confiesa","Que‿en Ti, Señor, tenemos perfecta‿unidad."]},{"label":"3.","lines":["Bebemos también esta copa bendita,","Que‿es fiel comunión de Tu sangre, Señor;","Por fe redimidos, a todos recibimos,","Los que por redención han venido a Dios."]},{"label":"4.","lines":["Pues, ¿qué se dirá sino‿\"¡Amén, aleluya!\"?","Tu gracia nos trajo a tal realidad;","Tu sangre aplicando, Tu Cuerpo disfrutando;","Iglesia tan gloriosa así se obtendrá."]}]}