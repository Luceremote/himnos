{"hymn":"S342","parent":"E444","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Todo sea para Cristo","subtitle":"Consagración—Rendirlo todo al Señor","syl":{"n1":["¡To","i"],"n2":["do","t"],"n3":["se","i"],"n4":["a","t"],"n5":["pa","i"],"n6":["ra","t"],"n7":["Cris","i"],"n8":["to!","t"],"n9":"Lo","n10":"que","n11":["re","i"],"n12":["di","m"],"n13":["mió‿en","t"],"n14":"mi","n15":"ser,","n17":["To","i"],"n18":["da‿ac","m"],"n19":["ción,","t"],"n20":["to","i"],"n21":["da","t"],"n22":["pa","i"],"n23":["la","m"],"n24":["bra,","t"],"n25":["To","i"],"n26":["do","t"],"n27":["tiem","i"],"n28":["po","t"],"n29":"y","n30":["po","i"],"n31":["der.","t"],"n33":["¡To","i"],"n34":["do","t"],"n35":["se","i"],"n36":["a","t"],"n37":["pa","i"],"n38":["ra","t"],"n39":["Cris","i"],"n40":["to!","t"],"n41":["To","i"],"n42":["do","t"],"n43":["tiem","i"],"n44":["po","t"],"n45":"y","n46":["po","i"],"n47":["der.","t"],"n49":["¡To","i"],"n50":["do","t"],"n51":["se","i"],"n52":["a","t"],"n53":["pa","i"],"n54":["ra","t"],"n55":["Cris","i"],"n56":["to!","t"],"n57":["To","i"],"n58":["do","t"],"n59":["tiem","i"],"n60":["po","t"],"n61":"y","n62":["po","i"],"n63":["der.","t"]},"verses":[{"label":"2.","lines":["Que mis manos hagan Su‿obra,","Que‿en su senda‿estén mis pies,","Que mis ojos puedan verlo,","Que mi boca honor le dé.","//¡Todo sea para Cristo!","Que mi boca‿honor le dé.//"]},{"label":"3.","lines":["Este mundo‿estima joyas,","Pequeñeces sin valor;","Oro‿y fama‿es su jactancia;","Mi confianza‿es el Señor.","//¡Todo sea para Cristo!","Mi confianza‿es el Señor.//"]},{"label":"4.","lines":["Desde que me fijé‿en Cristo,","Nada‿atrae mi‿atención;","Al ver al Crucificado,","Me cautiva tal visión.","//¡Todo sea para Cristo!","Me cautiva tal visión.//"]},{"label":"5.","lines":["¡Qué precioso! ¡Qué‿asombroso!","Que Jesús, supremo Rey,","Se digne‿a llamrme‿amado,","Y que yo descanse‿en Él.","//¡Todo sea para Cristo!","Mi descanso‿en Él hallé.//"]}]}