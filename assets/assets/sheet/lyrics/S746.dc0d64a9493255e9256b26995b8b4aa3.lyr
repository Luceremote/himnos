{"hymn":"S746","parent":"E907","quality":"exact","adjust":{"hold":0,"merge":0},"title":"No donde elijamos ir","subtitle":"El servicio—Por la dirección del Señor","syl":{"n1":"No","n2":["don","i"],"n3":["de‿e","m"],"n4":["li","m"],"n6":["ja","m"],"n7":["mos","t"],"n8":"ir,","n9":"Mas","n10":["don","i"],"n11":["de","t"],"n12":["gui","i"],"n13":["e","t"],"n14":["Je","i"],"n15":["sús;","t"],"n16":"El","n17":["flu","i"],"n19":["ir","t"],"n20":"se","n21":["ha","i"],"n22":["lla‿a","m"],"n24":["llí,","t"],"n25":"Y","n26":"la","n27":["no","i"],"n28":["che","t"],"n29":["cam","i"],"n30":["bia‿a","t"],"n31":"luz."},"verses":[{"label":"2.","lines":["No aprobará el Señor","La obra de nuestra elección,","Mas la que nos asignó","Le traerá satisfacción."]},{"label":"3.","lines":["No es aquella oración","Que queramos suplicar,","Mas el profundo gemir","Que el Espíritu nos da."]},{"label":"4.","lines":["Ni una ofrenda aceptará","Cuando en altivez se da,","Si hemos respondido: \"No\",","A Su quieto susurrar."]},{"label":"5.","lines":["Al morir a nuestro yo,","Viviremos hoy con Dios;","Y al servir, orar y dar,","Cristo es nuestro Galardón."]}]}