{"hymn":"S681","parent":"E1225","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Conocerte como el Cuerpo","subtitle":"La iglesia—Como cuerpo de Cristo","syl":{"n1":["Co","i"],"n2":["no","m"],"n3":["cer","m"],"n4":["te","t"],"n5":["co","i"],"n6":["mo‿el","t"],"n7":["Cuer","i"],"n8":["po","t"],"n9":"Hoy","n10":"me","n11":["ur","i"],"n12":["ge,","t"],"n13":"mi","n14":["Se","i"],"n15":["ñor;","t"],"n16":"Que","n17":"te","n18":["ve","i"],"n19":["a","t"],"n20":"en","n21":"Tus","n22":["miem","i"],"n23":["bros,","t"],"n24":"Es","n25":["mi‿an","i"],"n26":["he","m"],"n27":["lo","t"],"n28":["y‿o","i"],"n29":["ra","m"],"n30":["ción.","t"],"n31":"No","n32":"tan","n33":["só","i"],"n34":["lo","t"],"n35":["ver","i"],"n36":["te","t"],"n37":["co","i"],"n38":["mo","t"],"n39":"Mi","n40":["ca","i"],"n41":["be","m"],"n42":["za‿in","m"],"n43":["di","m"],"n44":["vi","m"],"n45":["dual,","t"],"n46":["Si","i"],"n47":["no","t"],"n48":["co","i"],"n49":["mo‿el","t"],"n50":["en","i"],"n51":["car","m"],"n52":["na","m"],"n53":["do","t"],"n54":["Cris","i"],"n55":["to","t"],"n56":"que‿en","n57":"el","n58":["Cuer","i"],"n59":["po‿es","m"],"n60":["tá.","t"]},"verses":[{"label":"2.","lines":["Por los siglos Tus amados","Han buscado realidad","En lo alto‿o en lo‿interno,","Muy sedientos de Tu faz;","Mas el Cristo ascendido,","con Su cuerpo uno es;","Y el Cristo en nosotros,","En el Cuerpo hoy se ve."]},{"label":"3.","lines":["Tiendo a errar por mis conceptos,","Que en lo alto sólo estás;","En mí mismo yo te busco,","Sin tocar Tu realidad.","Cuánto necesito hallarte","En Tus miembros para ver","A Dios manifiesto en carne","Quien se da a conocer."]},{"label":"4.","lines":["¡Oh, detén mi independencia!","A Tu Cuerpo hazme acudir;","Quiero más que luz del cielo:","La iglesia percibir.","Haznos piedras para el templo,","No más barro sin valor;","Y que así, edificados,","Hoy seamos Tu expresión."]}]}