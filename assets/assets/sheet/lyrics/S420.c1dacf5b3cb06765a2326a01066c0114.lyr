{"hymn":"S420","parent":"E532","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"Tú, fuente oculta de mi paz","subtitle":"Experiencia de Cristo—Como aquel que es el todo","syl":{"n1":"Tú,","n2":["fuen","i"],"n3":["te‿o","m"],"n4":["cul","m"],"n6":["ta","t"],"n7":"de","n8":"mi","n9":"paz;","n10":"Tú,","n11":["su","i"],"n12":["fi","m"],"n13":["cien","m"],"n14":["te‿a","m"],"n15":["mor","t"],"n17":"de","n18":"Dios,","n19":["Re","i"],"n20":["fu","m"],"n21":["gio,‿a","m"],"n22":["yu","m"],"n23":["da‿y","t"],"n24":["pro","i"],"n26":["tec","m"],"n27":["ción;","t"],"n28":["Se","i"],"n29":["gu","m"],"n30":["ro‿en","t"],"n31":"Tí,","n32":["Je","i"],"n33":["sús,","t"],"n34":["es","i"],"n35":["toy;","t"],"n36":"De","n37":["cul","i"],"n38":["pa,","t","u"],"n39":0,"n40":["pe","i"],"n41":["na‿y","t"],"n43":["do","i"],"n44":["lor","t"],"n45":["Me‿es","i"],"n46":["con","m"],"n47":["do‿en","t"],"n48":"Ti,","n50":"mi","n51":"buen","n53":["Se","i"],"n54":["ñor.","t"]},"verses":[{"label":"2.","lines":["Mi todo‿en todo‿eres Jesús;","Eres descanso‿en mi labor;","La medicina‿al corazón;","En guerra,‿el Pacificador.","Frente al rival, Tú gozo das;","En mi vergüenza: gloria‿y paz."]},{"label":"3.","lines":["En mi‿escasez, me llenas más;","Si débil soy, poder me das;","Mi libertad, si‿atado‿estoy;","Mi luz en densa‿oscuridad;","Gozo‿inefable‿en el dolor;","Mi vida‿en muerte, mi Señor."]}]}