{"hymn":"S193","parent":"E244","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El Santo Espíritu de Dios","subtitle":"La plenitud del Espíritu—Como Espíritu de vida","syl":{"n1":"El","n2":["San","i"],"n3":["to‿Es","m"],"n4":["pí","m"],"n5":["ri","m"],"n6":["tu","t"],"n7":"de","n8":"Dios,","n9":["Es","i"],"n10":["pí","m"],"n11":["ri","m"],"n12":["tu","t"],"n13":"de","n14":["vi","i"],"n15":["da","t"],"n16":"es;","n17":"Me","n18":"da","n19":"la","n20":["vi","i"],"n21":["da","t"],"n22":["di","i"],"n23":["vi","m"],"n24":["nal,","t"],"n25":["Pa","i"],"n26":["ra","t"],"n27":["lo","i"],"n28":["grar","t"],"n29":"Su","n30":"buen","n31":["pla","i"],"n32":["cer.","t"]},"verses":[{"label":"2.","lines":["Como agua viva a mi sed,","De Su torrente vida da;","Al impartir a Cristo en mí","Mi hambre El satisfará."]},{"label":"3.","lines":["Como la luz de vida Él","Disipa toda oscuridad;","Al impartir a Cristo en mí","Mi noche en día cambiará."]},{"label":"4.","lines":["Infunde vida con poder","A todo mi hombre interior;","Al impartir a Cristo así","Se cumple en mí el plan de Dios."]},{"label":"5.","lines":["Él por Su ley de vida en mí","Me libra de la ley del mal;","Y por Su esencia divinal","Él siempre me regulará."]},{"label":"6.","lines":["Como el Espíritu en mi ser","Su vida fruto llevará;","Al expresar a Dios así,","Trae Cristo en vida a los demás."]},{"label":"7.","lines":["Por vida el Espíritu","Mi ser hoy transformando está;","Renueva todo mi interior,","Y a Cristo me conformará."]},{"label":"8.","lines":["Oh, que Tu Espíritu, Señor,","Me llene por completo a mí,","Con esa vida divinal,","Hasta que yo te exprese a Ti."]}]}