{"hymn":"S25","parent":"E29","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¿Qué fue, bendito Dios","subtitle":"Adoración al Padre—Su amor","syl":{"n1":"¿Qué","n2":"fue,","n3":["ben","i"],"n4":["di","m"],"n6":["to","t"],"n7":"Dios,","n9":"Lo","n10":"que‿a","n12":"Ti","n13":"te","n14":["lle","i"],"n15":["vó,","t"],"n17":"A","n18":"dar","n20":"a","n21":["Tu‿Hi","i"],"n23":["jo‿a","m"],"n24":["sí,","t"],"n26":"Por","n27":["to","i"],"n28":["do","t"],"n29":["pe","i"],"n31":["ca","m"],"n32":["dor?","t"],"n35":"Fue","n36":"por","n37":["Tu‿i","i"],"n39":["li","m"],"n40":["mi","m"],"n41":["ta","m"],"n42":["do‿a","m"],"n43":["mor,","t"],"n45":"Fue","n46":"por","n47":["Tu‿i","i"],"n49":["li","m"],"n50":["mi","m"],"n51":["ta","m"],"n52":["do‿a","m"],"n53":["mor,","t"],"n54":"Por","n55":"un","n56":["de","i"],"n57":["se","m"],"n58":["cho","t"],"n59":["pe","i"],"n61":["ca","m"],"n62":["dor.","t"]},"verses":[{"label":"2.","lines":["¿Por qué Tu Hijo, oh Dios,","Tu trono abandonó,","Su sangre derramó,","Y en una cruz murió?","Fue por Su ilimitado amor,","Fue por Su ilimitado amor,","Que por nosotros El murió."]},{"label":"3.","lines":["¿Qué te movió a verter","Tu Espíritu, oh Dios,","En nuestro corazón,","Con tal celeste don?","Fue ese ilimitado amor,","Fue ese ilimitado amor,","El que Tu Espíritu impartió."]},{"label":"4.","lines":["¡Oh, qué deuda de amor","Tu gracia nos legó!","Rebosa el corazón","Con eternal loor.","Que te alabemos, nuestro Dios,","Que te alabemos, nuestro Dios,","Por tal ilimitado amor."]}]}