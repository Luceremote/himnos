{"hymn":"S669","parent":"E860","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Bendito es el cordón","subtitle":"La iglesia—Su comunión","syl":{"n1":["Ben","i"],"n2":["di","m"],"n4":["to‿es","t"],"n5":"el","n7":["cor","i"],"n8":["dón","t"],"n9":["De‿a","i"],"n10":["mor","t"],"n12":"que","n13":"nos","n15":["u","i"],"n16":["nió;","t"],"n17":"Es","n18":["nues","i"],"n20":["tra","t"],"n21":["co","i"],"n23":["mu","m"],"n24":["nión","t"],"n26":["a","i"],"n27":["quí,","t"],"n29":"La","n30":["co","i"],"n32":["mu","m"],"n33":["nión","t"],"n35":"de","n36":"Dios."},"verses":[{"label":"2.","lines":["A nuestro Padre Dios","Oramos con fervor","Lo que hay en nuestro corazón,","En unidad y amor."]},{"label":"3.","lines":["Las cargas y el pesar","Nos place compartir;","Frecuentes lágrimas se dan","Al ver a otros sufrir."]},{"label":"4.","lines":["Al separarnos hay","Un interior dolor;","Mas somos uno en corazón","Y en cada reunión."]},{"label":"5.","lines":["De penas y el pecar,","Dios nos ha de librar;","Amor y unidad habrá","Por la eternidad."]}]}