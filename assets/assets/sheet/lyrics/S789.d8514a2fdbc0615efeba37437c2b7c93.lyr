{"hymn":"S789","parent":"E954","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Ya la luz del horizonte","subtitle":"Esperanza de gloria—El día de la coronación","syl":{"n1":"Ya","n2":"la","n3":"luz","n4":"del","n5":["ho","i"],"n6":["ri","m"],"n7":["zon","m"],"n8":["te","t"],"n9":["Rom","i"],"n10":["pe‿el","t"],"n11":["dí","i"],"n12":["a","t"],"n13":"tan","n14":["fe","i"],"n15":["liz","t"],"n16":"En","n17":"que","n18":"se","n19":["ve","i"],"n20":["rá","t"],"n21":"la","n22":["glo","i"],"n23":["ria","t"],"n24":"Del","n25":"gran","n26":"Rey","n27":"que‿ha","n28":"de","n29":["ve","i"],"n30":["nir.","t"],"n31":"La","n32":["vi","i"],"n33":["gi","m"],"n34":["lia","t"],"n35":"de","n36":"la","n37":["no","i"],"n38":["che","t"],"n39":["De","i"],"n40":["jó‿ex","m"],"n41":["haus","m"],"n42":["to‿al","t"],"n43":["co","i"],"n44":["ra","m"],"n45":["zón,","t"],"n46":"Mas","n47":"por","n48":"fin","n49":["se‿a","i"],"n50":["cer","m"],"n51":["ca‿el","t"],"n52":["dí","i"],"n53":["a","t"],"n54":"Con","n55":"su","n56":["triun","i"],"n57":["fan","m"],"n58":["te","t"],"n59":["can","i"],"n60":["ción.","t"]},"verses":[{"label":"2.","lines":["Palidecen las estrellas","Al brotar la claridad","De un alba tan gloriosa","Que ya quiere despertar.","Está el cielo muy radiante","Como el fuego en su esplendor;","Y en el corazón humano","Hay una esperanza hoy."]},{"label":"3.","lines":["Hay una quietud profunda","Y en el aire, expectación;","Y de Dios viene un aliento","Por ferviente oración.","El Jesús crucificado","Es el Cristo en gloria hoy;","Si sufrimos, también sufre,","Con nosotros el Señor."]},{"label":"4.","lines":["Quiere Dios tumbar barreras","Y el camino edificar;","A Sus ángeles Él llama","Para puertas levantar,","Mas son ángeles humanos","No una hueste celestial,","Pues el toque de Su armada","Es en nuestro palpitar."]},{"label":"5.","lines":["Escuchad en la distancia,","Se acrecienta un himno hoy","Por Jesús, el Rey triunfante,","Nuestro ungido Salvador;","Ve, oh Sión, a recibirlo,","Alma apúrate y trae","Lo más dulce y más querido","Para el Rey, nuestro Emanuel."]}]}