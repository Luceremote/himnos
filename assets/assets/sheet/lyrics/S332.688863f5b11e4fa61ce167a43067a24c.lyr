{"hymn":"S332","parent":"E432","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Oh, Amor que no me dejará","subtitle":"Consagración—Constreñidos por el amor del Señor","syl":{"n1":"Oh,","n2":["A","i"],"n3":["mor","t"],"n4":"que","n5":"no","n6":"me","n7":["de‿ja","i"],"n8":["rá,","t"],"n10":["Re","i"],"n11":["po","m"],"n12":["so","t"],"n13":["mi‿al","i"],"n14":["ma","t"],"n15":"hoy","n16":"en","n17":"Ti;","n19":"Mi","n20":["vi","i"],"n21":["da‿es","t"],"n22":["Tu","i"],"n23":["ya,","t"],"n24":["tó","i"],"n25":["ma","m"],"n26":["la,","t"],"n28":["Pa","i"],"n29":["ra","t"],"n30":"que‿en","n31":"Tu","n32":["pro","i"],"n33":["fun","m"],"n34":["di","m"],"n35":["dad,","t"],"n36":"En","n37":"Ti,","n38":["pue","i"],"n39":["da","t"],"n40":["flu","i"],"n41":["ir.","t"]},"verses":[{"label":"2.","lines":["Oh, Luz que‿alumbra mi andar,","Mi‿antorcha cedo ante Ti;","Mi corazón postrado‿está,","Para que‿así, por Tu‿alumbrar,","Su día brille más."]},{"label":"3.","lines":["Oh, Gozo‿en medio del dolor,","No me podré cerrar a Ti;","Tu arco iris veo yo,","Tu fiel promesa; si llovió,","Yo sé que‿el sol saldrá."]},{"label":"4.","lines":["Oh, Cruz que alza hoy mi faz,","De Ti no me atrevo huir;","Muere la gloria terrenal,","Mas de la tierra brotará","Tu vida eternal."]}]}