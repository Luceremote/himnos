{"hymn":"S517","parent":"E626","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Si no se exprime la oliva","subtitle":"El camino de la cruz—Ganar al perder","syl":{"n1":"Si","n2":"no","n3":["se‿ex","i"],"n4":["pri","m"],"n5":["me","t"],"n6":["la‿o","i"],"n7":["li","m"],"n8":["va,","t"],"n10":["A","i"],"n11":["cei","m"],"n12":["te","t"],"n13":["no‿ha","i"],"n14":["brá;","t"],"n16":"Si","n17":"no","n18":"se","n19":["pi","i"],"n20":["san","t"],"n21":"las","n22":["u","i"],"n23":["vas,","t"],"n25":["Vi","i"],"n26":["no","t"],"n27":"no","n28":"se","n29":["ob","i"],"n30":["ten","m"],"n31":["drá;","t"],"n33":"Si","n34":"no","n35":"se","n36":["ma","i"],"n37":["cha","m"],"n38":["ca‿el","t"],"n39":["nar","i"],"n40":["do,","t"],"n42":["Su‿o","i"],"n43":["lor","t"],"n44":"no","n45":["sal","i"],"n46":["drá;","t"],"n48":["¿Re","i"],"n49":["hui","m"],"n50":["ré","t"],"n51":"los","n52":["su","i"],"n53":["fri","m"],"n54":["mien","m"],"n55":["tos","t"],"n57":"Que","n58":["Tu‿a","i"],"n59":["mor","t"],"n60":"me","n61":["pro","i"],"n62":["vee","m"],"n63":["rá?","t"],"n65":"Con","n66":["ca","i"],"n67":["da","t"],"n68":["gol","i"],"n69":["pe","t"],"n71":["Ga","i"],"n72":["nan","m"],"n73":["cia","t"],"n74":"me","n75":"das;","n77":"En","n78":["lu","i"],"n79":["gar","t"],"n80":"de","n81":"lo","n82":"que","n83":["qui","i"],"n84":["tas","t"],"n86":"A","n87":"Ti","n88":["mis","i"],"n89":["mo","t"],"n90":"Tú","n91":"me","n92":"das."},"verses":[{"label":"2.","lines":["¿Necesitas compungirme","Para dar loor?","¿Para eso es necesario","Un cruel trato de Tu amor?","Privación, Señor, no temo,","Si me lleva a Ti;","Plenamente yo me rindo","Para ver Tu amor por mí."]},{"label":"3.","lines":["Señor, siento hoy vergüenza,","Mi ego protegí;","Aunque Tú me has podado,","Tu tratar yo resistí.","Tu deseo sea cumplido","Obra Tú en mí;","Sin mirar mis sentimientos,","Haz lo que te plazca a Ti."]},{"label":"4.","lines":["Aunque yo no esté de acuerdo,","Sea Tu voluntad;","Si te place darme penas,","El \"Amén\" te quiero dar.","Mi deseo es agradarte,","Aunque sufra más;","Por Tu complacencia y gloria","Yo la cruz quiero llevar."]},{"label":"5.","lines":["Aún con lágrimas, te alabo,","Ésta es mi canción;","Tu dulzura que aumenta,","Hoy me trae inspiración.","Más preciado a mí te has hecho,","Todo eres, Señor;","Que Tú crezcas y yo mengüe","Es mi anhelo y oración."]}]}