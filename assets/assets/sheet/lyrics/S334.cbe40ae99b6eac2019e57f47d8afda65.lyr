{"hymn":"S334","parent":"E434","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, ganaste Tú por fin","subtitle":"Consagración—Constreñidos por el amor del Señor","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":["ga","i"],"n4":["nas","m"],"n5":["te","t"],"n6":"Tú","n7":"por","n8":"fin;","n10":"Tu","n11":["gra","i"],"n12":["cia","t"],"n13":"me","n14":["o","i"],"n15":["bli","m"],"n16":["ga‿a","m"],"n18":["sí","t"],"n20":"A","n22":["dar","i"],"n24":["te‿el","t"],"n26":["co","i"],"n27":["ra","m"],"n28":["zón.","t"],"n29":["Po","i"],"n30":["drí","m"],"n31":["a","t"],"n33":["re","i"],"n34":["sis","m"],"n36":["tir","t"],"n38":["te","i"],"n40":["rror,","t"],"n41":"Mas","n42":"no","n43":"Tu","n45":["in","i"],"n46":["fi","m"],"n48":["ni","m"],"n50":["to‿a","m"],"n52":["mor;","t"],"n54":["Tu‿a","i"],"n55":["mor","t"],"n56":"me","n58":["con","i"],"n59":["quis","m"],"n60":["tó.","t"]},"verses":[{"label":"2.","lines":["Mi terquedad se derritió.","No por Tus rayos y‿el temor,","Mas por Tu gran merced.","Me subyugó Tu‿inmenso‿amor,","Vi al sangrante Salvador;","Hoy odio mi vil ser."]},{"label":"3.","lines":["Ven, hazme ya Tu posesión;","Soy sólo Tuyo, mi Señor;","Me liberaste Tú,","Me desataste de Satán,","Y mis poderes ahora están","A Tus pies, mi Jesús."]}]}