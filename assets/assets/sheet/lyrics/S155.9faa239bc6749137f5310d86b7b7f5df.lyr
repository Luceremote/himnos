{"hymn":"S155","parent":"E196","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Las figuras del pasado","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"Las","n2":["fi","i"],"n3":["gu","m"],"n4":["ras","t"],"n5":"del","n6":["pa","i"],"n7":["sa","m"],"n9":["do,","t"],"n10":["Sím","i"],"n11":["bo","m"],"n12":["los","t"],"n13":"y","n14":["ti","i"],"n15":["pos","t"],"n16":"son","n18":"Que,","n19":["Se","i"],"n20":["ñor,","t"],"n21":"te","n22":["mues","i"],"n23":["tran","t"],"n24":["co","i"],"n26":["mo","t"],"n27":["To","i"],"n28":["da","t"],"n29":["nues","i"],"n31":["tra","t"],"n33":["pro","i"],"n34":["vi","m"],"n35":["sión.","t"],"n36":["Con","i"],"n37":["tem","m"],"n38":["plan","m"],"n39":["do","t"],"n40":["ta","i"],"n41":["les","t"],"n42":["cua","i"],"n44":["dros,","t"],"n45":["Im","i"],"n46":["pre","m"],"n47":["sio","m"],"n48":["na","t"],"n49":["su‿es","i"],"n50":["plen","m"],"n51":["dor.","t"],"n53":["Ad","i"],"n54":["mi","m"],"n55":["ran","m"],"n56":["do","t"],"n57":"Tus","n58":["ri","i"],"n59":["que","m"],"n61":["zas,","t"],"n62":["Te‿a","i"],"n63":["do","m"],"n64":["ra","m"],"n66":["mos","t"],"n68":"con","n69":["fer","i"],"n70":["vor.","t"]},"verses":[{"label":"2.","lines":["Señor, nuestra Pascua eres;","Dios por Ti nos perdonó.","Por Tu redención gozamos","Armonía hoy con Dios.","El Cordero de Dios eres,","Tu rescate nos libró.","Aplicamos hoy Tu sangre","Al comer de Ti, Señor."]},{"label":"3.","lines":["Eres pan sin levadura,","El pan vivo celestial;","Al comerte, nos mezclamos","Y nos libras del pecar.","El Cordero y‿el Pan muestran","Que‿eres nuestra vida, Tú;","Disfrutamos en Tu mesa","De Tu rica plenitud."]},{"label":"4.","lines":["Eres el Maná del cielo,","Nuestra diaria provisión;","Fortaleces, vigorizas","Y nos das satisfacción.","Eres Tú la Piedra viva","Que, hendida, agua dio.","Al beber del agua viva,","Toda nuestra sed sació."]},{"label":"5.","lines":["Tierra de Canaán Tu eres,","Rica, buena,‿en ascensión.;","Ella fluye miel y leche","En gloriosa profusión.","Con Tus ricos excedentes","Te‿alabamos en unión.","En tal comunión gloriosa","Somos Tu‿edificación."]}]}