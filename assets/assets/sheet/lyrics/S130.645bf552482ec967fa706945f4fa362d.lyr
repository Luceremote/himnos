{"hymn":"S130","parent":"E163","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh, si tuviera lenguas mil","subtitle":"Alabanza al Señor—Su gracia","syl":{"n1":"Oh,","n2":"si","n3":["tu","i"],"n4":["vie","m"],"n5":["ra","t"],"n6":["len","i"],"n7":["guas","t"],"n8":"mil","n9":["Pa","i"],"n10":["ra","t"],"n11":"mi","n12":["Re","i"],"n13":["den","m"],"n14":["tor,","t"],"n15":["Da","i"],"n16":["rí","m"],"n17":["a","t"],"n18":["glo","i"],"n19":["rias","t"],"n20":"a","n21":"mi","n22":"Rey","n23":"Por","n25":"Su","n26":["triun","i"],"n27":["fan","m"],"n28":["te‿a","m"],"n29":["mor.","t"]},"verses":[{"label":"2.","lines":["Amable Amo y mi Dios,","Aliéntame, Señor,","A propagar por tierra y mar","Tu Nombre‿y Tu honor."]},{"label":"3.","lines":["Jesús, Tu Nombre vida da","Y vence el temor,","Trae salvación, salud y paz","A todo pecador."]},{"label":"4.","lines":["Me cautivó Su gran amor,","Cautivo seré yo;","Pues fue vejado y murió,","Y mi alma liberó."]},{"label":"5.","lines":["Rompe‿el pecado‿y su poder,","Da‿al preso libertad;","Hasta‿al más vil puede limpiar","Su sangre eficaz."]},{"label":"6.","lines":["Tu Nombre‿ahora debo‿amar,","Y‿hacer Tu voluntad;","Mil corazones, oh Señor,","A Ti quisiera dar."]}]}