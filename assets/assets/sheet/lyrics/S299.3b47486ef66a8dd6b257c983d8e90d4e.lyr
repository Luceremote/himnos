{"hymn":"S299","parent":"E1133","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Concédeme, Padre un espíritu hoy","subtitle":"Anhelos—De tener comunión con Cristo","syl":{"n1":["Con","i"],"n2":["cé","m"],"n3":["de","m"],"n4":["me,","t"],"n5":["Pa","i"],"n6":["dre","t"],"n7":"un","n8":["es","i"],"n9":["pí","m"],"n10":["ri","m"],"n11":["tu‿hoy","t"],"n12":"De","n13":["sa","i"],"n14":["bi","m"],"n15":["du","m"],"n16":["rí","m"],"n17":["a","t"],"n18":"y","n19":["re","i"],"n20":["ve","m"],"n21":["la","m"],"n22":["ción,","t"],"n23":["Pa","i"],"n24":["ra","t"],"n25":"que","n26":["co","i"],"n27":["noz","m"],"n28":["ca","t"],"n30":"en","n31":["ple","i"],"n32":["no‿al","t"],"n33":["Se","i"],"n34":["ñor","t"],"n35":"Al","n36":"ser","n38":["a","i"],"n40":["lum","m"],"n41":["bra","m"],"n42":["do","t"],"n43":"en","n44":"mi","n45":["co","i"],"n46":["ra","m"],"n47":["zón.","t"]},"verses":[{"label":"2.","lines":["Enséñame al Cristo que vive en mi ser,","¡Oh, qué esperanza de gloria es Él!","Él todo en todo será‿en mi interior:","Riquezas de gloria, y‿herencia de Dios."]},{"label":"3.","lines":["Oh Padre, permíteme que pueda ver","Toda la grandeza de este poder","Que resucitó a Jesús el Señor,","Y‿así por Cabeza al Cuerpo lo dio."]},{"label":"4.","lines":["Todo‿este poder has forjado, oh Dios,","En Cristo, Tu Hijo, que vive‿en mí hoy;","Permite que vea que tal gran poder","Es una Persona que mora‿en mi ser."]},{"label":"5.","lines":["Cristo‿es mi esperanza, mi gloria,‿y poder,","Como mi Persona yo lo tomaré;","Entonces en mí Su poder actuará","Y mi esperanza de gloria Él será."]}]}