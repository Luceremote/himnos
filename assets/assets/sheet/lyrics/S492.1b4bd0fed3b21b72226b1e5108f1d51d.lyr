{"hymn":"S492","parent":"E599","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Yo ciego fui; no pude ver","subtitle":"Experiencia de Cristo—General","syl":{"n1":"Yo","n2":["cie","i"],"n3":["go","t"],"n4":"fui;","n5":"no","n7":["pu","i"],"n8":["de","t"],"n10":"ver","n11":"La","n12":["gra","i"],"n13":["cia","t"],"n14":"en","n16":["Tu‿he","i"],"n18":["ri","m"],"n19":["da","t"],"n20":"faz;","n21":"Mas","n22":"hoy","n23":["Tu‿her","i"],"n24":["mo","m"],"n25":["so","t"],"n26":["ros","i"],"n27":["tro‿a","m"],"n28":["quí","t"],"n29":"Yo","n30":["ve","i"],"n31":["o","t"],"n32":"en","n33":"su","n35":["es","i"],"n36":["plen","m"],"n38":["dor.","t"]},"verses":[{"label":"2.","lines":["Yo sordo fui; no pude oír","La melodía de Tu voz;","Mas hoy Te oigo, ¡qué placer!","Preciosas Tus palabras son."]},{"label":"3.","lines":["Yo mudo fui; jamás conté","La gloria de Tu nombre fiel;","Tu fuego, mis labios tocó,","Y‿ahora, siempre‿alabo yo."]},{"label":"4.","lines":["Yo muerto estuve: no logré","Llevar mi alma muerta a Ti;","Mas hoy Tu vida a mi llegó,","Y del sepulcro salgo yo."]},{"label":"5.","lines":["Por Ti, Jesús, el ciego vio,","El sordo oyó, el mudo habló,","El muerto vive, y hoy yo,","Soy libre de la esclavitud."]}]}