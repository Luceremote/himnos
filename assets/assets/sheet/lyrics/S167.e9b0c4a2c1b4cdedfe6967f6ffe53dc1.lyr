{"hymn":"S167","parent":"E208","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Jesús, Jesús, oh mi Señor","subtitle":"Alabanza al Señor—Satisfacción con Él","syl":{"n1":["¡Je","i"],"n2":["sús,","t"],"n3":["Je","i"],"n4":["sús,","t"],"n5":"oh","n6":"mi","n7":["Se","i"],"n8":["ñor!","t"],"n9":"Yo","n10":["a","i"],"n11":["mo","t"],"n12":["re","i"],"n14":["pe","m"],"n15":["tir","t"],"n17":"Tu","n18":["san","i"],"n19":["to","t"],"n20":["nom","i"],"n22":["bre","t"],"n23":"por","n24":["a","i"],"n25":["mor","t"],"n26":"Mil","n27":["ve","i"],"n28":["ces","t"],"n29":["ha","i"],"n31":["cia","t"],"n32":"Ti.","n34":["Se","i"],"n35":["ñor","t"],"n36":["Je","i"],"n37":["sús,","t"],"n38":["ha","i"],"n39":["bi","m"],"n40":["ta‿en","t"],"n41":"mí,","n42":"Tú","n43":["e","i"],"n44":["res","t"],"n45":"mi","n46":["sa","i"],"n47":["tis","m"],"n48":["fac","m"],"n49":["ción,","t"],"n50":"Tu","n51":["mis","i"],"n52":["mo","t"],"n53":"ser","n54":"es","n55":"mi","n56":["por","i"],"n57":["ción,","t"],"n58":["Te‿a","i"],"n59":["mo,","t"],"n60":["te‿a","i"],"n61":["mo,","t"],"n63":["Se","i"],"n64":["ñor.","t"]},"verses":[{"label":"2.","lines":["Te amo tanto que no sé","Tal éxtasis domar;","Tu‿amor es como‿un fuego‿en mí","Que arde sin cesar."]},{"label":"3.","lines":["Tú eres todo para mí,","Mis bienes y mi‿honor,","Salud eterna‿a mi alma das,","Y al cuerpo su vigor."]},{"label":"4.","lines":["Que arda‿en mí Tu gran amor,","Con fuerza‿y sin parar,","Hasta que toda‿escoria‿en mí","Se pueda‿incinerar."]},{"label":"5.","lines":["En pena, gozo;‿en sombra, luz,","¡Oh, vida celestial!","Jesús, mi‿amor, mi galardón,","¿Quién te podrá valuar?"]},{"label":"6.","lines":["¿Qué límite‿hay para‿este amor?","¿Cuán lejos su poder?","¡Seguid! Más dulce es el Señor","De lo que fue ayer."]}]}