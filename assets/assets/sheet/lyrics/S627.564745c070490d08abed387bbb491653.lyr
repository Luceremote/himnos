{"hymn":"S627","parent":"E812","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Vengo a Ti, Señor","subtitle":"El estudio de la palabra—Alimentarnos de la palabra","syl":{"n1":["Ven","i"],"n2":["go","t"],"n3":"a","n4":"Ti,","n5":["Se","i"],"n6":["ñor,","t"],"n7":"De","n8":"Ti","n9":"yo","n10":["ten","i"],"n11":["go","t"],"n12":"sed;","n13":["Be","i"],"n14":["ber","t"],"n15":"de","n16":"Ti,","n17":["co","i"],"n18":["mer","t"],"n19":"de","n20":"Ti,","n21":"Es","n22":"mi","n24":["ma","i"],"n25":["yor","t"],"n26":["pla","i"],"n27":["cer.","t"]},"verses":[{"label":"2.","lines":["Clama mi corazón","Sólo mirar Tu faz;","Beber de Ti anhelo yo,","Hasta mi sed saciar."]},{"label":"3.","lines":["Desea mi corazón","Ver Tu gloriosa faz;","Yo quiero así permanecer,","Fiel, contemplándola."]},{"label":"4.","lines":["En esta comunión,","Eres la gracia en mí;","De regocijo llenó estoy,","Y descansando en Ti."]},{"label":"5.","lines":["Aquí me quedaré","Buscando más de Ti,","En la Palabra y oración,","Hasta el fluir sentir."]}]}