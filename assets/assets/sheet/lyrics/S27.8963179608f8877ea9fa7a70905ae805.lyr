{"hymn":"S27","parent":"E32","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Postrados, Padre, en Tu luz","subtitle":"Adoración al Padre—Su intención","syl":{"n1":["Pos","i"],"n2":["tra","m"],"n4":["dos,","t"],"n5":["Pa","i"],"n6":["dre,","t"],"n7":"en","n9":"Tu","n10":"luz,","n11":["Ma","i"],"n12":["ra","m"],"n14":["vi","m"],"n15":["lla","m"],"n17":["dos","t"],"n18":"por","n20":["Tu‿a","i"],"n21":["mor,","t"],"n22":"Oh,","n23":"¿qué‿es","n25":"el","n27":["hom","i"],"n28":["bre","t"],"n29":["pa","i"],"n30":["ra","t"],"n31":"que","n32":"Le","n34":["brin","i"],"n36":["des","t"],"n37":"tal","n39":["gra","i"],"n40":["cia‿y","t"],"n42":["fa","i"],"n43":["vor?","t"]},"verses":[{"label":"2.","lines":["Damos loor por Tu intención,","El hombre es Tu imagen fiel,","Y por Tu vida eterna en él","Puede expresar Tu mismo ser."]},{"label":"3.","lines":["Tu misma imagen lleva él,","Le diste Tu autoridad;","Eres la vida para que","El hombre en ella pueda andar."]},{"label":"4.","lines":["Deseas en el hombre entrar","Para mezclarte con su ser;","Al transformarle obtendrás","Tu digna habitación en él."]},{"label":"5.","lines":["Aunque ese hombre sí cayó,","No abandonaste Tu intención;","Lo redimiste para Ti","Probando así Tu gran amor."]},{"label":"6.","lines":["Te revelaste en Cristo Tú,","Por muerte y resurrección;","Eres Espíritu que‿entró","Al hombre y vida le‿infundió."]},{"label":"7.","lines":["Hoy Tu Santísimo Lugar","En nuestro espíritu está.","El trono de la gracia allí","En oración tocamos ya."]},{"label":"8.","lines":["De ese trono un caudal","De gracia fluye sin cesar;","Por ella nos transformarás","Hasta Tu casa edificar."]},{"label":"9.","lines":["Al recibir Tu gracia hoy,","¡Gratuito don al corazón!","Padre, en nuestro espíritu","Gracias te damos por Tu amor."]}]}