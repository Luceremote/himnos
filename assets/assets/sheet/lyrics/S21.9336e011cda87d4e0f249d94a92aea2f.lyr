{"hymn":"S21","parent":"E25","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Nos otorgaste, Padre, Tu merced","subtitle":"Adoración al Padre—Su misericordia","syl":{"n1":"Nos","n2":["o","i"],"n3":["tor","m"],"n4":["gas","m"],"n5":["te,","t"],"n6":["Pa","i"],"n7":["dre,","t"],"n8":"Tu","n9":["mer","i"],"n10":["ced,","t"],"n12":"Por","n13":"Tu","n14":["fa","i"],"n15":["vor;","t"],"n16":"De","n17":["pe","i"],"n18":["ca","m"],"n19":["do","m"],"n20":["res,","t"],"n21":"Tu","n22":["lo","i"],"n23":["gras","m"],"n24":["te‿ha","m"],"n25":["cer","t"],"n27":["Hi","i"],"n28":["jos","t"],"n29":["de‿a","i"],"n30":["mor.","t"],"n32":["Va","i"],"n33":["sos","t"],"n34":["de‿ho","i"],"n35":["nor","t"],"n36":"Tú","n37":"nos","n38":["hi","i"],"n39":["cis","m"],"n41":["te,‿oh","t"],"n43":"Dios;","n44":["Va","i"],"n45":["sos","t"],"n46":"de","n47":["hon","i"],"n48":["ra","t"],"n49":"que","n50":["te‿ex","i"],"n51":["pre","m"],"n53":["san","t"],"n54":"hoy."},"verses":[{"label":"2.","lines":["Misericordia hoy deseas ver,","Dijiste Tú;","Por ella, Tu favor, nos haces ser","Hijos de luz.","No es de‿aquel que puede correr bien,","Sino de Dios que muestra Su merced."]},{"label":"3.","lines":["Padre, Tu amor, Tu gracia y piedad","Hoy nuestros son;","Y cara‿a cara nos han de guardar","En comunión.","Por siempre‿a Ti daremos todo honor","Por Tu misericordia‿y gran favor."]}]}