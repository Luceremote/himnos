{"hymn":"S840","parent":"E996","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh Jesús, Hijo de Dios","subtitle":"El evangelio—La redención","syl":{"n1":"Oh","n2":["Je","i"],"n3":["sús,","t"],"n4":["Hi","i"],"n5":["jo","t"],"n6":"de","n7":"Dios,","n8":["Sal","i"],"n9":["va","m"],"n10":["dor","t"],"n11":"del","n13":["pe","i"],"n14":["ca","m"],"n15":["dor;","t"],"n16":"De","n17":["ca","i"],"n18":["de","m"],"n19":["nas,","t"],"n20":["rom","i"],"n21":["pe","m"],"n22":["dor,","t"],"n23":"Y","n24":"de","n25":["man","i"],"n26":["chas,","t"],"n27":["lim","i"],"n28":["pia","m"],"n29":["dor.","t"]},"verses":[{"label":"2.","lines":["Tú moriste en la cruz,","Nuestro sustituto, Tú;","Y Tu carne se rasgó","Por nuestro pecado atroz."]},{"label":"3.","lines":["Con Su sangre nos compró","El Cordero redentor;","Toda culpa nos quitó,","Nuestra deuda Él saldó."]},{"label":"4.","lines":["Nada queda por obrar,","Nada queda por cargar,","Sólo Su perdón y amor,","Su luz, paz y bendición."]},{"label":"5.","lines":["Al mirarte, viviré;","Al mirarte, alabaré;","Al mirarte hay sanidad,","Alegría y claridad."]},{"label":"6.","lines":["Oh Jesús, Hijo de Dios,","Salvador del pecador,","Siempre te contemplaré,","Te amaré y alabaré."]}]}