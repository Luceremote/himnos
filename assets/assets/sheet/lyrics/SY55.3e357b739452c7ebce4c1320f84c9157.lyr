{"hymn":"SY55","parent":"NS10066","quality":"adapted","adjust":{"hold":1,"merge":3},"title":"¿Qué te llevó a morir por mí","subtitle":"","syl":{"n1":"¿Qué","n2":"te","n3":["lle","i"],"n4":["vó‿a","t"],"n5":["mo","i"],"n6":["rir","t"],"n7":"por","n8":"mí?","n10":["¿Mo","i"],"n11":["rir","t"],"n12":"por","n13":"mí","n14":"quien","n15":["Tu‿e","i"],"n17":["ne","m"],"n18":["mi","m"],"n19":["go","t"],"n20":"fui?","n22":["To","i"],"n23":["mas","m"],"n24":["te","t"],"n25":"en","n26":"la","n27":"cruz","n29":"mi","n30":["lu","i"],"n32":["gar,","t"],"n33":["Mal","i"],"n34":["di","m"],"n37":["to,","t"],"n39":["mal‿di","i"],"n41":["to,","t"],"n43":["lle‿gas","i"],"n45":["te‿a","t"],"n46":"ser.","n48":["Tu‿a","i"],"n49":["mor","t"],"n50":"me","n51":["con","i"],"n52":["quis","m"],"n53":["tó,","t"],"n55":["Ven","i"],"n56":["ci","m"],"n57":["do‿hoy‿es","m"],"n58":["toy;","t"],"n59":["Vi‿nis","i"],"n60":["te‿a","t"],"n62":"mí","n63":"con","n64":"Tu","n65":["a","i"],"n66":["mor.","t"],"n67":["Na","i"],"n68":["da‿an","m"],"n69":["tes","t"],"n71":"me","n72":["cam","i"],"n73":["bi","m"],"n74":["ó,","t"],"n75":["Pe","i"],"n76":["ro","t"],"n78":["Tu‿a","i"],"n79":["mor","t"],"n80":["ven","i"],"n81":["ci","m"],"n82":["ó.","t","u"],"n83":0,"n85":["¡Tu‿a","i"],"n86":["mor,","t"],"n87":["Se","i"],"n88":["ñor,","t"],"n89":"me","n90":["con","i"],"n91":["quis","m"],"n92":["tó!","t"]},"verses":[{"label":"2.","lines":["Nunca pensé que eras un Ser,","Lleno de amor, bondad y compasión.","¿Cómo Señor? ¿Por qué me amaste Tú?","Te odiaba, me amaste, ¡Te amo, Jesús!"]},{"label":"3.","lines":["Por largo tiempo amaste Tú,","Perseverante y fuerte, tal amor.","Yo te maldije y escarnecí,","Paciente orabas, orabas por mí."]},{"label":"4.","lines":["Un hombre de pecado fui,","Pecaminoso sucio mi vivir.","Mi corazón rebelde hacia Ti;","Tocaste mi alma con Tu compasión."]},{"label":"5.","lines":["Volví mi corazón a Ti,","Estabas esperándome ahí.","¿Podría aún Tu enemigo ser?","No puedo, Tu amor, Jesús me ganó."]}]}