{"hymn":"S156","parent":"E197","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Todo-inclusivo eres, Señor","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":["To","i"],"n2":["do","m"],"n3":["-in","m"],"n4":["clu","m"],"n5":["si","m"],"n6":["vo‿e","m"],"n8":["res,‿Se","m"],"n9":["ñor,","t"],"n10":"En","n11":"Ti","n13":"nos","n14":["pu","i"],"n16":["so","t"],"n17":"Dios;","n19":"Y","n20":"a","n21":["no","i"],"n22":["so","m"],"n23":["tros","t"],"n24":"te","n26":["le","i"],"n27":["gó","t"],"n28":["Co","i"],"n29":["mo","t"],"n31":["nues","i"],"n32":["tra","t"],"n34":["por","i"],"n35":["ción.","t"]},"verses":[{"label":"2.","lines":["Sabiduría eres de Dios,","Por Ti Él nos salvó;","No‿existe otro modo hoy","Para la salvación."]},{"label":"3.","lines":["Justicia nuestra eres Tú,","Lo que requiere Dios;","En Ti Él nos justificó,","En Ti nos completó."]},{"label":"4.","lines":["Tú eres nuestra santidad,","Para transformación;","Santificándonos estás","Para conformación."]},{"label":"5.","lines":["Tú eres nuestra redención,","Seremos como Tú;","Dios nuestros cuerpos cambiará","Con gloria y virtud."]},{"label":"6.","lines":["Al recordarte‿aquí, Señor,","Te disfrutarnos más;","Quisiéramos apresurar","Tu reino celestial."]},{"label":"7.","lines":["¡Qué dulce es tal presabor!","Nos trae satisfacción;","Mas esperamos lo mejor:","Tu manifestación."]}]}