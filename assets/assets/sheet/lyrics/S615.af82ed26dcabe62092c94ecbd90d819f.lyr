{"hymn":"S615","parent":"E794","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Avívame Señor, y logra ya","subtitle":"Oración—Por el mundo entero","syl":{"n1":["A","i"],"n2":["ví","m"],"n3":["va","m"],"n4":["me","t"],"n5":["Se","i"],"n6":["ñor,","t"],"n7":"y","n8":["lo","i"],"n9":["gra","t"],"n10":"ya,","n11":"Que","n12":"por","n13":"el","n14":["mun","i"],"n15":["do","t"],"n16":["sien","i"],"n17":["ta","t"],"n18":"yo","n19":["pa","i"],"n20":["sión;","t"],"n21":["A","i"],"n22":["ví","m"],"n23":["va","m"],"n24":["me","t"],"n25":"a","n26":"ir,","n27":"a","n28":"dar","n29":["y‿o","i"],"n30":["rar,","t"],"n31":"Que","n32":"Tu","n33":["ban","i"],"n34":["de","m"],"n35":["ra","t"],"n36":["o","i"],"n37":["tros","t"],"n38":["ve","i"],"n39":["an","t"],"n40":"hoy","n41":"En","n42":["tie","i"],"n43":["rras","t"],"n44":["don","i"],"n45":["de","t"],"n46":"hay","n47":["os","i"],"n48":["cu","m"],"n49":["ri","m"],"n50":["dad","t"],"n51":"Y‿en","n52":"los","n53":["de","i"],"n54":["sier","m"],"n55":["tos","t"],"n56":["don","i"],"n57":["de","t"],"n58":"cruz","n59":"no","n60":"hay."},"verses":[{"label":"2.","lines":["Avíva hoy Señor mi corazón,","Que por las almas sienta compasión;","Hasta que Tu palabra me haga orar,","Y me constriñas con todo Tu amor.","De norte a sur, que ardas en mi ser,","De oeste a este, haz Tu fuego arder."]},{"label":"3.","lines":["Avívame a orar aun con dolor,","Hasta llenar de gozo mi oración;","Mi corazón, mi mente y voluntad:","Que todo tuyo sea mi Señor.","Hasta que intensamente aprenda a orar","Y con expectación sepa esperar."]},{"label":"4.","lines":["Avívame, oh, hazme como Tú,","Que, por el fuego intenso de Tu amor,","Tú entregaste a Tu Unigénito","Para morir y ser mi vida hoy.","Avívame para entregarme a Ti;","Alcanza a otros por medio de mí."]},{"label":"5.","lines":["Avívame Señor, pues puedo ver,","Que Tu radiante día cerca está;","Vislumbra el dorado amanecer,","¡Gloriosa iglesia, oh, despierta ya!","¡Oh, haznos ese día anunciar!","Pasó la noche, el Rey pronto vendrá."]}]}