{"hymn":"S495","parent":"E602","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"¡Qué glorioso! ¡Oh, qué santo","subtitle":"Experiencia de Dios—Como vida","syl":{"n1":"¡Qué","n2":["glo","i"],"n3":["rio","m"],"n4":["so!","t"],"n5":"¡Oh,","n6":"qué","n7":["san","i"],"n8":["to!","t"],"n9":["¡Vi","i"],"n10":["da‿e","m"],"n12":["ter","m"],"n13":["na‿es","t"],"n14":["nues","i"],"n15":["tro","t"],"n16":"Dios!","n17":["¡Po","i"],"n18":["de","m"],"n19":["ro","m"],"n20":["so,‿i","m"],"n21":["li","m"],"n22":["mi","m"],"n23":["ta","m"],"n24":["do,","t"],"n25":["Lle","i"],"n26":["no‿de","t"],"n28":["to","i"],"n29":["da","t"],"n30":["com","i"],"n31":["pa","m"],"n32":["sión!","t"],"n33":"Qué","n34":["ri","i"],"n35":["que","m"],"n36":["zas","t"],"n37":"en","n38":"Su","n39":["vi","i"],"n40":["da:","t"],"n41":"Su","n42":["e","i"],"n43":["sen","m"],"n44":["cia,","t"],"n45":"luz","n46":["y‿a","i"],"n47":["mor.","t"]},"verses":[{"label":"2.","lines":["¡Qué amoroso! ¡Oh, qué gracia!","¡Para el hombre, vida es Dios!","Formó espíritu en el hombre,","Conforme al plan que Él trazó.","Que este hombre lo reciba","Es Su anhelo e intención."]},{"label":"3.","lines":["¡Qué amor e inmensa gracia!","¡Vida al hombre fluye Dios!","Se mostró primero en carne,","Mas el Espíritu es hoy;","Para propagar Su vida","Tal proceso Él pasó."]},{"label":"4.","lines":["¡Qué accesible! ¡Qué cercano!","¡Hoy Dios en Cristo vida es!","Cristo, el Dios encarnado,","Manifestado al hombre es.","Muerto y resucitado,","Vida al hombre viene a ser."]},{"label":"5.","lines":["¡Qué asombroso! ¡Esta vida","Dios en el hombre la impartió!","Al tomar Su otra forma","Como Espíritu entró.","Lo convence, lo inspira,","Y hace en él Su habitación."]},{"label":"6.","lines":["¡Qué glorioso! ¡Qué precioso!","¡Conocer al Triuno Dios!","Vino el Padre en el Hijo,","Mas el Espíritu es hoy.","Este Espíritu al hombre","Le trae la vida de Dios"]},{"label":"7.","lines":["¡Qué misterio, pero es cierto!","¡El mismo Dios fluye en mi ser!","Él conmigo se hizo uno","Para mi vida ahora ser.","¡Aleluya! ¡Aleluya!","¡Siempre le alabaré!"]}]}