{"hymn":"S540","parent":"E671","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En lo profundo de Tu Nombre, Oh Dios","subtitle":"Consuelo en las pruebas—Por el nombre del Señor","syl":{"n1":"En","n2":"lo","n3":["pro","i"],"n4":["fun","m"],"n5":["do","t"],"n6":"de","n7":"Tu","n8":["Nom","i"],"n9":["bre,‿Oh","t"],"n10":"Dios,","n11":"Yo","n12":"me","n13":["su","i"],"n14":["mer","m"],"n15":["jo‿en","t"],"n16":["cal","i"],"n17":["ma","t"],"n18":["ce","i"],"n19":["les","m"],"n20":["tial;","t"],"n21":["Du","i"],"n22":["ran","m"],"n23":["te‿el","t"],"n24":["dí","i"],"n25":["a","t"],"n26":"Tú","n27":"me","n28":["bas","i"],"n29":["ta","m"],"n30":["rás,","t"],"n31":["Tam","i"],"n32":["bién","t"],"n33":"me","n34":["bas","i"],"n35":["tas","t"],"n36":"en","n37":["la‿os","i"],"n38":["cu","m"],"n39":["ri","m"],"n40":["dad.","t"]},"verses":[{"label":"2.","lines":["El Todo-suficiente eres mi Dios,","Puedes crear lo que me falta a mí;","Mandas las maravillas de Tu amor,","Por mi camino solitario aquí."]},{"label":"3.","lines":["Confiando en Ti, me atrevo, oh mi Dios,","A echarme en Tu seno otra vez;","Tus sendas yo por fe adoro allí,","En fe adoro y reposo en Ti."]}]}