{"hymn":"S515","parent":"E621","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"Junto a la cruz de Cristo","subtitle":"Gloriarnos en la cruz—El refugio","syl":{"n1":["Jun","i"],"n2":["to‿a","t"],"n3":"la","n4":"cruz","n5":"de","n6":["Cris","i"],"n7":["to","t"],"n8":["An","i"],"n9":["he","m"],"n10":["lo","t"],"n11":["siem","i"],"n12":["pre‿es","m"],"n13":["tar;","t"],"n14":"La","n15":["som","i"],"n16":["bra","t"],"n17":["de‿e","i"],"n18":["sa","t"],"n19":["Pe","i"],"n20":["ña","t"],"n21":"fiel","n22":["Re","i"],"n23":["fu","m"],"n24":["gio‿a","t"],"n25":["mi‿al","i"],"n26":["ma","t"],"n27":"da.","n28":"En","n29":"el","n30":["de","i"],"n31":["sier","m"],"n32":["to","t"],"n33":"de","n34":["ca","i"],"n35":["lor,","t"],"n36":"En","n37":["e","i"],"n38":["lla","t"],"n39":["ha","i"],"n40":["llo‿ho","m"],"n41":["gar;","t"],"n42":"De","n43":["to","i"],"n44":["da","t"],"n45":["car","i"],"n46":["ga","t"],"n47":["pu","i"],"n48":["e","m"],"n49":["do","t"],"n50":"yo","n51":"En","n52":["e","i"],"n53":["lla","t"],"n54":["des","i"],"n55":["can","m"],"n56":["sar.","t","u"],"n57":0},"verses":[{"label":"2.","lines":["¡Seguro y contento","En tal refugio estoy,","Do la justicia y‿el amor","Se‿encuentran en unión!","Así como el patriarca vio","En sueño la visión,","Mi Salvador es, por la cruz,","Tal escalera hoy."]},{"label":"3.","lines":["Al lado de su sombra","Se puede observar","La tumba atróz abierta allí","Y negra oscuridad;","Mas entre ella y yo, la cruz","Se extiende con amor;","Dos brazos que pueden salvar","De eterna perdición."]},{"label":"4.","lines":["Sobre la cruz de Cristo","Mis ojos pueden ver","La forma del que allí sufrió y","Murió para mi bien.","Hoy mi contrito corazón","Confiesa la verdad","De Su maravilloso amor","Y de mi indignidad."]},{"label":"5.","lines":["Tu cruz será, oh Cristo,","Mi eterna habitación;","Yo sólo pido ver Tu faz","Que brilla más que el sol.","Contento, dejo el mundo atrás;","No hallo allí virtud,","Avergonzado de mi yo,","Mi gloria es Tu cruz."]}]}