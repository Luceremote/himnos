{"hymn":"S838","parent":"E993","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh, las dulces buenas nuevas","subtitle":"El evangelio—El salvador","syl":{"n1":"Oh,","n2":"las","n3":["dul","i"],"n5":["ces","t"],"n6":["bue","i"],"n7":["nas","t"],"n8":["nue","i"],"n9":["vas","t"],"n10":["Nues","i"],"n11":["tras","t"],"n12":"son","n13":"por","n14":"fe;","n16":["Hoy,‿a","i"],"n17":["yer","t"],"n18":"y","n20":["pa","i"],"n21":["ra","t"],"n22":["si","i"],"n23":["em","m"],"n24":["pre,","t"],"n25":["Cris","i"],"n26":["to‿el","t"],"n27":["mis","i"],"n29":["mo","t"],"n30":"es.","n32":["Sal","i"],"n33":["va‿a","m"],"n34":["ún","t"],"n36":"a","n37":["pe","i"],"n38":["ca","m"],"n39":["do","m"],"n41":["res,","t"],"n42":["Sa","i"],"n43":["na","t"],"n44":"al","n45":["mor","i"],"n46":["tal;","t"],"n48":"Él","n49":["a","i"],"n51":["le","m"],"n52":["gra‿al","t"],"n53":["que","i"],"n54":["jum","m"],"n55":["bro","m"],"n56":["so,","t"],"n57":"¡Su","n58":["nom","i"],"n59":["bre‿a","m"],"n60":["la","m"],"n61":["bad!","t"],"n63":"Hoy,","n64":["a","i"],"n66":["yer","t"],"n67":"y","n68":["pa","i"],"n69":["ra","t"],"n70":["siem","i"],"n72":["pre,","t"],"n73":["Cris","i"],"n74":["to‿el","t"],"n75":["mis","i"],"n77":["mo","t"],"n78":"es;","n80":["To","i"],"n81":["do","t"],"n83":["cam","i"],"n84":["bia,","t"],"n85":["me","i"],"n86":["nos","t"],"n88":["Cris","i"],"n89":["to,","t"],"n90":["¡Glo","i"],"n91":["ri","m"],"n92":["a","t"],"n93":"dad","n94":"Él!","n96":["¡Glo","i"],"n97":["ri","m"],"n98":["a","t"],"n99":"dad","n101":"Él!","n102":["¡Glo","i"],"n103":["ri","m"],"n104":["a","t"],"n106":"dad","n108":"Él!","n109":["To","i"],"n110":["do","t"],"n112":["cam","i"],"n113":["bia,","t"],"n114":["me","i"],"n115":["nos","t"],"n116":["Cris","i"],"n117":["to,","t"],"n118":["¡Glo","i"],"n119":["ri","m"],"n120":["a","t"],"n121":"dad","n122":"Él!"},"verses":[{"label":"2.","lines":["El que amó a los pecadores","Hoy te busca a ti;","Ven, perdido, a Su estrado,","Póstrate allí.","Dijo así: \"No te condeno,","Ve y no peques más\":","El perdón que Él otorgaba,","Aún vigente está."]},{"label":"3.","lines":["En la tierra, a los dolientes","El Señor sanó;","Penas y enfermedades","Huyen con Su voz.","Su virtud salió al toque","De una mujer;","Al que busque hoy Su gracia,","Se la da por fe."]},{"label":"4.","lines":["Fue a Emaús con ellos,","Los acompañó;","Hoy camina a nuestro lado","Nuestro buen Pastor,","Pronto lo contemparemos,","¡Señor, pronto ven!","El Jesús que pronto viene,","Siempre el mismo es."]}]}