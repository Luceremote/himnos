{"hymn":"S659","parent":"E847","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La comunión mi espíritu ama","subtitle":"La iglesia—Su edificación","syl":{"n1":"La","n2":["co","i"],"n3":["mu","m"],"n4":["nión","t"],"n5":["mi‿es","i"],"n6":["pí","m"],"n7":["ri","m"],"n8":["tu‿a","m"],"n9":["ma,","t"],"n10":["Mez","i"],"n11":["cla","m"],"n12":["do","t"],"n13":"con","n14":"los","n15":["san","i"],"n16":["tos","t"],"n17":"ser,","n18":"Y","n19":["sal","i"],"n20":["vo","t"],"n21":"de","n22":["mi‿in","i"],"n23":["de","m"],"n24":["pen","m"],"n25":["den","m"],"n26":["cia,","t"],"n27":"Hoy","n28":["e","i"],"n29":["di","m"],"n30":["fi","m"],"n31":["ca","m"],"n32":["ción","t"],"n33":["te","i"],"n34":["ner.","t"]},"verses":[{"label":"2.","lines":["La comunión mi espíritu ama,","Para que abierto siempre esté;","No más en reclusión continua,","Mas con los santos te honraré."]},{"label":"3.","lines":["La comunión mi espíritu ama,","Anhelo su liberación;","No quiero ser más un iluso,","Quiero vencer mi condición."]},{"label":"4.","lines":["La comunión mi espíritu ama,","Y con los santos quiero orar;","Quiero quitar las pretensiónes","Y en dulce comunión entrar."]},{"label":"5.","lines":["La comunión mi espíritu ama,","Y conocer la autoridad;","Anhelo comunión sincera,","Y en el servicio coordinar."]},{"label":"6.","lines":["Señor, se cumpla mi anhelo,","Inspíranos a comunión;","Para que, siendo edificados,","Se plazca así Tu corazón."]}]}