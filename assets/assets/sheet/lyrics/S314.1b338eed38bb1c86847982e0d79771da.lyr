{"hymn":"S314","parent":"E403","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Vive en mí, Señor, Tu vida","subtitle":"Anhelos—De expresar a Cristo","syl":{"n1":["Vi","i"],"n2":["ve‿en","t"],"n3":"mí,","n4":["Se","i"],"n5":["ñor,","t"],"n6":"Tu","n7":["vi","i"],"n8":["da,","t"],"n9":"Pues","n10":"mi","n11":["vi","i"],"n12":["da","t"],"n13":["e","i"],"n14":["res","t"],"n15":"hoy;","n16":"Al","n17":["to","i"],"n18":["mar","m"],"n19":["le‿en","t"],"n20":"mis","n21":["pro","i"],"n22":["ble","m"],"n23":["mas","t"],"n24":["E","i"],"n25":["res","t"],"n26":"Tu","n27":"la","n28":["so","i"],"n29":["lu","m"],"n30":["ción.","t"],"n31":["Vi","i"],"n32":["ve‿en","t"],"n33":"mí,","n34":["Se","i"],"n35":["ñor,","t"],"n36":"Tu","n37":["vi","i"],"n38":["da,","t"],"n39":["Cum","i"],"n40":["ple‿en","t"],"n41":"mí","n42":"Tu","n43":["vo","i"],"n44":["lun","m"],"n45":["tad;","t"],"n47":["Haz","i"],"n48":["me‿un","t"],"n49":["va","i"],"n50":["so","t"],"n51":["trans","i"],"n52":["pa","m"],"n53":["ren","m"],"n54":["te","t"],"n55":["Pa","i"],"n56":["ra‿al","t"],"n57":["Hi","i"],"n58":["jo","t"],"n59":["ex","i"],"n60":["pre","m"],"n61":["sar.","t"]},"verses":[{"label":"2.","lines":["Consagrado está Tu templo,","Ya purgado de maldad;","Que la llama de Tu gloria","Brille en mí con claridad.","Que con admirable asombro","Pueda el mundo contemplar,","La ofrenda de mi cuerpo,","Que este esclavo a Ti te da."]},{"label":"3.","lines":["Todo el tiempo, todo miembro,","Quede atentó a Tu mandar,","Para trabajar en yugo","O esperar según Tu plan.","Cuando sea restringido","No me intranquilizaré;","En Tu trato fiel conmigo","Nunca yo murmuraré."]},{"label":"4.","lines":["Tierno, quieto y en reposo,","Mis tendencias ya negué,","Para que te sientas libre","Y me indiques Tu querer.","Vive‿en mí, Señor, Tu vida,","Pues mi vida eres hoy;","Al tomarle‿en mis problemas","Eres Tu la solución."]}]}