{"hymn":"S33","parent":"E41","quality":"adapted","adjust":{"hold":3,"merge":3},"title":"No nos cansa el cantar la canción eternal","subtitle":"Adoración al Padre—Su redención","syl":{"n1":"No","n2":"nos","n3":["can","i"],"n4":["sa","t"],"n5":"el","n6":["can","i"],"n7":["tar","t"],"n8":"la","n9":["can","i"],"n10":["ción","t"],"n11":["e","i"],"n12":["ter","m"],"n13":["nal:","t"],"n14":["Glo","i"],"n15":["ria","t"],"n16":"a","n18":"Dios,","n19":["a","i"],"n20":["le","m"],"n21":["lu","m"],"n23":["ya!","t"],"n24":"Con","n25":["es","i"],"n26":["pí","m"],"n27":["ri","m"],"n28":["tu","t"],"n29":["fer","i"],"n30":["vi","m"],"n31":["en","m"],"n32":["te","t","u"],"n33":0,"n34":["siem","i"],"n35":["pre‿a","m"],"n36":["la","m"],"n37":["bad:","t"],"n38":["¡Glo","i"],"n39":["ria‿a","t"],"n40":"Dios,","n42":["a","i"],"n43":["le","m"],"n44":["lu","m"],"n45":["ya!","t"],"n46":"Oh,","n47":"los","n48":["hi","i"],"n49":["jos","t"],"n50":"del","n51":"Se‿ñor","n52":["Can","i"],"n53":["ta","m"],"n54":["rán","t"],"n55":["be","i"],"n56":["lla","t"],"n57":["can","i"],"n58":["ci","m"],"n59":["ón;","t"],"n60":"A","n61":"la","n62":["glo","i"],"n63":["ria","t"],"n64":"los","n65":["gui","i"],"n66":["a","m"],"n67":["rá","t"],"n68":"Por","n69":"Su","n70":["gra","i"],"n71":["cia‿el","t"],"n72":["Se","i"],"n73":["ñor;","t"],"n74":["Lue","i"],"n75":["go","t"],"n76":["fren","i"],"n77":["te‿a","t"],"n78":["nues","i"],"n79":["tro","t"],"n80":"Rey","n81":["To","i"],"n82":["dos","t"],"n83":"e‿llos","n84":["es","i"],"n85":["ta‿rán.","t"],"n86":["¡Glo","i"],"n87":["ria‿a","t"],"n88":["Di","i"],"n89":["os,","t","u"],"n90":0,"n91":["a","i"],"n93":["le","m"],"n94":["lu","m"],"n95":["ya!","t","u"],"n96":0},"verses":[{"label":"2.","lines":["En un éxtasis envuelto de amor redentor:","¡Gloria a Dios, aleluya!","Procuramos por Su gracia darle todo honor:","¡Gloria a Dios, aleluya!"]},{"label":"3.","lines":["Proseguimos a la gloria como ha dicho el Rey,","¡Gloria a Dios, aleluya!","Su belleza esplendorosa pronto se ha de ver.","¡Gloria a Dios, aleluya!"]},{"label":"4.","lines":["Luego, de Su inmensa gracia en feliz canción:","¡Gloria a Dios, aleluya!","Cantaremos con gran multitud al Salvador:","¡Gloria a Dios, aleluya!"]}]}