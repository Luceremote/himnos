{"hymn":"S261","parent":"E321","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, qué salvación tan grande","subtitle":"La certeza y el gozo de la salvación—Salvos por gracia","syl":{"n1":"¡Oh,","n2":"qué","n3":["sal","i"],"n4":["va","m"],"n5":["ción","t"],"n7":"tan","n9":["gran","i"],"n10":["de!","t"],"n11":["U","i"],"n12":["na","t"],"n13":["fuen","i"],"n14":["te","t"],"n15":"se","n16":["a","i"],"n17":["brió,","t"],"n18":["Flu","i"],"n19":["ye‿a","t"],"n20":["to","i"],"n21":["da","t"],"n22":["tie","i"],"n24":["rra‿y","t"],"n26":["pue","i"],"n27":["blo","t"],"n28":"Del","n29":["he","i"],"n30":["ri","m"],"n31":["do","t"],"n33":["Sal","i"],"n34":["va","m"],"n35":["dor.","t"],"n36":"¡Oh,","n37":"qué","n38":["sal","i"],"n39":["va","m"],"n40":["ción","t"],"n41":"tan","n42":["gran","i"],"n43":["de!","t"],"n44":"¡Un","n45":["to","i"],"n46":["rren","m"],"n47":["te","t"],"n48":"de‿Él","n49":["flu","i"],"n50":["yó!","t"],"n51":"¡Un","n52":["to","i"],"n53":["rren","m"],"n55":["te","t"],"n57":"de‿Él","n58":["flu","i"],"n59":["yó!","t"]},"verses":[{"label":"2.","lines":["¡Qué revelación tan grande!","La corriente carmesí","Lleva toda culpa‿y mancha,","Como nieve la‿hace así.","¡Oh, qué salvación tan grande!","¡Gozo inefable‿aquí!","¡Gozo inefable‿aquí!"]},{"label":"3.","lines":["Su amor, como‿un torrente,","Llega‿a todo mi‿interior;","Lava todo pensamiento,","Sentimiento e‿intención.","¡Oh, qué salvación tan grande!","¡Del pecado‿y su poder!","¡Del pecado‿y su poder!"]},{"label":"4.","lines":["Vida inmortal es mía,","Cristo en mi corazón:","Dios y‿el hombre siendo uno,","¡Insondable comunión!","¡Oh, qué salvación tan grande!","¡Vivo‿en Su resurrección!","¡Vivo‿en Su resurrección!"]},{"label":"5.","lines":["Dudas, penas y tinieblas,","Ya no sufro ni su‿afán;","Por mi fe en Jesucristo,","Se‿esfumó la‿oscuridad.","¡Oh, qué salvación tan grande!","¡Plena‿y por la‿eternidad!","¡Plena‿y por la‿eternidad!"]}]}