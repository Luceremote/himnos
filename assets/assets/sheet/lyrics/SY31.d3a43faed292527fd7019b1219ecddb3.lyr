{"hymn":"SY31","parent":"NS78","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús, Tú eres bello","subtitle":"","syl":{"n1":["Je","i"],"n2":["sús,","t"],"n3":["Tú‿e","i"],"n5":["res","t"],"n6":["be","i"],"n7":["llo,","t"],"n9":["Tú‿e","i"],"n10":["res","t"],"n11":"más","n12":["de","i"],"n13":["se","m"],"n14":["a","m"],"n15":["ble","t"],"n17":"Que‿el","n18":["mun","i"],"n19":["do‿y","t"],"n20":"sus","n21":["de","i"],"n22":["lei","m"],"n23":["tes.","t"],"n25":["Fi","i"],"n26":["no‿e","m"],"n27":["res,","t"],"n28":["dul","i"],"n29":["ce‿y","t"],"n30":"fiel.","n31":["Se","i"],"n32":["ñor,","t"],"n33":"Tu","n35":["be","i"],"n36":["lle","m"],"n37":["za","t"],"n39":["Ex","i"],"n40":["ce","m"],"n41":["de","t"],"n42":"lo","n43":"más","n44":["be","i"],"n45":["llo.","t"],"n47":["Gen","i"],"n48":["til,","t"],"n49":"Tú","n50":["e","i"],"n51":["res","t"],"n52":["tier","i"],"n53":["no.","t"],"n55":["Ra","i"],"n56":["dian","m"],"n57":["te,‿en","m"],"n58":["can","m"],"n59":["ta","m"],"n60":["dor.","t"]},"verses":[{"label":"2.","lines":["Al contemplarte, Cristo,","Me atraes por completo.","No puedo alejarme,","Descanso en Tu paz.","Y mientras pasa el tiempo","Yo vivo en Tu presencia,","Tan santa e inigualable,","Mirando allí Tu faz."]},{"label":"3.","lines":["Te doy toda mi vida,","Pues sólo Tú eres digno.","No hay nada, no hay nadie,","¡Te anhelo sólo a Ti!","Que mis días sean tuyos,","Mi corazón te ame;","Por Tu abundante gracia,","Te adore y sirva a Ti."]}]}