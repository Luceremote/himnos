{"hymn":"S510","parent":"E1200","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"Desde el norte un tempestuoso viento hay","subtitle":"Experiencia de Dios—Como viento, nube, fuego y electro","syl":{"n1":["Des","i"],"n2":["de‿el","t"],"n3":["nor","i"],"n4":["te‿un","t"],"n5":["tem","i"],"n6":["pes","m"],"n7":["tuo","m"],"n8":["so","t"],"n9":["vien","i"],"n10":["to","t"],"n11":"hay;","n12":["¡So","i"],"n13":["pla","t"],"n14":"ya!","n15":["¡So","i"],"n16":["pla","t"],"n17":"ya!","n18":"En","n19":["nues","i"],"n20":["tra‿ex","m"],"n21":["pe","m"],"n22":["rien","m"],"n23":["cia,‿él","t"],"n24":"a","n25":"Dios","n26":"nos","n27":["tra","i"],"n28":["e;","t"],"n29":["¡So","i"],"n30":["pla","t"],"n31":"ya!","n32":["¡So","i"],"n33":["pla","t"],"n34":"ya!","n35":["So","i"],"n36":["pla,","t","u"],"n37":0,"n39":["cu","i"],"n40":["bre,‿ar","m"],"n41":["de‿y","t"],"n42":["bri","i"],"n43":["lla,‿oh","t"],"n44":"Dios,","n45":["Has","i"],"n46":["ta","t"],"n47":["nues","i"],"n49":["tro","t"],"n50":"ser","n51":["ga","i"],"n52":["nar;","t"],"n53":["Pa","i"],"n54":["ra","t"],"n55":"que","n57":["po","i"],"n58":["da","m"],"n59":["mos","t"],"n60":["Tu","i"],"n61":["yos","t"],"n62":"ser,","n63":"Y","n64":["Tu‿i","i"],"n65":["ma","m"],"n67":["gen","t"],"n68":["ex","i"],"n69":["pre","m"],"n70":["sar.","t"]},"verses":[{"label":"2.","lines":["Hoy detrás del viento una nube va;","¡Cúbrenos! ¡Cúbrenos!","La presencia del Señor la nube trae;","¡Cúbrenos! ¡Cúbrenos!"]},{"label":"3.","lines":["Con la nube‿un fuego resplandecerá;","¡Arderá! ¡Arderá!","Se verá‿el pecado y nuestro yo carnal;","¡Arderá! ¡Arderá!"]},{"label":"4.","lines":["El electro desde‿el fuego brillará;","¡Brillará! ¡Brillará!","El Dios redentor así se expresará;","¡Brillará! ¡Brillará!"]},{"label":"5.","lines":["Viento, nube, fuego y electro, hoy","Fórjalos sin cesar","En nosotros, como un ciclo, oh Señor,","Más y más, más y más."]}]}