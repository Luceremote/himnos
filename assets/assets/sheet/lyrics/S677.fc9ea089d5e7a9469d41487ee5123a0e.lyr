{"hymn":"S677","parent":"E1221","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Nuestro Pastor admirable","subtitle":"La iglesia—Como rebaño de Dios","syl":{"n1":["Nues","i"],"n2":["tro","t"],"n3":["Pas","i"],"n4":["tor","t"],"n5":["ad","i"],"n6":["mi","m"],"n7":["ra","m"],"n8":["ble,","t"],"n9":["Cris","i"],"n10":["to","t"],"n11":["Je","i"],"n12":["sús,","t"],"n13":"nos","n14":["sa","i"],"n15":["có","t"],"n16":["De‿a","i"],"n17":["quel","t"],"n18":["re","i"],"n19":["dil","t"],"n20":"a","n21":"los","n22":["pas","i"],"n23":["tos,","t"],"n24":"Y","n25":"Sus","n26":["ri","i"],"n27":["que","m"],"n28":["zas","t"],"n29":"nos","n30":"dio.","n31":["¡Glo","i"],"n33":["rio","m"],"n34":["sa‿i","m"],"n35":["gle","m"],"n36":["sia!","t"],"n37":["¡Ri","i"],"n38":["co,‿a","m"],"n39":["bun","m"],"n40":["dan","m"],"n41":["te","t"],"n42":["cau","i"],"n43":["dal!","t"],"n44":["A","i"],"n45":["quí‿en","t"],"n46":["u","i"],"n47":["nión","t"],"n48":["ha","i"],"n49":["bi","m"],"n50":["tan","m"],"n51":["do,","t"],"n52":"Dios","n53":["man","i"],"n54":["da","t"],"n55":["vi","i"],"n56":["da‿e","m"],"n57":["ter","m"],"n58":["nal.","t"]},"verses":[{"label":"2.","lines":["Nos encontró en divisiones,","Hambrientos, casi al morir;","A buena tierra nos trajo,","Mi espíritu hizo vivir."]},{"label":"3.","lines":["Nuestro Jesús es el pasto,","Nuestra comida también;","Siempre alimenta el rebaño,","Al congregarnos con Él."]},{"label":"4.","lines":["En este monte habitamos","Bajo el rocio de Dios;","Fluye la vida en la fuente,","Aguas de gran bendición."]},{"label":"5.","lines":["Es nuestro Cristo el descanso,","Nada tememos aquí;","A Sus ovejas Él cuida","Con Su presencia gentil."]}]}