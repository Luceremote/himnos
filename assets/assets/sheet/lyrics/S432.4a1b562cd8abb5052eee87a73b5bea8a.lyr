{"hymn":"S432","parent":"E548","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Yo de barro hecho fui","subtitle":"Experiencia de Cristo—Contenerlo a Él","syl":{"n1":"Yo","n2":"de","n3":["ba","i"],"n4":["rro","t"],"n5":["he","i"],"n6":["cho","t"],"n7":"fui,","n8":["Co","i"],"n9":["mo‿en","m"],"n10":["va","m"],"n11":["se","t"],"n12":["pa","i"],"n13":["ra","t"],"n14":"Dios;","n15":["Cris","i"],"n16":["to‿es","t"],"n17":"el","n18":["te","i"],"n19":["so","m"],"n20":["ro‿en","t"],"n21":"mí","n22":"Yo","n23":"el","n24":["va","i"],"n25":["so","t"],"n26":"que‿Él","n27":["for","i"],"n28":["mó.","t"]},"verses":[{"label":"2.","lines":["A Su imagen hecho fui,","Para que Él se impregne en mí","Dios el vaso así forjó,","Al tesoro lo igualó."]},{"label":"3.","lines":["Mora en mí Su Espíritu,","Me sostiene con poder;","En mi espíritu Él está,","Es en mí la realidad."]},{"label":"4.","lines":["Hoy en mí se mueve Él,","Y se mezcla con mi ser,","Para el alma saturar","Y mis pasos regular."]},{"label":"5.","lines":["Transparente debo ser,","Desde todo mi interior,","Para que otros puedan ver","Su imagen y expresión."]},{"label":"6.","lines":["Debo transformado ser","Quebrantado más y más,","Conformado el barro así,","Al tesoro estará."]}]}