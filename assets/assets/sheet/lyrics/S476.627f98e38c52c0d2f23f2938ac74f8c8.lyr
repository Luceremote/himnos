{"hymn":"S476","parent":"E1169","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La verdadera adoración","subtitle":"Experiencia de Cristo—Como aquel que es la buena tierra","syl":{"n1":"La","n2":["ver","i"],"n3":["da","m"],"n4":["de","m"],"n5":["ra‿a","m"],"n7":["do","m"],"n8":["ra","m"],"n10":["ción","t"],"n11":["Moi","i"],"n12":["sés,","t"],"n13":"en","n14":["ti","i"],"n15":["pos,","t"],"n16":"nos","n17":["mos","i"],"n18":["tró;","t"],"n19":"Con","n20":"el","n21":["pro","i"],"n22":["duc","m"],"n24":["to","t"],"n25":"de","n26":["Ca","i"],"n28":["naán","t"],"n29":"El","n30":["pue","i"],"n31":["blo","t"],"n32":["a","i"],"n34":["do","m"],"n35":["ró","t"],"n36":"a","n37":"Dios."},"verses":[{"label":"2.","lines":["Debemos hoy así venir,","Para‿adorar en realidad:","Trayendo‿a Cristo, el fruto que","A nuestro Dios satisfará."]},{"label":"3.","lines":["La‿adoración que quiere Dios","No es producto del maná,","Sino de laborar en Él","Para tener qué presentar."]},{"label":"4.","lines":["Así, lo que desea Dios","No son milagros por doquier,","Sino a diario, tan normal,","Vivir y laborar en Él."]},{"label":"5.","lines":["De Dios provino el maná,","Mas surge‿el fruto del labrar;","¡Mezclándonos con el Señor,","A Dios podemos adorar!"]},{"label":"6.","lines":["Vivimos cada día‿en Él,","Hoy Cristo nuestro todo es;","Así el fruto ha de ser","La real adoración a Él."]},{"label":"7.","lines":["Ya no buscamos el maná,","Sino a Cristo aplicar;","Así el dulce fruto‿habrá,","Que al Señor satisfará."]}]}