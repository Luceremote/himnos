{"hymn":"S526","parent":"E642","quality":"exact","adjust":{"hold":0,"merge":0},"title":"\"Detrás del velo\", vuestra porción sea","subtitle":"La vida de resurrección—La vida que surge de la muerte","syl":{"n1":["\"De","i"],"n2":["trás","t"],"n3":"del","n4":["ve","i"],"n5":["lo\",","t"],"n6":["vues","i"],"n7":["tra","t"],"n8":["por","i"],"n9":["ción","t"],"n10":["se","i"],"n11":["a,","t"],"n12":["Mo","i"],"n13":["ran","m"],"n14":["do","t"],"n15":"en","n16":["se","i"],"n17":["cre","m"],"n18":["to‿en","t"],"n19":"el","n20":["Se","i"],"n21":["ñor;","t"],"n23":["Mi","i"],"n24":["rán","m"],"n25":["do","m"],"n26":["lo,","t"],"n27":["has","i"],"n28":["ta","t"],"n29":"que","n30":["vues","i"],"n31":["tro","t"],"n32":["ros","i"],"n33":["tro","t"],"n34":["Mues","i"],"n35":["tre","t"],"n36":["Su‿a","i"],"n37":["mor","t"],"n38":"y","n39":["glo","i"],"n40":["ria","t"],"n41":"en","n42":["lo","i"],"n43":["or.","t"]},"verses":[{"label":"2.","lines":["\"Detrás del velo\", pues si contemplamos","La hermosura de Su faz sin par,","Seremos una revelación viva","De Su insondable gracia y gran amor."]},{"label":"3.","lines":["\"Detrás del velo\", hallemos Su fragancia,","Fuera del velo, esta fragancia dad;","\"Detrás del velo\", Él toca melodías","Para en la tierra alabanzas dar."]},{"label":"4.","lines":["\"Detrás del velo\", espíritu anclado,","En paz andamos, libres de ansiedad;","\"Detrás del velo\", el alma a Él unida,","Tendrá Su vida de resurrección."]}]}