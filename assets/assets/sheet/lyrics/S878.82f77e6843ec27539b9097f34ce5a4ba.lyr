{"hymn":"S878","parent":"E1057","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh Jesús, mi Salvador","subtitle":"El evangelio—Clamar al Señor","syl":{"n1":"¡Oh","n2":["Je","i"],"n3":["sús,","t"],"n4":"mi","n5":["Sal","i"],"n6":["va","m"],"n7":["dor!","t"],"n9":["Hu","i"],"n10":["yo","t"],"n11":"de","n12":"la","n13":["tem","i"],"n14":["pes","m"],"n15":["tad","t"],"n18":"A","n19":"Tu","n20":["se","i"],"n21":["no","t"],"n22":["pro","i"],"n23":["tec","m"],"n24":["tor,","t"],"n26":["Fián","i"],"n27":["do","m"],"n28":["me","t"],"n29":"de","n30":"Tu","n31":["bon","i"],"n32":["dad.","t"],"n35":["Sál","i"],"n36":["va","m"],"n37":["me,","t"],"n38":["Se","i"],"n39":["ñor","t"],"n40":["Je","i"],"n41":["sús,","t"],"n44":"De","n45":"la","n46":["fu","i"],"n47":["ria","t"],"n48":"del","n49":["tur","i"],"n50":["bión;","t"],"n53":["Guí","i"],"n54":["a","t"],"n55":"hoy","n56":"mi","n57":["bar","i"],"n58":["co,","t"],"n59":"Tú,","n61":"¡Oh,","n62":["re","i"],"n63":["fú","m"],"n64":["gia","m"],"n65":["me‿en","t"],"n66":["Tu‿a","i"],"n67":["mor!","t"]},"verses":[{"label":"2.","lines":["Ningun otro asilo hay;","Desvalido, acudo a Ti;","Mi necesidad me trae,","Porque mi peligro vi.","Solamente Tú, Señor,","Traes consuelo al corazón;","Cubre mi indefenso ser","Con Tus alas, Salvador."]},{"label":"3.","lines":["Cristo, encuentro todo en Ti,","Y no necesito más;","Débil, me pusiste en pie;","Triste, ánimo me das.","Santo y justo eres Tú;","Yo, inmundo pecador;","Al enfermo das salud,","Por Tu gracia, mi Señor."]},{"label":"4.","lines":["La abundante gracia en Ti,","Mi pecado cubrirá;","El arroyo sanador,","Limpio y puro me hará.","Fuente de la vida, hoy","Libremente acudo a Ti;","Salta, manantial de Dios,","Para vida eterna en mí."]}]}