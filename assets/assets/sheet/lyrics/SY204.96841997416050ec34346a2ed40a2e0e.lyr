{"hymn":"SY204","parent":"NS42","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Vengo a Ti, Señor","subtitle":"","syl":{"n2":["Ven","i"],"n3":["go‿a","t"],"n4":"Ti,","n5":["Se","i"],"n7":["ñor;","t"],"n10":["Es","i"],"n11":["ta‿es","t"],"n12":["mi‿o","i"],"n13":["ra","m"],"n15":["ción,","t"],"n17":["Que‿es","i"],"n18":["té‿a","m"],"n19":["bier","m"],"n20":["to","t"],"n21":"a","n22":"Ti,","n24":["Siem","i"],"n25":["pre","t"],"n26":["te‿a","i"],"n27":["me","t"],"n28":"a","n29":"Ti.","n33":"Hoy","n35":"Te","n36":["a","i"],"n37":["mo","t"],"n38":"más,","n39":["Se","i"],"n40":["ñor;","t"],"n42":["Te‿a","i"],"n43":["mo","t"],"n44":["mu","i"],"n45":["cho","t"],"n46":"más","n47":["que‿a","i"],"n49":["yer;","t"],"n51":["Te‿a","i"],"n52":["mo","t"],"n53":"y","n54":"te","n56":["Ne","i"],"n57":["ce","m"],"n58":["si","m"],"n59":["to.","t"]},"verses":[{"label":"2.","lines":["Hoy puedo‿elegir,","Yo te‿elijo‿a Ti;","Sin saber donde‿iré.","En Ti yo confiaré"]},{"label":"3.","lines":["Y si‿algo sale mal,","Si‿es duro‿el caminar.","Guarda mi corazón,","Que‿esté‿abierto, Señor."]},{"label":"4.","lines":["Guíame, Señor,","Esta‿es mi oración;","Que te mire a Ti,","Sin barreras, Señor."]},{"label":"5.","lines":["El tiempo pasará,","Aquí yo seguiré,","Pero que te‿ame‿a Ti,","Y te diga sin fin:"]}]}