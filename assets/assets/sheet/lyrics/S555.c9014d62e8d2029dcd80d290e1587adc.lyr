{"hymn":"S555","parent":"E721","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús me legó una promesa","subtitle":"Consuelo en las pruebas—Al tener gracia para sufrir","syl":{"n1":["Je","i"],"n3":["sús","t"],"n4":"me","n5":["le","i"],"n6":["gó‿u","m"],"n7":["na","t"],"n8":["pro","i"],"n9":["me","m"],"n10":["sa:","t"],"n12":["\"Per","i"],"n13":["fec","m"],"n14":["cio","m"],"n15":["na","m"],"n16":["ré","t"],"n17":"Mi","n18":["po","i"],"n19":["der","t"],"n21":"En","n23":["to","i"],"n24":["das","t"],"n25":"tus","n26":["de","i"],"n27":["bi","m"],"n28":["li","m"],"n29":["da","m"],"n30":["des;","t"],"n32":"Mi","n33":["gra","i"],"n34":["cia","t"],"n35":["su","i"],"n36":["fi","m"],"n37":["cien","m"],"n38":["te","t"],"n39":"es\"","n41":"Y","n42":["pa","i"],"n43":["ra","t"],"n44":"que","n45":["mi‿al","i"],"n46":["ma","t"],"n47":["re","i"],"n48":["cuer","m"],"n49":["de","t"],"n51":"Y","n52":["nun","i"],"n53":["ca","t"],"n54":"lo","n55":["pue","i"],"n56":["da‿ol","m"],"n57":["vi","m"],"n58":["dar,","t"],"n60":["A","i"],"n62":["sí","t"],"n63":"Su","n64":["pro","i"],"n65":["me","m"],"n66":["sa","t"],"n67":["re","i"],"n68":["pi","m"],"n69":["te:","t"],"n71":"\"Mi","n72":["gra","i"],"n73":["cia","t"],"n74":["su","i"],"n75":["fi","m"],"n76":["cien","m"],"n77":["te","t"],"n78":"es\".","n81":"Sí,","n82":["u","i"],"n83":["na","t"],"n84":"y","n85":["o","i"],"n86":["tra","t"],"n87":"vez","n88":["di","i"],"n89":["ce:","t"],"n90":["\"Per","i"],"n91":["fec","m"],"n92":["cio","m"],"n93":["na","m"],"n94":["ré","t"],"n95":"Mi","n96":["po","i"],"n97":["der","t"],"n99":"En","n101":["to","i"],"n102":["das","t"],"n103":"tus","n104":["de","i"],"n105":["bi","m"],"n106":["li","m"],"n107":["da","m"],"n108":["des;","t"],"n109":"Mi","n110":["gra","i"],"n111":["cia","t"],"n112":["su","i"],"n113":["fi","m"],"n114":["cien","m"],"n115":["te","t"],"n116":"es\"."},"verses":[{"label":"2.","lines":["Su gracia sí puede salvarme,","Lavarme de culpa y maldad,","Y santificarme del todo;","Su Espíritu me ha de llenar.","Su gracia supera las pruebas,","Por más duras que ellas estén;","Pues firme está Su promesa:","\"Mi gracia suficiente es\"."]},{"label":"3.","lines":["Su gracia en enfermedades,","Suficiente para mí es;","Si penas cual olas me cubren,","Su gracia suficiente es;","Nos libra de todo egoísmo,","Y para servir, da el poder;","Nos lleva a decir a quien sufre:","\"Su gracia suficiente es\"."]},{"label":"4.","lines":["Su gracia es más que suficiente;","Por ella podemos vivir;","Y cuando a la muerte lleguemos,","Su luz nos hará resurgir.","Cuando en Su victoria estemos,","Y en gloria le podamos ver,","A sus pies, postrados diremos:","\"Tu gracia suficiente fue\"."]},{"label":"5.","lines":["Mi gracia no es suficiente,","Mas la Suya siempre ha de ser;","Mi gracia es finita y fluctuante,","Mas Su gracia confiable es.","Repito Sus promesas siempre:","\"Perfeccionaré mi poder","En todas tus debilidades;","Mi gracia suficiente es\"."]}]}