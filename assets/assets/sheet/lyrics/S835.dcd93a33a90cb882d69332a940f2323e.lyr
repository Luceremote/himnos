{"hymn":"S835","parent":"E987","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Un día, cuando oprimía el pecado","subtitle":"El evangelio—El salvador","syl":{"n1":"Un","n2":["dí","i"],"n3":["a,","t"],"n4":["cuan","i"],"n5":["do‿o","m"],"n6":["pri","m"],"n7":["mí","m"],"n8":["a‿el","t"],"n9":["pe","i"],"n10":["ca","m"],"n11":["do,","t"],"n12":"La","n13":["a","i"],"n14":["la","m"],"n15":["ban","m"],"n16":["za‿en","t"],"n17":"el","n18":["cie","i"],"n19":["lo","t"],"n20":["bro","i"],"n21":["tó;","t"],"n23":["Vi","i"],"n24":["no","t"],"n25":["Je","i"],"n26":["sús","t"],"n27":"al","n28":["na","i"],"n29":["cer","t"],"n30":["de‿u","i"],"n31":["na","t"],"n32":["vir","i"],"n33":["gen;","t"],"n34":["Mo","i"],"n35":["ró‿en","m"],"n36":["tre‿hom","m"],"n37":["bres,","t"],"n38":["¡mi‿e","i"],"n39":["jem","m"],"n40":["plo","t"],"n41":"es","n42":["ho","i"],"n43":["y!","t"],"n45":["Me‿a","i"],"n46":["mó","t"],"n47":["vi","i"],"n48":["vien","m"],"n49":["do;","t"],"n50":["sal","i"],"n51":["vo","t"],"n52":["mu","i"],"n53":["rien","m"],"n54":["do;","t"],"n55":"Y,","n56":["se","i"],"n57":["pul","m"],"n58":["ta","m"],"n59":["do,","t"],"n60":"mis","n61":["cul","i"],"n62":["pas","t"],"n63":["qui","i"],"n64":["tó;","t"],"n66":"Él","n67":"me","n68":["jus","i"],"n69":["ti","m"],"n70":["fi","m"],"n71":["có","t"],"n72":["re","i"],"n73":["su","m"],"n74":["ci","m"],"n75":["tan","m"],"n76":["do;","t"],"n77":"¡Un","n78":["dí","i"],"n79":["a","t"],"n80":["vie","i"],"n81":["ne","t"],"n82":"con","n83":["glo","i"],"n84":["ria","t"],"n85":["y‿ho","i"],"n86":["nor!","t"]},"verses":[{"label":"2.","lines":["Un día Él fue llevado al Calvario,","Un día en el madero murió;","Lleno de angustia, sufrió el desprecio;","Mi Redentos, mis pecados llevó."]},{"label":"3.","lines":["Un día Él fue dejado en el huerto,","Un día Él del dolor reposó;","Ángeles fieles su tumba velaron;","Nuestra esperanza es mi Salvador."]},{"label":"4.","lines":["Un día fue esa piedra rodada,","Un día Él del sepulcro salió;","Resucitado, Él venció la muerte,","Él ascendió y por siempre es Señor."]},{"label":"5.","lines":["Un día ha de sonar la trompeta,","Un día Cristo vendrá con gran luz;","Traerá consigo a los vencedores,","¡Mi Salvador, mi glorioso Jesús!"]}]}