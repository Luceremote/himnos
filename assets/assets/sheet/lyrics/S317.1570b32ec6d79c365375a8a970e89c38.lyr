{"hymn":"S317","parent":"E408","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús, mi Señor, sana mi corazón","subtitle":"Anhelos—Del camino del Señor","syl":{"n1":["Je","i"],"n2":["sús,","t"],"n3":"mi","n4":["Se","i"],"n5":["ñor,","t"],"n6":["sa","i"],"n7":["na","t"],"n8":"mi","n9":["co","i"],"n10":["ra","m"],"n11":["zón;","t"],"n12":["Ha","i"],"n13":["bi","m"],"n14":["ta‿en","t"],"n15":"mi","n16":["al","i"],"n17":["ma","t"],"n18":"por","n19":["siem","i"],"n20":["pre,","t"],"n21":["Se","i"],"n22":["ñor;","t"],"n23":"Los","n24":["í","i"],"n25":["do","m"],"n26":["los","t"],"n27":["e","i"],"n29":["cha,","t"],"n30":["ri","i"],"n31":["va","m"],"n32":["les","t"],"n33":["tam","i"],"n34":["bién;","t"],"n35":"Ven,","n36":["lá","i"],"n37":["va","m"],"n38":["me‿y","t"],"n39":["blan","i"],"n40":["co","t"],"n41":"cual","n42":["nie","i"],"n43":["ve","t"],"n44":["se","i"],"n45":["ré.","t"],"n46":"Más","n47":["blan","i"],"n48":["co","t"],"n49":"que","n50":"la","n51":["nie","i"],"n52":["ve","t"],"n53":["se","i"],"n54":["ré,","t"],"n55":"Ven,","n56":["lá","i"],"n57":["va","m"],"n58":["me‿y","t"],"n59":["blan","i"],"n60":["co","t"],"n61":"cual","n62":["nie","i"],"n63":["ve","t"],"n64":["se","i"],"n65":["ré.","t"]},"verses":[{"label":"2.","lines":["Jesús, mi Señor, borra toda maldad,","Que quite mis manchas Tu sangre‿eficaz;","Deseo Tu bendita limpieza obtener.","Ven, lávame‿y blanco cual nieve seré."]},{"label":"3.","lines":["Jesús, mi Señor, entronado estás;","Ayúdame‿a todo hoy sacrificar;","Te‿entrego mi ser y todo lo que sé;","Ven, lávame‿y blanco cual nieve seré."]},{"label":"4.","lines":["Jesús, mi Señor, oye mi oración","Mientras a Tus pies yo postrado estoy;","Yo veo que Tu sangre me limpia por fe;","Ven, lávame‿y blanco cual nieve seré."]},{"label":"5.","lines":["Jesús, mi Señor, yo espero en Ti;","Ven, crea en mí un nuevo corazón;","A los que te buscan, Tú recibes fiel;","Ven, lávame‿y blanco cual nieve seré."]}]}