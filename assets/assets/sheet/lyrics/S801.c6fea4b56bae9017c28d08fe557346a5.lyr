{"hymn":"S801","parent":"E969","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Hoy escuchad ¡sonido tan divino","subtitle":"Esperanza de gloria—Cristo como fin","syl":{"n1":"Hoy","n2":["es","i"],"n3":["cu","m"],"n4":["chad","t"],"n5":["¡so","i"],"n6":["ni","m"],"n7":["do","t"],"n8":"tan","n9":["di","i"],"n10":["vi","m"],"n12":["no!","t"],"n13":"En","n14":["tie","i"],"n15":["rra","t"],"n16":"y‿en","n17":"el","n18":["cie","i"],"n19":["lo","t"],"n20":"hay","n21":["tem","i"],"n22":["blor;","t"],"n23":["¿Se","i"],"n24":["rá","t"],"n25":"el","n26":["true","i"],"n27":["no","t"],"n29":"del","n30":["Se","i"],"n31":["ñor","t"],"n32":["vi","i"],"n33":["nien","m"],"n34":["do?","t"],"n35":["¿Se","i"],"n36":["rá‿el","t"],"n37":["so","i"],"n38":["ni","m"],"n39":["do","t"],"n40":"de","n41":["nues","i"],"n42":["tra‿o","m"],"n43":["ra","m"],"n45":["ción?","t"]},"verses":[{"label":"2.","lines":["Él sí vendrá, y con Él diez mil voces","Han de clamar y Sus santos lo oirán;","Él sí vendrá, para traer el goce","De Su venida que segura está."]},{"label":"3.","lines":["Lo prometió, y ¿no lo adoraremos?","Lo cumplirá, ¿podemos desconfiar?","Ven y a Sus pies todos nos postraremos,","Echando nuestras cargas y ansiedad."]},{"label":"4.","lines":["Por vida y muerte, penas y pecados,","Ha hecho frente a mi necesidad;","Cristo es el fin, pues Cristo fue el principio;","Cristo, el principio, y el final será."]}]}