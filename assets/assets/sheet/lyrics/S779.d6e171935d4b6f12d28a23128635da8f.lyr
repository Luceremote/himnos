{"hymn":"S779","parent":"E945","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El Hijo de Dios se sembró","subtitle":"El reino—Su apariencia externa","syl":{"n1":"El","n2":["Hi","i"],"n3":["jo","t"],"n4":"de","n6":"Dios","n7":"se","n9":["sem","i"],"n10":["bró","t"],"n11":["Co","i"],"n12":["mo","t"],"n13":["se","i"],"n14":["mi","m"],"n15":["lla‿en","t"],"n16":["nues","i"],"n17":["tro","t"],"n18":"ser,","n19":["Cum","i"],"n20":["plien","m"],"n21":["do","t"],"n22":"con","n23":"el","n24":"plan","n25":"de","n26":"Dios","n27":"Su","n28":["rei","i"],"n30":["no‿a","m"],"n31":["sí","t"],"n33":"ha","n34":"de","n36":["cre","i"],"n37":["cer.","t"]},"verses":[{"label":"2.","lines":["Un solo grano era Él,","Produjo frutos a granel;","Los hizo hijos para Dios","Y así Su reino estableció."]},{"label":"3.","lines":["Sembró cizaña Satanás,","Y entre el trigo la esparció,","Trayendo grande confusión,","Al reino daño así causó."]},{"label":"4.","lines":["Por esa obra tan sutil","Cizaña y trigo mixturó;","En su apariencia el reino está","Grotescamente anormal."]},{"label":"5.","lines":["El reino cual mostaza es,","Pequeña planta con sabor;","Mas como un árbol vino a ser","Un gran sistema impostor."]},{"label":"6.","lines":["En vez de alimento dar,","Brinda a las aves un lugar","Do hombres y espíritus","Malignos hacen su hogar."]},{"label":"7.","lines":["Es una enorme religión","En su apariencia exterior,","Con paganismo tan sutil","Que así la masa fermentó."]},{"label":"8.","lines":["Su forma externa así cambió,","Del mundo un sistema es,","En su interior se corrompió","Y con maldad se saturó."]},{"label":"9.","lines":["Mas algo oculto busca Dios,","Como \"tesoro\" y \"perla\" es;","En tales nos transformará,","Su reino así se ha de ver."]},{"label":"10.","lines":["Del cristianismo oculto está","El reino en su realidad;","Mas por la real transformación","Conforme a Cristo se verá."]},{"label":"11.","lines":["De la \"cizaña\" apártanos,","Señor, y de ese \"árbol\" vil;","De \"levadura\" púrganos,","Y haznos puros para Ti."]},{"label":"12.","lines":["Transforma nuestras almas, Tú.","Preciosas piedras quieres ver,","Para formar Tu habitación","Y en realidad Tu reino ser."]}]}