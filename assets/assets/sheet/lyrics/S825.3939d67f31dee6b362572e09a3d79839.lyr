{"hymn":"S825","parent":"E976","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh, Señor, Tus redimidos","subtitle":"La máxima manifestación—La ciudad santa","syl":{"n1":"Oh,","n2":["Se","i"],"n3":["ñor,","t"],"n4":"Tus","n5":["re","i"],"n6":["di","m"],"n7":["mi","m"],"n8":["dos","t"],"n9":"Son","n10":["Tu‿a","i"],"n11":["ma","m"],"n12":["da","t"],"n13":["No","i"],"n14":["via","t"],"n15":"hoy;","n16":["E","i"],"n17":["lla","t"],"n18":"es","n19":"Tu","n20":["mis","i"],"n21":["mo","t"],"n22":["Cuer","i"],"n23":["po,","t"],"n24":["Ple","i"],"n25":["ni","m"],"n26":["tud","t"],"n27":"y","n28":["ex","i"],"n29":["pre","m"],"n30":["sión.","t"],"n31":["E","i"],"n32":["res","t"],"n33":["to","i"],"n35":["do","t"],"n36":["pa","i"],"n37":["ra","t"],"n38":["e","i"],"n39":["lla,","t"],"n40":"Tus","n41":["ri","i"],"n42":["que","m"],"n44":["zas","t"],"n45":"Tú","n46":"le","n47":"das,","n48":["Ple","i"],"n49":["na","m"],"n50":["men","m"],"n51":["te","t"],"n52":"la","n54":["col","i"],"n55":["mas","m"],"n56":["te","t"],"n57":"De","n58":"Tu","n59":["glo","i"],"n61":["ria‿y","t"],"n62":["san","i"],"n63":["ti","m"],"n64":["dad.","t"],"n65":"¡Ved","n66":"la","n67":["ciu","i"],"n68":["dad","t"],"n69":["san","i"],"n70":["ta,","t"],"n71":["Lle","i"],"n72":["na","t"],"n73":"de","n74":"Su","n75":["glo","i"],"n76":["ria!","t"],"n77":["La‿ex","i"],"n78":["pre","m"],"n79":["sión","t"],"n80":"de","n81":"Dios","n82":["com","i"],"n83":["ple","m"],"n84":["ta","t"],"n85":"En","n86":["la‿hu","i"],"n87":["ma","m"],"n88":["ni","m"],"n89":["dad.","t"]},"verses":[{"label":"2.","lines":["Dios y el hombre están mezclados:","¡Qué misterio de piedad!","Siendo el hombre Su morada,","Su fulgor puede expresar.","Manifiesta Su belleza","Este vaso universal,","Toda plenitud divina","Con Su gloria y santidad."]},{"label":"3.","lines":["Tal composición viviente","Son los que Dios transformó,","Como piedras muy preciosas","A Jesús los conformó.","Fluye el río de agua viva","Desde el trono del Dios fiel,","Cristo el árbol de la vida","Lleva frutos a granel."]},{"label":"4.","lines":["Son el candelero de oro","Cuya lámpara es Jesús;","Dios en Él, la luz de gloria,","Brilla como Espíritu.","La expresión final y eterna:","Coinherente el hombre y Dios,","Tal morada mutua cumple","El eterno plan de Dios."]}]}