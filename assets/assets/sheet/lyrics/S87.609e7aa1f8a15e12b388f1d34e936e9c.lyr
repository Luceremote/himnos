{"hymn":"S87","parent":"E1090","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, Tu sangre es sin igual","subtitle":"Alabanza al Señor—Su redención","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":"Tu","n4":["san","i"],"n5":["gre‿es","t"],"n6":"sin","n7":["i","i"],"n8":["gual,","t"],"n9":"¡Del","n10":["nue","i"],"n11":["vo","t"],"n12":["pac","i"],"n13":["to","t"],"n14":"es!","n15":"Por","n16":["e","i"],"n17":["lla","t"],"n18":"nos","n19":["ben","i"],"n20":["di","m"],"n21":["ce","t"],"n22":"Dios","n23":"Y","n24":"nos","n25":["mez","i"],"n26":["cla","t"],"n27":"con","n28":"Él."},"verses":[{"label":"2.","lines":["Tu sangre ya nos redimió","Y nos santificó;","De obras muertas y‿el pecar,","La conciencia limpió."]},{"label":"3.","lines":["Habla mejor Tu sangre‿a Dios","Que la de‿Abel, Señor;","Provee perfecta redención;","Complace‿al justo Dios."]},{"label":"4.","lines":["Por el eterno Espíritu,","A Dios te diste fiel.","Tal sacrificio‿es eficaz;","Tu sangre‿eterna es."]},{"label":"5.","lines":["Al trono de la gracia hoy,","Por Tu sangre, Señor,","Vamos confiados hacia Dios,","Hasta el Santísimo."]},{"label":"6.","lines":["Tu sangre obliga‿a Dios, Señor,","A dar Si mismo Ser;","Debe tomarnos para Sí","Y‿en nosotros vivir."]},{"label":"7.","lines":["Señor, Tu sangre‿es sin igual,","¡Del nuevo pacto es!","Por ella nos bendice Dios","Y nos mezcla con Él."]}]}