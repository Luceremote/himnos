{"hymn":"S543","parent":"E688","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Los rayos han destellado","subtitle":"Consuelo en las pruebas—Por la presencia del Señor","syl":{"n1":"Los","n2":["ra","i"],"n3":["yos","t"],"n5":"han","n6":["des","i"],"n8":["te‿lla","m"],"n9":["do,","t"],"n10":"Los","n11":["true","i"],"n12":["nos","t"],"n14":"yo","n15":["o","i"],"n16":["í;","t"],"n18":"Las","n19":["o","i"],"n20":["las","t"],"n22":"del","n23":["pe","i"],"n25":["ca","m"],"n26":["do","t"],"n28":["Rom","i"],"n29":["pi","m"],"n30":["e","m"],"n31":["ron","t"],"n32":["so","i"],"n33":["bre","t"],"n35":"mí;","n36":["O","i"],"n37":["í","t"],"n38":"la","n40":"voz","n41":"de","n42":["Cris","i"],"n44":["to,","t"],"n46":"Que","n47":["me‿a","i"],"n48":["ni","m"],"n49":["mó‿a","t"],"n50":["con","i"],"n51":["ti","m"],"n52":["nuar;","t"],"n54":"Y","n55":"Él","n56":"me","n57":"ha","n58":["pro","i"],"n59":["me","m"],"n61":["ti","m"],"n62":["do","t"],"n64":"Que","n65":["nun","i"],"n66":["ca","t"],"n67":"me","n68":["de","i"],"n69":["ja","m"],"n70":["rá.","t"],"n72":"No","n74":"me","n75":["de","i"],"n76":["ja","m"],"n77":["rá,","t"],"n81":"No","n83":"me","n84":["de","i"],"n85":["ja","m"],"n86":["rá,","t"],"n88":"Sí,","n89":"Él","n90":"me","n91":"ha","n92":["pro","i"],"n93":["me","m"],"n95":["ti","m"],"n96":["do","t"],"n98":"Que","n99":["nun","i"],"n100":["ca","t"],"n101":"me","n102":["de","i"],"n103":["ja","m"],"n104":["rá;","t"],"n106":"No","n108":"me","n109":["de","i"],"n110":["ja","m"],"n112":["rá,","t"],"n115":"No","n117":"me","n118":["de","i"],"n119":["ja","m"],"n120":["rá,","t"],"n122":"Sí,","n123":"Él","n124":"me","n125":"ha","n126":["pro","i"],"n127":["me","m"],"n129":["ti","m"],"n130":["do","t"],"n132":"Que","n133":["nun","i"],"n134":["ca","t"],"n135":"me","n136":["de","i"],"n137":["ja","m"],"n138":["rá.","t"]},"verses":[{"label":"2.","lines":["Los vientos de este mundo","Hoy soplan, con tentación;","Mas siento paz sabiendo","Que tengo al Salvador;","Me guarda Él del peligro","Cuando otros no están,","Y Él me ha prometido","Que nunca me dejará."]},{"label":"3.","lines":["Cuando‿en el valle ando,","Por sendas de aflicción,","La cruz pesada, conmigo","La lleva mi Salvador;","Espinos mis pies enredan,","Tropiezo quieren causar;","Mas Él me ha prometido","Que nunca me dejará."]},{"label":"4.","lines":["Murió por mí en el monte,","La lanza lo hirió,","Abierta fue la fuente","Que carmesí fluyó;","Por mí, Él espera en gloria,","Y en Su trono está;","Y Él ha prometido","Que nunca me dejará."]}]}