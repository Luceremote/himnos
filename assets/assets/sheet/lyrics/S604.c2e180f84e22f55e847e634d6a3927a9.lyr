{"hymn":"S604","parent":"E782","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Qué misterio, oh Señor","subtitle":"Oración—Ejercitar el Espíritu","syl":{"n1":"¡Qué","n2":["mis","i"],"n3":["te","m"],"n4":["rio,","t"],"n5":"oh","n6":["Se","i"],"n7":["ñor!","t"],"n8":"Hoy","n9":["Tu‿Es","i"],"n10":["pí","m"],"n11":["ri","m"],"n13":["tu","t"],"n14":["es","i"],"n15":["tá","t"],"n16":"En","n17":"el","n18":["mí","i"],"n19":["o,","t"],"n20":"y","n21":"los","n22":"dos","n23":["U","i"],"n24":["no","t"],"n25":"son","n26":"en","n27":["rea","i"],"n28":["li","m"],"n29":["dad.","t"]},"verses":[{"label":"2.","lines":["En mi espíritu ando yo,","Para ser espiritual;","Sirviendo en mi espíritu,","Yo te puedo adorar."]},{"label":"3.","lines":["Toco con mi espíritu,","Tu Palabra en oración,","Bulle así mi espíritu,","Con la fuerza de Tu unción."]},{"label":"4.","lines":["Fuerte haz mi espíritu,","Para a otros avivar;","Libre en mi espíritu,","Puedo a otros animar."]},{"label":"5.","lines":["Cuando hable, oh Señor,","Pon mi espíritu en acción;","Motivado así por él,","Cumpliré con mi función."]},{"label":"6.","lines":["Al actuar mi espíritu","Los de otros se abrirán,","Al mover mi espíritu","Puedo a otros alentar."]},{"label":"7.","lines":["Ten piedad de mí, Señor,","Sopla fuertemente en mí;","Para que mi espíritu","Sea fuerte y fresco en Ti."]}]}