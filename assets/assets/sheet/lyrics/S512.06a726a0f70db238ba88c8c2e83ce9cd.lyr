{"hymn":"S512","parent":"E1203","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Dios es justo en Sus hechos","subtitle":"Experiencia de Dios—Su justicia, santidad y gloria","syl":{"n1":"Dios","n2":"es","n3":["jus","i"],"n4":["to","t"],"n5":"en","n6":"Sus","n7":["he","i"],"n9":["chos,","t"],"n10":"Sus","n11":["ca","i"],"n12":["mi","m"],"n13":["nos","t"],"n14":["rec","i"],"n15":["tos","t"],"n17":"son;","n18":"Es","n19":["per","i"],"n20":["fec","m"],"n21":["to‿en","t"],"n22":"Sus","n23":["ac","i"],"n24":["cio","m"],"n26":["nes","t"],"n27":"Y","n28":["me","i"],"n29":["re","m"],"n30":["ce","t"],"n31":["to","i"],"n32":["do‿ho","m"],"n34":["nor.","t"],"n35":["Jus","i"],"n36":["to‿es","t"],"n37":"lo","n39":"que","n40":"Él","n41":["re","i"],"n42":["quie","m"],"n44":["re,","t"],"n45":["Jus","i"],"n46":["ta‿es","t"],"n47":"Su","n48":["con","i"],"n49":["de","m"],"n50":["na","m"],"n51":["ción;","t"],"n52":["Pe","i"],"n53":["ca","m"],"n54":["do","m"],"n55":["res","t"],"n56":["pa","i"],"n57":["ra","t"],"n58":["jui","i"],"n60":["cio,","t"],"n61":"Ya","n62":"la","n64":"ley","n67":"nos","n68":["de","i"],"n69":["cla","m"],"n71":["ró.","t"]},"verses":[{"label":"2.","lines":["Por la ley fuimos juzgados,","Mas Su amor ya nos libró;","Dios pasó Su juicio al Hijo,","Su justicia Él cumplió.","Para Dios nos compró Cristo,","¡Aleluya al Redentor!","Justicia de Dios nos hace","Gracias a Su redención."]},{"label":"3.","lines":["Su naturaleza es santa,","Todo en Dios es santidad;","Él se une a nosotros","Y nos santificará,","Del espíritu se expande,","A todo nuestro interior;","Renovando cada parte,","Nos satura el corazón."]},{"label":"4.","lines":["¡Es precioso el proceso!","Salva en vida el Señor;","Día a día, nuestra vida","Es constante salvación.","Si fijamos nuestra mente,","Sólo en nuestro espíritu;","Él nos gana y nos transforma,","Por Su amor y Su virtud."]},{"label":"5.","lines":["Gloria es Dios expresado,","Lo que es Él en Su expresión,","Se verá en nuestros cuerpos,","Cuando alcancen redención.","Esta vida santifica:","Gloria es Su consumación;","Y la meta de la vida","Es la transfiguración."]},{"label":"6.","lines":["Qué gloriosa expectativa:","Él nos arrebatará.","Y la tierra ha de verlo:","Cristo a Dios exhibirá.","Siempre así lo expresaremos,","Todos los hijos de Dios;","Manifestando Su gloria,","Gozo para la creación."]},{"label":"7.","lines":["Qué destino tan glorioso:","¡Con piedad nos escogió!","No es del que quiere o corre,","Mas por voluntad de Dios.","Fuimos olivo silvestre,","Mas, en Cristo, ramas hoy;","Creceremos para el reino,","¡Cristo en Él nos injertó!"]},{"label":"8.","lines":["Disfrutamos por Su vida,","Nuestra santificación;","Es la vida de iglesia,","Suministro y bendición.","Aquí Dios es nuestro gozo,","Oh, ¡qué práctico y real!","Hijos somos, herederos,","En la iglesia hasta el final."]}]}