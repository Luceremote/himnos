{"hymn":"S505","parent":"E612","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Dios anhela proveerme","subtitle":"Experiencia de Dios—Al ejercitar el Espíritu","syl":{"n1":"Dios","n2":["an","i"],"n3":["he","m"],"n4":["la","t"],"n5":["pro","i"],"n6":["ve","m"],"n7":["er","m"],"n8":["me","t"],"n9":"Con","n10":"Su","n11":["mis","i"],"n12":["mo","t"],"n13":"ser;","n14":"En","n15":["mi‿es","i"],"n16":["pí","m"],"n17":["ri","m"],"n18":["tu","t"],"n19":"por","n20":["e","i"],"n21":["so","t"],"n22":"Me","n23":["u","i"],"n24":["no‿a","t"],"n25":"Él.","n26":["To","i"],"n27":["do","t"],"n28":"lo","n29":"de","n30":"Dios","n31":"hoy","n32":["flu","i"],"n33":["ye","t"],"n34":"En","n35":["Su‿Es","i"],"n36":["pí","m"],"n37":["ri","m"],"n38":["tu;","t"],"n39":"Le","n40":["co","i"],"n41":["noz","m"],"n42":["co‿e","m"],"n43":["jer","m"],"n44":["ci","m"],"n45":["tan","m"],"n46":["do","t"],"n47":["Mi‿es","i"],"n48":["pí","m"],"n50":["ri‿tu.","t"]},"verses":[{"label":"2.","lines":["Su naturaleza rica","Me ha dado Él;","En mi espíritu lo toco","Para ésta ver."]},{"label":"3.","lines":["Con mi espíritu lo toco,","No con mi pensar;","Si mi espíritu no uso,","Falto he de estar."]},{"label":"4.","lines":["Cuando escucho los mensajes,","Los tengo que orar;","En mi espíritu digiero","Todo el hablar."]},{"label":"5.","lines":["Al Señor en la Palabra","Tengo que tocar;","Si la estudio en mi mente,","Muerta estará."]},{"label":"6.","lines":["¡Oh, qué gloria, qué riquezas","En Su Espíritu!","Mías son cuando ejercito","Mi espíritu."]}]}