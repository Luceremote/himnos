{"hymn":"S698","parent":"E1248","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Juró el rey David","subtitle":"La iglesia—La consagración para la iglesia","syl":{"n1":["Ju","i"],"n2":["ró","t"],"n3":"el","n4":"rey","n5":["Da","i"],"n6":["vid:","t"],"n7":"\"No","n9":["en","i"],"n10":["tra","m"],"n11":["ré‿en","t"],"n12":"mi","n13":["ca","i"],"n14":["sa,","t"],"n16":"Ni‿al","n17":["le","i"],"n18":["cho","t"],"n19":["su","i"],"n20":["bi","m"],"n21":["ré,","t"],"n22":"Ni","n24":["ce","i"],"n25":["rra","m"],"n26":["ré","t"],"n27":"mis","n28":["o","i"],"n30":["jos,","t"],"n33":["Has","i"],"n34":["ta","t"],"n35":"que","n36":["ha","i"],"n37":["lle","t"],"n38":"un","n39":["lu","i"],"n40":["gar,","t"],"n42":["Se","i"],"n43":["ñor,","t"],"n44":["pa","i"],"n45":["ra","t"],"n46":["Tu‿ho","i"],"n47":["gar\".","t"],"n49":"Hoy","n50":["quie","i"],"n51":["re","t"],"n52":["nues","i"],"n53":["tro","t"],"n54":["fuer","i"],"n55":["te","t"],"n56":"Dios","n57":["Te","i"],"n58":["ner","t"],"n59":["Su‿ha","i"],"n60":["bi","m"],"n61":["ta","m"],"n62":["ción.","t"]},"verses":[{"label":"2.","lines":["Oh, qué ceguera estar","En lo nuestro encerrados,","Mientras desierta está","La casa que Él ansiaba.","Sacúdenos para subir","Al monte y encontrar","Madera para edificar,","Señor, Tu santo hogar."]},{"label":"3.","lines":["Como a David, Señor,","Inspira algunos hombres,","Por Tu edificación,","Que honren hoy Tu nombre,","Que vengan para edificar","Tu casa y cooperar","Contigo y con Tu intención","Señor, ¡qué bendición!"]},{"label":"4.","lines":["En los que llamarás","Pon tal anhelo alto,","De todo abandonar","Por Tu edificio santo.","La iglesia prevalecerá","Si edificada está;","Pronto edifica en nuestro ser,","En nuestro ser, Señor."]}]}