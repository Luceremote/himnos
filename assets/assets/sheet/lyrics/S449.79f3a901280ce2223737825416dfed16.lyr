{"hymn":"S449","parent":"E575","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Yo Tu promesa tomo, mi Señor","subtitle":"Experiencia de Cristo—Confiar en Él","syl":{"n1":"Yo","n2":"Tu","n3":["pro","i"],"n4":["me","m"],"n5":["sa","t"],"n6":["to","i"],"n7":["mo,","t"],"n8":"mi","n9":["Se","i"],"n10":["ñor","t"],"n11":["Co","i"],"n12":["mo","t"],"n13":"mi","n14":["fuer","i"],"n15":["za","t"],"n16":["dia","i"],"n17":["ria","t"],"n18":"y","n19":["sos","i"],"n20":["tén;","t"],"n21":["Mi","i"],"n22":["ro‿al","t"],"n23":["fu","i"],"n24":["tu","m"],"n25":["ro","t"],"n26":"sin","n27":["nin","i"],"n28":["gún","t"],"n29":["te","i"],"n30":["mor,","t"],"n31":"Pues","n32":["siem","i"],"n33":["pre‿es","m"],"n34":["tás","t"],"n35":["con","i"],"n36":["mi","m"],"n37":["go,","t"],"n38":["Sal","i"],"n39":["va","m"],"n40":["dor.","t"]},"verses":[{"label":"2.","lines":["Días de inseguridad, vendrán,","Cambios de‿entorno, confusión y afán;","Más se que nunca‿el día llegará","En que mi Salvador me‿olvidará."]},{"label":"3.","lines":["Días vendrán con sombras y aflicción,","Cuando‿el pecado sea tentador;","Mas esos días no traerán temor,","Porque cercano Tú‿estarás, Señor."]},{"label":"4.","lines":["Puede‿haber días de gran gozo y paz,","Diáfanos cielos, brillo y claridad;","En ese tiempo atráeme más a Ti,","Que seas Tú mi provisión aquí."]},{"label":"5.","lines":["Los otros días que queden, Señor,","Aunque sin luchas, gozo o dolor,","Días normales, sin nada‿especial,","Con cargas de cerácter tan trivial;"]},{"label":"6.","lines":["En esos días sé conmigo, Tú;","Así Tu gloria me traerá la luz;","Y cuando pase‿el mundo terrenal,","Contigo‿el día perfecto será."]}]}