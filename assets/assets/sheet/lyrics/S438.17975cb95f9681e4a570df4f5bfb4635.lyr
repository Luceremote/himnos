{"hymn":"S438","parent":"E556","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Tu nombre es como ungüento de valor","subtitle":"Experiencia de Cristo—Comunión con Él","syl":{"n1":"Tu","n2":["nom","i"],"n3":["bre‿es","t"],"n4":["co","i"],"n5":["mo‿un","m"],"n6":["güen","m"],"n7":["to‿de","t"],"n8":["va","i"],"n10":["lor,","t"],"n11":["Me","i"],"n12":["jor","t"],"n13":"que‿el","n14":["vi","i"],"n15":["no,","t"],"n16":["dul","i"],"n17":["ce","t"],"n18":"es","n19":["Tu‿a","i"],"n20":["mor;","t"],"n21":"Si","n22":["si","i"],"n23":["go","t"],"n24":"en","n25":"las","n26":["hue","i"],"n27":["llas","t"],"n28":"de","n29":"la","n30":"grey,","n31":"Tu","n32":["co","i"],"n33":["mu","m"],"n34":["nión","t"],"n35":["de‿a","i"],"n36":["mor","t"],"n37":["dis","i"],"n38":["fru","m"],"n39":["ta","m"],"n40":["ré.","t"]},"verses":[{"label":"2.","lines":["Yo soy Su amor y Él mi Amado es;","Él me atrae, lo sigo por doquier.","Lo escondo en mí, mirra fragante es,","Me cubre como bella *alheña* Él."]},{"label":"3.","lines":["Gusto Su amor, y Su grosura da;","Hallo en Su seno gran reposo y paz.","Me muestra la bandera de Su amor,","Enterneciendo así mi corazón."]},{"label":"4.","lines":["Mi Amado es mío, y yo Suyo soy,","Yo soy un lirio, Él mi buen Pastor;","Que apunte el día, las sombras se irán,","Él como un ciervo en el monte está."]},{"label":"5.","lines":["Mirra de muerte y resurrección,","Olíbano empapa el corazón;","Viento del norte, sopla hasta hacer","Del huerto de mi alma Su placer."]},{"label":"6.","lines":["Como paloma quiero limpio ser,","Un lirio puro delante de Él;","Yo quiero el gozo de Sus gozos ser,","Y mi Cantar de los cantares, Él."]},{"label":"7.","lines":["Como la luna, conformado a Él,","Esclarecido como el sol seré;","Sólo a mi Amado quiero agradar,","Sólo Su vida quiero expresar."]},{"label":"8.","lines":["Eres mi vida, yo Tu imagen soy;","¡Como la muerte, fuerte es este amor!","No se destruye ni decaerá;","Hasta que vengas, él nos guardará."]}]}