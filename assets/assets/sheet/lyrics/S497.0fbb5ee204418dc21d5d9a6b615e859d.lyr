{"hymn":"S497","parent":"E1193","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Vida es Dios el Padre en Jesucristo","subtitle":"Experiencia de Dios—Como vida","syl":{"n1":["Vi","i"],"n2":["da‿es","t"],"n3":"Dios","n4":"el","n5":["Pa","i"],"n6":["dre‿en","t"],"n7":["Je","i"],"n8":["su","m"],"n9":["cris","m"],"n11":["to,","t"],"n13":["Flu","i"],"n14":["ye","t"],"n15":["co","i"],"n16":["mo‿Es","m"],"n17":["pí","m"],"n18":["ri","m"],"n19":["tu‿en","t"],"n20":"mi","n21":"ser;","n23":"¡Qué","n24":["Per","i"],"n25":["so","m"],"n26":["na","t"],"n27":["ri","i"],"n28":["ca","t"],"n29":["pa","i"],"n30":["ra","t"],"n31":["dis","i"],"n32":["fru","m"],"n33":["tar!","t"],"n34":["Nues","i"],"n35":["tra","t"],"n36":["vi","i"],"n37":["da‿en","t"],"n38":["ple","i"],"n39":["ni","m"],"n40":["tud","t"],"n41":"es","n42":"Él."},"verses":[{"label":"2.","lines":["Experimentamos nueva vida","Cuando abrimos nuestro ser a Él;","Nos regeneró, Su misma vida entró,","Que nos va inundando con Su Ser."]},{"label":"3.","lines":["Él es el Espíritu viviente,","Fluye en mi espíritu también;","Hasta transformar, mi mente renovar,","Por la vida que impartiendo está."]},{"label":"4.","lines":["Mi cooperación Él necesita,","Al fijar la mente en el Señor;","Del pensar errante vuelvo yo mi ser,","Hasta que se fije sólo en Él."]},{"label":"5.","lines":["Nuestro espíritu hoy te contiene,","Pero aún Tu plan quieres lograr;","Si me despojara del viejo pensar,","Gozaría de Tu vida y paz."]},{"label":"6.","lines":["¡Oh, captura cada pensamiento,","Tu Palabra me renovará;","Ella cambiará mi mente natural","Hasta mi pensar santificar."]},{"label":"7.","lines":["Vamos practicando este principio:","De ocupar la mente en el Señor;","De Él emana nuestro modo de vivir,","¡Qué maravilloso estar en Él!"]}]}