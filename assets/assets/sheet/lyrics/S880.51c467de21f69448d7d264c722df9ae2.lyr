{"hymn":"S880","parent":"E1059","quality":"check","adjust":{"hold":0,"merge":0},"title":"Guárdame en Tu cruz, Señor","subtitle":"El evangelio—Clamar al Señor","syl":{"n1":["Guár","i"],"n2":["da","m"],"n3":["me‿en","t"],"n4":"Tu","n5":"cruz,","n6":["Se","i"],"n7":["ñor;","t"],"n9":"Su","n10":["pre","i"],"n11":["cio","m"],"n12":["sa","t"],"n13":["fuen","i"],"n14":["te","t"],"n16":"Del","n17":["Cal","i"],"n18":["va","m"],"n19":["rio","t"],"n20":"trae","n21":["sa","i"],"n22":["lud,","t"],"n24":["A","i"],"n25":["bun","m"],"n26":["dan","m"],"n27":["te","m"],"n28":["men","m"],"n29":["te.","t"],"n31":"En","n32":"la","n33":"cruz,","n34":"en","n35":"la","n36":"cruz,","n37":"Sea","n38":"mi","n39":["glo","i"],"n40":["ria","t"],"n41":["siem","i"],"n42":["pre;","t"],"n43":"A","n44":"Tu","n45":"cruz","n46":["se‿a","i"],"n47":["fe","m"],"n48":["rra","m"],"n49":["rá","t"],"n51":["Mi‿al","i"],"n52":["ma‿e","m"],"n53":["ter","m"],"n54":["na","m"],"n55":["men","m"],"n56":["te.","t"]},"verses":[{"label":"2.","lines":["En la cruz, a un pecador,","Por Tu amor hallaste;","Estrella de resplandor","Sobre mí brillaste."]},{"label":"3.","lines":["Cerca de la cruz, Señor,","Tráeme sus escenas,","Para que yo pueda andar","En su sombra plena."]},{"label":"4.","lines":["Cerca de la cruz, aquí","Vigilo y espero;","Hasta contemplar Tu faz,","Salvador, me esmero."]}]}