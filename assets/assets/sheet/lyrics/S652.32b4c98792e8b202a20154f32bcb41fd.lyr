{"hymn":"S652","parent":"E840","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Libre de Adán y el ego","subtitle":"La iglesia—Su edificación","syl":{"n1":["Li","i"],"n2":["bre","t"],"n3":"de","n4":["A","i"],"n5":["dán","t"],"n6":"y‿el","n7":["e","i"],"n8":["go,","t"],"n9":["E","i"],"n10":["di","m"],"n11":["fí","m"],"n12":["ca","m"],"n13":["me,","t"],"n14":["Se","i"],"n15":["ñor,","t"],"n16":"Con","n17":"los","n18":["san","i"],"n19":["tos","t"],"n20":["co","i"],"n21":["mo‿un","t"],"n22":["tem","i"],"n23":["plo","t"],"n24":"Do","n25":["ve","i"],"n26":["re","m"],"n27":["mos","t"],"n28":["Tu‿es","i"],"n29":["plen","m"],"n30":["dor.","t"],"n31":"De","n32":"los","n33":["ras","i"],"n34":["gos","t"],"n35":["pe","i"],"n36":["cu","m"],"n37":["lia","m"],"n38":["res","t"],"n39":"Y","n40":"de","n41":"lo","n42":["in","i"],"n43":["di","m"],"n44":["vi","m"],"n45":["dual","t"],"n47":["Lí","i"],"n48":["bra","m"],"n49":["nos,","t"],"n50":["y‿a","i"],"n51":["sí","t"],"n52":["se","i"],"n53":["re","m"],"n54":["mos","t"],"n55":"Tu","n56":["mo","i"],"n57":["ra","m"],"n58":["da","t"],"n59":["e","i"],"n60":["ter","m"],"n61":["nal.","t"]},"verses":[{"label":"2.","lines":["Al fluir en mí Tu vida","Transformado yo seré,","Coordinado con los santos","Edificación tendré;","Guardaré en Tu Cuerpo el orden","Al hacer Tu voluntad,","Ayudando y sirviendo","Cumpliré Tu eterno plan."]},{"label":"3.","lines":["Mi saber y experiencia","No me deben exaltar;","Balanceado por el Cuerpo,","Sometido he de estar;","Crezco con el crecimiento","Que ministra la Cabeza;","Me proveen las coyunturas","Nutrición y unidad."]},{"label":"4.","lines":["Con poder fortalecido","En el hombre interior","Por Tu Espíritu, comprendo","Tu grandeza y vasto amor;","Todas Tus riquezas tomo,","Hasta ver Tu plenitud,","Madurando en el Cuerpo,","Así lo edificas Tú."]},{"label":"5.","lines":["En Tu casa y en Tu Cuerpo","Edifícame, Señor;","Este vaso colectivo","Mostrará Tu resplandor;","Que Tu novia, ciudad santa,","Aparezca en la tierra,","Refulgente candelero","Que exprese Tu valor."]}]}