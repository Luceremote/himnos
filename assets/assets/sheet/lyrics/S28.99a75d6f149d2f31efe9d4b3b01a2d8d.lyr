{"hymn":"S28","parent":"E33","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Padre, Tú nos escogiste","subtitle":"Adoración al Padre—Su elección","syl":{"n1":["Pa","i"],"n2":["dre,","t"],"n3":"Tú","n4":"nos","n5":["es","i"],"n7":["co","m"],"n9":["gis","m"],"n10":["te","t"],"n11":["An","i"],"n12":["tes","t"],"n13":"de","n14":"la","n15":["cre","i"],"n16":["a","m"],"n17":["ción;","t"],"n18":"A","n19":"Tu","n20":["Hi","i"],"n21":["jo","t"],"n22":"nos","n24":["a","i"],"n26":["tra","m"],"n27":["e","t"],"n28":"Tu","n29":["a","i"],"n30":["mor","t"],"n31":["con","i"],"n33":["mo","m"],"n34":["ve","m"],"n35":["dor,","t"],"n36":"Y","n37":"nos","n38":["guar","i"],"n39":["da,","t"],"n40":"y","n41":"nos","n42":["guar","i"],"n43":["da","t"],"n44":["Fir","i"],"n45":["me","m"],"n46":["men","m"],"n47":["te‿en","t"],"n48":"el","n49":["Se","i"],"n50":["ñor,","t"],"n51":["Fir","i"],"n52":["me","m"],"n53":["men","m"],"n55":["te‿en","t"],"n57":"el","n58":["Se","i"],"n59":["ñor.","t"]},"verses":[{"label":"2.","lines":["Aunque‿el mundo es cambiante,","Nuestro Dios no cambiará;","Su misericordia‿y pacto","No se pueden alterar.","Y Sus hijos, y Sus hijos","Siempre lo han de‿alabar,","Siempre lo han de‿alabar."]},{"label":"3.","lines":["Mi historia‿y mi jactancia","Es la compasión de Dios;","Siempre‿abunda, nunca falla,","Me dirige‿a donde voy;","Dios nos ama, Dios nos ama,","¡Su‿Unigénito nos dio!","¡Su‿Unigénito nos dio!"]},{"label":"4.","lines":["Padre‿amado, te‿alabamos","Por Tu‿inmensurable‿amor;","Cantaremos para siempre","Con el Hijo de Tu‿amor.","Dando gloria, dando gloria","Al Cordero y a Dios,","Al Cordero y a Dios."]}]}