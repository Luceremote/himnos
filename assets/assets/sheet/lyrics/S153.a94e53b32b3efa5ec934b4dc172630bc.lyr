{"hymn":"S153","parent":"E194","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El testimonio de Dios Tú","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"El","n2":["tes","i"],"n3":["ti","m"],"n4":["mo","m"],"n5":["nio","t"],"n6":"de","n7":"Dios","n8":"Tú,","n9":["Su","i"],"n10":["pe","m"],"n11":["ras","m"],"n12":["te","t"],"n13":"la","n14":"ley.","n16":"La","n17":"ley,","n18":"un","n19":["ti","i"],"n20":["po","t"],"n21":"fiel","n22":"de","n23":"Ti,","n24":["Gra","i"],"n25":["ba","m"],"n26":["da‿en","t"],"n27":["pie","i"],"n28":["dras","t"],"n29":"fue.","n31":"La","n32":"ley","n33":"un","n34":["cua","i"],"n36":["dro","t"],"n37":"fue","n38":"de","n39":"Dios,","n40":"Y","n41":"su","n42":["de","i"],"n44":["fi","m"],"n45":["ni","m"],"n46":["ción;","t"],"n48":"Mas","n49":["e","i"],"n50":["res","t"],"n51":"Tú","n52":"Su","n53":["rea","i"],"n54":["li","m"],"n55":["dad,","t"],"n56":"En","n57":"Ti","n58":"hoy","n59":["mo","i"],"n60":["ra","t"],"n61":"Dios."},"verses":[{"label":"2.","lines":["También el Arca‿un tipo fue,","Tu testimonio‿aquí;","En ella puso Dios Su ley,","Más Él se ve en Ti.","El arca de madera es","Y de‿oro se cubrió;","Es tipo de Tu‿humanidad,","En donde‿habita Dios."]},{"label":"3.","lines":["Eres el tabernáculo,","Morada eternal,","Del mismo Dios que se‿encarnó","Con gracia‿y realidad.","Su gloria Dios en Ti mostró,","Tú, Su Palabra fiel,","Que por Tu obra, luz y amor","Lo diste‿a conocer."]},{"label":"4.","lines":["El templo‿un tipo Tuyo fue,","La casa de Dios, Tú.","En Ti habita‿el Dios de amor,","Nos das Su plenitud.","Aunque Satán te destruyó,","Por muerto te contó,","Te haces, en resurrección,","Más grande‿habitación."]},{"label":"5.","lines":["Es la ciudad Tu plenitud,","Tu novia es señal;","Tu mismo‿aumento ella es,","Donde morando‿estás.","La luz divina‿en Ti es Dios;","La lámpara‿eres Tú;","Por ella‿alumbra‿a todos Dios","Con tal gloriosa luz."]},{"label":"6.","lines":["El Arca‿y tabernáculo","Guardan la ley de Dios.","El templo‿y la ciudad también","Son todos Tú, Señor.","El eje y la rueda, Tú,","¡El todo‿en todos hoy!","En Ti se ven el hombre‿y Dios,","¡Cuán grato‿al corazón!"]}]}