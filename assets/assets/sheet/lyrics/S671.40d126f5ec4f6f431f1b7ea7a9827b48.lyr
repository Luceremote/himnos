{"hymn":"S671","parent":"E1258","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Cuán hermosas y preciosas","subtitle":"La iglesia—Su expresión local","syl":{"n1":"¡Cuán","n2":["her","i"],"n3":["mo","m"],"n5":["sas","t"],"n6":"y","n7":["pre","i"],"n8":["cio","m"],"n10":["sas","t"],"n11":"Tus","n12":["i","i"],"n13":["gle","m"],"n14":["sias","t"],"n16":"son,","n17":["Se","i"],"n18":["ñor!","t"],"n19":["Mi‿al","i"],"n20":["ma","t"],"n21":["a","i"],"n23":["ño","m"],"n24":["ra‿hoy","t"],"n25":"los","n26":["a","i"],"n28":["trios","t"],"n29":["Don","i"],"n30":["de","t"],"n31":["mo","i"],"n32":["ras","t"],"n33":"Tú,","n35":"oh","n36":"Dios;","n37":"Mi","n38":["es","i"],"n39":["pí","m"],"n41":["ri","m"],"n42":["tu","t"],"n43":["an","i"],"n44":["he","m"],"n46":["la,","t"],"n47":"Y","n48":["de","i"],"n49":["sea","t"],"n51":"mi","n52":["co","i"],"n54":["ra","m"],"n55":["zón","t"],"n56":"Ver","n58":"en","n59":["to","i"],"n61":["das","t"],"n62":"las","n64":["i","i"],"n66":["gle","m"],"n69":["sias","t"],"n70":"Más","n71":["es","i"],"n72":["tre","m"],"n74":["cha","t"],"n75":["co","i"],"n76":["mu","m"],"n77":["nión.","t"]},"verses":[{"label":"2.","lines":["Bienaventurado el hombre","Cuya fuerza en Ti halló;","En su corazón él tiene","Las calzadas a Sion.","En unión con las iglesias","Él, confiado, cantará;","Y las lágrimas del valle,","Las convierte en manantial."]},{"label":"3.","lines":["¡Más vale en Tu iglesia un día","Que mil días fuera estar!","Para el más pequeño miembro,","Sol y escudo es Jehová.","Todo bien con gracia y gloria,","Nos otorga Él allí.","Bendito el que en Tus iglesias","More para siempre así."]}]}