{"hymn":"S304","parent":"E387","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Tuyo soy, Jesús; escuché Tu voy","subtitle":"Anhelos—De un andar más cercano con Cristo","syl":{"n1":["Tu","i"],"n2":["yo","t"],"n3":"soy,","n4":["Je","i"],"n5":["sús;","t"],"n6":["es","i"],"n7":["cu","m"],"n8":["ché","t"],"n9":"Tu","n10":"voy","n11":"Que","n12":["me‿ha","i"],"n13":["bla","m"],"n14":["ba","t"],"n15":"de","n16":["Tu‿a","i"],"n18":["mor.","t"],"n19":"Mas","n20":"por","n21":["fe‿an","i"],"n22":["he","m"],"n23":["lo‿a","m"],"n24":["cer","m"],"n25":["car","m"],"n26":["me‿hoy,","t"],"n27":["A","i"],"n28":["ún","t"],"n29":"más","n30":["cer","i"],"n31":["ca","t"],"n32":"a","n33":"Ti,","n34":["Se","i"],"n35":["ñor.","t"],"n37":["A","i"],"n38":["ún","t"],"n39":"más","n40":["cer","i"],"n41":["ca,","t"],"n42":["cer","i"],"n43":["ca","t"],"n44":"de‿Tu","n45":"cruz,","n46":"Do","n47":["san","i"],"n48":["gras","m"],"n49":["te,","t"],"n50":"mi","n51":["Se","i"],"n52":["ñor;","t"],"n54":"A‿ún","n55":"más","n56":["cer","i"],"n57":["ca,","t"],"n59":["cer","i"],"n60":["ca,","t"],"n62":["cer","i"],"n63":["ca‿a","t"],"n64":"Ti,","n65":["Je","i"],"n66":["sús,","t"],"n67":["Llé","i"],"n68":["va","m"],"n69":["me,","t"],"n70":"mi","n71":["Sal","i"],"n72":["va","m"],"n73":["dor.","t"]},"verses":[{"label":"2.","lines":["Hoy conságrame para‿así servir","Por Tu gracia divinal;","A mi alma firme‿esperanza da;","Pierda‿en Ti mi voluntad."]},{"label":"3.","lines":["¡Oh, qué gran placer, una hora‿estar","Frente‿al trono‿en oración,","Cuando me‿arrodillo‿ante Ti, mi Dios,","Es tan dulce comunión!"]},{"label":"4.","lines":["Quiero conocer más profundo‿amor","Antes de mirar Tu faz;","Quiero más y más gozo celestial","Antes de‿entrar en Tu paz."]}]}