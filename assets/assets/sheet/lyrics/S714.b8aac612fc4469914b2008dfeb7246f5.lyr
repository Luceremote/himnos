{"hymn":"S714","parent":"E869","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Te alabamos al partir, Señor","subtitle":"Las reuniones—Despedida","syl":{"n1":"Te","n2":["a","i"],"n3":["la","m"],"n4":["ba","m"],"n5":["mos","t"],"n6":"al","n7":["par","i"],"n8":["tir,","t"],"n9":["Se","i"],"n10":["ñor,","t"],"n11":"Por","n12":"Tu","n13":["pre","i"],"n14":["sen","m"],"n15":["cia","t"],"n16":"y","n17":["pa","i"],"n18":["la","m"],"n19":["bra","t"],"n21":"fiel;","n22":"Tú","n23":"nos","n24":["a","i"],"n25":["traes","t"],"n26":"por","n27":"Tu","n28":["pre","i"],"n29":["cio","m"],"n30":["si","m"],"n31":["dad,","t"],"n32":"Y,","n33":"por","n34":["Tu‿ha","i"],"n35":["blar,","t"],"n36":["se‿in","i"],"n37":["cli","m"],"n38":["na‿el","t"],"n39":["co","i"],"n40":["ra","m"],"n41":["zón.","t"]},"verses":[{"label":"2.","lines":["Por Tu palabra nos haces crecer,","Ella espíritu y vida es;","A Tu imagen nos transformará,","Hasta alcanzar la plena madurez."]},{"label":"3.","lines":["Impártete en nosotros más y más,","En el espíritu haznos andar;","Contigo guárdanos en comunión,","Hasta la próxima reunión, Señor."]}]}