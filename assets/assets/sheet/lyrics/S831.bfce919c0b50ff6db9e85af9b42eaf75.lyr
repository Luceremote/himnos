{"hymn":"S831","parent":"E985","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Los vasos, hoy de barro","subtitle":"La máxima manifestación—La vida en la eternidad","syl":{"n1":"Los","n2":["va","i"],"n3":["sos,","t"],"n4":"hoy","n5":"de","n6":["ba","i"],"n7":["rro,","t"],"n8":["Trans","i"],"n9":["lú","m"],"n10":["ci","m"],"n11":["dos","t"],"n12":["se","i"],"n13":["rán;","t"],"n15":["Se","i"],"n16":["ñor,","t"],"n17":["co","i"],"n18":["mo","t"],"n19":["te","i"],"n20":["so","m"],"n21":["ro,","t"],"n22":"En","n23":"mí","n24":"Tú","n25":["bri","i"],"n27":["lla","m"],"n28":["rás.","t"]},"verses":[{"label":"2.","lines":["El vaso de oro brilla,","Es Dios su resplandor;","Allí el sol no alumbra;","Su misma luz es Dios."]},{"label":"3.","lines":["La más preciosa Piedra","Es Cristo en la ciudad;","Cual jaspe en suma gloria,","Allí Él brillará."]},{"label":"4.","lines":["Tal vaso grande y claro,","Con gloria en plenitud,","Alumbra bien la tierra","Con su radiante luz."]},{"label":"5.","lines":["Verán todos Su gloria","En la nueva creación:","La novia del Cordero","En su consumación."]},{"label":"6.","lines":["Tal vaso tan glorioso","Evoca adoración,","Pues Dios, en el Cordero,","Encuentra Su expresión."]}]}