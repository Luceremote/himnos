{"hymn":"S649","parent":"E837","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Hoy te alabamos por Tu plan","subtitle":"La iglesia—Su edificación","syl":{"n1":"Hoy","n2":["te‿a","i"],"n3":["la","m"],"n4":["ba","m"],"n5":["mos","t"],"n7":"por","n8":"Tu","n10":"plan,","n11":"Pues","n12":"nos","n13":["ha","i"],"n14":["rás","t"],"n15":["Tu‿ha","i"],"n17":["bi","m"],"n18":["ta","m"],"n20":["ción.","t"],"n21":["Vi","i"],"n22":["vien","m"],"n23":["do‿en","t"],"n24":["nues","i"],"n25":["tro","t"],"n27":"ser","n28":["ten","i"],"n30":["drás","t"],"n31":["U","i"],"n32":["na","t"],"n33":["mo","i"],"n34":["ra","m"],"n35":["da","t"],"n36":["y‿ex","i"],"n37":["pre","m"],"n39":["sión.","t"]},"verses":[{"label":"2.","lines":["Dios a Su‿imagen nos creó,","Nos dio Su misma autoridad;","Sólo de barro nos formó,","Mas sin Su esencia divinal."]},{"label":"3.","lines":["Al recibirlo‿en nuestro ser","Su esencia y vida nos legó;","Mezclados hoy el hombre y Dios,","Somos un Cuerpo, Su expresión."]},{"label":"4.","lines":["Fluye Tu vida en nuestro ser,","Piedras preciosas nos harás;","Vas renovando el corazón,","Y a Tu imagen nos cambiarás."]},{"label":"5.","lines":["Pero todo‿esto no será","Para un elogió o vanidad,","Mas para que‿haya material","Para Tu casa edificar."]},{"label":"6.","lines":["A Ti nos damos, oh Señor,","Y a Tus manos sabias hoy;","Quebrántanos hasta obtener","Una gloriosa habitación."]},{"label":"7.","lines":["Quiebra esta vida natural,","Quiebra también lo peculiar,","De independencia líbranos,","Para ser uno en verdad."]},{"label":"8.","lines":["Así Tu Novia nos harás,","Disfrutaremos de Tu amor;","Y Tú tendrás Tu ansiado hogar","Que saciará Tu corazón."]}]}