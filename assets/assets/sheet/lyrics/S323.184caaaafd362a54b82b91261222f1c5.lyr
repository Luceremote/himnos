{"hymn":"S323","parent":"E425","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo, Príncipe de Paz","subtitle":"Anhelos—De obtener reposo","syl":{"n1":["Cris","i"],"n2":["to,","t"],"n3":["Prín","i"],"n4":["ci","m"],"n5":["pe","t"],"n6":"de","n7":"Paz,","n8":["To","i"],"n9":["ma","t"],"n10":"Tú","n12":"mi","n13":["vo","i"],"n14":["lun","m"],"n15":["tad:","t"],"n16":"Mis","n17":["te","i"],"n18":["mo","m"],"n20":["res","t"],"n21":"haz","n22":["ce","i"],"n23":["sar,","t"],"n24":"Da‿a","n25":["mi‿es","i"],"n26":["pí","m"],"n28":["ri","m"],"n29":["tu","t"],"n30":["so","i"],"n31":["laz.","t"]},"verses":[{"label":"2.","lines":["Ya Tu sangre me compró","Y me dio acceso‿a Dios;","Pido paz genuina hoy,","Esa paz que‿es nuestra‿unión."]},{"label":"3.","lines":["Haz Tu voluntad, Señor,","Yo la mía cedo hoy;","Toda duda haz huir,","Y tu paz imparte‿en mí."]},{"label":"4.","lines":["A Tus pies postrado‿estoy,","Sé mi vida‿y todo hoy;","Siempre yo te serviré,","Uno contigo seré."]}]}