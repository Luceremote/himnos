{"hymn":"S522","parent":"NS297","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Enterrada, pero es","subtitle":"El camino de la cruz—El camino de ser fructiferos","syl":{"n1":["En","i"],"n2":["te","m"],"n3":["rra","m"],"n4":["da,","t"],"n5":["pe","i"],"n6":["ro","t"],"n7":"es","n8":"La","n9":["se","i"],"n10":["mi","m"],"n12":["lla","t"],"n13":"que","n14":"tal","n15":"vez","n16":["Pue","i"],"n17":["de‿un","t"],"n18":["dí","i"],"n20":["a‿a","m"],"n21":["li","m"],"n22":["men","m"],"n23":["tar","t"],"n24":["Con","i"],"n25":["ti","m"],"n26":["nen","m"],"n28":["tes","t"],"n29":"con","n30":"su","n31":"pan."},"verses":[{"label":"2.","lines":["¡Enterrada, oculta está","En la negra oscuridad!","Todo allí ya se perdió,","Todo excepto el mismo Dios."]},{"label":"3.","lines":["Enterrada: al parecer,","Para el hombre nada es,","Mas Dios no la olvidará;","Vida un día brotará."]},{"label":"4.","lines":["¿Enterrado estás tú hoy?","¿Ya te sangra el corazón?","Canta, no lamentes más,","Sólo así la mies vendrá."]}]}