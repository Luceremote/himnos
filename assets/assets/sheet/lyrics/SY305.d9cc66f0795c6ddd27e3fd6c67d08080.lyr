{"hymn":"SY305","parent":"NS915","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Tinieblas, luz, distintos son","subtitle":"","syl":{"n1":"Hoy,","n2":"mi","n3":["Se","i"],"n4":["ñor,","t"],"n6":["re","i"],"n7":["ci","m"],"n9":["bo‿el","t"],"n10":["a","i"],"n11":["mor","t"],"n13":"De","n15":["la‿ver","i"],"n16":["dad,","t"],"n18":["pa","i"],"n19":["ra","t"],"n21":"ser","n23":["sal","i"],"n26":["vo","t"],"n27":"De","n28":"la","n29":["con","i"],"n30":["fu","m"],"n31":["sión,","t"],"n33":["men","i"],"n34":["ti","m"],"n35":["ra","t"],"n36":["y‿e","i"],"n37":["rror;","t"],"n39":"Me","n40":["a","i"],"n41":["fe","m"],"n42":["rro‿a","t"],"n43":"Ti,","n45":["Se","i"],"n47":["ñor.","t"],"n52":["Ti","i"],"n53":["nie","m"],"n54":["blas,","t"],"n55":"luz,","n57":["dis","i"],"n58":["tin","m"],"n60":["tos","t"],"n61":"son;","n63":["A","i"],"n64":["mar","m"],"n65":["go‿y","t"],"n66":["dul","i"],"n68":["ce","t"],"n70":"no‿es","n72":["i","i"],"n74":["gual.","t"],"n76":"No","n77":["par","i"],"n78":["ti","m"],"n79":["ci","m"],"n81":["pa","m"],"n82":["ré","t"],"n84":"del","n85":"mal,","n87":["Es","i"],"n88":["co","m"],"n89":["jo","t"],"n90":"la","n92":["ver","i"],"n94":["dad","t"],"n96":["a","i"],"n98":["mar.","t"]},"verses":[{"label":"2.","lines":["Mi Dios existe y es real,","El diablo no me engañara.","La oscuridad rechazaré,","Su luz, Su presencia, toqué."]},{"label":"3.","lines":["El Alfarero me hizo bien,","Su arreglo no despreciaré;","Su Espíritu en el mío esta","Me hizo así, trae vida y paz."]},{"label":"4.","lines":["Señor eres la realidad,","Ocupa todo mi pensar;","En Tu palabra hay vida y luz","Mi mente la renuevas Tú."]},{"label":"5.","lines":["Señor en Tu iglesia hoy,","Los cielos abiertos están;","Constituidos para ser","Columna fiel de la verdad."]}]}