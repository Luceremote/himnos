{"hymn":"S146","parent":"E187","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Muy rico eres, oh Señor","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"Muy","n2":["ri","i"],"n3":["co","t"],"n4":["e","i"],"n5":["res,","t"],"n6":"oh","n7":["Se","i"],"n8":["ñor,","t"],"n9":["Tu‿a","i"],"n10":["mor","t"],"n11":"nos","n12":"lo","n13":["re","i"],"n14":["ve","m"],"n15":["la;","t"],"n16":"Tu","n17":"ser","n18":["i","i"],"n20":["nes","m"],"n21":["cru","m"],"n22":["ta","m"],"n23":["ble","t"],"n25":"hoy","n26":["Nues","i"],"n27":["tro‿es","m"],"n28":["pí","m"],"n29":["ri","m"],"n30":["tu","t"],"n31":["lle","i"],"n33":["na.","t"]},"verses":[{"label":"2.","lines":["Tu eres la Palabra‿y Dios,","Con Dios desde‿el principio;","Como‿hombre te‿encarnaste Tú","Para‿a Dios definirnos."]},{"label":"3.","lines":["El tabernáculo‿eres Tú,","Con la divina gloria;","También el templo para Dios,","En Ti está Su‿historia."]},{"label":"4.","lines":["Como‿Unigénito de Dios,","El Padre declaraste;","Así Su vida eternal","Y‿esencia nos legaste."]},{"label":"5.","lines":["Como‿Hijo de‿Hombre llevas Tú","Nuestra naturaleza,","Para llevar hijos a Dios","Con Tu‿estatura plena."]},{"label":"6.","lines":["Eres el Cristo y‿el Señor,","Por Dios fuiste ungido;","El todo‿en todos eres Tú;","De Dios, el Escogido."]},{"label":"7.","lines":["Crucificado Salvador,","Sangre‿y agua vertiste;","Tu vida‿entró en nuestro ser,","También nos redimiste."]},{"label":"8.","lines":["Glorificado‿estás, Jesús,","Como‿Espíritu vienes;","Este‿inclusivo‿Espíritu","Tu mérito hoy tiene."]},{"label":"9.","lines":["La luz de vida eres Tú,","Brillando‿en nuestras sombras;","Resplandeciendo‿así con Dios,","En nuestro ser Tú obras."]},{"label":"10.","lines":["Como la vida divinal","Nuestro‿espíritu‿avivas;","De toda muerte libras Tú,","Y nuestro ser animas."]},{"label":"11.","lines":["Eres la realidad de Dios,","Verdad que‿a Dios complace;","Ella nos trae Tu mismo ser,","Así nos satisface."]},{"label":"12.","lines":["La senda de la vida, Tú","Nos llevas a la gloria;","La senda de Tu realidad","Apremia la victoria."]},{"label":"13.","lines":["Tú eres la resurrección","Que traga toda muerte;","Podemos hoy llevar la cruz","Por su poder tan fuerte."]},{"label":"14.","lines":["Cordero‿inmaculado, Tú","La redención lograste;","Al darnos Tu Espíritu,","Tú nos regeneraste."]},{"label":"15.","lines":["Serpiente de bronce‿eres Tú,","Que salva del pecado;","Te levantaron en la cruz","Para‿aplastar al diablo."]},{"label":"16.","lines":["Eres la puerta y‿el Pastor","Que del redil nos saca.","Por Ti gozamos libertad;","En pastos Tú nos sacias."]},{"label":"17.","lines":["Como‿el lavacro‿en su función,","Muy limpios nos mantienes;","Así, andando‿en comunión,","Gozamos de Tus bienes."]},{"label":"18.","lines":["Hendida roca celestial,","Tú fluyes agua viva;","Bebemos de‿este manantial","Que sacia con Tu vida."]},{"label":"19.","lines":["Eres el pozo celestial,","Siempre con agua viva;","Bebemos Tu vida‿eternal","Que nuestra sed termina."]},{"label":"20.","lines":["El pan del cielo eres Tú,","Nos nutres con Tu vida;","Por Tu‿abundancia divinal","Nuestro‿espíritu‿animas."]},{"label":"21.","lines":["Aliento de vida‿eres Tú,","Y‿en nuestro ser te soplas;","Viviendo y andando‿en Ti,","Tu‿herencia nos otorgas."]},{"label":"22.","lines":["Grano de trigo divinal,","por muerte,‿en gloria entraste;","Formando muchos granos, Tú","El Cuerpo‿así formaste."]},{"label":"23.","lines":["Eres la verdadera vid,","Los pámpanos, nosotros;","Morando mutuamente‿así,","Nos das Tu suministro."]},{"label":"24.","lines":["Eres el Novio celestial","Que va‿a tomar la novia,","Para contigo uno ser","En vida,‿amor y gloria."]},{"label":"25.","lines":["Tú, la‿escalera de Jacob,","Por Ti se‿abren los cielos;","En Ti somos casa de Dios,","Cielos y tierra‿unidos."]},{"label":"26.","lines":["Señor, Tú como el gran \"Yo Soy\"","Nuestra‿escasez hoy llenas;","Por ser el todo‿en todos, Tú","El plan de Dios consumas."]}]}