{"hymn":"S315","parent":"E405","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Ya que he visto la hermosura","subtitle":"Anhelos—De deleite en el Señor","syl":{"n1":"Ya","n2":"que‿he","n3":["vis","i"],"n4":["to","t"],"n5":["la‿her","i"],"n6":["mo","m"],"n7":["su","m"],"n8":["ra","t"],"n9":["De‿es","i"],"n10":["te","t"],"n11":["mun","i"],"n12":["do","t"],"n13":["ten","i"],"n14":["ta","m"],"n15":["dor,","t"],"n17":"Yo","n18":["pre","i"],"n19":["fie","m"],"n20":["ro","t"],"n21":"Tu","n22":["pre","i"],"n23":["sen","m"],"n24":["cia,","t"],"n25":["Aun","i"],"n26":["que","t"],"n27":["cie","i"],"n28":["go‿es","m"],"n29":["té,","t"],"n30":["Se","i"],"n31":["ñor.","t"],"n33":"Ya","n34":"que‿he","n35":["vis","i"],"n36":["to","t"],"n37":["la‿her","i"],"n38":["mo","m"],"n39":["su","m"],"n40":["ra","t"],"n41":["De‿es","i"],"n42":["te","t"],"n43":["mun","i"],"n44":["do","t"],"n45":["ten","i"],"n46":["ta","m"],"n47":["dor,","t"],"n49":"Yo","n50":["pre","i"],"n51":["fie","m"],"n52":["ro","t"],"n53":"Tu","n54":["pre","i"],"n55":["sen","m"],"n56":["cia,","t"],"n57":["Aun","i"],"n58":["que","t"],"n59":["cie","i"],"n60":["go‿es","m"],"n61":["té,","t"],"n62":["Se","i"],"n63":["ñor.","t"]},"verses":[{"label":"2.","lines":["Aunque en el paraíso","Pueda ver la luz del sol,","Mas aquí a mi ceguera","Su piedad es mi farol."]},{"label":"3.","lines":["Ya no quiero liberarme","De mi diario aguijón;","Tras el velo hallo gracia","En el rostro del Señor."]},{"label":"4.","lines":["En mi noche Su hermosura","Sólo puedo ver por fe,","Al mirar la faz gloriosa","Que por mí sufrió desdén."]},{"label":"5.","lines":["Con Su corona de espinas","Que llevó en mi lugar,","El opaca toda gloria","O galaxia celestial."]}]}