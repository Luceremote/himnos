{"hymn":"S521","parent":"E635","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Hoy la vid consideremos","subtitle":"El camino de la cruz—El camino de ser fructiferos","syl":{"n1":"Hoy","n2":"la","n3":"vid","n4":["con","i"],"n5":["si","m"],"n6":["de","m"],"n7":["re","m"],"n8":["mos,","t"],"n9":"De","n10":"su","n11":["vi","i"],"n12":["da‿hay","t"],"n13":["que‿a","i"],"n14":["pren","m"],"n15":["der:","t"],"n16":["Só","i"],"n17":["lo‿en","t"],"n18":["me","i"],"n19":["dio","t"],"n20":["de‿a","i"],"n21":["flic","m"],"n22":["cio","m"],"n23":["nes","t"],"n24":["pue","i"],"n25":["de","t"],"n26":["e","i"],"n27":["lla‿a","m"],"n28":["sí","t"],"n29":["cre","i"],"n30":["cer.","t"],"n31":"Muy","n32":["dis","i"],"n33":["tin","m"],"n34":["ta","t"],"n35":["de‿e","i"],"n36":["sas","t"],"n37":["flo","i"],"n38":["res","t"],"n39":"Que,‿en","n40":["sil","i"],"n41":["ves","m"],"n42":["tre","t"],"n43":["con","i"],"n44":["fu","m"],"n46":["sión,","t"],"n47":["Cre","i"],"n48":["cen","t"],"n49":["li","i"],"n50":["bres","t"],"n51":"en","n52":"los","n53":["cam","i"],"n54":["pos","t"],"n55":"Sin","n56":["nin","i"],"n57":["gu","m"],"n58":["na","t"],"n59":["res","i"],"n60":["tric","m"],"n61":["ción.","t"]},"verses":[{"label":"2.","lines":["Mas las flores en la viña","Son sin gloria ni atracción;","Tan pequeñas de tamaño,","Sin ninguna expresión.","Una vez que‿han florecido,","Nunca más se exhibirán,","Pues jamás serán carolas;","Sólo el fruto se verá."]},{"label":"3.","lines":["A un poste está atada,","Pierde así su libertad;","Luego de crecer, sus ramas","Amarradas estarán.","Desde el suelo endurecido","Saca ella nutrición;","Nunca elije su camino","Ni se aparta de aflicción."]},{"label":"4.","lines":["El verdor de su hermosura","Coloreando el campo va;","Llena de energía viva,","Plenitud podrá lograr;","Hasta que con tiernas ramas","Que se enredan llena esté,","Alcanzando el azul cielo","Para el aire absorber."]},{"label":"5.","lines":["Mas el amo de la viña","Indulgente nunca es;","Va podando, muy preciso,","Despojando la altivez.","Aunque esté la vid muy tierna,","Con preciso atinar,","Todo pámpano excedente","De la vid él cortará."]},{"label":"6.","lines":["Al sufrir la vid el daño,","¿Tendrá autocompasión?","No, más bien se entrega plena","A aquel que la podó,","A la mano que desgarra","Y le roba su belleza,","Para que su vida entera","Pueda siempre fruto dar."]},{"label":"7.","lines":["Donde se cortó la rama,","La madera seca está;","Mas los pámpanos restantes","Ahora fruto pueden dar.","Luego, bajo el sol candente,","Hojas secas caerán;","Mas el fruto así madura","Y la mies se segará."]},{"label":"8.","lines":["Encorvada por la carga","De su fruto a granel:","El producto de las penas","Que la hizo así crecer.","Con su fruto ya maduro,","Consolada debe estar;","Mas apremia la cosecha","Y más penas sufrirá."]},{"label":"9.","lines":["Con las manos se recogen","Las riquezas de la vid;","Con los pies se va hollando,","Hasta el vino conseguir.","Todo el día fluye un río","Del buen vino del lagar,","Rico, dulce y dando gozo","Hasta la tierra llenar."]},{"label":"10.","lines":["Hasta aquí, en su apariencia,","Luce seca esta vid;","Todo dio y ahora en entra","En la noche cruel sin fin,","Nadie ofrece con pagarle","Por su vino alegrador;","Mas la cortan hasta el tronco,","Desgajada y sin valor."]},{"label":"11.","lines":["Con su vino, en el invierno","Trae dulzura y calor","A los que de frío tiemblan","Con tristeza y dolor.","Sin embargo, a la interperie,","La vid en la nieve está,","Soportando allí su suerte,","¡Qué difícil de explicar!"]},{"label":"12.","lines":["Pasa el frío y se prepara","La vid para fruto dar;","Floreciendo, echando ramas,","Con verdor tan singular,","No se queja ni murmura","De ese frío invernal","Ni por pérdidas sufridas;","Sólo fruto quiere dar."]},{"label":"13.","lines":["Respirando el aire limpio,","Busca hallar lo celestial;","No se ocupa de lo impuro,","Ni de afecto terrenal.","Al sufrir, aún sonríe","Mientras la poda el amor;","Nuevos golpes ya recibe","Sin fijarse en el dolor."]},{"label":"14.","lines":["Fluye savia, vino y sangre","De las ramas de la vid;","¿Es acaso ella más pobre","Por ceder y por sufrir?","Los borrachos de la tierra,","De‿ella gozan al tomar;","Mas, por todo su deleite,","¿Son más ricos al final?"]},{"label":"15.","lines":["No se mide lo ganado,","Sino lo que se perdió;","No el vino ya bebido,","Sino aquel que se vertió.","El amor nos fortalece","Para todo soportar;","Y quien más ha padecido,","Mucho más puede brindar."]},{"label":"16.","lines":["Quien consigo es severo,","Es quien Dios puede ganar;","El que no se considera,","Puede a otros consolar.","El que nunca aguanta penas","Sólo es \"bronce que resuena\";","El que su alma no escatima,","Tiene gozo sin igual."]}]}