{"hymn":"S641","parent":"E824","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La iglesia, los llamados","subtitle":"La iglesia—Su definición general","syl":{"n1":["La‿i","i"],"n2":["gle","m"],"n3":["sia,","t"],"n4":"los","n5":["lla","i"],"n6":["ma","m"],"n7":["dos,","t"],"n8":["Cuer","i"],"n9":["po","t"],"n10":"de","n11":["Cris","i"],"n12":["to","t"],"n13":"es,","n14":"El","n15":["hom","i"],"n16":["bre‿y","t"],"n17":"Dios","n18":["mez","i"],"n19":["cla","m"],"n20":["dos,","t"],"n21":"Su","n22":["mo","i"],"n23":["ra","m"],"n24":["da","t"],"n25":["tam","i"],"n26":["bién;","t"],"n27":["E","i"],"n28":["lec","m"],"n29":["ta‿en","t"],"n30":"el","n31":["pa","i"],"n32":["sa","m"],"n33":["do,","t"],"n34":"La","n35":["re","i"],"n36":["di","m"],"n37":["mió‿al","t"],"n38":["mo","i"],"n39":["rir,","t"],"n40":"Su","n41":["pos","i"],"n42":["tu","m"],"n43":["ra‿y","t"],"n44":["ca","i"],"n45":["rác","m"],"n46":["ter","t"],"n47":"Es","n48":["ce","i"],"n49":["les","m"],"n50":["tial","t"],"n51":"sin","n52":"fin."},"verses":[{"label":"2.","lines":["La iglesia, el nuevo hombre,","Nació en resurrección;","Se bautizó‿en el Santo","Espíritu de Dios;","Santa por la Palabra,","Su vida Cristo es;","Con la Cabeza en gloria,","Todo puesto a sus pies."]},{"label":"3.","lines":["Su único cimiento","Es Cristo el Señor;","Como Él, ella es divina","En todo su interior;","Sus miembros en la muerte","Y en resurrección,","Como oro, plata y piedras,","Edificados son."]},{"label":"4.","lines":["Un Dios, un Señor nuestro,","Un Espíritu fiel,","Una fe, un bautismo,","Una esperanza en Él;","Un Cuerpo son sus miembros,","El Dios Triuno en él,","Esperando Su gloria,","Se unen por la fe."]},{"label":"5.","lines":["De toda tribu y lengua","Todos Sus miembros son;","Sin importar las clases,","Son uno‿en el Señor.","No hay libre ni esclavo,","Ni raza alguna en Él,","Mas Cristo el todo en todos","El \"nuevo hombre\" es."]},{"label":"6.","lines":["Expresa cada Iglesia","El Cuerpo universal;","Su único terreno","Es la localidad;","Local es su gobierno","Sujeta al Señor;","Y universalmente","Son una en comunión."]},{"label":"7.","lines":["En todas sus reuniones","Se ve con claridad","Aspectos y detalles","De la Santa Ciudad.","La lámpara es Cristo,","La luz interna es Dios;","Ellas son candeleros,","Su imagen, Su expresión."]}]}