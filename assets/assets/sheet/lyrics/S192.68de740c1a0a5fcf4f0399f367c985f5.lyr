{"hymn":"S192","parent":"E243","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Hoy el Espíritu de Dios","subtitle":"La plenitud del Espíritu—Como Espíritu de realidad","syl":{"n1":"Hoy","n2":"el","n4":["Es","i"],"n5":["pí","m"],"n6":["ri","m"],"n7":["tu","t"],"n9":"de","n10":"Dios","n11":"La","n12":["re","i"],"n14":["a","m"],"n15":["li","m"],"n17":["dad","t"],"n18":"de","n20":["Cris","i"],"n21":["to‿es;","t"],"n22":"Es","n24":["Cris","i"],"n25":["to","t"],"n26":"en","n27":["mi‿es","i"],"n29":["pí","m"],"n30":["ri","m"],"n31":["tu","t"],"n32":["Vi","i"],"n33":["vien","m"],"n35":["do","t"],"n36":["den","i"],"n37":["tro","t"],"n38":"de","n39":"mi","n40":"ser."},"verses":[{"label":"2.","lines":["Tal como Cristo expresa Dios","Y es Su corporificación,","Así el Espíritu también","Es para Cristo Su expresión."]},{"label":"3.","lines":["La plenitud del Padre Dios","Corporalmente en Cristo está;","Y Cristo tomó Espíritu","Es hoy nuestra realidad."]},{"label":"4.","lines":["El Padre en el Hijo está","Y el Hijo el Espíritu es;","El Padre unido al Hijo está","Con el Espíritu a mi ser."]},{"label":"5.","lines":["Con fuerza del Espíritu","Hoy Cristo en mí hará Su hogar;","Y el Padre con Su plenitud","Mi ser entero ha de llenar."]},{"label":"6.","lines":["El Padre en Cristo nuestro es,","El llena nuestra escasez;","Probamos en Espíritu","Que Cristo‿el todo‿en todo es."]},{"label":"7.","lines":["Señor, por Tu Espíritu","Impártenos Tu realidad,","Hasta llenarnos de Tu ser","Y Tus riquezas disfrutar."]}]}