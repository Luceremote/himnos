{"hymn":"S286","parent":"E357","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Con fuego santo ven, Señor","subtitle":"Anhelos—De Cristo","syl":{"n1":"Con","n2":["fue","i"],"n4":["go","t"],"n5":["san","i"],"n6":["to","t"],"n7":"ven,","n9":["Se","i"],"n10":["ñor,","t"],"n11":"Ven","n12":["a‿ins","i"],"n14":["pi","m"],"n15":["rar","t"],"n17":"mi","n18":["co","i"],"n20":["ra","m"],"n21":["zón;","t"],"n22":"Tu","n23":["san","i"],"n25":["gre","t"],"n26":"me","n27":["pur","i"],"n28":["gó;","t"],"n29":"Tu","n30":["mis","i"],"n31":["mo","t"],"n32":"ser","n34":["re","i"],"n35":["ve","m"],"n37":["la‿a","t"],"n38":"mí,","n39":"Tu","n40":["fuer","i"],"n41":["te","t"],"n42":["o","i"],"n43":["bra‿haz","m"],"n44":["me","t"],"n46":["sen","i"],"n47":["tir,","t"],"n48":"Ya","n49":"que","n51":["na","i"],"n52":["cí","t"],"n53":"de","n54":"Dios."},"verses":[{"label":"2.","lines":["Nada divida‿el corazón,","Ya que‿en la cruz contigo‿estoy;","Que viva para Dios.","Que muera‿al mundo‿y su‿esplendor,","Con su placer y diversión;","Mi gloria es el Señor."]},{"label":"3.","lines":["Eterno‿anhelo‿inspira‿en mí","Con insaciable sed de Ti,","Y lléname, Jesús.","No me des menos que Tu ser,","En mí que vivas con poder;","Ven con Tu plenitud."]},{"label":"4.","lines":["Se pierda‿en Ti mi voluntad,","Luz en Tu luz así verá","Mi alma‿al ver Tu faz;","Tú me llamaste a probar","Un corazón de‿amor sin par","Y vida‿en santidad."]}]}