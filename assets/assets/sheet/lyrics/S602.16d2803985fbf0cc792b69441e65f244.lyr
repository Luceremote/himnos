{"hymn":"S602","parent":"E780","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En espíritu oremos","subtitle":"Oración—En el Espíritu","syl":{"n1":"En","n2":["es","i"],"n3":["pí","m"],"n5":["ri","m"],"n6":["tu","t"],"n7":["o","i"],"n8":["re","m"],"n10":["mos,","t"],"n11":"No‿en","n12":"la","n13":["men","i"],"n14":["te","t"],"n15":["na","i"],"n17":["tu","m"],"n18":["ral;","t"],"n19":"Si","n20":["guar","i"],"n21":["da","m"],"n23":["mos","t"],"n24":"tal","n25":["prin","i"],"n26":["ci","m"],"n28":["pio","t"],"n29":"Su","n30":["pre","i"],"n31":["sen","m"],"n33":["cia","t"],"n34":"Dios","n35":"nos","n36":"da.","n37":"En","n38":["es","i"],"n39":["pí","m"],"n40":["ri","m"],"n41":["tu","t"],"n42":["o","i"],"n43":["re","m"],"n45":["mos,","t"],"n46":"El","n47":["se","i"],"n49":["cre","m"],"n50":["to","t"],"n51":"se","n53":"nos","n54":"dio;","n55":"Si‿en","n56":["es","i"],"n57":["pí","m"],"n59":["ri","m"],"n60":["tu","t"],"n61":["o","i"],"n62":["ra","m"],"n64":["mos","t"],"n65":["To","i"],"n66":["ca","m"],"n67":["re","m"],"n69":["mos","t"],"n70":"al","n71":["Se","i"],"n72":["ñor.","t"]},"verses":[{"label":"2.","lines":["En espíritu oremos,","No en el hombre natural;","Sólo así con Dios tendremos","Comunión espiritual."]},{"label":"3.","lines":["En espíritu oremos","Por lo que le agrada a Dios;","Nuestro espíritu encendido","Estará por el Señor."]},{"label":"4.","lines":["En espíritu oremos,","Y, gimiendo en lo interior,","Por Su Espíritu expresemos","La intención de nuestro Dios."]},{"label":"5.","lines":["En espíritu oremos","¡Qué Santísimo Lugar!","Donde Dios con Sus creyentes","Se entrelaza en unidad."]},{"label":"6.","lines":["En espíritu oremos","Sólo allí se debe orar;","Y orando así, probamos","Del caudal de la Deidad."]}]}