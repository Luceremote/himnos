{"hymn":"SY229","parent":"NS10050","quality":"adapted","adjust":{"hold":0,"merge":4},"title":"Sión, allí Dios habita","subtitle":"","syl":{"n1":"Sión,","n2":["a","i"],"n5":["llí","t"],"n6":["Di","i"],"n7":["os","t"],"n8":["ha","i"],"n9":["bi","m"],"n10":["ta;","t"],"n13":["Can‿te","i"],"n14":["mos","t"],"n15":["a","i"],"n16":["la","m"],"n17":["ban","m"],"n19":["zas,","t"],"n20":"En","n21":"la","n22":["ciu","i"],"n24":["dad","t"],"n25":"del","n27":"Rey.","n30":"Sión,","n31":["Di","i"],"n34":["os","t"],"n35":"ha","n36":["es","i"],"n37":["co","m"],"n38":["gi","m"],"n39":["do;","t"],"n42":["Los‿san","i"],"n43":["tos","t"],"n44":["go","i"],"n45":["zan","m"],"n46":["do‿es","m"],"n48":["tán","t"],"n49":"De","n50":"Dios","n51":"su","n52":["sal","i"],"n53":["va","m"],"n54":["ci","m"],"n56":["ón.","t"],"n58":["¡Be","i"],"n59":["llas","t"],"n60":["I","i"],"n61":["gle","m"],"n62":["sias,","t"],"n65":"los","n66":["can","i"],"n67":["de","m"],"n68":["re","m"],"n70":["los!","t"],"n72":["La‿mez","i"],"n73":["cla","t"],"n74":["com","i"],"n75":["ple","m"],"n77":["ta","t"],"n79":"De","n80":"Dios","n82":"y‿el","n83":["hom","i"],"n84":["bre,","t"],"n85":["¡La‿úl","i"],"n86":["ti","m"],"n87":["ma","t"],"n89":["con‿su","i"],"n90":["ma","m"],"n91":["ción!","t"]},"verses":[{"label":"2.","lines":["Sión, ¡cuán bueno y cuán dulce!","¡Qué disfrute inmenso es!","¡Como ungüento valioso!","Sión, ¡cuán bueno y cuán dulce!","¡Moramos en unidad!","¡El ungüento tan fresco!"]},{"label":"3.","lines":["Sión, Él nuestra unidad es;","Se mueve como un bálsamo,","Desciende como rocío.","Sión, nuestra morada es Dios;","Como bálsamo sanador,","Como el rocío, Él nos suple."]},{"label":"4.","lines":["Sión, en Dios habitamos;","Vivimos en tal unidad,","Siendo Dios nuestro todo.","Sión, ¡bendición eterna!","Dios y hombre mezclados,","Dios triuno Dispensado."]}]}