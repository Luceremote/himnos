{"hymn":"S162","parent":"E1103","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Lo que es: es el Padre","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"Lo","n2":"que","n3":"es:","n4":"es","n5":"el","n6":["Pa","i"],"n7":["dre.","t"],"n9":"El","n10":"es","n11":"el","n12":["e","i"],"n13":["ter","m"],"n14":["no","t"],"n15":["Pa","i"],"n16":["dre.","t"],"n18":["Pri","i"],"n19":["mo","m"],"n20":["gé","m"],"n21":["ni","m"],"n22":["to","t"],"n23":"de","n24":["la‿crea","i"],"n26":["ción","t"],"n27":"Es","n28":["A","i"],"n29":["quel","t"],"n30":"que","n31":["vi","i"],"n32":["ve‿en","t"],"n33":["mi‿in","i"],"n34":["te","m"],"n35":["rior.","t"],"n36":"¡Es","n37":"el","n38":["Pa","i"],"n39":["dre!","t"],"n41":["¡Glo","i"],"n42":["ria‿a","t"],"n44":"Dios!"},"verses":[{"label":"2.","lines":["Lo que es: es el río.","Es el río caudaloso.","Él me riega cuando seco‿estoy,","Mi escondedero,‿a Él yo voy.","¡Es el río! ¡Gloria a Dios!"]},{"label":"3.","lines":["Lo que es: vid fructuosa.","De‿Isaí raíz y rama.","Árbol de vida para comer","Y así Su vida poseer.","¡Vid fructuosa! ¡Gloria a Dios!"]},{"label":"4.","lines":["Lo que es: es Cordero.","Es Pastor de Su rebaño.","A los pastos verdes guía El.","Al untar la sangre‿hay que comer","Del Cordero. ¡Gloria a Dios!"]},{"label":"5.","lines":["Lo que es: es el \"pneuma\",","El Espíritu‿inclusivo.","Es el todo‿en todo‿a nuestro ser.","Vida nos da clamando a El.","¡Es el \"pneuma\"! ¡Gloria a Dios!"]},{"label":"6.","lines":["Lo que es: es Persona.","¡Tan viviente y real Persona!","En nosotros hoy viviendo está,","Esa Persona es sin igual.","¡Qué Persona! ¡Gloria a Dios!"]},{"label":"7.","lines":["Lo que es: es el Cuerpo.","Es la plenitud del Padre.","Es el centro de Su eterno plan,","Cristo y la iglesia en unidad","¡Nuevo hombre! ¡Gloria a Dios!"]}]}