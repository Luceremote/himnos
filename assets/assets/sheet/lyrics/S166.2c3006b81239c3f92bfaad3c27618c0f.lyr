{"hymn":"S166","parent":"E207","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Pensando en Tí, Señor Jesús","subtitle":"Alabanza al Señor—Satisfacción con Él","syl":{"n1":["Pen","i"],"n2":["san","m"],"n3":["do‿en","t"],"n5":"Tí,","n7":["Se","i"],"n9":["ñor","t"],"n11":["Je","i"],"n12":["sús,","t"],"n13":"Tu","n14":["gra","i"],"n15":["cia","t"],"n16":"y","n19":["Tu‿a","i"],"n20":["mor,","t"],"n21":["An","i"],"n22":["he","m"],"n23":["la","t"],"n24":["nues","i"],"n25":["tro‿es","m"],"n26":["pí","m"],"n28":["ri","m"],"n29":["tu","t"],"n30":["Tu‿her","i"],"n32":["mo","m"],"n33":["sa","t"],"n34":"faz,","n36":["Se","i"],"n37":["ñor.","t"]},"verses":[{"label":"2.","lines":["Aunque‿en desierto‿andamos hoy,","Por tierra de‿aridéz,","Por tierra que espinos da,","Rivales por doquier."]},{"label":"3.","lines":["Mas al mirar Tu gran amor,","Rebosa‿el corazón;","Contentos ante Ti, Señor,","Alzamos hoy canción."]},{"label":"4.","lines":["Descanso‿y Vida‿eres, Señor,","Roca, Comida‿y luz;","Es un deleite‿en Ti pensar;","Refrescas siempre Tú."]},{"label":"5.","lines":["Oh, guarda nuestro espíritu","En pos de Ti, Señor,","Hasta, en triunfo, poder ver","Tu gloria y‿esplendor."]}]}