{"hymn":"S470","parent":"E1161","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo hará a quien lo ama","subtitle":"Experiencia de Cristo—Satisfacerlo a Él","syl":{"n1":["Cris","i"],"n2":["to‿ha","m"],"n3":["rá","t"],"n4":"a","n5":"quien","n6":"lo","n7":["a","i"],"n8":["ma","t"],"n9":"Su","n10":["co","i"],"n11":["lum","m"],"n12":["na‿y","t"],"n13":["pa","i"],"n14":["lan","m"],"n15":["quín,","t"],"n16":"Su","n17":["co","i"],"n18":["ro","m"],"n19":["na","t"],"n20":"y","n21":"Su","n22":["glo","i"],"n23":["ria;","t"],"n24":["¡To","i"],"n25":["do","t"],"n26":"Él","n27":["lo‿ha","i"],"n28":["rá!","t"],"n29":["¡A","i"],"n30":["mén!","t"],"n31":["Cuán","i"],"n32":["to‿Él","t"],"n33":["a","i"],"n34":["ma","t"],"n35":"a","n36":["Su‿a","i"],"n37":["ma","m"],"n38":["da:","t"],"n39":"Su","n40":["de","i"],"n41":["lei","m"],"n42":["te","t"],"n43":["e","i"],"n44":["lla","t"],"n45":"es.","n46":["E","i"],"n47":["lla","t"],"n48":"lo","n49":"ha","n50":["cau","i"],"n51":["ti","m"],"n52":["va","m"],"n53":["do;","t"],"n54":"Es","n55":"tan","n56":["be","i"],"n57":["lla","t"],"n58":["pa","i"],"n59":["ra","t"],"n60":"Él."},"verses":[{"label":"2.","lines":["Mas aún queda‿una sombra;","Satisfecho no‿está Él.","Quiere‿un huerto floreciente","Que Su novia llegue‿a ser."]},{"label":"3.","lines":["Paraíso de granadas,","Mirra, frutos a granel,","Azafrán, nardo y‿áloe","Para que disfrute Él."]},{"label":"4.","lines":["A Su huerto ha venido","Para mirra recoger;","Del panal, comer las mieles;","Vino‿y leche‿ha de beber."]},{"label":"5.","lines":["La ciudad del huerto sale,","El cual suple‿el material;","A Dios ella satisface,","Y aterra al rival."]},{"label":"6.","lines":["\"Tan hermosa,‿amiga mía,","Como Tirsa eres tú;","Cual Jerusalén, deseada\".","¡Tú lo‿harás, Señor Jesús!"]}]}