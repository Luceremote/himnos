{"hymn":"S281","parent":"E349","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cual ciervo que anhela beber","subtitle":"Anhelos—De Dios","syl":{"n1":"Cual","n2":["cier","i"],"n3":["vo","t"],"n4":["que‿an","i"],"n5":["he","m"],"n7":["la","t"],"n8":["be","i"],"n9":["ber","t"],"n10":"Del","n11":["a","i"],"n12":["gua‿en","t"],"n14":"el","n15":["ca","i"],"n16":["lor,","t"],"n17":["A","i"],"n18":["sí","t"],"n19":["tam","i"],"n20":["bién","t"],"n21":["an","i"],"n22":["he","m"],"n23":["lo","t"],"n24":"yo","n25":"Tu","n26":["fres","i"],"n28":["ca","t"],"n30":["gra","i"],"n31":["cia,‿oh","t"],"n32":"Dios."},"verses":[{"label":"2.","lines":["¿Por qué te‿abates, mi‿alma, así?","Por qué turbada‿estás?","Confía‿en Dios; Él cambiará","Tu llanto‿en gozo‿y paz."]},{"label":"3.","lines":["Por Ti, mi Dios, viviente Dios,","Sedienta mi‿alma‿está;","Oh, ¿cuándo yo veré Tu faz,","Divina Majestad?"]},{"label":"4.","lines":["¿Por cuánto tiempo, Fuerte Dios,","Me quedo‿en luto atroz,","Escarnecido y‿en prisión,","Expuesto‿a mi‿opresor?"]},{"label":"5.","lines":["Por qué te‿abates, mi‿alma,‿así?","Ten fe y cantarás","Las alabanzas a tu Dios,","Tu fuente eternal."]}]}