{"hymn":"S860","parent":"E1024","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Necesitas a Cristo el Salvador","subtitle":"El evangelio—Necesidad de Cristo","syl":{"n1":["Ne","i"],"n2":["ce","m"],"n3":["si","m"],"n4":["tas","t"],"n5":"a","n6":["Cris","i"],"n7":["to‿el","t"],"n8":["Sal","i"],"n9":["va","m"],"n10":["dor:","t"],"n11":"El","n12":["mis","i"],"n13":["mo","t"],"n14":"Dios","n15":"que‿un","n16":["dí","i"],"n17":["a","t"],"n18":["se‿en","i"],"n19":["car","m"],"n20":["nó;","t"],"n22":"En","n23":"Su","n24":["cuer","i"],"n25":["po","t"],"n26":["su","i"],"n27":["frió","t"],"n28":["to","i"],"n29":["do","t"],"n30":["do","i"],"n31":["lor,","t"],"n32":"Y","n33":"por","n34":"tus","n35":["man","i"],"n36":["chas","t"],"n37":"Él","n38":["mu","i"],"n39":["rió,","t"],"n40":"¡Lo","n41":["ne","i"],"n42":["ce","m"],"n43":["si","m"],"n44":["tas!","t"],"n45":["¡Ne","i"],"n46":["ce","m"],"n47":["si","m"],"n48":["tas,","t"],"n49":["ne","i"],"n50":["ce","m"],"n51":["si","m"],"n52":["tas,","t"],"n53":["Ne","i"],"n54":["ce","m"],"n55":["si","m"],"n56":["tas","t"],"n57":"a","n58":["Je","i"],"n59":["sús!","t"],"n62":"¡Sí,","n63":["pa","i"],"n64":["ra","t"],"n65":"tu","n66":["re","i"],"n67":["den","m"],"n68":["ción!","t"],"n69":"¡Sí,","n70":["pa","i"],"n71":["ra","t"],"n72":"tu","n73":["sal","i"],"n74":["va","m"],"n75":["ción!","t"],"n76":"¡Y","n77":["pa","i"],"n78":["ra","t"],"n79":["vi","i"],"n80":["da‿e","m"],"n81":["ter","m"],"n82":["nal!","t"],"n83":"Lo","n84":["ne","i"],"n85":["ce","m"],"n86":["si","m"],"n87":["tas!","t"]},"verses":[{"label":"2.","lines":["De los muertos Jesús resucitó,","Para la vida eterna impartir;","Si lo invocas y crees de corazón,","Lo que te falta ha de suplir,","¡Lo necesitas!"]},{"label":"3.","lines":["Tu alma oscura Él iluminará,","De tus pecados Él te librará;","Con Su sangre tus manchas lavará,","La vida de Dios te dará,","¡Lo necesitas!"]},{"label":"4.","lines":["En tu vida sientes una escasez,","Y por los años crece más y más;","Sólo Cristo la puede en ti saciar;","Tu vanidad desafiará,","¡Lo necesitas!"]},{"label":"5.","lines":["Este mundo de luchas y afán","En los apuros no te da sostén;","Todo es vano, en qué puedes confiar?","Aquí te muestra todo que,","¡Lo necesitas!"]}]}