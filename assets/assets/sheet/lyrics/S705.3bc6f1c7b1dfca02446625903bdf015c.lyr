{"hymn":"S705","parent":"E1275","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh, iglesia en Filadelfia","subtitle":"La iglesia—Filadelfia","syl":{"n1":"Oh,","n2":["i","i"],"n3":["gle","m"],"n4":["sia‿en","t"],"n5":["Fi","i"],"n6":["la","m"],"n7":["del","m"],"n9":["fia,","t"],"n10":["Mu","i"],"n11":["cho","t"],"n12":["se‿ha","i"],"n13":["bla","t"],"n14":"de","n15":["tu‿a","i"],"n17":["mor,","t"],"n18":["Es","i"],"n19":["tas","t"],"n20":["co","i"],"n21":["sas","t"],"n22":["di","i"],"n23":["ce‿el","t"],"n24":["San","i"],"n26":["to,","t"],"n27":"El","n28":"que","n29":["ha","i"],"n30":["bla‿a","t"],"n31":"tu","n32":["fa","i"],"n34":["vor,","t"],"n35":"El","n36":["que‿a","i"],"n37":["brió","t"],"n39":["la‿en","i"],"n40":["tra","m"],"n41":["da‿al","t"],"n42":["rei","i"],"n44":["no","t"],"n45":"Con","n46":"la","n47":["lla","i"],"n48":["ve","t"],"n49":"de","n50":["Da","i"],"n51":["vid:","t"],"n52":["\"He","i"],"n53":["cho","t"],"n54":["es","i"],"n55":["tá\",‿ha","t"],"n56":["pro","i"],"n57":["cla","m"],"n58":["ma","m"],"n60":["do,","t"],"n61":["\"Na","i"],"n62":["die","t"],"n64":["cie","i"],"n66":["rre","t"],"n68":"lo","n69":["que‿a","i"],"n71":["brí\".","t"]},"verses":[{"label":"2.","lines":["Tienes obras Filadelfia,","Que complacen al Señor.","Su Palabra has guardado,","Aunque es poco tu vigor.","Tú Su nombre no has negado,","Mas lo confesaste aquí;","Una puerta Él ha puesto","Sólo abierta para ti."]},{"label":"3.","lines":["Has guardado la Palabra","De perseverancia fiel.","De la hora de la prueba","Guardada serás por Él.","Sabrán que Él te ha amado,","A tus pies se postrarán.","\"Vengo pronto, lo que tienes","Tú retén hasta‿el final\""]},{"label":"4.","lines":["Aleluya, vencedores,","\"En el templo de mi Dios\",","Han de ser edificados,","Las columnas ellos son.","En sus frentes hay los nombres","De su Padre y del Señor,","Con el Triuno Dios mezclados,","Forman la ciudad de Dios."]},{"label":"5.","lines":["Aleluya, de Dios viene","La Nueva Jerusalén;","Ataviada está con perlas,","Jaspe y gemas a la vez.","Filadelfia, Filadelfia,","Su preciosa novia es;","El Espíritu y la novia,","Al que oye dicen: \"Ven\"."]}]}