{"hymn":"S797","parent":"E963","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cara a cara con mi Cristo","subtitle":"Esperanza de gloria—Cara a cara con el Señor","syl":{"n1":["Ca","i"],"n2":["ra‿a","t"],"n3":["ca","i"],"n4":["ra","t"],"n5":"con","n6":"mi","n7":["Cris","i"],"n8":["to","t"],"n10":["Ca","i"],"n11":["ra‿a","t"],"n12":["ca","i"],"n13":["ra,","t"],"n14":"¡qué","n15":["fe","i"],"n16":["liz","t"],"n18":["Cuan","i"],"n19":["do,‿en","t"],"n20":["glo","i"],"n21":["ria,‿a","t"],"n22":["Cris","i"],"n23":["to","t"],"n24":["ve","i"],"n25":["a,","t"],"n26":["A","i"],"n27":["quel","t"],"n28":"que","n29":["mu","i"],"n30":["rió","t"],"n31":"por","n32":"mí!","n34":["Ca","i"],"n35":["ra‿a","t"],"n36":["ca","i"],"n37":["ra","t"],"n38":"con","n39":"mi","n40":["Cris","i"],"n41":["to","t"],"n42":"En","n43":"Su","n44":["glo","i"],"n45":["ria","t"],"n46":"yo","n47":["ve","i"],"n48":["ré;","t"],"n50":["Ca","i"],"n51":["ra‿a","t"],"n52":["ca","i"],"n53":["ra,","t"],"n54":"yo","n55":"Su","n56":["ros","i"],"n57":["tro","t"],"n58":"Por","n59":["siem","i"],"n60":["pre","t"],"n61":["con","i"],"n62":["tem","m"],"n63":["pla","m"],"n64":["ré.","t"]},"verses":[{"label":"2.","lines":["Hoy borrosamente veo","Tras el velo al Salvador;","Mas el día pronto viene:","¡He de ver Su resplandor!"]},{"label":"3.","lines":["¡Oh, qué gozo en Su presencia!","Pronto el llanto no ha de ser","Cuando lo torcido acabe,","Y lo oscuro, claro esté."]},{"label":"4.","lines":["Cara a cara, ¡qué sublime!","Contemplando al Redentor;","Cara a cara con mi Cristo,","Con Aquel que así me amó."]}]}