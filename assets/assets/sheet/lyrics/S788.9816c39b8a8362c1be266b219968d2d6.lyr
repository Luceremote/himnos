{"hymn":"S788","parent":"E951","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Cristo viene! ¡Cristo viene","subtitle":"Esperanza de gloria—La esperanza bienaventurada","syl":{"n1":["¡Cris","i"],"n2":["to","t"],"n3":["vie","i"],"n4":["ne!","t"],"n5":["¡Cris","i"],"n6":["to","t"],"n7":["vie","i"],"n8":["ne!","t"],"n9":"La","n10":["crea","i"],"n11":["ción","t"],"n12":"no","n13":["su","i"],"n14":["fra","t"],"n15":"más;","n16":"Tal","n17":["pro","i"],"n18":["cla","m"],"n19":["ma","m"],"n20":["ción","t"],"n21":["glo","i"],"n22":["rio","m"],"n23":["sa","t"],"n24":"Fe","n25":"y","n26":["es","i"],"n27":["pe","m"],"n28":["ran","m"],"n29":["za","t"],"n30":"da.","n31":["¡Cris","i"],"n32":["to","t"],"n33":["vie","i"],"n34":["ne!","t"],"n35":["¡Cris","i"],"n36":["to","t"],"n37":["vie","i"],"n38":["ne!","t"],"n39":"¡Ven,","n40":"oh","n41":["Prín","i"],"n42":["ci","m"],"n44":["pe","t"],"n45":"de","n46":"Paz!"},"verses":[{"label":"2.","lines":["Hoy la tierra sólo puede","Tu sufrida historia hablar;","Mas contemplará Tu gloria","Cuando vengas a reinar.","¡Cristo viene! ¡Cristo viene!","Se repita sin cesar."]},{"label":"3.","lines":["Cuánto ha suspirado el pueblo","Por Ti, por descanso y paz;","Pronto con radiante gloria,","Su Restaurador verán.","¡Cristo viene! ¡Cristo viene!","Jubiloso gozo habrá."]},{"label":"4.","lines":["Ante esta esperanza,","Toda arpa ha de sonar;","Y ante tal advenimiento,","Suene un coro universal.","¡Cristo viene! ¡Cristo viene!","¡Oh Jesús, ven pronto ya!"]}]}