{"hymn":"S417","parent":"E529","quality":"adapted","adjust":{"hold":1,"merge":1},"title":"¡Cuán lento las horas se van","subtitle":"Experiencia de Cristo—Como aquel que es el todo","syl":{"n1":"¡Cuán","n2":["len","i"],"n3":["to","t"],"n4":"las","n5":["ho","i"],"n6":["ras","t"],"n7":"se","n8":"van","n9":["Cuan","i"],"n10":["do‿a","t"],"n11":["Cris","i"],"n12":["to","t"],"n13":"no","n14":["pue","i"],"n15":["do","t"],"n16":"ver!","n17":"Sin","n18":"Él","n19":["to","i"],"n20":["do","t"],"n21":["pier","i"],"n22":["de‿el","t"],"n23":"sa‿bor;","n24":"Sin","n25":"Él","n26":["na","i"],"n27":["da","t"],"n28":"me","n29":"da","n30":["pla","i"],"n31":["cer;","t","u"],"n32":0,"n33":"El","n34":"sol","n35":["pier","i"],"n36":["de","t"],"n37":"su","n38":["cla","i"],"n39":["ra","t"],"n40":"luz,","n41":"Los","n42":["cam","i"],"n43":["pos","t"],"n44":["es","i"],"n45":["tán","t"],"n46":"sin","n47":["ver","i"],"n48":["gel;","t"],"n49":"Mas","n50":"si","n51":"yo","n52":["dis","i"],"n53":["fru","m"],"n54":["to","t"],"n55":"de","n56":"Él,","n57":["Di","i"],"n58":["ciem","m"],"n59":["bre,","t"],"n60":["co","i"],"n61":["mo","t"],"n62":["ma","i"],"n63":["yo","t"],"n64":"es."},"verses":[{"label":"2.","lines":["Su nombre da fragante‿olor;","Es música Su dulce voz.","Es por Su presencia gentil","Que la‿oscuridad me quitó.","Si Él está cerca de mí,","Carencia‿o temor no tendré;","Ninguno cual yo tan feliz,","Todo el año verano es."]},{"label":"3.","lines":["Contento, contemplo Su faz;","Yo busco‿agradarlo a Él;","No hay panorama‿o lugar","Que a mí me pueda mover.","Al ser bendecido‿en Su‿amor,","Nada un palacio valdrá;","Pasiones, palacios serán,","Si Cristo conmigo está."]},{"label":"4.","lines":["Señor, si soy Tuyo‿en verdad,","Si eres mi sol y canción,","¿Por qué mi invierno está","Tan largo, y lánguido‿estoy?","Restaura Tu gozo en mí;","Dispersa las nubes, Señor,","O llévame junto a Ti,","Adonde‿el invierno cesó."]}]}