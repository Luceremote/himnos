{"hymn":"S253","parent":"E309","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Qué admirable es el cambio forjado en mi ser","subtitle":"La certeza y el gozo de la salvación—Cambiados en vida","syl":{"n1":["¡Qué‿ad","i"],"n2":["mi","m"],"n3":["ra","m"],"n4":["ble‿es","t"],"n5":"el","n6":["cam","i"],"n7":["bio","t"],"n8":["for","i"],"n9":["ja","m"],"n10":["do‿en","t"],"n11":"mi","n12":"ser,","n13":["Des","i"],"n14":["de","t"],"n15":"que","n16":["Je","i"],"n17":["sús","t"],"n18":["vi","i"],"n19":["no‿a","t"],"n20":"mí!","n21":"¡En","n22":"mi","n23":["al","i"],"n24":["ma‿hay","t"],"n25":"la","n26":"luz","n27":"que","n28":"por","n29":["siem","i"],"n30":["pre‿an","m"],"n31":["he","m"],"n32":["lé,","t"],"n33":["Des","i"],"n34":["de","t"],"n35":"que","n36":["Je","i"],"n37":["sús","t"],"n38":["vi","i"],"n39":["no‿a","t"],"n40":"mí!","n42":["¡Des","i"],"n43":["de","t"],"n44":"que","n45":["Je","i"],"n46":["sús","t"],"n47":["vi","i"],"n48":["no‿a","t"],"n49":"mí!","n50":["¡Des","i"],"n51":["de","t"],"n52":"que","n53":["Je","i"],"n54":["sús","t"],"n55":["vi","i"],"n56":["no‿a","t"],"n57":"mí!","n58":["¡Bu","i"],"n59":["lle","t"],"n60":"el","n61":["go","i"],"n62":["zó‿en","t"],"n63":["mi‿al","i"],"n64":["ma","t"],"n65":["co","i"],"n66":["mo‿o","m"],"n67":["las","t"],"n68":"del","n69":"mar,","n70":["Des","i"],"n71":["de","t"],"n72":"que","n73":["Je","i"],"n74":["sús","t"],"n75":["vi","i"],"n76":["no‿a","t"],"n77":"mí!"},"verses":[{"label":"2.","lines":["¡He cesado el vagar y del camino errar,","Desde que Jesús vino a mí!","¡Y mis muchos pecados lavados ya están,","Desde que Jesús vino a mí!"]},{"label":"3.","lines":["¡Una firme esperanza sostiene mi andar,","Desde que Jesús vino a mí!","¡No hay nubes de dudas en mi caminar,","Desde que Jesús vino a mí!"]},{"label":"4.","lines":["¡En el valle de muerte la luz brillará,","Desde que Jesús vino a mí!","¡Más allá puedo ver esa Santa Ciudad,","Desde que Jesús vino a mí!"]},{"label":"5.","lines":["¡Moraré en la Santa Ciudad, yo lo sé,","Desde que Jesús vino a mí!","¡Soy feliz, tan feliz mientras marchando esté,","Desde que Jesús vino a mí!"]}]}