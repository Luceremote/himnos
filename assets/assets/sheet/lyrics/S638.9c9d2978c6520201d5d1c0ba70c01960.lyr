{"hymn":"S638","parent":"E821","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La iglesia para Cristo es","subtitle":"La iglesia—El vaso de Cristo","syl":{"n1":"La","n2":["i","i"],"n3":["gle","m"],"n4":["sia","t"],"n5":["pa","i"],"n6":["ra","t"],"n7":["Cris","i"],"n8":["to‿es","t"],"n9":"Su","n10":["va","i"],"n12":["so‿y","t"],"n13":["ma","i"],"n15":["ni","m"],"n16":["fes","m"],"n18":["ta","m"],"n19":["ción;","t"],"n20":"A","n21":"Tal","n22":["co","i"],"n23":["mo‿el","t"],"n24":["cuer","i"],"n25":["po‿hu","m"],"n26":["ma","m"],"n27":["no‿en","t"],"n28":"sí","n29":"Su","n31":["vi","i"],"n32":["da‿in","m"],"n33":["ter","m"],"n34":["na‿ex","m"],"n35":["pre","m"],"n36":["sa‿hoy.","t"]},"verses":[{"label":"2.","lines":["Tal como el templó al Arca dio","Reposo y ubicación;","Así la iglesia a Cristo es","Descanso y habitación."]},{"label":"3.","lines":["Cristo, el misterio de Dios,","Lo explica y lo expresa a Él,","Así la iglesia a Cristo es","Misterio y manifestación."]},{"label":"4.","lines":["Los miembros de la iglesia son","De barro en primer lugar;","Mas Dios, por la transformación,","Bien transparentes los hará."]},{"label":"5.","lines":["Así Su vaso Cristo‿hará,","Con ellos lo‿edificará;","Y Su todo-inclusividad","En transparencia expresarán."]},{"label":"6.","lines":["Por toda la transformación","Del Triuno Dios en nuestro ser,","La‿iglesia‿un vaso‿al fin será","Tal como la Jerusalén."]},{"label":"7.","lines":["Preciosa en todo ella es","Transparente en cada fase;","Cristo, la plenitud de Dios,","Su gloria en ella exhibe bien."]},{"label":"8.","lines":["Cristo, su vida y Dios, su luz","Con el Espíritu fluirá,","Ella así al Triuno Dios","Al universo mostrará."]}]}