{"hymn":"S36","parent":"E45","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Abba, Padre! Te exaltamos","subtitle":"Adoración al Padre—Su redención","syl":{"n1":["¡Ab","i"],"n2":["ba,","t"],"n3":["Pa","i"],"n4":["dre!","t"],"n5":["Te‿e","i"],"n6":["xal","m"],"n7":["ta","m"],"n9":["mos;","t"],"n10":["Se","i"],"n11":["a‿a","t"],"n12":"Ti","n13":["la‿a","i"],"n14":["do","m"],"n15":["ra","m"],"n16":["ción.","t"],"n17":["Só","i"],"n18":["lo","t"],"n19":"los","n20":"que","n21":"son","n22":"Tus","n23":["hi","i"],"n25":["jos","t"],"n26":["Cla","i"],"n27":["man","t"],"n28":["\"Ab","i"],"n29":["ba\"","t"],"n30":"en","n31":["Tu‿ho","i"],"n32":["nor.","t"],"n33":["Nues","i"],"n34":["tra‿he","m"],"n35":["ren","m"],"n36":["cia","t"],"n37":"tan","n38":["pre","i"],"n40":["cio","m"],"n42":["sa","t"],"n43":"Por","n44":"la","n45":["san","i"],"n47":["gre‿es","t"],"n48":["nues","i"],"n49":["tro","t"],"n50":"don;","n51":"Tu","n52":["Es","i"],"n53":["pí","m"],"n55":["ri","m"],"n56":["tu‿en","t"],"n57":"el","n58":["nues","i"],"n60":["tro","t"],"n61":["Tes","i"],"n62":["ti","m"],"n63":["fi","m"],"n64":["ca:","t"],"n66":["\"Hi","i"],"n67":["jos","t"],"n68":"sois\"."},"verses":[{"label":"2.","lines":["Por Tu plan hoy existimos;","Fue conforme‿a Tu‿elección.","Tú nos escogiste en Cristo","Antes de la creación.","Padre, fue Tu amor precioso","Que a Tu seno nos llevó,","Cuando‿al Hijo amado diste","Estos hijos de Tu amor."]},{"label":"3.","lines":["Aunque en Adán caímos,","Alejándonos de Dios,","Tu consejo‿eterno trajo","Por la sangre redención.","Hoy más cerca‿a Ti estamos;","¡Oh qué grande compasión!","Cristo y Sus redimidos","Por Tu gracia uno son."]},{"label":"4.","lines":["Pese‿al cambio de los tiempos,","Llanto, pena y dolor,","Nunca cambiará Tu afecto;","Salva Tu divino‿amor.","Pronto, en torno‿al trono‿eterno,","Los que la sangre compró","Cantarán sus alabanzas","Por Tu‿excelsa salvación."]}]}