{"hymn":"S309","parent":"E395","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Oh, Jesucristo, crece en mí","subtitle":"Anhelos—De crecer en Cristo","syl":{"n1":"Oh,","n2":["Je","i"],"n3":["su","m"],"n4":["cris","m"],"n5":["to,","t"],"n6":["cre","i"],"n8":["ce‿en","t"],"n9":"mí,","n11":"Y","n12":["men","i"],"n14":["güe","t"],"n15":"lo","n16":["de","i"],"n17":["más;","t"],"n20":"Mi","n21":["co","i"],"n22":["ra","m"],"n23":["zón","t"],"n24":["se‿a","i"],"n25":["cer","m"],"n27":["que","m"],"n28":["-a‿Ti,","t"],"n30":"Se","n31":["li","i"],"n33":["bre","t"],"n34":"del","n35":["pe","i"],"n36":["car.","t"],"n39":"Que","n40":"Tu","n42":["po","i"],"n43":["der","t"],"n44":["sos","i"],"n45":["te","m"],"n47":["ne","m"],"n48":["dor","t"],"n49":["Me‿am","i"],"n50":["pa","m"],"n51":["re,","t"],"n52":"mi","n54":["Je","i"],"n55":["sús;","t"],"n58":["Cam","i"],"n59":["bia","t"],"n60":"mi","n61":["muer","i"],"n62":["te‿en","t"],"n63":["vi","i"],"n65":["da","t"],"n66":"hoy,","n68":"Mi","n69":["no","i"],"n71":["che","t"],"n72":"por","n73":"Tu","n74":"luz."},"verses":[{"label":"2.","lines":["Que bajó el rayo de Tu luz","Se‿eclipse‿el mal pensar;","Que Tú‿eres todo y nada soy,","Yo debo aceptar."]},{"label":"3.","lines":["Más de Tu gloria‿anhelo ver,","Oh Santo, Sabio‿y Fiel;","Tu imagen viva quiero ser","En pena o‿en placer."]},{"label":"4.","lines":["Me llene‿el gozo celestial","Con todo su poder;","Que el fulgor de Tu amor","Hoy brille en mi ser."]},{"label":"5.","lines":["Haz amenguar mi pobre ser,","Mi vida‿y meta sé;","Que por Tu gracia pueda yo","Tu nombre‿ennoblecer."]}]}