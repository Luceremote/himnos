{"hymn":"S778","parent":"E944","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La esencia de Su reino es","subtitle":"El reino—Su realidad","syl":{"n1":"La","n2":["e","i"],"n4":["sen","m"],"n5":["cia","t"],"n6":"de","n7":"Su","n8":["rei","i"],"n9":["no‿es","t"],"n10":["Su","i"],"n11":["mi","m"],"n13":["sa","t"],"n14":["vi","i"],"n15":["da","t"],"n16":["pa","i"],"n18":["ra","t"],"n20":"Dios,","n21":"Que","n22":["vi","i"],"n24":["ve","t"],"n25":"de","n26":"lo","n27":["di","i"],"n29":["vi","m"],"n30":["nal","t"],"n31":["To","i"],"n33":["man","m"],"n34":["do‿a","t"],"n35":["Cris","i"],"n36":["to","t"],"n38":"por","n39":["por","i"],"n40":["ción.","t"]},"verses":[{"label":"2.","lines":["Tal vida es el reino hoy:","Muy pobre en espíritu,","Con manso y puro corazón","Que sólo busca a Dios en luz."]},{"label":"3.","lines":["Los mensajeros de la paz","Por la justicia sufren hoy","El vituperio de Jesús,","Mas gozo es su galardón."]},{"label":"4.","lines":["Es sal que mata corrupción","Y en las tinieblas, plena luz;","Sincera y pura en acción,","Amando con abnegación."]},{"label":"5.","lines":["No busca gloria terrenal","Y por el reino orando va;","En Dios confía sin afán","Y al reino da la prioridad."]},{"label":"6.","lines":["Estricta para con el yo,","Mas muestra a otros compasión;","La voluntad del Padre hará","Con la Palabra y oración."]},{"label":"7.","lines":["No da lugar a Satanás,","Ni al pecado, el mundo o el yo,","Mas busca el reino celestial","Y la autoridad de Dios."]},{"label":"8.","lines":["Tal vida puede subyugar","Todas las cosas para Dios;","Apresurando el reino está","Hasta su manifestación."]}]}