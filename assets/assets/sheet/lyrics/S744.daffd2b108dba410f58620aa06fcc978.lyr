{"hymn":"S744","parent":"E899","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La obra es Tuya, oh Señor","subtitle":"El servicio—Al ser sepultados","syl":{"n1":"La","n2":["o","i"],"n3":["bra","t"],"n4":"es","n5":["Tu","i"],"n6":["ya,‿oh","t"],"n7":["Se","i"],"n8":["ñor,","t"],"n9":"Y","n10":["nues","i"],"n11":["tra","t"],"n13":["cau","i"],"n14":["sa‿es;","t"],"n15":"Y","n16":"por","n17":"ser","n18":["Tu","i"],"n19":["ya,","t"],"n20":["ven","i"],"n21":["ce","m"],"n22":["rá","t"],"n23":["Ri","i"],"n24":["va","m"],"n25":["les","t"],"n26":"por","n28":["do","i"],"n29":["quier.","t"],"n30":"Mas","n31":["se","i"],"n33":["pul","m"],"n34":["ta","m"],"n35":["do","t"],"n36":["de","i"],"n37":["be","t"],"n38":"ser","n39":"El","n40":["gra","i"],"n42":["no","t"],"n43":["an","i"],"n44":["tes","t"],"n45":"de","n46":["cre","i"],"n47":["cer;","t"],"n48":"Lo","n49":["vie","i"],"n50":["jo","t"],"n51":["a","i"],"n52":["sí","t"],"n54":["pe","i"],"n56":["re","m"],"n57":["ce","m"],"n58":["rá","t"],"n59":"Y","n60":["nue","i"],"n61":["va","t"],"n62":["vi","i"],"n64":["da","t"],"n66":["bro","i"],"n67":["ta","m"],"n68":["rá;","t"],"n69":["A","i"],"n70":["sí","t"],"n71":"nos","n72":["li","i"],"n74":["bras","t"],"n75":"del","n76":"yo","n77":"y‿el","n80":["pe","i"],"n81":["car.","t"]},"verses":[{"label":"2.","lines":["Sufriste, Cristo, hasta llegar","Al trono celestial,","Y a Tus fieles guiarás","Por un camino igual;","Condúcenos, pese al sufrir,","Para Tu reino compartir;","Tu muerte quebrantó a Satán","Y a la luz nos guía ya;","De las tinieblas a eterna luz."]},{"label":"3.","lines":["Abriste el camino Tú","Por muerte y aflicción;","¡Oh, danos más Tu Espíritu,","Tu aliento vivo hoy!","Tus mensajeros traerán","Tus escogidos a Tu faz;","Tu nombre trae salvación,","A Ti nos consagramos hoy,","Tus siervos y guerreros seremos."]}]}