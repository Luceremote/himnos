{"hymn":"S39","parent":"E50","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Padre, nos guía Tu Hijo a alabar","subtitle":"Adoración al Padre—Alabanza a Él de parte de sus muchos hijos","syl":{"n1":["Pa","i"],"n2":["dre,","t"],"n3":"nos","n4":["guí","i"],"n5":["a","t"],"n6":"Tu","n7":["Hi","i"],"n8":["jo‿a‿a","m"],"n9":["la","m"],"n10":["bar","t"],"n11":["Cuan","i"],"n12":["do‿el","t"],"n13":["con","i"],"n14":["vi","m"],"n15":["te","t"],"n16":"ya","n17":"se","n18":["ter","i"],"n19":["mi","m"],"n20":["nó;","t"],"n21":["Dul","i"],"n22":["ce‿a","m"],"n23":["la","m"],"n24":["ban","m"],"n25":["za","t"],"n26":"El","n27":["di","i"],"n28":["ri","m"],"n29":["ge‿a","t"],"n30":"Ti,","n31":"Y‿en","n32":["Su‿a","i"],"n33":["la","m"],"n34":["ban","m"],"n35":["za","t"],"n36":["so","i"],"n37":["mos","t"],"n38":["u","i"],"n39":["no‿a","m"],"n40":["quí.","t"]},"verses":[{"label":"2.","lines":["Padre, Tú eres toda la bondad","Que disfrutamos. ¡No‿hay amor igual!","Te adoramos, pues haces saber","La‿inescrutable vida de Tu Ser."]},{"label":"3.","lines":["Padre‿en Tu amor el nuestro crece‿así,","Trasciende todo lazo terrenal;","Tu‿amor con fuerza lleva‿el corazón","A Tu presencia en consolación."]},{"label":"4.","lines":["Padre, en unión con Tu Hijo amado hoy,","Te alabamos en Tu santo amor;","Con alegría disfrutamos más","Tu nombre como hijos al clamar."]}]}