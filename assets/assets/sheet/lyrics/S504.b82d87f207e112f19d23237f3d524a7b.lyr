{"hymn":"S504","parent":"E611","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Dios en sustancia Espíritu es","subtitle":"Experiencia de Dios—Al ejercitar el Espíritu","syl":{"n1":"Dios","n2":"en","n3":["sus","i"],"n4":["tan","m"],"n5":["cia‿Es","m"],"n6":["pí","m"],"n7":["ri","m"],"n8":["tu‿es,","t"],"n9":["Su‿e","i"],"n10":["sen","m"],"n11":["cia","t"],"n12":["san","i"],"n14":["ta‿y","t"],"n15":["di","i"],"n16":["vi","m"],"n17":["nal,","t"],"n18":["Pa","i"],"n19":["ra","t"],"n20":["to","i"],"n21":["car","t"],"n22":["Su‿Es","i"],"n23":["pí","m"],"n24":["ri","m"],"n25":["tu,","t"],"n26":["Mi‿es","i"],"n27":["pí","m"],"n28":["ri","m"],"n29":["tu‿he","t"],"n30":["de‿e","i"],"n31":["jer","m"],"n32":["ci","m"],"n33":["tar.","t"]},"verses":[{"label":"2.","lines":["En el hombre, su espíritu","Es lo mas hondo y real;","Para tocar en vida a Dios,","Debe su espíritu usar."]},{"label":"3.","lines":["Sólo en el espíritu","Se debe al Padre adorar;","Su Espíritu viene a morar","En el nuestro en unidad."]},{"label":"4.","lines":["Su Espíritu a mi espíritu","Llama y hace la unidad;","Su Espíritu es vida en mí,","Y el mío llega a ser Su hogar."]},{"label":"5.","lines":["Si en Sus riquezas quiero entrar,","Su Espíritu debo tocar;","Sólo con mi espíritu","Puedo al Padre adorar."]},{"label":"6.","lines":["La comunión debe llevar","Al hombre a su‿espíritu;","Allí él debe orar y hallar","Respuesta del Espíritu."]},{"label":"7.","lines":["Debemos en espíritu","Orar a Dios y a Él servir,","Crecer en vida, edificar,","Para a Cristo exhibir."]},{"label":"8.","lines":["Señor, yo quiero hoy volver","Al espíritu y‿aprender","Cómo tocar Tu Espíritu,","Hasta que fluyas en mi ser."]}]}