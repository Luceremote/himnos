{"hymn":"S350","parent":"E460","quality":"check","adjust":{"hold":0,"merge":0},"title":"Mi Jesús, todo he dejado","subtitle":"Consagración—Seguir al Señor","syl":{"n1":"Mi","n2":["Je","i"],"n3":["sús,","t"],"n4":["to","i"],"n5":["do‿he","t"],"n6":["de","i"],"n7":["ja","m"],"n9":["do,","t"],"n10":"Con","n11":"mi","n12":"cruz","n13":"te","n14":["si","i"],"n15":["go‿en","t"],"n16":"pos;","n18":["Des","i"],"n19":["pre","m"],"n20":["cia","m"],"n21":["do,‿a","m"],"n22":["ban","m"],"n23":["do","m"],"n24":["na","m"],"n26":["do,","t"],"n27":"Mas","n28":"mi","n30":["to","i"],"n31":["do","t"],"n33":["e","i"],"n34":["res","t"],"n35":"hoy.","n36":"Que","n37":["pe","i"],"n38":["rez","m"],"n39":["ca","t"],"n40":["to","i"],"n41":["do‿an","m"],"n42":["he","m"],"n44":["lo,","t"],"n45":["Es","i"],"n46":["pe","m"],"n47":["ran","m"],"n48":["za","t"],"n49":["y‿am","i"],"n50":["bi","m"],"n52":["ción;","t"],"n53":"Mas","n54":"cuán","n55":["ri","i"],"n56":["ca","t"],"n57":"es","n58":["mi‿he","i"],"n59":["ren","m"],"n61":["cia:","t"],"n62":["Cris","i"],"n63":["to‿y","t"],"n65":"Dios","n66":"mi","n68":["to","i"],"n69":["do","t"],"n70":"son."},"verses":[{"label":"2.","lines":["A mi Salvador el mundo","Despreció‿y también a mí;","Engañosos son los hombres,","Mas no‿hay falsedad en Ti.","Y si hoy Tú me sonríes,","Dios de amor y de poder,","Aunque me‿odien y repudien,","Tu faz suficiente es."]},{"label":"3.","lines":["Si los hombres me angustian,","A Tu pecho‿acudiré;","Si mi vida trae sus pruebas,","Mi descanso Cristo es.","Mientras Tu amor no cese,","No me‿agravia el sufrir;","No me‿atrae gozo‿alguno","Si tu no estás allí."]},{"label":"4.","lines":["Muévete de gracia‿a gloria,","Fuerte‿en oración y fe,","Al gran día sempiterno,","Guiado por Su mano fiel.","Pronto tu peregrinaje","Y misión se‿acabarán;","La‿oración se‿hará‿alabanza,","La fe‿en vista cambiará."]}]}