{"hymn":"S628","parent":"E813","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Al trono de Tu gracia hoy","subtitle":"El estudio de la palabra—Alimentarnos de la palabra","syl":{"n1":"Al","n2":["tro","i"],"n4":["no","t"],"n5":"de","n6":"Tu","n7":["gra","i"],"n8":["cia","t"],"n9":"hoy","n10":["Ham","i"],"n11":["brien","m"],"n13":["to,","t"],"n14":["ven","i"],"n15":["go","t"],"n16":"a","n18":["co","i"],"n19":["mer;","t"],"n21":"Tu","n23":["gra","i"],"n24":["cia","t"],"n25":["quie","i"],"n26":["ro","t"],"n27":["re","i"],"n29":["ci","m"],"n30":["bir;","t"],"n31":"En","n32":["es","i"],"n34":["ta","t"],"n35":["ho","i"],"n37":["ra‿a","m"],"n38":["yú","m"],"n39":["da","m"],"n40":["me.","t"]},"verses":[{"label":"2.","lines":["Mirando Tu radiante faz","Luz brilla en mi corazón;","Tus rayos sanan con poder","Mi flojedad y todo error."]},{"label":"3.","lines":["Aquí descubres con Tu luz,","Mi verdadera condición;","Aquí Tu sangre eficaz","Limpia todo pecado hoy."]},{"label":"4.","lines":["Tu Espíritu me‿unge aquí,","Tu misma‿esencia Él me da,","Así te puedo disfrutar","Y conocer Tu voluntad."]},{"label":"5.","lines":["Trae Tu Palabra luz a mí,","Es una lámpara en mi ser;","Tu Espíritu su aceite es","Para que resplandezca bien."]},{"label":"6.","lines":["Como los sacerdotes yo","Hoy persevero en oración;","Tu Espíritu, que‿incienso es,","Se mezcla con mi oración."]},{"label":"7.","lines":["Con Tu Palabra rica fiel","Comida y luz me suplirás;","Si como y leo de ella yo,","Comida y luz me saciarán."]},{"label":"8.","lines":["El agua viva eres Tú","Que puede siempre avivar;","Bebiendo y orando yo,","Los ríos vivos brotarán."]},{"label":"9.","lines":["Incienso eres para Dios,","Y la completa aceptación;","Orar yo quiero más y más","Para ofrecer un grato olor."]},{"label":"10.","lines":["Tu luz me alumbra al leer,","Mi sed se apaga al orar,","Me suples con Tu mismo ser,","Así me puedes Tú usar."]},{"label":"11.","lines":["Anhelo yo tal comunión,","Satúrame y rebosaré;","Por la Palabra y oración","Mezclado a Ti yo estaré."]}]}