{"hymn":"S180","parent":"E233","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, qué milagro, mi Señor","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n1":"¡Oh,","n2":"qué","n3":["mi","i"],"n4":["la","m"],"n5":["gro,","t"],"n6":"mi","n7":["Se","i"],"n8":["ñor,","t"],"n9":["Que‿es","i"],"n10":["tés","t"],"n11":"en","n12":"mí","n14":"y","n16":"yo‿en","n17":["Ti‿es","i"],"n18":["té!","t"],"n19":["De‿he","i"],"n20":["cho,","t"],"n21":["so","i"],"n22":["mos","t"],"n23":["u","i"],"n24":["no","t"],"n26":"Tú‿y","n28":"yo;","n29":["¡Mis","i"],"n30":["te","m"],"n31":["rio","t"],"n32":"tan","n33":["ex","i"],"n34":["cel","m"],"n35":["so","t"],"n36":"es!"},"verses":[{"label":"2.","lines":["Tu cuerpo diste Tú por mí,","De Ti yo puedo‿así participar;","Por mí Tu sangre derramada fue,","Librándome del cruel pecar."]},{"label":"3.","lines":["Cambiaste en resurrección,","Tu forma‿Espíritu ahora es;","Deseas que lleno de Ti esté,","Y Tus riquezas poseer."]},{"label":"4.","lines":["Por estos símbolos, Señor","De nuevo vemos Tu amante ser;","Y por Tu plan te damos gracias hoy,","Al recordar Tu padecer."]},{"label":"5.","lines":["Hoy compartimos vino y pan,","A Tu dulzura Tú nos guiarás;","Al recibirte‿en nuestro‿espíritu,","Tu mismo ser nos saciará."]},{"label":"6.","lines":["Comer, beber queremos más,","Tomándote en nuestro espíritu","Hasta que llenes todo nuestro ser,","Y recordarte‿en plenitud."]}]}