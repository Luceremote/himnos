{"hymn":"S211","parent":"E1121","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Alabamos al Señor que","subtitle":"La plenitud del Espíritu—La unción, el sello y las arras","syl":{"n1":["A","i"],"n2":["la","m"],"n3":["ba","m"],"n5":["mos","t"],"n6":"al","n8":["Se","i"],"n9":["ñor","t"],"n10":"que","n11":"Al","n12":["Un","i"],"n13":["gi","m"],"n15":["do","t"],"n16":"nos","n18":["u","i"],"n19":["nió;","t"],"n21":"Con","n22":"la","n23":["mis","i"],"n25":["ma‿un","m"],"n27":["ción","t"],"n28":["di","i"],"n29":["vi","m"],"n30":["na","t"],"n31":"De","n32":"Su","n33":["Hi","i"],"n35":["jo","t"],"n36":"nos","n38":["un","i"],"n39":["gió.","t"]},"verses":[{"label":"2.","lines":["En la unción de este Cristo","Los ungidos somos ya;","Qué bendito‿es este‿ungüento","Que‿a Sus hijos hoy les da."]},{"label":"3.","lines":["¡Aleluya! Este ungüento","Habitando‿en nuestro ser","Trae a Dios en Su esencia,","Todo nos enseña él."]},{"label":"4.","lines":["Somos del Señor tesoro,","Con Su sangre nos compró;","En nosotros puso el sello","Con el cual Dios nos marcó."]},{"label":"5.","lines":["El nos sella día a día,","Impartiendo así Su ser,","Hasta que Su semejanza","E imagen puedan ver."]},{"label":"6.","lines":["Hoy las arras poseemos","De‿este Cristo que vendrá;","Añoramos nuestra herencia:","Dios, gran fiesta eternal."]},{"label":"7.","lines":["Dios con este plan nos hizo","Y las arras nos legó,","Garantía del disfrute","Del Señor en dulce‿amor."]},{"label":"8.","lines":["En mi‿espíritu las arras","Con el sello y la‿unción,","Son depósitos valiosos,","Dulces dones del Señor."]}]}