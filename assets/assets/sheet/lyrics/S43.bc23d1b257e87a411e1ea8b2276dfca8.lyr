{"hymn":"S43","parent":"E54","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh Padre Dios, venimos a alabar","subtitle":"Adoración al Padre—Alabanza a Él de parte de sus muchos hijos","syl":{"n1":"Oh","n2":["Pa","i"],"n3":["dre","t"],"n4":"Dios,","n5":["ve","i"],"n6":["ni","m"],"n7":["mos","t"],"n8":["a‿a","i"],"n9":["la","m"],"n10":["bar,","t"],"n11":["Nin","i"],"n12":["gu","m"],"n13":["no","t"],"n14":"hay","n15":"tan","n16":["dig","i"],"n17":["no","t"],"n18":["co","i"],"n19":["mo","t"],"n21":"Tú.","n22":["Bus","i"],"n23":["can","m"],"n24":["do‿a","m"],"n25":["do","m"],"n26":["ra","m"],"n27":["do","m"],"n28":["res","t"],"n29":"Tú","n30":["es","i"],"n31":["tás,","t"],"n32":["Que‿a","i"],"n33":["do","m"],"n34":["ren","t"],"n35":"en","n36":["ver","i"],"n37":["dad","t"],"n38":["y‿es","i"],"n39":["pí","m"],"n40":["ri","m"],"n41":["tu.","t"]},"verses":[{"label":"2.","lines":["Todos los mundos Tú creaste aquí","Por Cristo el Hijo y Su gran poder;","Y hoy venimos en el Hijo a Ti:","¡Causa de‿adoración tal hecho es!"]},{"label":"3.","lines":["Él nos dirige‿en alabanza‿a Ti,","¡En la‿asamblea, oh qué bendición!","¡Cómo Él se goza, pues nos tiene‿así,","Cerca de Él, en libertad y‿amor!"]},{"label":"4.","lines":["¡Con Él unidos, entonamos hoy!","Hallas, oh Dios, satisfacción total.","Nuestra alabanza, el Hijo inició,","Y‿en la‿alabanza siempre morarás."]}]}