{"hymn":"S125","parent":"E153","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Bendito Salvador, Tu amor","subtitle":"Alabanza al Señor—Su amor","syl":{"n1":["Ben","i"],"n3":["di","m"],"n4":["to","t"],"n5":["Sal","i"],"n7":["va","m"],"n8":["dor,","t"],"n10":["Tu‿a","i"],"n11":["mor,","t"],"n13":"¡Cuán","n14":["gran","i"],"n15":["de‿y","t"],"n16":["ri","i"],"n18":["co","t"],"n19":"es!","n21":["Que","i"],"n22":["re","m"],"n23":["mos","t"],"n24":["de","i"],"n25":["di","m"],"n27":["car","t"],"n28":"a","n30":"Ti","n31":["Nues","i"],"n33":["tro","t"],"n34":["com","i"],"n36":["ple","m"],"n38":["to","t"],"n39":"ser."},"verses":[{"label":"2.","lines":["Te‿amamos por el gran valor","Que hemos visto‿en Ti;","Te‿amamos por sufrir la cruz","Pacientemente allí."]},{"label":"3.","lines":["¡Cuán grande‿amor es el morir","Por un amigo fiel!","Mas por Tus enemigos, Tú,","Sufriste lo más cruel."]},{"label":"4.","lines":["Aunque en forma‿igual a Dios,","Con gloria celestial,","Te‿hiciste un esclavo fiel,","Con pena terrenal."]},{"label":"5.","lines":["Un hombre Tú llegaste‿a ser;","Mas sin pecado‿en Ti,","Para hacernos como Tú,","En vida y‿en vivir."]},{"label":"6.","lines":["Tal como Tú en humildad,","En vida y en amor;","De gloria‿en gloria vamos ya","A ver Tu faz, Señor."]},{"label":"7.","lines":["Atesoramos Tu amor","En nuestro corazón;","Tu nombre siempre ha de ser","El más fragante‿olor."]}]}