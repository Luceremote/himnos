{"hymn":"S458","parent":"E591","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo, no yo, sea honrado y exaltado","subtitle":"Experiencia de Cristo—Expresarlo a Él","syl":{"n1":["Cris","i"],"n2":["to,","t"],"n3":"no","n4":"yo,","n5":["se","i"],"n6":["a‿hon","m"],"n7":["ra","m"],"n8":["do‿y‿e","m"],"n9":["xal","m"],"n10":["ta","m"],"n11":["do,","t"],"n12":["Cris","i"],"n13":["to,","t"],"n14":"no","n15":"yo,","n16":"se","n17":["pue","i"],"n18":["da","t"],"n19":["siem","i"],"n20":["pre","t"],"n21":"ver;","n23":["Cris","i"],"n24":["to,","t"],"n25":"no","n26":"yo,","n27":"en","n28":["to","i"],"n29":["das","t"],"n30":"mis","n31":["pa","i"],"n32":["la","m"],"n33":["bras,","t"],"n34":["Cris","i"],"n35":["to,","t"],"n36":"no","n37":"yo,","n38":"sea","n39":["da","i"],"n40":["do‿a","t"],"n41":["co","i"],"n42":["no","m"],"n43":["cer.","t"],"n45":"¡Oh,","n46":"que","n47":"me","n48":["sal","i"],"n49":["ves","t"],"n50":"del","n51":"yo,","n52":["Se","i"],"n53":["ñor!","t"],"n54":"¡Oh,","n55":"que","n56":"me","n57":["pier","i"],"n58":["da‿en","t"],"n59":"Ti!","n61":"¡Oh,","n62":"que","n63":"no","n64":["sur","i"],"n65":["ja","t"],"n66":"ya","n67":"más","n68":"yo,","n69":"Mas","n70":["vi","i"],"n71":["va","t"],"n72":["Cris","i"],"n73":["to‿en","t"],"n74":"mí!"},"verses":[{"label":"2.","lines":["Cristo, no yo, al suavizar tristezas,","Cristo, no yo, al llanto sosegar;","Cristo, no yo, alzando toda carga,","Cristo, no yo, al miedo apaciguar."]},{"label":"3.","lines":["Cristo más bien, que un hablar ocioso,","Cristo más bien, que estéril trabajar;","Cristo más bien, que el engreído ego,","Cristo, o más bien, que el yo manifestar."]},{"label":"4.","lines":["Cristo, no yo, en mis necesidades,","Cristo, no yo, mi fuerza y mi suplir;","Cristo cubriendo espíritu, alma y cuerpo,","¡Oh, que Tu vida vivas, Cristo, en mí!"]},{"label":"5.","lines":["Cristo, será mi único ensueño,","Gloria excelsa pronto yo veré;","Cristo será el fin de mis anhelos,","Cristo mi todo en todo ha de ser."]}]}