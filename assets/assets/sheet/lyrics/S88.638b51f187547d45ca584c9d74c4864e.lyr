{"hymn":"S88","parent":"E1091","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Te alabamos, oh Señor Jesús","subtitle":"Alabanza al Señor—Su redención","syl":{"n1":"Te","n2":["a","i"],"n3":["la","m"],"n4":["ba","m"],"n5":["mos,","t"],"n6":"oh","n7":["Se","i"],"n8":["ñor","t"],"n9":["Je","i"],"n10":["sús,","t"],"n11":"Nos","n12":["re","i"],"n13":["ve","m"],"n14":["las","m"],"n15":["te","t"],"n16":"el","n17":["ca","i"],"n18":["mi","m"],"n19":["no‿a","t"],"n20":"Dios.","n21":["A","i"],"n22":["trás","t"],"n23":["de","i"],"n24":["jas","m"],"n25":["te‿el","t"],"n26":["tro","i"],"n27":["no‿y","t"],"n28":"su","n29":["vir","i"],"n30":["tud,","t"],"n31":"¡Qué","n32":["Su","i"],"n33":["mo","t"],"n34":["Sa","i"],"n35":["cer","m"],"n36":["do","m"],"n37":["te","t"],"n38":"nos","n39":["lle","i"],"n40":["gó!","t"],"n41":"Tu","n42":["san","i"],"n43":["gre","t"],"n44":["o","i"],"n45":["fre","m"],"n46":["cis","m"],"n47":["te,","t"],"n48":"oh","n49":["Se","i"],"n50":["ñor,","t"],"n51":"Y","n52":"paz","n53":"por","n54":["siem","i"],"n55":["pre","t"],"n56":"nos","n57":["dis","i"],"n58":["te","t"],"n59":"con","n60":"Dios."},"verses":[{"label":"2.","lines":["El trono con Tu sangre se roció,","Tu pueblo redimiste del pecar.","El dulce‿amor que diste‿a conocer","Nos llena‿en el Santísimo Lugar;","Y por Tu sangre‿allí, tenemos hoy","Misericordia‿y gracia‿en nuestro Dios."]},{"label":"3.","lines":["Viniste no sólo para expiar,","También para‿el pecado eliminar.","Podemos hoy al trono‿así llegar,","Ya que quitaste nuestro vil pecar.","Su faz, de Ti el Padre la‿apartó,","Tal precio cruel, en gracia se pagó."]},{"label":"4.","lines":["Ahora el camino‿abierto está","A pecadores que‿oyen Tu llamar.","Nuestro temor eliminaste ya","Al derramar Tu sangre,‿y todo dar;","Recibe‿ahora nuestro corazón,","Hallamos nuestra vida‿en Ti, Señor."]}]}