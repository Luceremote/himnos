{"hymn":"S660","parent":"E848","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, qué bendición gloriosa","subtitle":"La iglesia—Su edificación","syl":{"n1":"¡Oh,","n2":"qué","n3":["ben","i"],"n4":["di","m"],"n5":["ción","t"],"n6":["glo","i"],"n7":["rio","m"],"n8":["sa!","t"],"n9":"Ser","n10":"un","n11":["sa","i"],"n12":["cer","m"],"n13":["do","m"],"n14":["te","t"],"n15":"real;","n16":["Aun","i"],"n17":["que","t"],"n18":["se","i"],"n19":["a‿el","t"],"n20":"más","n21":["pe","i"],"n22":["que","m"],"n23":["ño","t"],"n24":["Ten","i"],"n25":["go‿o","m"],"n26":["fi","m"],"n27":["cio","t"],"n28":["di","i"],"n29":["vi","m"],"n30":["nal.","t"],"n31":["La‿e","i"],"n32":["di","m"],"n33":["fi","m"],"n34":["ca","m"],"n35":["ción","t"],"n36":"del","n37":["Cuer","i"],"n38":["po","t"],"n39":"Por","n40":"el","n41":["sa","i"],"n42":["cer","m"],"n43":["do","m"],"n44":["cio","t"],"n45":"es;","n46":"En","n47":["mi‿es","i"],"n48":["pí","m"],"n49":["ri","m"],"n50":["tu","t"],"n51":["o","i"],"n52":["ran","m"],"n53":["do","t"],"n54":["Es","i"],"n55":["te‿o","m"],"n56":["fi","m"],"n57":["cio","t"],"n58":["cum","i"],"n59":["pli","m"],"n60":["ré.","t"]},"verses":[{"label":"2.","lines":["Si atiendo este llamado","Bajo Tu autoridad","Se edificará la iglesia","Por el sacerdocio real."]},{"label":"3.","lines":["Es la iglesia el sacerdocio","Concertado en unión;","Hoy los sacerdotes juntos","Forman su edificación."]},{"label":"4.","lines":["En la iglesia degradada","Este oficio se anuló;","Sus espíritus endebles","Sólo quieren un sermón."]},{"label":"5.","lines":["Muchos buscan un mensaje","Y no quieren funcionar,","Descuidando el sacerdocio,","Y, en espíritu, el orar."]},{"label":"6.","lines":["Hazme ser equilibrado","Al orar y predicar;","Que, orando, a otros guíe,","Tu Palabra al liberar."]},{"label":"7.","lines":["Con espíritus unidos","Y vital predicación,","Se edificará la iglesia","Al servir en oración."]}]}