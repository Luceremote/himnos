{"hymn":"S284","parent":"E352","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Una zarza ardiente aquí","subtitle":"Anhelos—De Dios como vida","syl":{"n1":["¡U","i"],"n2":["na","t"],"n3":["zar","i"],"n4":["za‿ar","m"],"n5":["dien","m"],"n6":["te‿a","m"],"n7":["quí","t"],"n8":"En","n9":"la","n10":["tie","i"],"n12":["rra","t"],"n13":["pa","i"],"n14":["ra","t"],"n15":"Dios!","n16":"Que‿a","n17":"Tu","n18":["nom","i"],"n20":["bre","t"],"n21":["glo","i"],"n22":["ria","t"],"n23":"dé,","n24":"Es","n25":["mi‿an","i"],"n26":["he","m"],"n28":["lo,","t"],"n29":"buen","n30":["Se","i"],"n31":["ñor.","t"]},"verses":[{"label":"2.","lines":["Una zarza, nada más,","Donde Dios pueda morar,","Por la cual Él pueda‿hablar","Y se pueda expresar."]},{"label":"3.","lines":["Su amor por el mortal,","Su designio eternal,","Que‿arde sin luz terrenal,","Mas con gloria celestial."]},{"label":"4.","lines":["Sí, Dios en la zarza‿está,","Sólo‿el fuego‿ahí se ve;","Hazme eso, hazlo‿oh, Dios,","Que‿a Tu nombre gloria dé."]}]}