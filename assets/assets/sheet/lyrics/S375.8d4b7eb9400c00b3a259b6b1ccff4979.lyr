{"hymn":"S375","parent":"E491","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, en carne una vez","subtitle":"Experiencia de Cristo—En el Espíritu","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n4":"en","n5":["car","i"],"n6":["ne","t"],"n7":["u","i"],"n9":["na","t"],"n10":"vez","n12":"Los","n13":["hom","i"],"n15":["bres","t"],"n16":"te","n17":["pu","i"],"n18":["die","m"],"n20":["ron","t"],"n21":"ver;","n22":"Mas","n23":["co","i"],"n25":["mo","t"],"n26":"el","n27":["Es","i"],"n28":["pí","m"],"n30":["ri","m"],"n31":["tu","t"],"n32":"En","n33":"mí","n35":"te","n36":["pue","i"],"n38":["do","t"],"n39":["co","i"],"n41":["no","m"],"n42":["cer.","t"]},"verses":[{"label":"2.","lines":["Te conocí por lo exterior","En carne, como el Redentor;","Mas hoy, como el Espíritu,","Como íntimo Consolador."]},{"label":"3.","lines":["Tú como el Espíritu","Te me revelas sin cesar;","Así en mi espíritu","Conozco hoy Tu realidad."]},{"label":"4.","lines":["Hoy más que aquellos del ayer","Conozco yo Tu vida en mí,","Ya que en la carne estabas Tú","Cuando anduvieron juntó a Ti."]},{"label":"5.","lines":["Por Tu Espíritu en mí,","¡Qué real te haces, oh Señor!","Jamás te vi o conocí,","Mas yo te amo con fervor."]},{"label":"6.","lines":["En mí Tu Santo Espíritu,","Tu mismo ser me impartirá","Como justicia, santidad","Y redención; según Tu plan."]},{"label":"7.","lines":["Tu Espíritu te imparte a mí,","Te une a mi espíritu;","Así soy siempre el mismo yo,","Mas, a la vez, también soy Tú."]}]}