{"hymn":"S475","parent":"E1168","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Voy laborando en Jesús, mi Canaán","subtitle":"Experiencia de Cristo—Como aquel que es la buena tierra","syl":{"n1":"Voy","n2":["la","i"],"n3":["bo","m"],"n4":["ran","m"],"n5":["do‿en","t"],"n6":["Je","i"],"n7":["sús,","t"],"n8":"mi","n9":["Ca","i"],"n10":["naán,","t"],"n12":["Plan","i"],"n13":["to","t"],"n14":"y","n15":["rie","i"],"n16":["go","t"],"n17":["si","i"],"n18":["guien","m"],"n19":["do","t"],"n20":"Su","n21":"plan;","n23":"Él","n24":["rin","i"],"n25":["de","t"],"n26":["fru","i"],"n27":["to","t"],"n28":"de","n29":"Su","n30":["rea","i"],"n31":["li","m"],"n32":["dad,","t"],"n34":"Es","n35":"las","n36":["pri","i"],"n37":["mi","m"],"n38":["cias","t"],"n39":"que‿en","n40":"mí","n41":"Dios","n42":["ten","i"],"n43":["drá.","t"],"n44":["Je","i"],"n45":["sús,","t"],"n46":"¡Oh","n47":["bue","i"],"n48":["na","t"],"n49":["tie","i"],"n50":["rra","t"],"n51":"Que","n52":"Dios","n53":"nos","n54":["en","i"],"n55":["tre","m"],"n56":["gó!","t"],"n57":"Yo","n58":["pau","i"],"n59":["la","m"],"n60":["ti","m"],"n61":["na","m"],"n62":["men","m"],"n63":["te","t"],"n64":["Te‿ha","i"],"n65":["ré","t"],"n66":"mi","n67":["po","i"],"n68":["se","m"],"n69":["sión.","t"],"n70":"Al","n71":["la","i"],"n72":["bo","m"],"n73":["rar","t"],"n74":"la","n75":["tie","i"],"n76":["rra","t"],"n77":"Dios","n78":["man","i"],"n79":["da","t"],"n80":["ben","i"],"n81":["di","m"],"n82":["ción;","t"],"n83":"Yo","n84":["ga","i"],"n85":["no","t"],"n86":"Tu","n87":["Per","i"],"n88":["so","m"],"n89":["na‿a","m"],"n90":["sí,","t"],"n91":"Pues","n92":["e","i"],"n93":["res","t"],"n94":"mi","n95":["por","i"],"n96":["ción.","t"]},"verses":[{"label":"2.","lines":["Voy laborando en Jesús, mi Señor,","No me lamento, pues yo firme estoy;","Mientras laboro la lluvia tendré;","Obrando en Cristo, ganancia veré."]},{"label":"3.","lines":["Voy laborando en Jesús al orar","Con Su Palabra en mi diario andar;","Sigo en mi espíritu Su viva unción,","Y con los santos yo vivo en unión."]},{"label":"4.","lines":["Voy laborando en Jesús para dar","A las reuniones sustancia real;","Allí los hombres con Dios hallarán","En Su presencia disfrute eternal."]},{"label":"5.","lines":["Ve laborando en Jesús, tu porción,","Y luego tráelo a cada reunión;","El excedente ofrece a tu Dios,","Come con gozo y bendice al Señor."]}]}