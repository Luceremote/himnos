{"hymn":"S821","parent":"E973","quality":"adapted","adjust":{"hold":0,"merge":4},"title":"La Ciudad Santa nuestra meta es","subtitle":"La máxima manifestación—Nuestra meta","syl":{"n1":"La","n2":["Ciu","i"],"n3":["dad","t"],"n4":["San","i"],"n5":["ta","t"],"n6":["nues","i"],"n7":["tra","t"],"n8":["me","i"],"n10":["ta","t"],"n11":"es,","n14":"Y","n15":"la","n16":["por","i"],"n17":["ción","t"],"n18":"de","n19":["to","i"],"n20":["da","t"],"n21":["al","i"],"n23":["ma","t"],"n24":"fiel;","n26":"Aun","n27":["cuan","i"],"n28":["do","t"],"n29":["nues","i"],"n30":["tro","t"],"n31":["cuer","i"],"n32":["po","t"],"n33":["vi","i"],"n34":["ve‿a","m"],"n35":["quí,","t"],"n38":["Es","i"],"n39":["tá‿el","t"],"n40":["es","i"],"n41":["pí","m"],"n42":["ri‿tu","t"],"n43":"con","n44":["el‿Se","i"],"n45":["ñor","t"],"n47":["a","i"],"n49":["llí,","t"],"n51":["Es","i"],"n52":["tá‿el","t"],"n53":["es","i"],"n54":["pí","m"],"n55":["ri‿tu","t"],"n56":"con","n57":["el‿Se","i"],"n58":["ñor","t"],"n60":["a","i"],"n62":["llí.","t"]},"verses":[{"label":"2.","lines":["Es nuestra meta la Jerusalén,","Do Dios y el hombre pueden uno ser,","Los que caminan tras el Redentor,","Tendrán derecho de gozar Su bendición,","Tendrán derecho de gozar Su bendición."]},{"label":"3.","lines":["Cuando miramos hacia la ciudad,","Es nuestro anhelo contemplar Tu faz,","Oir el grito que nos lleva a Ti","Y compartir Tu Dios eternamente así,","Y compartir Tu Dios eternamente así."]},{"label":"4.","lines":["Nuestra deseo no es la dulce paz,","Tampoco el gozo que nos llenará,","Nuestra esperanza eres Tú, Señor.","Señor, Tú mismo eres nuestro galardón.","Señor, Tú mismo eres nuestro galardón."]},{"label":"5.","lines":["Escucha ahora nuestro gran clamor,","¡Ven a llevarnos hasta Ti, Señor!","Compartiremos la Santa Ciudad,","Y de Ti mismo nos harás participar,","Y de Ti mismo nos harás participar."]},{"label":"6.","lines":["¡Todas las cosas, nuevas las harás:","La tierra el cielo y todo lo demás!","El Dios de gloria, la porción allí;","Señor, ven pronto a llevarnos junto a Ti,","Señor, ven pronto a llevarnos junto a Ti."]}]}