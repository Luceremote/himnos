{"hymn":"S159","parent":"E200","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El Sol de la justicia, Tú","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"El","n2":"Sol","n3":"de","n4":"la","n5":["jus","i"],"n6":["ti","m"],"n8":["cia,","t"],"n9":"Tú,","n10":"Nos","n11":"traes","n13":"la","n14":["sa","i"],"n16":["ni","m"],"n17":["dad;","t"],"n19":"Y","n20":"de","n21":"Tu","n22":["ros","i"],"n23":["tro","t"],"n24":"el","n25":["res","i"],"n26":["plan","m"],"n27":["dor,","t"],"n28":"Hoy","n29":"Tus","n31":["ri","i"],"n32":["que","m"],"n34":["zas","t"],"n35":"da."},"verses":[{"label":"2.","lines":["Por la merced de nuestro Dios","Amaneciste Tú;","La sombra de la noche‿atróz","Se disipó‿en Tu luz."]},{"label":"3.","lines":["La luz del alba eres Tú,","Y nuestro‿amanecer;","Somos los pastos que‿en Tu luz","Encuentran gran placer."]},{"label":"4.","lines":["Tu agradable resplandor","A diario‿ha de crecer,","Brillando‿en nuestro interior","Hasta perfecto ser."]},{"label":"5.","lines":["Tu luz traspasa la‿aflicción","Como‿a la lluvia‿el sol;","Tu brillo nunca cesará","Por Tu bondad y‿amor."]},{"label":"6.","lines":["Resplandeciente‿estrella, Tú,","Hoy eres galardón","Y luz a los que,‿al madrugar,","Te buscan con amor."]},{"label":"7.","lines":["Ayúdanos a‿amar Tu luz","Y a buscar, Señor,","Esa estrella que‿eres Tú,","Velando‿en oración."]}]}