{"hymn":"S605","parent":"E783","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Toca el trono en oración","subtitle":"Oración—Toca el trono","syl":{"n1":["To","i"],"n2":["ca‿el","t"],"n3":["tro","i"],"n4":["no‿en","t"],"n5":["o","i"],"n6":["ra","m"],"n7":["ción,","t"],"n8":["Gra","i"],"n9":["cia‿a","m"],"n10":["llí","t"],"n11":["re","i"],"n12":["ci","m"],"n13":["bi","m"],"n14":["rás;","t"],"n15":"Con","n16":["mi","i"],"n17":["se","m"],"n18":["ri","m"],"n19":["cor","m"],"n20":["dia","t"],"n21":"Dios","n23":["Tu‿es","i"],"n24":["ca","m"],"n25":["sez","t"],"n26":"hoy","n27":["su","i"],"n28":["pli","m"],"n29":["rá","t"]},"verses":[{"label":"2.","lines":["Toca el trono en oración,","Y la gracia encontrarás;","En Tu espíritu a Dios","Cara a cara le verás."]},{"label":"3.","lines":["Toca el trono en oración,","De Su gracia aprenderás;","Tómala en comunión,","Dando gracias sin cesar."]},{"label":"4.","lines":["Toca el trono en oración,","Toca el trono de poder;","En el nombre de Jesús","Haz lo que se debe hacer."]},{"label":"5.","lines":["Toca el trono en oración,","Usa tu viviente fe,","Ejercita autoridad","Para la muerte vencer."]},{"label":"6.","lines":["Toca el trono en oración,","Sacude el poder del mal;","Ora con autoridad,","Hoy con Cristo hay que orar."]}]}