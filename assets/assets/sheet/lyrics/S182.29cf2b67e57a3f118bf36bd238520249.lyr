{"hymn":"S182","parent":"E1107","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Reunidos hoy, Señor como Tu Cuerpo","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n1":["Reu","i"],"n2":["ni","m"],"n3":["dos","t"],"n4":"hoy,","n5":["Se","i"],"n6":["ñor","t"],"n7":["co","i"],"n8":["mo","t"],"n9":"Tu","n10":["Cuer","i"],"n11":["po,","t"],"n13":"Aun","n14":["sien","i"],"n15":["do","t"],"n16":["mu","i"],"n17":["chos,","t"],"n18":["u","i"],"n19":["no","t"],"n20":["so","i"],"n21":["mos","t"],"n22":"ya;","n24":"Tu","n25":["vi","i"],"n26":["da","t"],"n27":["com","i"],"n28":["par","m"],"n29":["ti","m"],"n30":["mos","t"],"n31":["co","i"],"n32":["mo","t"],"n33":["miem","i"],"n34":["bros,","t"],"n36":"Y‿en","n37":["e","i"],"n38":["sa","t"],"n39":["vi","i"],"n40":["da‿es","m"],"n41":["tá","t"],"n42":["nues","i"],"n43":["tra‿u","m"],"n44":["ni","m"],"n45":["dad.","t"],"n47":"Un","n48":["Cuer","i"],"n49":["po","t"],"n50":"en","n51":"el","n52":["u","i"],"n53":["ni","m"],"n54":["ver","m"],"n55":["so","t"],"n56":"hay,","n58":"Su","n59":["ex","i"],"n60":["pre","m"],"n61":["sión","t"],"n63":["so","i"],"n64":["mos","t"],"n65":["a","i"],"n66":["quí;","t"],"n68":"Y","n69":["so","i"],"n70":["mos","t"],"n71":["u","i"],"n72":["no‿en","t"],"n73":"la","n74":["lo","i"],"n75":["ca","m"],"n76":["li","m"],"n77":["dad,","t"],"n79":["Pa","i"],"n80":["ra‿ex","m"],"n81":["hi","m"],"n82":["bir","t"],"n84":["nues","i"],"n85":["tra‿u","m"],"n86":["ni","m"],"n87":["dad.","t"]},"verses":[{"label":"2.","lines":["Un solo pan, Tu cuerpo representa","Quebrado fue para participar;","Y al comer del pan hoy declaramos","Que con los santos es nuestra unidad."]},{"label":"3.","lines":["Un solo pan y una copa muestran","Que no podemos mas que uno ser;","La redención nos hizo un solo Cuerpo,","Qué se dirá, sino: \"‿Señor, Amén!\""]},{"label":"4.","lines":["Nuestra unidad no puede dividirse,","Nuestra unidad es sólo en el Señor;","La copa, el pan, tomamos siendo uno,","Y así visible se‿hace nuestra unión."]},{"label":"5.","lines":["¡Qué bendición! ¡Qué gozo el ser uno!","Sentimos del Señor satisfacción;","Contigo este gozo disfrutamos:","¡Primicias de las bodas del Señor!"]}]}