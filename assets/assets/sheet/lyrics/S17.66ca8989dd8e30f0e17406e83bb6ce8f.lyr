{"hymn":"S17","parent":"E21","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Por Tu justicia, Padre Dios","subtitle":"Adoración al Padre—Su justicia","syl":{"n1":"Por","n2":"Tu","n3":["jus","i"],"n4":["ti","m"],"n5":["cia,","t"],"n6":["Pa","i"],"n7":["dre","t"],"n8":"Dios,","n9":"Te","n10":["a","i"],"n11":["la","m"],"n12":["ba","m"],"n13":["mos","t"],"n14":["a‿u","i"],"n15":["na","t"],"n16":"voz","n17":["Tes","i"],"n18":["ti","m"],"n19":["fi","m"],"n20":["can","m"],"n21":["do‿a","m"],"n22":["quí:","t"],"n23":"El","n24":"Juez","n25":"de","n26":["to","i"],"n27":["dos","t"],"n28":["e","i"],"n29":["res","t"],"n30":"Tú,","n31":["Só","i"],"n33":["lo‿en","t"],"n34":"Tu","n35":"ser","n36":"hay","n37":["rec","i"],"n38":["ti","m"],"n39":["tud,","t"],"n40":"No","n41":"hay","n42":["e","i"],"n43":["rror","t"],"n44":"en","n45":"Ti."},"verses":[{"label":"2.","lines":["Oh Padre santo, justo Dios,","Tu rectitud al trono dio","Un fundamento fiel.","Por Tu justicia reinan ya","En Cristo, gracia divinal","Y paz en nuestro ser."]},{"label":"3.","lines":["Por Tu justicia Él murió,","Así Tu Hijo nos ganó,","La redención logró.","Al aplicar tal redención","En Cristo hallamos salvación;","Él nos justificó."]},{"label":"4.","lines":["Para mostrar Tu rectitud","En el pasado diste Tú","Perdón al vil mortal.","Por Tu justicia exhibes hoy","La remisión al pecador","En nuestra era actual."]},{"label":"5.","lines":["Tú juzgarás a todo ser,","Tu rectitud se ha de ver","Por Cristo el Señor;","Mas ¿qué de Ti nos moverá?","Tu rectitud nos guardará","Con gracia y amor."]},{"label":"6.","lines":["Con Tu justicia al reino das","El fundamento de Tu paz,","Cuánta armonía allí!","Se llenarán de rectitud","Los cielos y la tierra, Tú","Lo prometiste así."]}]}