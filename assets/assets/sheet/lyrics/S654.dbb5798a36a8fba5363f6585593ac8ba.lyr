{"hymn":"S654","parent":"E842","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Sopla en mí, Señor","subtitle":"La iglesia—Su edificación","syl":{"n1":["So","i"],"n2":["pla","t"],"n3":"en","n4":"mí,","n5":["Se","i"],"n6":["ñor;","t"],"n7":["Mi‿es","i"],"n8":["pí","m"],"n9":["ri","m"],"n10":["tu","t"],"n11":["sos","i"],"n12":["tén;","t"],"n13":["Qui","i"],"n14":["ta","t"],"n15":"mi","n16":["muer","i"],"n17":["te‿y","t"],"n18":"mi","n19":["te","i"],"n20":["mor,","t"],"n21":"Y","n22":["a","i"],"n23":["la","m"],"n24":["ban","m"],"n25":["zas","t"],"n26":"ten."},"verses":[{"label":"2.","lines":["Sopla en mí, Señor;","A mi ser, fuerza da;","Que sin fatiga ande yo","En alas de‿águila."]},{"label":"3.","lines":["Sopla en mí, Señor,","Para descanso hallar;","Que encuentre gozo el corazón","En Ti, al descansar."]},{"label":"4.","lines":["Sopla en mí, Señor,","Hasta mi ser llenar;","No viva yo, mas Cristo en mí,","En mi sentir y obrar."]},{"label":"5.","lines":["Sopla y quita así","La independencia en mí;","Que con los santos pueda ser","Edificado en Ti."]}]}