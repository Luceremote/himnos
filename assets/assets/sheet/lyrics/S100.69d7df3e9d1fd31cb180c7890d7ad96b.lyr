{"hymn":"S100","parent":"E1097","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Tu nombre, qué excelente es","subtitle":"Alabanza al Señor—Su victoria y exaltación","syl":{"n2":"¡Tu","n4":["nom","i"],"n5":["bre,","t"],"n6":["qué‿ex","i"],"n7":["ce","m"],"n9":["len","m"],"n10":["te","t"],"n11":"es","n12":"En","n14":"la","n15":["tie","i"],"n16":["rra,‿oh","t"],"n17":["Se","i"],"n19":["ñor!","t"],"n20":"Que","n22":["to","i"],"n23":["da","t"],"n24":["len","i"],"n25":["gua","t"],"n27":"y","n28":["na","i"],"n29":["ción","t"],"n30":["Pro","i"],"n32":["cla","m"],"n33":["men","t"],"n35":"su","n36":["va","i"],"n38":["lor.","t"],"n39":["Fun","i"],"n40":["das","m"],"n41":["te","t"],"n43":["fuer","i"],"n44":["za","t"],"n46":"y","n47":["lo","i"],"n48":["or","t"],"n49":"De","n51":"la","n52":["bo","i"],"n53":["ca‿in","m"],"n56":["fan","m"],"n57":["til,","t"],"n58":["Pa","i"],"n59":["ra","t"],"n60":["ca","i"],"n61":["llar","t"],"n62":"a","n63":["Sa","i"],"n65":["ta","m"],"n67":["nás","t"],"n68":["Y‿a","i"],"n70":["ce","m"],"n71":["le","m"],"n73":["rar","t"],"n74":"su","n75":"fin."},"verses":[{"label":"2.","lines":["Al contemplar los cielos que","Tu manó‿así formó,","La luna‿y las estrellas mil","Que Tu plan diseñó,","¿Qué es el hombre para que","Tú te acuerdes de‿él?","Y el hijo de hombre a quien","Tú visitaste fiel?"]},{"label":"3.","lines":["Tú eres, oh Señor Jesús,","Aquel que se‿humanó,","Quien con la carne se vistió","Sufriendo‿humillación;","Mas coronado fuiste ya","Con gloria y honor","Y por Tu Cuerpo todo‿está","Bajo Tus pies, Señor."]},{"label":"4.","lines":["Vemos aquí Tu encarnación","Y la resurrección,","Tu señorío‿y reino con","Tu Cuerpo en ascensión.","Por estos pasos, oh Señor,","Fundaste así loor;","Con rebozante corazón","Alzamos nuestra voz."]},{"label":"5.","lines":["¡En breve el día llegará,","Tal dicho se oirá!","Mas en la iglesia hoy está","Un presabor real.","¡Tu nombre, qué‿excelente es","En la tierra, oh Señor!","Que toda lengua y nación","Proclamen su valor."]}]}