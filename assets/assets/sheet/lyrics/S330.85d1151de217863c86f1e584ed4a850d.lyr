{"hymn":"S330","parent":"E1137","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Los ángeles pueden Su faz contemplar","subtitle":"Anhelos—De la comunión en los padecimientos de Cristo","syl":{"n1":"Los","n2":["án","i"],"n3":["ge","m"],"n4":["les","t"],"n5":["pue","i"],"n6":["den","t"],"n7":"Su","n8":"faz","n9":["con","i"],"n10":["tem","m"],"n11":["plar,","t"],"n12":"Mas","n13":["gra","i"],"n14":["cia","t"],"n15":"no","n16":["pue","i"],"n17":["den","t"],"n18":["pro","i"],"n19":["bar;","t"],"n21":"Los","n22":["san","i"],"n23":["tos","t"],"n24":["co","i"],"n25":["no","m"],"n26":["cen","t"],"n27":["Su‿a","i"],"n28":["mor","t"],"n29":["e","i"],"n30":["ter","m"],"n31":["nal,","t"],"n32":"Mas","n33":["nun","i"],"n34":["ca","t"],"n35":"han","n36":["vis","i"],"n37":["to","t"],"n38":"Su","n39":"faz.","n41":"Los","n42":["san","i"],"n43":["tos","t"],"n44":"muy","n45":["pron","i"],"n46":["to","t"],"n47":"Su","n48":["ros","i"],"n49":["tro","t"],"n50":["ve","i"],"n51":["rán","t"],"n52":"Su","n53":["glo","i"],"n54":["ria","t"],"n55":["tam","i"],"n56":["bién","t"],"n57":["lle","i"],"n58":["va","m"],"n59":["rán;","t"],"n61":["Ma","i"],"n62":["rí","m"],"n63":["a,","t"],"n64":"en","n65":["cam","i"],"n66":["bio,","t"],"n67":"al","n68":["ver","i"],"n69":["lo","t"],"n70":["llo","i"],"n71":["rar,","t"],"n72":["Sin","i"],"n73":["tió","t"],"n74":["Su‿an","i"],"n75":["gus","m"],"n76":["ti","m"],"n77":["a‿y","t"],"n78":["pe","i"],"n79":["sar,","t"],"n81":["Sin","i"],"n82":["tió","t"],"n83":["Su‿an","i"],"n84":["gus","m"],"n85":["ti","m"],"n86":["a‿y","t"],"n87":["pe","i"],"n88":["sar.","t"]},"verses":[{"label":"2.","lines":["Muy pronto veremos la faz del Señor,","Lo conoceremos como‿es;","Pero‿el toque tierno de Su sanidad,","Ya no volverá‿a nuestro ser.","Aunque‿en aquel día habrá gran loor,","No‿habrá más pesar ni‿oración,","Tampoco‿el consuelo que quita‿el dolor,","//Ni fe a través de‿aflicción.//"]},{"label":"3.","lines":["Aquel día, gloria nos coronará,","Más no habrá cruz que llevar;","La comunión dulce de Su aflicción","Hoy sólo podemos probar.","Después de entrar al descanso‿eternal,","No‿habrá más oportunidad","De padecer pruebas o dificultad","//Por causa de Él en verdad.//"]},{"label":"4.","lines":["Oh, muy pocas veces podemos sufrir","La burla y vergüenza por Él;","Y pronto se va la oportunidad","Que‿Él nos acompañe‿en desdén.","Los malentendidos y penas se irán,","Dolor y desprecio también;","Valoro hoy las bendiciones que traen","//Más comunión dulce con Él.//"]},{"label":"5.","lines":["Anhelo Tu faz pronto ver, mi Señor;","¡Qué extasis, contigo‿estar!","Mas no quiero ninguna prueba‿eludir;","Tan dulces y‿escasas son ya.","¡Ten misericordia, que viva por Ti!","¡Oh, llena mi ser de Tu‿amor!","No sea que en ese día, Señor","//Lamente lo que se perdió.//"]}]}