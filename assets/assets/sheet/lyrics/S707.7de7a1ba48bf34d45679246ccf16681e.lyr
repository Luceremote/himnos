{"hymn":"S707","parent":"E1278","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En la iglesia viva del Señor Jesús","subtitle":"La iglesia—General","syl":{"n1":"En","n2":["la‿i","i"],"n3":["gle","m"],"n4":["sia","t"],"n5":["vi","i"],"n6":["va","t"],"n8":"del","n9":["Se","i"],"n10":["ñor","t"],"n11":["Je","i"],"n12":["sús","t"],"n13":"Hay","n14":["a","i"],"n15":["mor","t"],"n16":["pro","i"],"n17":["fun","m"],"n18":["do,","t"],"n19":["tier","i"],"n20":["no","t"],"n21":"y","n22":["ve","i"],"n23":["raz;","t"],"n24":"¿Por","n25":"qué","n26":["es","i"],"n27":["tar","t"],"n28":"tan","n29":["so","i"],"n30":["lo‿y","t"],"n31":"sin","n32":["a","i"],"n33":["mis","m"],"n34":["tad,","t"],"n35":["Cuan","i"],"n36":["do","t"],"n37":"Su","n38":["i","i"],"n39":["gle","m"],"n40":["sia","t"],"n41":"te","n42":["pue","i"],"n43":["de‿a","m"],"n44":["rro","m"],"n45":["par?","t"]},"verses":[{"label":"2.","lines":["En la iglesia viva del Señor Jesús,","Una vida fresca vibra sin cesar;","¿Por qué estar ansioso, lleno de temor,","Si Su iglesia cuida a los que Él compró?"]},{"label":"3.","lines":["En la iglesia viva del Señor Jesús,","Una obra noble hay que realizar;","¿Por qué estar ocioso? Hay que cosechar;","En la iglesia ahora puedes laborar."]},{"label":"4.","lines":["En la iglesia viva del Señor Jesús,","Un lugar glorioso te espera ya;","¿Por qué estar inquieto y vagar sin paz,","Cuando en Su iglesia tienes un hogar?"]}]}