{"hymn":"S76","parent":"E100","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El Hacedor, como Hombre, fue","subtitle":"Alabanza al Señor—Su sufrimiento","syl":{"n1":"El","n2":["Ha","i"],"n3":["ce","m"],"n4":["dor,","t"],"n5":["co","i"],"n6":["mo‿Hom","m"],"n8":["bre,","t"],"n9":"fue","n10":"Por","n11":["hom","i"],"n12":["bres","t"],"n13":["he","i"],"n14":["cho","t"],"n16":["mal","i"],"n18":["di","m"],"n19":["ción;","t"],"n20":"Lo","n21":["que‿e","i"],"n22":["xi","m"],"n23":["gió","t"],"n25":"Su","n26":["mis","i"],"n27":["ma","t"],"n28":"ley,","n30":["Has","i"],"n31":["ta","t"],"n32":"lo","n33":["su","i"],"n35":["mo","t"],"n36":"Él","n38":["pa","i"],"n39":["gó.","t"]},"verses":[{"label":"2.","lines":["Hizo la rama que brotó","Espinas que‿en Su sien llevó;","El clavo que lo traspasó","Salió de minas que‿Él creó."]},{"label":"3.","lines":["Hizo el árbol que formó","La cruz de la cual Él colgó;","Él hizo‿el monte‿en que se‿alzó","La cruz en la cual Él murió."]},{"label":"4.","lines":["Él extendió el cielo que","Sobre Su faz se‿oscureció;","El sol que su rostro‿escondió,","Por Su decreto‿Él suspendió."]},{"label":"5.","lines":["La lanza que lo traspasó,","Fuego divino la templó;","La tumba donde reposó","Era‿una peña que‿El formó."]},{"label":"6.","lines":["El trono‿en que sentado‿está","Fue Suyo por la‿eternidad;","Mas nueva gloria‿Él lleva ya;","Todos a Él se‿inclinarán."]}]}