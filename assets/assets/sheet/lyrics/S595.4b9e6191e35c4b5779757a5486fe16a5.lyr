{"hymn":"S595","parent":"E772","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Buscamos Tu faz, Señor","subtitle":"Oración—En el lugar santísimo","syl":{"n1":["Bus","i"],"n2":["ca","m"],"n3":["mos","t"],"n4":"Tu","n5":"faz,","n6":["Se","i"],"n7":["ñor,","t"],"n8":["Pa","i"],"n9":["ra‿u","m"],"n10":["ná","m"],"n11":["ni","m"],"n12":["mes","t"],"n13":["o","i"],"n14":["rar;","t"],"n15":["Te‿es","i"],"n16":["pe","m"],"n17":["ra","m"],"n18":["mos,","t"],"n19":["sien","i"],"n20":["do‿a","m"],"n21":["quí","t"],"n22":["San","i"],"n23":["to","t"],"n24":["sa","i"],"n25":["cer","m"],"n26":["do","m"],"n27":["cio","t"],"n28":"real.","n29":["A","i"],"n30":["quí","t"],"n31":["jun","i"],"n32":["tos","t"],"n33":["pa","i"],"n34":["ra‿o","m"],"n35":["rar,","t"],"n36":["Lo‿al","i"],"n37":["to‿y","t"],"n38":"lo","n39":["me","i"],"n40":["jor","t"],"n41":["bus","i"],"n42":["car,","t"],"n43":["Nues","i"],"n44":["tro‿es","m"],"n45":["pí","m"],"n46":["ri","m"],"n47":["tu","t"],"n48":["to","i"],"n49":["car","t"],"n50":"Y","n51":["Tu‿i","i"],"n52":["gle","m"],"n53":["sia‿e","m"],"n54":["di","m"],"n55":["fi","m"],"n56":["car.","t"]},"verses":[{"label":"2.","lines":["Sacerdotes haznos hoy,","Que perciban Tu sentir,","Que‿usen sus espíritus","Para‿así Tu plan cumplir."]},{"label":"3.","lines":["Al Santísimo Lugar","Venimos para tocar","Tu trono de gracia real","Y en lo interior orar."]},{"label":"4.","lines":["Desde el trono fluirán","Ríos de Tu gracia en mí;","Refresca mi espíritu","La ayuda que hallo en Ti."]},{"label":"5.","lines":["Haz que nuestra oración","Fluya de Tu Espíritu;","Que no exprese nuestro yo,","Sino lo que quieras Tú."]},{"label":"6.","lines":["Aunque es mucho nuestro afán","Por todo lo temporal,","Te pedimos, al orar,","Que seamos Tu canal."]},{"label":"7.","lines":["Nuestra petición hoy es","Que agua viva fluya aquí;","Si la gracia Tú nos das,","Tu obra puede proseguir."]}]}