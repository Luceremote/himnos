{"hymn":"S383","parent":"E497","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Gracia, en su mayor definición","subtitle":"Experiencia de Cristo—Como gracia","syl":{"n1":["Gra","i"],"n2":["cia,","t"],"n3":"en","n4":"su","n5":["ma","i"],"n6":["yor","t"],"n7":["de","i"],"n8":["fi","m"],"n9":["ni","m"],"n10":["ción","t"],"n11":"Es","n12":"Dios","n13":"en","n14":["Cris","i"],"n15":["to","t"],"n16":["sien","i"],"n17":["do","t"],"n18":"mi","n19":["por","i"],"n20":["ción;","t"],"n21":"No","n22":["só","i"],"n23":["lo‿es","t"],"n24":["al","i"],"n25":["go","t"],"n26":["he","i"],"n27":["cho‿a","t"],"n28":"mi","n29":["fa","i"],"n30":["vor,","t"],"n31":["Si","i"],"n32":["no","t"],"n33":"Dios","n34":["mis","i"],"n35":["mo","t"],"n36":["co","i"],"n37":["mo","t"],"n38":["ben","i"],"n39":["di","m"],"n40":["ción.","t"]},"verses":[{"label":"2.","lines":["Dios se‿encarnó para que pueda yo,","Hoy recibirle en Su realidad;","Esta es la gracia que viene de Dios,","La cual es Cristo en Su‿humanidad."]},{"label":"3.","lines":["Pablo, el apóstol, no consideró","Más que a Cristo, la gracia de Dios;","Por esta gracia se fortaleció,","Y en la carrera, a todos pasó."]},{"label":"4.","lines":["Basta la gracia, suficiente es,","Cristo en nosotros: fuerza y vigor;","En nuestro espíritu la gracia está","Energizando, obrando el plan de Dios."]},{"label":"5.","lines":["El Cristo vivo esta gracia es,","La necesito experimentar;","Que pueda yo la gracia conocer,","Y en mi vivir, a Cristo realizar."]}]}