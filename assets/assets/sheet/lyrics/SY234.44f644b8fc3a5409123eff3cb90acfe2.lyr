,"n125":"con","n126":"Dios,","n128":["Nues","i"],"n129":["tra‿u","m"],"n130":["ni","m"],"n131":["dad,","t"],"n133":["glo","i"],"n134":["rio","m"],"n135":["so","t"],"n136":"es!","n138":"Por","n139":["siem","i"],"n140":["pre‿¡A","m"],"n141":["mén!","t"],"n142":"Nos","n143":["guí","i"],"n144":["a‿el","t"],"n145":["Cor","i"],"n146":["de","m"],"n147":["ro‿a","m"],"n148":["quí.","t"]},"verses":[{"label":"2.","lines":["Aunque muchos seguidores tuvo Él,","Pocos conocieron Su andar;","Puerta estrecha, camino angosto,","A la vida la senda trazó.","Él se dio aunque le negaron,","Maldecido y despreciado.","¿Cómo no rendir el corazón?","Si Su vida por nosotros dio."]},{"label":"3.","lines":["¡Oh, Señor! Oramos hoy: Presérvanos","Fieles para en Tu camino andar,","Por Tu gracia yendo en pos de Ti,","Al tomar la cruz, seguirte así.","Consagrado sin reserva a Ti,","Absoluto enteramente a Ti.","Solo en nuestro corazón, Señor,","Quepan las calzadas a Sion."]}]}