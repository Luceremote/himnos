{"hymn":"S619","parent":"E800","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Dios nos ha hablado, Dios se reveló","subtitle":"El estudio de la palabra—La función de la palabra","syl":{"n1":"Dios","n2":"nos","n3":"ha","n4":["ha","i"],"n5":["bla","m"],"n6":["do,","t"],"n7":"Dios","n8":"se","n9":["re","i"],"n10":["ve","m"],"n11":["ló;","t"],"n13":"Su","n14":["ca","i"],"n15":["rác","m"],"n16":["ter","t"],"n17":"y","n18":["per","i"],"n19":["so","m"],"n20":["nas","t"],"n21":["ex","i"],"n22":["pre","m"],"n23":["só;","t"],"n25":"Su","n26":["mis","i"],"n27":["te","m"],"n28":["rio","t"],"n29":"a","n30":"los","n31":["hom","i"],"n32":["bres","t"],"n33":"se","n34":["mos","i"],"n35":["tró;","t"],"n37":["Lo‿i","i"],"n38":["lus","m"],"n39":["tró‿a","t"],"n40":["no","i"],"n41":["so","m"],"n42":["tros;","t"],"n43":"lo","n44":["ma","i"],"n45":["ni","m"],"n46":["fes","m"],"n47":["tó.","t"]},"verses":[{"label":"2.","lines":["Dios nos ha hablado desde el corazón:","La preeminencia a Su Hijo dio,","Para que se glorifique el Padre en Él,","Hizo a Cristo el centro de la creación."]},{"label":"3.","lines":["Dios nos ha hablado y nos reveló:","Cristo mismo es Dios y hombre a la vez;","Centro y circunferencia de Su plan,","Es el todo en todos; todo lo une Él."]},{"label":"4.","lines":["Dios nos ha hablado; ¡gran misterio es!","Lo que Él desea es Cristo y Su expresión:","Cristo, la Cabeza, a Su plenitud,","Su iglesia, el Cuerpo, Sus riquezas dio."]},{"label":"5.","lines":["Dios nos ha hablado; del cielo mostró","Que el Dios Triuno al hombre se unirá;","El Padre en el Hijo como Espíritu","Vive en el Cuerpo, cumpliendo Su plan."]},{"label":"6.","lines":["Dios nos ha hablado y nos reveló","Su creación tan vasta y cómo Él se humanó,","Su gran redención y plena salvación;","¡Qué toda la tierra le dé adoración!"]}]}