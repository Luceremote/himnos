{"hymn":"S872","parent":"E1048","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tal como soy, sin más decir","subtitle":"El evangelio—Venir al Señor","syl":{"n2":"Tal","n3":["co","i"],"n4":["mo","t"],"n5":"soy,","n7":"sin","n8":"más","n10":["de","i"],"n11":["cir","t"],"n12":"Que","n13":"en","n15":"Tu","n16":["san","i"],"n17":["gre","t"],"n18":"yo","n19":["cre","i"],"n20":["í,","t"],"n22":"Ya","n23":"que","n24":["me‿in","i"],"n25":["vi","m"],"n27":["tas,","t"],"n28":["ven","i"],"n29":["go‿a","m"],"n30":["sí,","t"],"n32":["Cor","i"],"n33":["de","m"],"n34":["ro","t"],"n35":"de","n37":"Dios,","n38":["ven","i"],"n39":["go‿a","t"],"n40":"Ti."},"verses":[{"label":"2.","lines":["Tal como soy, sin demorar","Para quitarme mi maldad;","Mi ser, Tu sangre limpiará;","Cordero de Dios, vengo a Ti."]},{"label":"3.","lines":["Tal como soy, en confusión,","Conflicto, duda y tentación,","Aunque con luchas y temor,","Cordero de Dios, vengo a Ti."]},{"label":"4.","lines":["Tal como soy, pobre infeliz,","Por mi carencia a Ti acudí;","Salud y gozo halló aquí,","Cordero de Dios, vengo a Ti."]},{"label":"5.","lines":["Tal como soy, me aceptarás,","Dando el perdón, con vida y paz;","Pues Tu promesa yo creí,","Cordero de Dios, vengo a Ti."]},{"label":"6.","lines":["Tal como soy, Tu gran amor","Ya mis barreras derribó;","Soy todo Tuyo, mi Señor,","Cordero de Dios, vengo a Ti."]}]}