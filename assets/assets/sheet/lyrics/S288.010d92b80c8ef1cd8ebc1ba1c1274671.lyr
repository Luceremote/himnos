{"hymn":"S288","parent":"E359","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, Luz de luces, ven","subtitle":"Anhelos—De Cristo","syl":{"n1":"¡Oh,","n2":"Luz","n3":"de","n4":["lu","i"],"n5":["ces,","t"],"n6":"ven!","n7":"Y","n8":["e","i"],"n9":["cha","t"],"n10":"hoy","n11":"de","n12":"mí","n13":["Pe","i"],"n14":["ca","m"],"n15":["do‿y","t"],"n16":["no","i"],"n17":["che","t"],"n18":"vil:","n19":"¡Oh,","n20":"Luz","n21":"de","n22":["lu","i"],"n23":["ces,","t"],"n24":"ven!","n25":"¡Oh,","n26":"Luz","n27":"tan","n28":["re","i"],"n29":["ful","m"],"n30":["gen","m"],"n31":["te,","t"],"n32":["Mo","i"],"n33":["ra‿en","t"],"n34":"mí","n35":"por","n36":["siem","i"],"n37":["pre;","t"],"n38":"¡Oh,","n39":["Go","i"],"n40":["zo","t"],"n41":["ex","i"],"n42":["ce","m"],"n43":["len","m"],"n44":["te,","t"],"n45":"Al","n46":["co","i"],"n47":["ra","m"],"n48":["zón","t"],"n49":"hoy","n50":"ven!"},"verses":[{"label":"2.","lines":["¡Gozo de gozos, ven!","Pon fin a mi pecar,","Trae calma con Tu paz:","¡Gozo de gozos, ven!"]},{"label":"3.","lines":["¡Vida de vidas, ven!","Tu vida‿expulsará","Pecado‿y mortandad:","¡Vida de vidas, ven!"]},{"label":"4.","lines":["¡Amor de‿amores, ven!","Destruye mi maldad","Traeme Tu novedad:","¡Amor de‿amores, ven!"]},{"label":"5.","lines":["¡Cielo de cielos, ven!","Que no‿haya nube‿en mí;","Da‿a la tormenta fin:","¡Cielo de cielos, ven!"]},{"label":"6.","lines":["¡Mi Dios y Cristo, ven!","Gozo‿en suma total,","En mí hoy haz Tu‿hogar:","¡Mi Dios y Cristo, ven!"]}]}