{"hymn":"S324","parent":"E426","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Descúbreme, Señor","subtitle":"Anhelos—De recibir luz","syl":{"n1":["Des","i"],"n2":["cú","m"],"n3":["bre","m"],"n4":["me,","t"],"n5":["Se","i"],"n6":["ñor,","t"],"n7":["A","i"],"n8":["lum","m"],"n9":["bra","t"],"n10":["mi‿in","i"],"n11":["te","m"],"n12":["rior,","t"],"n13":"Que","n14":["pue","i"],"n15":["da","t"],"n16":["dis","i"],"n17":["cer","m"],"n18":["nir","t"],"n19":"El","n20":["e","i"],"n21":["go‿en","m"],"n22":["ga","m"],"n23":["ña","m"],"n24":["dor.","t"],"n25":"Oh,","n26":"que","n27":"Tu","n28":"luz","n29":["vi","i"],"n30":["vien","m"],"n31":["te,","t"],"n32":["Qui","i"],"n33":["te","t"],"n34":"de","n35":"mi","n36":["men","i"],"n37":["te","t"],"n38":"La","n39":["no","i"],"n40":["che","t"],"n41":["ab","i"],"n42":["sor","m"],"n43":["ben","m"],"n44":["te,","t"],"n45":"Te","n46":["pi","i"],"n47":["do‿a","t"],"n48":"Ti,","n49":["Se","i"],"n50":["ñor.","t"]},"verses":[{"label":"2.","lines":["No me conozco bien,","Me creo lo mejor,","Me‿engaña mi‿altivez,","Y vivo en presunción."]},{"label":"3.","lines":["Yo te conozco a Ti,","Aún menos, mi Señor,","Y de Tu realidad","Me falta más visión."]},{"label":"4.","lines":["Tu vida en mi interior,","La torno en confusión","Me creo espiritual","Cuando en la carne estoy."]},{"label":"5.","lines":["En cuanto a Tu sentir,","Me frustro, oh Señor,","Pues tiendo a reclusión","Y caigo en más error."]},{"label":"6.","lines":["Aún Tu voluntad,","No la conozco bien;","Impongo mi pensar","Queriendo pretender."]},{"label":"7.","lines":["Yo necesito hoy","Tu iglesia conocer,","Y por revelación","Tu Cuerpo comprender."]},{"label":"8.","lines":["Sin velos, oh Señor,","Anhelo claro estar,","Que no me engañen más","Mi orgullo y vanidad."]}]}