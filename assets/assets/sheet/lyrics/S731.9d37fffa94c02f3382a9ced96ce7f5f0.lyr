{"hymn":"S731","parent":"E887","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El nombre del Señor Jesús","subtitle":"La guerra espiritual—Con la armadura de Dios","syl":{"n2":"El","n4":["nom","i"],"n5":["bre","t"],"n6":"del","n7":["Se","i"],"n9":["ñor","t"],"n10":["Je","i"],"n11":["sús","t"],"n12":["Nues","i"],"n14":["tra","t"],"n15":["fir","i"],"n16":["me","m"],"n17":["za","t"],"n19":"es;","n20":["Con","i"],"n22":["fia","m"],"n23":["mos","t"],"n24":["só","i"],"n25":["lo‿en","t"],"n27":"Ti,","n28":["Se","i"],"n29":["ñor,","t"],"n30":"No","n32":"en","n33":["nues","i"],"n35":["tro","t"],"n36":["po","i"],"n38":["der.","t"],"n39":"Las","n40":["ar","i"],"n41":["mas","t"],"n42":"no","n44":"de","n46":["car","i"],"n47":["ne","t"],"n48":"son,","n49":"Mas","n51":"del","n52":["Es","i"],"n53":["pí","m"],"n55":["ri","m"],"n57":["tu;","t"],"n58":"Con","n59":["la‿ar","i"],"n60":["ma","m"],"n61":["du","m"],"n62":["ra","t"],"n63":"de","n65":"Dios,","n67":"hoy","n68":"Nos","n69":["ha","i"],"n71":["ces","t"],"n73":["ven","i"],"n74":["cer,","t"],"n75":"Tú."},"verses":[{"label":"2.","lines":["Por esa astucia de Satán,","¡Es un acuerdo estad!","Aunque la lucha cruenta es,","En el Señor pelead.","Si uno se retira, él","Traiciona a los demás.","No falles a los santos, tú,","Ni aumentes su penar."]},{"label":"3.","lines":["El diablo sabe que su fin","Muy pronto ha de llegar;","Trama agotar a muchos hoy,","Y busca desgastar.","Las pruebas más severas son;","La lucha, más atroz;","Y el poder de Satanás","Se vuelve más feroz."]},{"label":"4.","lines":["Oh, ¿qué postura hay que tomar?","¡La hora‿es tan crucial!","¿Deleites y comodidad?","¿Vencidos por Satán?","O el conflicto, al crecer,","¿Nos fortalecerá?","¡De vida o muerte esto es!","¿A quién Dios premiará?"]},{"label":"5.","lines":["Por Cristo firmes hay que estar;","Él es Conquistador.","Hasta el final hay que aguantar","Por Él cualquier dolor.","El triunfo pronto llegará,","Y Cristo volverá;","So hoy sufrimos por Su bien,","Él nos hará reinar."]}]}