{"hymn":"S488","parent":"E1187","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, qué excelente es","subtitle":"Experiencia de Cristo—Como ministro del nuevo pacto","syl":{"n1":"¡Oh,","n2":["qué‿ex","i"],"n3":["ce","m"],"n4":["len","m"],"n5":["te","t"],"n6":"es","n7":"Tu","n8":["mi","i"],"n9":["nis","m"],"n10":["te","m"],"n11":["rio‿hoy!","t"],"n12":"Su","n13":["pac","i"],"n14":["to‿y","t"],"n15":"sus","n16":["pro","i"],"n17":["me","m"],"n18":["sas","t"],"n19":["Su","i"],"n20":["pe","m"],"n21":["ri","m"],"n22":["o","m"],"n23":["res","t"],"n24":"son.","n25":["Se‿es","i"],"n26":["ta","m"],"n27":["ble","m"],"n28":["ció","t"],"n29":["so","i"],"n30":["bre‿u","m"],"n31":["na","t"],"n32":"ley","n33":["Me","i"],"n34":["jor,","t"],"n35":["y‿e","i"],"n36":["res","t"],"n37":"el","n38":["Me","i"],"n39":["dia","m"],"n40":["dor.","t"]},"verses":[{"label":"2.","lines":["Un pacto aun mejor,","¡Promesas sin igual!","La ley de vida","Y una ofrenda eternal.","Es superior la sangre que","Nos consumó la redención."]},{"label":"3.","lines":["La senda a sanidad","En este pacto está:","La vida en lo interior","Que al alma ha de llegar.","La ley de vida inscrita en","La mente, emoción y voluntad."]},{"label":"4.","lines":["Dejad la antigua ley,","La ley de vida hallad;","La antigua muerte trae,","La nueva vida da.","La letra mata, mas la ley","De vida nos puede ayudar."]},{"label":"5.","lines":["La ley de vida hoy","Ya vemos en función,","Sin nuestro trabajar","Opera en lo interior.","Saturará, para moldearnos","Conforme al Hijo de Dios."]},{"label":"6.","lines":["Quitó el pecado Dios,","Y Su vida impartió;","Somos Su pueblo hoy","Y Dios es nuestro Dios.","En lo interior le conocemos:","¡Qué cuádruple bendición!"]},{"label":"7.","lines":["Nos hijifica Dios","Por Su vida interior;","Él nos renueva y hace","La transformación.","Ya hecho está, ¡ahora sólo","Hay que al Hijo alabar!"]}]}