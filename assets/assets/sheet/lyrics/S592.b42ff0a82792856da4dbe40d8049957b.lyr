{"hymn":"S592","parent":"E769","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Vengo al Santísimo","subtitle":"Oración—En el lugar santísimo","syl":{"n1":["Ven","i"],"n2":["go","t"],"n3":"al","n4":["San","i"],"n5":["tí","m"],"n6":["si","m"],"n7":["mo,","t"],"n8":["Pa","i"],"n9":["ra","t"],"n10":"tras","n11":"el","n12":["ve","i"],"n13":["lo‿es","m"],"n14":["tar,","t"],"n16":["Pa","i"],"n17":["ra‿el","t"],"n18":["tro","i"],"n19":["no‿a","m"],"n20":["llí","t"],"n21":["to","i"],"n22":["car","t"],"n24":["Y‿a","i"],"n25":["gua","t"],"n26":["vi","i"],"n27":["va","t"],"n28":["re","i"],"n29":["bo","m"],"n30":["sar.","t"]},"verses":[{"label":"2.","lines":["El Santísimo Lugar","Es mi espíritu interior,","Donde habita mi Señor","Con mi espíritu en unión."]},{"label":"3.","lines":["A mi espíritu entraré,","Aquí encuentro a mi Señor;","Qué maravilloso es!","Mora Él en mi interior."]},{"label":"4.","lines":["Cristo en resurrección","Es fragancia celestial;","En mi espíritu, al orar","Cristo en mí se esparcirá."]},{"label":"5.","lines":["Al tocar mi espíritu","Sus riquezas me dará;","Vida, gracia, luz, y amor","Como un manantial saldrán."]},{"label":"6.","lines":["Si le toco en mi interior","Lo podré experimentar,","Por la ley de vida en mí","Y Su dulce unción probar."]},{"label":"7.","lines":["Yo quisiera disfrutar","En mi espíritu interior,","Del maná escondido allí","Con mi amado Salvador."]},{"label":"8.","lines":["Cuando se haga real en mí","La vida en resurrección,","Aceptado yo seré","Como la vara de Aarón."]},{"label":"9.","lines":["Hallo el vivo manantial","De Tu rica gracia aquí;","Fluye como un gran caudal","Esta gracia para mí."]},{"label":"10.","lines":["Al reunirnos para orar","Cada espíritu estará","Liberado para Tu","Servicio sacerdotal."]},{"label":"11.","lines":["El Santísimo Lugar","Es donde se toca a Dios;","Gracia plena emana allí","Desde el trono del Señor."]}]}