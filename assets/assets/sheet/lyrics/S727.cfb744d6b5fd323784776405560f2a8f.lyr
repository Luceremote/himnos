{"hymn":"S727","parent":"E881","quality":"adapted","adjust":{"hold":1,"merge":1},"title":"Escudo y Defensor, nuestro Reposo","subtitle":"La guerra espiritual—En fe","syl":{"n2":["Es","i"],"n3":["cu","m"],"n4":["do‿y","t"],"n5":["De","i"],"n6":["fen","m"],"n7":["sor,","t"],"n8":["nues","i"],"n9":["tro","t"],"n10":["Re","i"],"n11":["po","m"],"n12":["so;","t"],"n14":"No","n15":["va","i"],"n16":["mos","t"],"n17":["so","i"],"n18":["los","t"],"n19":["con","i"],"n20":["tra","t"],"n21":["Sa","i"],"n22":["ta","m"],"n23":["nás;","t"],"n25":"Nos","n26":"das","n27":"Tu","n28":["fuer","i"],"n29":["za‿y","t"],"n30":"Tu","n31":["tier","i"],"n32":["no","t"],"n33":["cui","i"],"n34":["da","m"],"n35":["do,","t"],"n37":"Y","n38":"en","n39":"Tu","n40":["nom","i"],"n41":["bre","t"],"n42":["he","i"],"n43":["mos","t"],"n44":["de‿a","i"],"n45":["van","m"],"n46":["zar.","t"],"n48":"Nos","n49":"das","n50":["Tu‿fuer","i"],"n51":["za‿y","t"],"n52":"Tu","n53":["tier","i"],"n54":["no","t"],"n55":["cu","i"],"n56":["i","m"],"n57":["da","m"],"n58":["do,","t"],"n60":"Y","n61":"en","n62":["Tu",null,"u"],"n63":0,"n64":["nom","i"],"n65":["bre‿he","m"],"n66":["mos","t"],"n67":["de‿a","i"],"n68":["van","m"],"n69":["zar.","t"]},"verses":[{"label":"2.","lines":["Sí, Capitan de Salvación, Tu nombre,","Que sobre todo otro nombre es;","//Nuestra Justicia, nuestro Fundamento,","Señor de gloria y nuestro Rey de amor.//"]},{"label":"3.","lines":["No somos fuertes, mas por fe andamos;","Tu gracia conocemos más y más;","//Del corazón brota canción triunfante,","Y en Tu nombre hemos de avanzar.//"]},{"label":"4.","lines":["Escudo y Defensor, nuestro Reposo,","Es Tuya la batalla y el loor;","//Has de reinar en esplendor triunfante;","Victoria y Reposo nos serás.//"]}]}