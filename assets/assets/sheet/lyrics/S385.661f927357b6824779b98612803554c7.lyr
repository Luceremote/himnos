{"hymn":"S385","parent":"E499","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, qué vivir! ¡Oh, qué solaz","subtitle":"Experiencia de Cristo—Como vida","syl":{"n1":"¡Oh,","n2":"qué","n3":["vi","i"],"n4":["vir!","t"],"n5":"¡Oh,","n7":"qué","n8":["so","i"],"n10":["laz!","t"],"n11":"Pues","n13":["Cris","i"],"n15":["to","t"],"n16":["vi","i"],"n17":["ve","t"],"n19":"hoy","n20":"en","n21":"mí.","n22":"Yo","n23":"en","n24":"la","n25":"cruz","n26":"con","n28":"Él","n29":["es","i"],"n30":["toy,","t"],"n31":"Tal","n32":["he","i"],"n34":["cho‿en","t"],"n35":"El","n37":"yo","n38":["re","i"],"n39":["ci","m"],"n40":["bí.","t"],"n41":["A","i"],"n42":["ho","m"],"n43":["ra","t"],"n44":"ya","n45":"no","n47":["vi","i"],"n49":["vo","t"],"n51":"yo,","n54":"Mas","n56":"el","n58":["Se","i"],"n60":["ñor","t"],"n62":"hoy","n63":["vi","i"],"n66":["ve‿en","t"],"n67":"mí.","n68":["A","i"],"n69":["ho","m"],"n70":["ra","t"],"n71":"ya","n72":"no","n73":["vi","i"],"n74":["vo","t"],"n75":"yo,","n76":"Mas","n77":"el","n78":["Se","i"],"n79":["ñor","t"],"n80":"hoy","n82":["vi","i"],"n83":["ve‿en","t"],"n84":"mí."},"verses":[{"label":"2.","lines":["¡Oh, qué confiar! ¡Oh, qué gozar!","Se está formando Cristo en mí.","Su vida divinal está","Forjándose ahora en mí.","//Lo que soy yo se terminó,","Y Cristo es todo para mí.//"]},{"label":"3.","lines":["¡Oh, qué gloriar! ¡Oh qué pensar!","Se hace magno Cristo en mí.","Avergonzado no seré,","Pues yo lo aplico en mi vivir.","//En vida o muerte, bien o mal,","A Cristo tengo que expresar.//"]},{"label":"4.","lines":["¡Oh, qué premiar! ¡Oh, qué ganar!","Mi meta sólo en Cristo está.","Ningún tesoro deseo yo,","Mas Cristo en Su totalidad.","//Mi Cristo es mi galardón,","Mi gloria y premio sin igual.//"]}]}