{"hymn":"S601","parent":"E779","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Ora siempre en un acuerdo","subtitle":"Oración—En unanimidad","syl":{"n1":["O","i"],"n2":["ra","t"],"n3":["siem","i"],"n4":["pre‿en","t"],"n5":"un","n6":["a","i"],"n7":["cuer","m"],"n8":["do:","t"],"n9":"Con","n10":["la‿un","i"],"n11":["ción","t"],"n12":"y‿en","n13":["u","i"],"n14":["ni","m"],"n15":["dad.","t"],"n16":"Que‿el","n17":["es","i"],"n18":["pí","m"],"n19":["ri","m"],"n20":["tu","t"],"n21":"te","n22":["guí","i"],"n23":["e,","t"],"n24":"No","n25":"el","n26":["na","i"],"n27":["tu","m"],"n28":["ral","t"],"n29":["pen","i"],"n30":["sar.","t"],"n31":["O","i"],"n32":["ra","t"],"n33":["siem","i"],"n34":["pre‿en","t"],"n35":"un","n36":["a","i"],"n37":["cuer","m"],"n38":["do:","t"],"n39":"Con","n40":["la‿un","i"],"n41":["ción","t"],"n42":"y‿en","n43":["u","i"],"n44":["ni","m"],"n45":["dad.","t"],"n46":"Que‿el","n47":["es","i"],"n48":["pí","m"],"n49":["ri","m"],"n50":["tu","t"],"n51":"te","n52":["guí","i"],"n53":["e,","t"],"n54":"No","n55":"el","n56":["na","i"],"n57":["tu","m"],"n58":["ral","t"],"n59":["pen","i"],"n60":["sar.","t"]},"verses":[{"label":"2.","lines":["Ora siempre en un acuerdo,","Por la cruz, rechaza el yo,","Al Espíritu tomando","Todo bajo Su control."]},{"label":"3.","lines":["Ora siempre en un acuerdo,","Es la esfera celestial;","Pisoteando principados,","Huye de lo terrenal."]},{"label":"4.","lines":["Ora siempre en un acuerdo,","Hazlo en cordinación;","Sigue del Señor la guía","De Su mente y dirección."]},{"label":"5.","lines":["Ora siempre en un acuerdo,","Vela con tenacidad,","Por Su reino y por Su gloria","Ora y vela en unidad."]},{"label":"6.","lines":["Ora siempre en un acuerdo,","Busca a Dios en unidad,","Y el Espíritu del Cuerpo","Su armonía mantendrá."]}]}