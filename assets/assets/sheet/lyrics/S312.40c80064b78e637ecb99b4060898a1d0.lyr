{"hymn":"S312","parent":"E398","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Ser como Tú! Oh, Redentor mío","subtitle":"Anhelos—De ser semejantes a Cristo","syl":{"n1":"¡Ser","n2":["co","i"],"n3":["mo","t"],"n4":"Tú!","n5":"Oh,","n6":["Re","i"],"n7":["den","m"],"n8":["tor","t"],"n9":["mí","i"],"n10":["o,","t"],"n11":"Es","n12":["mi‿o","i"],"n13":["ra","m"],"n14":["ción","t"],"n15":"y","n16":["fir","i"],"n17":["me","t"],"n18":["sen","i"],"n19":["tir;","t"],"n20":["Fe","i"],"n21":["liz","t"],"n22":["re","i"],"n23":["nun","m"],"n24":["cio‿a","t"],"n25":["to","i"],"n26":["do","t"],"n27":["te","i"],"n28":["so","m"],"n29":["ro,","t"],"n30":"Ser","n31":["co","i"],"n32":["mo","t"],"n33":["Cris","i"],"n34":["to","t"],"n35":"es","n36":"mi","n37":["ge","i"],"n38":["mir.","t"],"n39":"¡Ser","n40":["co","i"],"n41":["mo","t"],"n42":"Tú!","n43":"¡Oh,","n44":"ser","n45":["co","i"],"n46":["mo","t"],"n47":["e","i"],"n48":["res!","t"],"n49":["Pu","i"],"n50":["ro","t"],"n51":"y","n52":"fiel,","n53":"mi","n54":"buen","n55":["Re","i"],"n56":["den","m"],"n57":["tor;","t"],"n58":"Ven","n59":"con","n60":["dul","i"],"n61":["zu","m"],"n62":["ra","t"],"n63":"y‿en","n64":["Tu‿a","i"],"n65":["bun","m"],"n66":["dan","m"],"n67":["cia;","t"],"n68":["Tu‿i","i"],"n69":["ma","m"],"n70":["gen","t"],"n71":["gra","i"],"n72":["ba‿en","t"],"n73":"mi","n74":["co","i"],"n75":["ra","m"],"n76":["zón.","t"]},"verses":[{"label":"2.","lines":["¡Ser como Tú! El más compasivo,","Tierno, amoroso, perdonador,","Cuidando al débil, alzando al triste,","Buscando al pobre vil pecador."]},{"label":"3.","lines":["¡Ser como Tú! Muy manso y valiente,","Crueles reproches pueda aguantar;","Pobre en espíritu, padeciendo,","Para que a otros pueda salvar."]},{"label":"4.","lines":["¡Ser como Tú! Por eso yo vengo","A recibir la santa unción;","Lo que yo soy ahora te traigo;","Lo que yo tengo‿es Tuyo, Señor."]},{"label":"5.","lines":["¡Ser como Tú! Y mientras te imploro,","Manda Tu Espíritu con amor.","Hazme un templo, digna morada,","Para que gane Tu aprobación."]}]}