{"hymn":"S818","parent":"E971","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Dios se ha propuesto","subtitle":"La máxima manifestación—El propósito eterno de Dios","syl":{"n1":"Dios","n2":"se","n3":"ha","n4":["pro","i"],"n5":["pues","m"],"n6":["to","t"],"n8":"En","n9":["la‿e","i"],"n10":["ter","m"],"n11":["ni","m"],"n12":["dad","t"],"n14":["U","i"],"n15":["nir","m"],"n16":["se","t"],"n17":"al","n18":["hom","i"],"n19":["bre,","t"],"n21":"Al","n22":"Su","n23":["vi","i"],"n24":["da","t"],"n25":"dar;","n27":"Al","n28":["re","i"],"n29":["ge","m"],"n30":["ne","m"],"n31":["rar","m"],"n32":["lo","t"],"n33":"Y","n34":["lle","i"],"n35":["nar","t"],"n37":"Su","n39":"ser,","n41":"Dios","n42":"en","n43":"él","n44":["se‿ex","i"],"n45":["pre","m"],"n47":["sa,","t"],"n49":["Sien","i"],"n50":["do‿u","m"],"n51":["no","t"],"n52":"con","n53":"él."},"verses":[{"label":"2.","lines":["A Su propia imagen","Hizo al hombre Dios,","Para que cumpliera","El plan que Él trazó;","Le ofreció el árbol","De la vida a él,","Para convertirlo","En Su esposa fiel."]},{"label":"3.","lines":["Su fluir de vida","Lo transformará;","A Su misma imagen","Lo conformará;","Como complemento","Lo edificará;","Será Su morada","Lo satisfará."]},{"label":"4.","lines":["Todos los llamados","Mezclados con Dios","Son la Ciudad Santa,","Y Su habitación.","Él, Su contenido,","Ellos Su expresión,","Llenos de Su gloria","En perfecta unión."]},{"label":"5.","lines":["Dios allí es el centro,","En el tronó está;","Su vida los guarda","En grata unidad.","Por Su luz de gloria","Andan en la luz","Gozando armonía,","Divinal salud."]},{"label":"6.","lines":["El es su agua viva","Y su provisión;","Su hambre y sed apaga,","¡Qué satisfacción!","Dios mismo es Su templo,","Siempre en Él están;","Frente a Su presencia","Lo adorarán."]}]}