{"hymn":"S783","parent":"E1298","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En el pasado eterno, Dios","subtitle":"El reino—Recompensa y castigo","syl":{"n1":"En","n2":"el","n3":["pa","i"],"n4":["sa","m"],"n5":["do‿e","m"],"n6":["ter","m"],"n8":["no,","t"],"n9":"Dios","n10":"Nos","n11":["es","i"],"n12":["co","m"],"n13":["gió‿y","t"],"n14":"no","n15":["cam","i"],"n18":["bia","m"],"n19":["rá;","t"],"n20":"La","n21":["sal","i"],"n22":["va","m"],"n23":["ción","t"],"n25":["se","i"],"n26":["gu","m"],"n27":["ra‿es","m"],"n28":["tá,","t"],"n30":["Sa","i"],"n31":["be","m"],"n32":["mos","t"],"n33":["es","i"],"n35":["to","t"],"n36":"en","n38":["ver","i"],"n39":["dad.","t"]},"verses":[{"label":"2.","lines":["\"Ellos jamás perecerán,","La vida eterna Yo les doy;","Nadie los puede arrebatar,","De Nuestras manos\", dice Dios."]},{"label":"3.","lines":["A todos los hijos de Dios,","Una advertencia da el Señor:","\"Si preparados no están,","Castigo habrá, no galardón\"."]},{"label":"4.","lines":["La recompensa no será","La vida eterna que Él nos dio;","Hay que correr y edificar","Para alcanzar el galardón."]},{"label":"5.","lines":["Por Dios y el reino, ¡proseguid!","Cual Moisés, somos del Señor;","Sufrimos con Su pueblo aquí,","Mas vemos ese galardón."]},{"label":"6.","lines":["Su vituperio vale más","Que todo lo que Egipto da;","La tierra egipcia abandonad","Y disciplina evitad."]},{"label":"7.","lines":["¡La era del reino anhelad!","¡Vida del alma abandonad!","Así la hemos de salvar","Para en el reino disfrutar."]},{"label":"8.","lines":["Pagad el precio para que","Cristo se forje en nuestro ser;","Nuestra alma Cristo ganará,","¡Sí, ésta nuestra meta es!"]}]}