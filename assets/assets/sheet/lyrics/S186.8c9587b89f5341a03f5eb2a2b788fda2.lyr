{"hymn":"S186","parent":"E1112","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Qué gloriosa es Tu mesa, Señor","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n1":"¡Qué","n2":["glo","i"],"n3":["rio","m"],"n4":["sa‿es","t"],"n5":"Tu","n6":["me","i"],"n7":["sa,","t"],"n8":["Se","i"],"n9":["ñor!","t"],"n11":"Es","n12":"la","n13":["me","i"],"n14":["sa","t"],"n15":"de","n16":"Tu","n17":["ca","i"],"n18":["sa,","t"],"n20":"De","n21":["Tu‿ho","i"],"n22":["gar,","t"],"n23":"Tu","n24":"real","n25":["mo","i"],"n26":["ra","m"],"n27":["da,","t"],"n29":"¡Qué","n30":["glo","i"],"n31":["rio","m"],"n32":["sa‿es","t"],"n33":"Tu","n34":["me","i"],"n35":["sa,","t"],"n36":["Se","i"],"n37":["ñor!","t"],"n38":["¡A","i"],"n39":["le","m"],"n40":["lu","m"],"n42":["ya,","t"],"n43":["a","i"],"n44":["le","m"],"n45":["lu","m"],"n46":["ya!","t"],"n47":["¡A","i"],"n48":["le","m"],"n49":["lu","m"],"n50":["ya,","t"],"n51":"qué","n53":["fes","i"],"n55":["tín!","t"],"n56":["¡A","i"],"n57":["le","m"],"n58":["lu","m"],"n60":["ya,","t"],"n61":["a","i"],"n62":["le","m"],"n63":["lu","m"],"n64":["ya!","t"],"n65":"¡Qué","n66":["glo","i"],"n67":["rio","m"],"n68":["sa‿es","t"],"n69":"Tu","n70":["me","i"],"n71":["sa,","t"],"n72":["Se","i"],"n73":["ñor!","t"]},"verses":[{"label":"2.","lines":["¡Disfrutable es Tu mesa, Señor!","Donde comunión tenemos;","¡Aleluya, la encontramos!","¡Disfrutable es Tu mesa, Señor!"]},{"label":"3.","lines":["¡Qué preciosa es Tu mesa, Señor!","Vino y pan Tu muerte anuncian,","Mi alma á todo aquí renuncia,","Mientras como en Tu mesa, Señor."]},{"label":"4.","lines":["¡Insondable es Tu mesa, Señor!","En el pan todos nos vemos,","Tu expresión de amor tenemos;","¡Insondable es Tu mesa, Señor!"]},{"label":"5.","lines":["¡Refrescante es Tu mesa, Señor!","Totalmente satisface,","Diariamente nos complace,","¡Refrescante es Tu mesa, Señor!"]},{"label":"6.","lines":["¡Qué animante es Tu mesa, Señor!","Me recuerda Tu venida,","Esperanza de mis días;","¡Qué animante es Tu mesa, Señor!"]}]}