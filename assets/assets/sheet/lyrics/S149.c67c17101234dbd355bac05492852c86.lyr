{"hymn":"S149","parent":"E190","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Señor, considerándote","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n4":["con","i"],"n5":["si","m"],"n6":["de","m"],"n7":["rán","m"],"n8":["do","m"],"n9":["te,","t"],"n10":"Por","n11":["to","i"],"n12":["do","t"],"n13":"lo","n14":"que","n15":["e","i"],"n16":["res","t"],"n17":"Tú,","n19":["Te‿a","i"],"n20":["do","m"],"n21":["ra","m"],"n22":["mos,","t"],"n24":["te‿ad","i"],"n25":["mi","m"],"n26":["ra","m"],"n27":["mos,","t"],"n30":"Por","n31":"Tus","n32":["ri","i"],"n33":["que","m"],"n34":["zas","t"],"n35":"y","n36":["vir","i"],"n37":["tud.","t"],"n38":"¡Lo","n39":["que‿e","i"],"n40":["res","t"],"n41":["lle","i"],"n42":["na","t"],"n43":["mi‿es","i"],"n44":["ca","m"],"n45":["sez!","t"],"n47":["¡Re","i"],"n48":["bo","m"],"n49":["so","t"],"n50":["de‿a","i"],"n51":["la","m"],"n52":["ban","m"],"n53":["za‿a","t"],"n54":"Ti!","n55":["Ex","i"],"n56":["ce","m"],"n57":["des","t"],"n58":["to","i"],"n59":["dos","t"],"n60":"mis","n61":["an","i"],"n62":["he‿los,","t"],"n65":"Me","n66":["sa","i"],"n67":["tis","m"],"n68":["fa","m"],"n69":["ces","t"],"n70":["siem","i"],"n71":["pre‿a","t"],"n72":"mí."},"verses":[{"label":"2.","lines":["Tú eres Dios mismo‿en verdad,","El Dios que‿es nuestra luz y amor;","El Dios que siempre‿es nuestra vida,","El Dios que disfrutamos hoy."]},{"label":"3.","lines":["Hombre genuino eres también,","Un hombre tan puro y cabal;","Un hombre‿en quien Dios se complace,","Y nuestro amor puede ganar."]},{"label":"4.","lines":["Humilde‿esclavo para Dios,","Tú nos viniste a servir;","Hasta la muerte obediente,","La libertad nos diste así."]},{"label":"5.","lines":["Tú eres además un Rey,","Que reina‿en vida y‿en amor;","Con Su poder Dios te ha‿ungido,","Para de todos ser Señor."]},{"label":"6.","lines":["Señor, al recordarte a Ti,","Te disfrutamos en amor;","Y lo que eres compartimos","Como Tu complemento hoy."]}]}