{"hymn":"S768","parent":"E934","quality":"check","adjust":{"hold":0,"merge":0},"title":"No sé explicar por qué Él amó al hombre","subtitle":"Predicar el evangelio—Miríadas ganadas","syl":{"n3":"No","n4":["sé‿ex","i"],"n5":["pli","m"],"n6":["car","t"],"n7":"por","n8":"qué‿Él","n9":["a","i"],"n10":["mó","t"],"n11":"al","n12":["hom","i"],"n14":["bre;","t"],"n15":"Él,","n16":"quien","n17":"por","n18":["án","i"],"n19":["ge","m"],"n20":["les","t"],"n21":["lo","i"],"n22":["a","m"],"n23":["do","t"],"n24":"fue;","n26":"Ni","n27":["có","i"],"n28":["mo,","t"],"n29":"cual","n30":["Pas","i"],"n31":["tor,","t"],"n32":["bus","i"],"n33":["có‿al","t"],"n34":["per","i"],"n35":["di","m"],"n37":["do","t"],"n38":["Pa","i"],"n39":["ra","t"],"n40":["tra","i"],"n41":["er","m"],"n42":["lo","t"],"n43":"de","n44":["re","i"],"n45":["gre","m"],"n46":["so‿a","t"],"n47":"Él.","n49":"Mas","n50":["es","i"],"n51":["to","t"],"n52":["se","i"],"n53":["é,","t"],"n54":"que","n55":["na","i"],"n56":["ció","t"],"n57":"de","n58":["Ma","i"],"n60":["ria","t"],"n61":"En","n62":"un","n63":["pe","i"],"n64":["se","m"],"n65":["bre","t"],"n66":["po","i"],"n67":["bre","t"],"n68":"en","n69":["Be","i"],"n70":["lén;","t"],"n72":"Que‿en","n73":["na","i"],"n74":["za","m"],"n75":["ret","t"],"n76":["vi","i"],"n77":["ví","m"],"n78":["a","t"],"n79":"y","n80":["o","i"],"n81":["bra","m"],"n83":["ba;","t"],"n84":"De","n85":["es","i"],"n86":["ta","t"],"n87":["for","i"],"n88":["ma","t"],"n89":["lle","i"],"n90":["gó‿al","t"],"n91":["mun","i"],"n92":["do‿el","t"],"n93":["Sal","i"],"n94":["va","m"],"n95":["dor.","t"]},"verses":[{"label":"2.","lines":["No se‿explicar cómo Él sufrió en silencio,","Mientras Su paz y gracia al mundo dio;","Su corazón fue en la cruz quebrado,","Corona de dolor siempre llevó.","Mas esto sé, que Él sana al quebrantado,","Quita el pecado, calma el temor,","Lleva las cargas de quien va cansado,","Ya que al mundo llegó nuestro Salvador."]},{"label":"3.","lines":["No sé explicar que todas las naciones,","Toda la tierra, Él herederá;","Que la necesidad de todo sabio","Y todo pecador Él saciará.","Mas esto sé: todos verán Su gloria,","Y‿Él segará aquello que sembró;","Con esplendor Su sol saldrá un día","Cuando conozcan todos nuestro Salvador."]},{"label":"4.","lines":["No sé explicar cómo han de adorarlo","Cuando Él calme toda tempestad,","O que habrá un júbilo tan grande","Pues Su amor a todos llenará.","Mas esto sé, que‿Él llenará los cielos,","Miríadas entonarán canción;","En tierra y cielo habrá una respuesta:","Por fin ya reina nuestro Rey y Salvador."]}]}