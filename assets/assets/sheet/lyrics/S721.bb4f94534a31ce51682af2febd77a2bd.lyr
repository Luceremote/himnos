{"hymn":"S721","parent":"E872","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Buena batalla hay que pelear","subtitle":"La guerra espiritual—Seguir combatiendo","syl":{"n1":["Bue","i"],"n2":["na","t"],"n3":["ba","i"],"n4":["ta","m"],"n5":["lla‿hay","t"],"n6":"que","n7":["pe","i"],"n8":["lear,","t"],"n9":["Cris","i"],"n10":["to‿es","t"],"n11":"tu","n12":["fuer","i"],"n13":["za","t"],"n14":"sin","n15":["i","i"],"n16":["gual;","t"],"n17":"La","n18":["vi","i"],"n19":["da‿a","m"],"n20":["sid,","t"],"n21":["y‿a","i"],"n22":["sí","t"],"n23":["se","i"],"n24":["rá","t"],"n25":["Go","i"],"n26":["zo‿y","t"],"n27":["co","i"],"n28":["ro","m"],"n29":["na","t"],"n30":["e","i"],"n31":["ter","m"],"n32":["nal.","t"]},"verses":[{"label":"2.","lines":["Esta carrera corre ya,","Fijos los ojos en Su faz;","Cristo la vida y senda es,","Cristo, el premio a obtener."]},{"label":"3.","lines":["Toda preocupación dejad,","Misericordia Cristo da;","Confía en Él y gustarás","Vida y amor que‿es sin igual."]},{"label":"4.","lines":["No desfallezcas, cerca está,","Él nunca cambiará jamás;","Tú solo cree y verás","Tu todo‿en todo Él será."]}]}