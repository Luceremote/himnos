{"hymn":"S616","parent":"E797","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Aviva Tu obra, oh Dios","subtitle":"Oración—Para ser avivados","syl":{"n1":["¡A","i"],"n3":["vi","m"],"n4":["va","t"],"n6":["Tu‿o","i"],"n7":["bra,‿oh","t"],"n8":"Dios!","n9":["¡Que","i"],"n10":["re","m"],"n11":["mos","t"],"n12":["ver","i"],"n13":["te","t"],"n14":"hoy!","n15":"¡Oh,","n17":["ha","i"],"n18":["bla‿a","t"],"n20":["to","i"],"n21":["dos","t"],"n23":"con","n24":["po","i"],"n26":["der!","t"],"n27":"¡Que","n28":["se‿oi","i"],"n29":["ga‿a","m"],"n30":["quí","t"],"n31":"Tu","n32":"voz!","n33":["¡A","i"],"n35":["vi","m"],"n36":["va","t"],"n37":["Tu‿o","i"],"n38":["bra,‿oh","t"],"n39":"Dios!","n41":["Pos","i"],"n42":["tra","m"],"n43":["mos","t"],"n44":["nues","i"],"n45":["tro","t"],"n46":"ser;","n47":["¡Des","i"],"n49":["cien","m"],"n50":["de","t"],"n52":"en","n54":["gra","i"],"n55":["cia,‿oh","t"],"n56":["Se","i"],"n58":["ñor!","t"],"n59":["¡Ben","i"],"n60":["dí","m"],"n61":["ce","m"],"n62":["nos;","t"],"n63":"hoy","n64":"ven!"},"verses":[{"label":"2.","lines":["¡Avíva Tu obra, oh Dios!","¡Inspíranos, Señor!","Con fuego del Pentecostés,","Enciende el corazón."]},{"label":"3.","lines":["¡Avíva Tu obra, oh Dios!","¡Tu nombre exalta hoy!","Que arda en cada corazón","La llama de tu amor."]},{"label":"4.","lines":["¡Avíva Tu obra, oh Dios!","¡Bendíganos Tu hablar!","Se oiga Tu santa verdad","En fe viviente y real."]},{"label":"5.","lines":["¡Avíva Tu obra, oh Dios!","Y danos gran valor","Para poder hoy convencer","Al pecador, Señor."]},{"label":"6.","lines":["¡Avíva Tu obra, oh Dios,","Como en Pentecostés!","¡Nos basta, Dios, Tu bendición!","¡La gloria Tuya es!"]}]}