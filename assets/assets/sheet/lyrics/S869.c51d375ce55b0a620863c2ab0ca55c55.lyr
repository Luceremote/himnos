{"hymn":"S869","parent":"E1045","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"¡Oh, no rechaces la verdad","subtitle":"El evangelio—Persuasión","syl":{"n1":"¡Oh,","n3":"no","n4":["re","i"],"n5":["cha","m"],"n6":["ces","t"],"n7":"la","n8":["ver","i"],"n9":["dad!","t"],"n10":"Tus","n11":["o","i"],"n12":["jos","t"],"n13":"hoy","n14":["a","i"],"n15":["bre‿a","t"],"n16":"la","n17":"luz;","n18":["A","i"],"n19":["blan","m"],"n20":["da","t"],"n21":"ya","n22":"tu","n23":["co","i"],"n24":["ra","m"],"n25":["zón","t"],"n26":"Y","n27":"ven","n28":"a","n29":["Je","i"],"n30":["sús.","t"],"n31":"¡Oh,","n33":"ven","n34":"sin","n35":["tar","i"],"n36":["dar!","t"],"n37":"¡Oh,","n38":"ven","n39":"sin","n40":["tar","i"],"n41":["dar!","t"],"n42":["A‿cep","i"],"n43":["ta‿a","t"],"n44":["Je","i"],"n46":["sús,","t"],"n47":"Y","n48":["sal","i"],"n49":["vo","t"],"n51":["se","i"],"n52":["rás.","t"]},"verses":[{"label":"2.","lines":["Sé sabio, el tiempo ahora es;","Tal vez mañana no vendrá;","Hoy es el día de salvación,","¡Oh, ven a Jesús!"]},{"label":"3.","lines":["Jesús te tiene compasión;","¿Con qué le pagarás Su amor?","Renuncia a toda terquedad,","Y salvo serás."]},{"label":"4.","lines":["Jesús recibe al pecador","Que abra a Él su corazón;","Confía en Él, por ti murió,","¡Oh, ven a Jesús!"]}]}