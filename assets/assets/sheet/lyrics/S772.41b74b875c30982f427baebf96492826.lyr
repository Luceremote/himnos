{"hymn":"S772","parent":"E937","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Por el bautismo, uno soy","subtitle":"El bautismo—Sepultado y resucitado","syl":{"n1":"Por","n2":"el","n3":["bau","i"],"n4":["tis","m"],"n5":["mo,","t"],"n6":["u","i"],"n7":["no","t"],"n8":"soy","n9":["Con","i"],"n10":["ti","m"],"n11":["go,","t"],"n12":"mi","n13":["Se","i"],"n14":["ñor;","t"],"n16":"Oh,","n17":"por","n18":"Tu","n19":["gra","i"],"n20":["cia‿y","t"],"n21":"Tu","n22":["pie","i"],"n23":["dad,","t"],"n24":["Re","i"],"n25":["ve","m"],"n26":["la","t"],"n27":"su","n28":["va","i"],"n29":["lor.","t"]},"verses":[{"label":"2.","lines":["En muerte y sepultura, yo","Contigo uno soy;","Así al pecado muerto estoy.","¡Qué gran liberación!"]},{"label":"3.","lines":["En muerte y sepultura, yo","Contigo uno soy;","Así soy libre de Satán,","Y al mundo digo: \"Adios\"."]},{"label":"4.","lines":["Contigo Dios nos levantó,","De muerte nos libró;","El fruto de la santidad","Tu vida nos legó."]},{"label":"5.","lines":["Me bauticé en Tu nombre yo,","Y mío ya no soy;","Uno contigo vivo aquí,","Tus pasos sigo hoy."]}]}