{"hymn":"S16","parent":"E20","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Dios y Padre, te adoramos","subtitle":"Adoración al Padre—Su justicia","syl":{"n1":"Dios","n2":"y","n3":["Pa","i"],"n4":["dre,","t"],"n5":["te‿a","i"],"n6":["do","m"],"n7":["ra","m"],"n9":["mos","t"],"n10":"Por","n11":["jus","i"],"n12":["ti","m"],"n13":["cia","t"],"n14":["y‿e","i"],"n15":["qui","m"],"n17":["dad;","t"],"n18":"Nos","n19":["jus","i"],"n20":["ti","m"],"n21":["fi","m"],"n22":["cas","m"],"n23":["te‿en","t"],"n24":["Cris","i"],"n26":["to,","t"],"n27":["Con","i"],"n28":["de","m"],"n29":["nar","m"],"n30":["nos,","t"],"n31":"quién","n32":["po","i"],"n34":["drá?","t"],"n35":["Tú‿e","i"],"n36":["res","t"],"n37":["fi","i"],"n39":["de","m"],"n40":["dig","m"],"n41":["no‿Y","t"],"n42":["jus","i"],"n44":["to,","t"],"n45":"Tu","n46":["jus","i"],"n47":["ti","m"],"n48":["cia‿es","t"],"n49":["nues","i"],"n50":["tro","t"],"n51":"bien;","n52":"No","n53":["e","i"],"n54":["xis","m"],"n55":["te‿en","t"],"n56":"Ti","n57":["lo‿in","i"],"n58":["jus","m"],"n60":["to,","t"],"n61":["Só","i"],"n62":["lo","t"],"n64":"Tu","n66":["jus","i"],"n68":["ti","m"],"n69":["cia","t"],"n71":"fiel."},"verses":[{"label":"2.","lines":["Todas nuestras transgreSiónes","Tú pusiste en Jesús;","El cumplió con Tu justicia","Al llevarlas en la cruz.","Recibiste pleno pago","Con satisfacción total;","No podrías, Dios tan justo,","Exigirnos algo más!"]},{"label":"3.","lines":["Como nuestro substituto","Aceptaste a Jesús;","Fue juzgado siendo justo,","Cambiarías de actitud?","Como prueba de justicia","A Tu diestra se sentó;","Pues Tus requisitos justos,","Por completo El cumplió."]},{"label":"4.","lines":["Padre nuestro, por Su sangre","Jesucristo nos legó","La justicia inmutable","Para nuestra protección.","Nos hiciste Tu justicia,","Zarandearnos, quién podrá?","En Jerusalén, la nueva,","Testimonio fiel será."]}]}