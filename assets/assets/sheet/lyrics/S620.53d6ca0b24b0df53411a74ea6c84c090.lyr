{"hymn":"S620","parent":"E801","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tú, la Palabra viviente Dios","subtitle":"El estudio de la palabra—La función de la palabra","syl":{"n1":"Tú,","n2":"la","n3":["Pa","i"],"n4":["la","m"],"n5":["bra","t"],"n6":["vi","i"],"n7":["vien","m"],"n8":["te","t"],"n9":["Di","i"],"n10":["os,","t"],"n11":"En","n12":"la","n13":["Pa","i"],"n14":["la","m"],"n15":["bra‿es","m"],"n16":["cri","m"],"n17":["ta‿o","m"],"n18":["í","t"],"n19":"Tu","n20":"voz;","n21":"En","n22":"Ti","n23":["en","i"],"n24":["cuen","m"],"n25":["tro‿a","t"],"n26":"Dios","n27":"en","n28":["ple","i"],"n29":["ni","m"],"n30":["tud","t"],"n31":"Y‿en","n32":["la‿Es","i"],"n33":["cri","m"],"n34":["tu","m"],"n35":["ra","t"],"n36":"te","n37":["re","i"],"n38":["ve","m"],"n39":["las","t"],"n40":"Tú."},"verses":[{"label":"2.","lines":["Ninguno ha visto a Dios fuera de Ti,","Sin la Escritura no te conocí;","Tú a la humanidad mostraste a Dios","Y la Escritura es Tu revelación."]},{"label":"3.","lines":["Corporificación eres de Dios,","Es la Escritura un cuadro hoy de Ti;","Su viva imagen, Dios por Ti mostró,","Por la Escritura te haces real a mí."]},{"label":"4.","lines":["Eres Espíritu que vida das,","Y en la Palabra, Espíritu y verdad;","Por la Palabra, me impartirás","El mismo Espíritu de realidad."]},{"label":"5.","lines":["Encuentro en Ti con Dios tal comunión,","Y en la Escritura me alimento yo;","La debo estudiar orando a Dios,","Para que Tus riquezas me des hoy."]},{"label":"6.","lines":["Quiero mi espíritu ejercitar,","Y contactarte en vida al estudiar;","Por la Escritura, Tú, Palabra fiel,","Eres maná diario a mi ser."]}]}