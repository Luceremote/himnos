{"hymn":"S830","parent":"E984","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El río de agua viva","subtitle":"La máxima manifestación—La vida en la eternidad","syl":{"n1":"El","n2":["rí","i"],"n3":["o","t"],"n4":["de‿a","i"],"n6":["gua","t"],"n7":["vi","i"],"n8":["va","t"],"n9":["Flu","i"],"n10":["ye","t"],"n11":"del","n12":["tro","i"],"n13":["no","t"],"n14":"de","n15":"Dios;","n16":["Su‿au","i"],"n17":["to","m"],"n18":["ri","m"],"n19":["dad","t"],"n20":"nos","n21":["re","i"],"n22":["ve","m"],"n23":["la,","t"],"n24":["Tam","i"],"n25":["bién","t"],"n26":"nos","n27":"trae","n28":["co","i"],"n29":["mu","m"],"n30":["nión.","t"],"n31":"El","n32":["rí","i"],"n33":["o","t"],"n34":["de‿a","i"],"n36":["gua","t"],"n37":["vi","i"],"n38":["va,","t"],"n39":"La","n40":["co","i"],"n41":["mu","m"],"n42":["nión","t"],"n43":"nos","n44":["da","i"],"n45":["rá;","t"],"n46":["La‿au","i"],"n47":["to","m"],"n48":["ri","m"],"n49":["dad","t"],"n50":"trae","n51":["con","i"],"n52":["si","m"],"n53":["go","t"],"n54":"Por","n55":["don","i"],"n56":["de","m"],"n57":["quie","m"],"n58":["ra","t"],"n59":"que","n60":"va."},"verses":[{"label":"2.","lines":["Es el Espíritu el agua;","Fluye la vida, que es Dios;","Nos trae Su señorío,","Por donde fluye el Señor."]},{"label":"3.","lines":["Fluye en la calle de oro","Para el camino mostrar;","Fluye en la naturaleza","De Dios, para en Él andar."]},{"label":"4.","lines":["Por ambos lados del río,","El árbol de vida está;","Muestra que Dios es comida","Que el río nos brindará."]}]}