{"hymn":"S624","parent":"E807","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Abre mis ojos para ver","subtitle":"El estudio de la palabra—Buscar la palabra","syl":{"n1":["A","i"],"n2":["bre","t"],"n3":"mis","n4":["o","i"],"n5":["jos","t"],"n6":["pa","i"],"n7":["ra","t"],"n8":"ver","n9":["Des","i"],"n10":["te","m"],"n11":["llos","t"],"n12":"de","n13":"Tu","n14":"gran","n15":["ver","i"],"n16":["dad;","t"],"n17":"Pon","n18":"en","n19":"mis","n20":["ma","i"],"n21":["nos","t"],"n22":"la","n23":["lla","i"],"n24":["ve","t"],"n25":"que","n26":"Ha","n27":"de","n28":["po","i"],"n29":["ner","m"],"n30":["me‿en","t"],"n31":["li","i"],"n32":["ber","m"],"n33":["tad.","t"],"n34":["Tran","i"],"n35":["qui","m"],"n36":["lo,‿es","m"],"n37":["pe","m"],"n38":["ro‿en","t"],"n39":"Ti,","n40":"mi","n41":"Dios;","n42":"Tu","n43":["vo","i"],"n44":["lun","m"],"n45":["tad","t"],"n46":["re","i"],"n47":["ve","m"],"n48":["la","t"],"n49":"hoy;","n50":"Que","n51":"a","n52":"mis","n53":["o","i"],"n54":["jos","t"],"n55":"les","n56":"dé","n57":"luz","n58":["Tu‿Es","i"],"n59":["pí","m"],"n60":["ri","m"],"n61":["tu.","t"]},"verses":[{"label":"2.","lines":["Abre mi oído a Tu hablar,","Para escuchar con claridad,","Y, mientras oigo de Tu verdad,","Todo lo falso se irá."]},{"label":"3.","lines":["Abre mi boca para hablar,","Quiero Tu gracia anunciar;","Mi corazón he de preparar","Para Tu amor hoy proclamar."]},{"label":"4.","lines":["Abre mi mente al leer","De Tu amor, Tu hablar y hacer;","Eres mi Guía, ¿a qué temeré?","Entre Tu luz hoy en mi ser."]}]}