{"hymn":"S41","parent":"E52","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Padre, a Ti un cántico alzamos","subtitle":"Adoración al Padre—Alabanza a Él de parte de sus muchos hijos","syl":{"n1":["Pa","i"],"n2":["dre,","t"],"n3":"a","n4":"Ti","n5":"un","n6":["cán","i"],"n7":["ti","m"],"n8":["co‿al","m"],"n9":["za","m"],"n10":["mos;","t"],"n12":"En","n13":["co","i"],"n14":["mu","m"],"n15":["nión;","t"],"n16":"En","n17":"Tu","n18":["pre","i"],"n19":["sen","m"],"n20":["cia","t"],"n21":["to","i"],"n22":["dos","t"],"n23":["te‿a","i"],"n24":["la‿ba","m"],"n25":["mos,","t"],"n27":"¡Qué","n28":["ben","i"],"n29":["di","m"],"n30":["ción!","t"],"n32":["Es","i"],"n33":["tar","t"],"n34":"en‿Ti,","n35":"¡qué","n36":["gra","i"],"n37":["cia","t"],"n38":"sin","n39":["i","i"],"n41":["gu","m"],"n43":["al!","t"],"n44":"Que","n45":"con","n46":["Tu‿a","i"],"n47":["ma","m"],"n48":["do‿Hi","m"],"n49":["jo‿es","m"],"n50":["ta","m"],"n51":["mos","t"],"n53":"al","n54":"par."},"verses":[{"label":"2.","lines":["Llena de gozó‿esa radiante‿escena","Donde se ve","Tu‿amor, oh Dios y Padre, que gozamos","Sólo en Él.","Reposa así Tu santa calma aquí,","Cantamos con Aquel que te‿ama a Ti."]},{"label":"3.","lines":["Levanta alabanza el Hijo al Padre,","¡Qué dulce es!","A Ti nos lleva Él para‿adorarte,","Y estar con Él;","Fue Tu deseo antes de la creación,","Con Tu amado Hijo darnos porción."]}]}