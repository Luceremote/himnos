{"hymn":"S748","parent":"E909","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Sólo en el fluir, laboremos por Dios","subtitle":"El servicio—En el fluir","syl":{"n1":["Só","i"],"n2":["lo","t"],"n3":"en","n4":"el","n5":"fluir,","n6":["la","i"],"n7":["bo","m"],"n8":["re","m"],"n9":["mos","t"],"n10":"por","n11":["Di","i"],"n12":["os,","t"],"n13":"Por","n14":"Su","n15":["men","i"],"n16":["te,‿en","t"],"n17":"Su","n18":["for","i"],"n19":["ma,","t"],"n20":["co","i"],"n21":["mo‿Él","t"],"n22":["re","i"],"n23":["ve","m"],"n24":["ló;","t"],"n25":["O","i"],"n26":["bran","m"],"n27":["do‿en","t"],"n28":"el","n29":"fluir","n30":"de","n31":"Su","n32":["vi","i"],"n33":["da","t"],"n34":"y","n35":["po","i"],"n36":["der,","t"],"n37":"Por","n38":"Su","n39":["Rei","i"],"n40":["no,","t"],"n41":["Su‿i","i"],"n42":["gle","m"],"n43":["sia,","t"],"n44":"en","n45":["Su‿ac","i"],"n46":["tual","t"],"n47":["mo","i"],"n48":["ver.","t"],"n49":["¡Só","i"],"n50":["lo","t"],"n51":"en","n52":"el","n53":["flu","i"],"n54":["ir!","t"],"n55":["¡La","i"],"n56":["bo","m"],"n57":["re","m"],"n58":["mos","t"],"n59":"por","n60":"Dios!","n61":["¡Só","i"],"n62":["lo","t"],"n63":"en","n64":"el","n65":["flu","i"],"n66":["ir!","t"],"n67":["¡La","i"],"n68":["bo","m"],"n69":["re","m"],"n70":["mos","t"],"n71":["en‿coor","i"],"n72":["di","m"],"n73":["na","m"],"n74":["ción!","t"]},"verses":[{"label":"2.","lines":["Sólo en el fluir, laboremos con Dios,","En el Espíritu como Él lo enseñó;","Nunca independiente, obrando en el yo,","Mas en cuanto al servicio: en coordinación."]},{"label":"3.","lines":["Sólo en el fluir, laboremos en Dios,","Con la iglesia, los santos, conforme a Su luz;","La palabra de vida a todos brindad,","Y seguid Su fluir realizando Su plan."]}]}