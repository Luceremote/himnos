{"hymn":"S73","parent":"E94","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Qué carga sobre Ti cayó","subtitle":"Alabanza al Señor—Su sufrimiento","syl":{"n1":"Qué","n3":["car","i"],"n4":["ga","t"],"n5":["so","i"],"n6":["bre","t"],"n7":"Ti","n8":["ca","i"],"n9":["yó,","t"],"n10":"Oh","n11":["Cris","i"],"n12":["to,","t"],"n13":["Sal","i"],"n14":["va","m"],"n15":["dor;","t"],"n16":["Sus","i"],"n18":["ti","m"],"n19":["tu","m"],"n20":["is","m"],"n21":["te‿al","t"],"n22":["pe","i"],"n23":["ca","m"],"n24":["dor,","t"],"n25":["Lle","i"],"n26":["vas","m"],"n27":["te","t"],"n28":["mi‿a","i"],"n29":["flic","m"],"n30":["ción.","t"],"n31":"Tu","n32":["san","i"],"n33":["gre","t"],"n34":["de","i"],"n35":["rra","m"],"n36":["ma","m"],"n37":["da","t"],"n38":"fue;","n39":"¡No","n40":["lle","i"],"n41":["vó","t"],"n42":["car","i"],"n43":["gas","t"],"n44":"hoy!"},"verses":[{"label":"2.","lines":["La copa de la maldición","Bebiste, oh Señor;","Ni una gota‿ahí quedó,","Tu‿amor ya la tomó.","La copa‿amarga se vació;","Hoy tengo bendición."]},{"label":"3.","lines":["¡Jehová Su vará levantó","Y sobre Ti cayó!","Golpeado fuiste‿así por Dios,","Mas yo ileso‿estoy.","Con lágrimas, sangre fluyó;","Tu‿herida me sanó."]},{"label":"4.","lines":["La tempestad así rugió,","¡A Ti te azotó!","Tu pecho‿abierto me cubrió","De ese gran turbión.","Tu forma se desfiguró,","Mas paz yo tengo hoy."]},{"label":"5.","lines":["Jehová Su‿espada despertó,","¡A ti te traspasó!","Tu sangre ella requirió,","Tu corazón clavó:","¡Con Dios mi paz estableció!","Su‿espada no me hirió!"]},{"label":"6.","lines":["Por mi moriste, mi Señor,","Y‿en Ti he muerto yo;","Resucitaste‿y libre soy,","En mí Tú vives hoy.","Más puro‿y blanco me harás,","¡Tu gloria me darás!"]}]}