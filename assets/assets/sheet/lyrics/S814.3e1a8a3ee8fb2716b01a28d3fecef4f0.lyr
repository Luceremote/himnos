{"hymn":"S814","parent":"E1315","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"¡Gozaos, gozaos! El Novio viene","subtitle":"Esperanza de gloria—El día de las bodas","syl":{"n1":["¡Go","i"],"n2":["zaos,","t"],"n3":["go","i"],"n4":["zaos!","t"],"n5":"El","n6":["No","i"],"n7":["vio","t"],"n8":["vie","i"],"n9":["ne","t"],"n10":"Y","n11":"no","n12":["tar","i"],"n13":["da","m"],"n14":["rá‿en","t"],"n15":["lle","i"],"n17":["gar.","t"],"n18":"El","n20":["dí","i"],"n21":["a","t"],"n22":"de","n23":"Sus","n24":["gra","i"],"n25":["tas","t"],"n26":["bo","i"],"n27":["das","t"],"n28":["Se‿al","i"],"n29":["za","m"],"n30":["rá","t"],"n31":["can","i"],"n32":["ción","t"],"n33":["triun","i"],"n34":["fal.","t"],"n35":"¡Oh,","n37":["dí","i"],"n38":["a‿fe","m"],"n39":["liz!","t"],"n40":"¡Oh,","n41":"qué","n42":["ma","i"],"n43":["ña","m"],"n44":["na!","t"],"n45":["Cuan","i"],"n46":["do‿lle","m"],"n47":["ge‿el","t"],"n48":["Cris","i"],"n49":["to‿a","m"],"n50":["ma","m"],"n51":["do;","t"],"n54":"Con","n55":["va","i"],"n56":["sos","t"],"n57":["lle","i"],"n58":["nos","t"],"n59":["es","i"],"n60":["pe","m"],"n61":["re","m"],"n62":["mos","t"],"n63":"Y","n64":"las","n65":["lám","i"],"n66":["pa","m"],"n67":["ras","t"],"n68":"con","n69":"luz.","n70":["¡Go","i"],"n71":["zaos,","t"],"n72":["go","i"],"n73":["zaos!","t"],"n74":"El","n75":["No","i"],"n76":["vio","t"],"n77":["vie","i"],"n78":["ne","t"],"n79":"Y","n80":"no","n81":["tar","i"],"n82":["da","m"],"n83":["rá‿en","t"],"n84":["lle","i"],"n86":["gar.","t"],"n87":"El","n89":["dí","i"],"n90":["a","t"],"n91":"de","n92":"Sus","n93":["gra","i"],"n94":["tas","t"],"n95":["bo","i"],"n96":["das","t"],"n97":["Se‿al","i"],"n98":["za","m"],"n99":["rá","t"],"n100":["can","i"],"n101":["ción","t"],"n102":["triun","i"],"n103":["fal.","t"]},"verses":[{"label":"2.","lines":["Oh, redimamos hoy el tiempo,","¡Más aceite hay que comprar!","Antes del grito a medianoche","Cada vaso hay que llenar."]},{"label":"3.","lines":["¡Qué gozo es el prepararse","Para un