{"hymn":"S179","parent":"E228","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Qué fiesta de amor","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n2":"¡Qué","n3":["fies","i"],"n4":["ta","t"],"n5":"de","n6":["a","i"],"n7":["mor!","t"],"n9":"La","n11":["gra","i"],"n12":["cia","t"],"n13":"nos","n14":["li","i"],"n15":["bró","t"],"n16":["Pa","i"],"n17":["ra","t"],"n18":["to","i"],"n19":["mar","t"],"n20":"en","n21":"Tu","n22":["ho","i"],"n23":["nor","t"],"n24":"El","n25":["vi","i"],"n26":["no‿y","t"],"n27":"pan,","n28":["Se","i"],"n29":["ñor.","t"]},"verses":[{"label":"2.","lines":["Todos los invitados","De Ti han de‿aprender","Secretos que‿en el Padre‿están","Y tu gracia‿aprehender."]},{"label":"3.","lines":["Con la conciencia en paz,","La fe gusta probar","Qué dulce‿el pan de vida es","Y Tu amor filial."]},{"label":"4.","lines":["En símbolo se ve","Tu sangre que fluyó;","Tus arras en el corazón","Nos confirman Tu amor."]},{"label":"5.","lines":["Si tan glorioso es","Tu dulce amor gustar;","¿Cómo será, oh mi Señor,","Tu rostro contemplar?"]},{"label":"6.","lines":["Al verte cara‿a cara,","Igual a Ti seré;","Tu gracia, por la‿eternidad","Siempre declararé."]}]}