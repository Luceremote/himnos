{"hymn":"S12","parent":"E16","quality":"adapted","adjust":{"hold":0,"merge":4},"title":"Oh Padre, eres inmarcesible","subtitle":"Adoración al Padre—Su novedad","syl":{"n1":"Oh","n2":["Pa","i"],"n3":["dre,‿e","m"],"n4":["res","t"],"n5":["in","i"],"n6":["mar","m"],"n8":["ce","m"],"n9":["si‿ble,","t"],"n11":["Nue","i"],"n12":["vo","t"],"n13":["siem","i"],"n14":["pre‿e","m"],"n15":["res","t"],"n16":"Tú,","n18":["Co","i"],"n19":["mo‿el","t"],"n20":["ro","i"],"n21":["cí","m"],"n22":["o‿siem","m"],"n23":["pre‿es","m"],"n25":["tás","t"],"n26":"fres‿co,","n28":["Siem","i"],"n29":["pre","t"],"n30":["vi","i"],"n31":["vien","m"],"n32":["te,","t"],"n33":"Tú.","n35":"Oh,","n36":["Pa","i"],"n37":["dre,‿e","m"],"n38":["res","t"],"n39":["in","i"],"n40":["mu","m"],"n41":["ta","m"],"n42":["ble,","t"],"n43":["No‿en","i"],"n44":["ve","m"],"n45":["je","m"],"n46":["ces","t"],"n47":["ja","i"],"n48":["más;","t"],"n50":"Se","n51":["des","i"],"n52":["plie","m"],"n53":["ga","t"],"n54":"por","n55":"las","n56":["e‿da","i"],"n57":["des,","t"],"n59":"Tu","n60":["fres","i"],"n61":["ca","t"],"n62":["no","i"],"n63":["ve","m"],"n64":["dad.","t"]},"verses":[{"label":"2.","lines":["Tú eres Dios y Tú eres “nuevo”;","Todo‿es viejo sin Ti,","Pero contigo todo es fresco,","Aunque‿años pasen mil."]},{"label":"3.","lines":["Las bendiciones que nos has dado","Tienen Tu novedad;","Tu pacto, Tus caminos son nuevos,","Y siempre‿así serán."]},{"label":"4.","lines":["Hoy ya Tu nueva creación somos,","Un nuevo‿espíritu;","A diario‿el corazón nos renuevas,","Le‿impartes vida Tú."]},{"label":"5.","lines":["La nueva tierra‿y los nuevos cielos","Nueva ciudad tendrán;","Supliendo cada mes nuevos frutos,","Pues todo‿es novedad."]},{"label":"6.","lines":["Oh Padre, Tú eres siempre nuevo,","Todo nuevo‿es en Ti;","Un canto eterno‿y nuevo cantamos,","Nueva‿alabanza‿a Ti."]}]}