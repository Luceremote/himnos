{"hymn":"S565","parent":"E736","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La ley de Dios antigua fue","subtitle":"Varios aspectos de la vida interior—La ley de vida","syl":{"n1":"La","n2":"ley","n3":"de","n4":"Dios","n6":["an","i"],"n7":["ti","m"],"n9":["gua","t"],"n10":"fue","n11":["Gra","i"],"n12":["ba","m"],"n13":["da‿en","t"],"n14":["le","i"],"n15":["tras","t"],"n17":"de","n18":["pie","i"],"n19":["dra;","t"],"n20":["A","i"],"n21":["ho","m"],"n22":["ra‿es","t"],"n23":"ley","n25":"de","n26":["vi","i"],"n28":["da","t"],"n30":"que","n32":"En","n33":["nues","i"],"n34":["tro","t"],"n36":["co","i"],"n37":["ra","m"],"n38":["zón","t"],"n40":["es","i"],"n41":["tá.","t"]},"verses":[{"label":"2.","lines":["La antigua ley exige el bien,","Descubre así el débil ser;","La ley de vida, fuerza da","Para al Señor satisfacer."]},{"label":"3.","lines":["La antigua ley revela a Dios","Solo en la forma exterior;","La ley de vida proveerá","Su realidad en lo interior."]},{"label":"4.","lines":["La antigua ley puede regir","Por mandamiento exterior;","La ley de vida reina hoy","Por un sentir en lo interior."]},{"label":"5.","lines":["Esta viviente ley está","Moviéndose en nuestro andar;","Por su sentido interior","Nos puede en todo refrenar."]},{"label":"6.","lines":["¡Profunda es su regulación!","Opera desde lo interior,","Una conciencia viva da","Y nos imparte al mismo Dios."]},{"label":"7.","lines":["Por ser tan viva esta ley","No nos enseña en lo exterior;","Pues todo el saber de Dios","Nos lo revela en lo interior."]},{"label":"8.","lines":["Enséñanos, Señor, a andar","Conforme a esta interna ley,","Para de Ti participar","Y conocerte en nuestro ser."]}]}