{"hymn":"S433","parent":"E549","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cruza el velo, obtén lo celestial","subtitle":"Experiencia de Cristo—Contenerlo a Él","syl":{"n1":["Cru","i"],"n2":["za","t"],"n3":"el","n4":["ve","i"],"n5":["lo,‿ob","m"],"n6":["tén","t"],"n7":"lo","n8":["ce","i"],"n9":["les","m"],"n10":["tial,","t"],"n11":["Fue","i"],"n12":["ra","t"],"n13":"del","n14":["cam","i"],"n15":["pa","m"],"n16":["men","m"],"n17":["to‿hay","t"],"n18":"que","n19":["mar","i"],"n20":["char;","t"],"n21":"Si","n22":["gus","i"],"n23":["to","t"],"n24":"del","n25":["San","i"],"n26":["tí","m"],"n27":["si","m"],"n28":["mo","t"],"n29":["Lu","i"],"n30":["gar,","t"],"n31":["¿Có","i"],"n32":["mo","t"],"n33":"de","n34":["va","i"],"n35":["ni","m"],"n36":["dad","t"],"n37":["par","i"],"n38":["ti","m"],"n39":["ci","m"],"n40":["par?","t"]},"verses":[{"label":"2.","lines":["Cruza el velo, ve lo celestial,","Sal de ese campamento terrenal;","Si me cautiva la gloria de Dios,","Mi corazón el mundo no amará."]},{"label":"3.","lines":["Cruza el velo, Cristo en gloria está,","Fuera del campamento va Jesús;","Trono y corona a mi espíritu","Inspiran a sobrellevar la cruz."]},{"label":"4.","lines":["Cruzando el velo hay resurrección","Fuera del campamento está la cruz;","Si Su radiante rostro puedo ver,","Yo seguiré los pasos de Jesús."]},{"label":"5.","lines":["Cruza el velo, ten lo celestial,","Fuera del campamento aguantarás;","Y aunque pruebas sufre el corazón,","Celeste comunión te alentará."]},{"label":"6.","lines":["Cruza el velo, goza del caudal,","Sal de ese campamento a ministrar;","Si vivo yo la vida celestial,","Las almas de la tierra he de saciar."]},{"label":"7.","lines":["Cruza el velo hasta que no esté,","Sal de ese campamento hasta que","El cielo con la tierra llegue a ser","Uno, como el hombre y Dios también."]}]}