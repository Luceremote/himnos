{"hymn":"S723","parent":"E873","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Soldados, a la carga","subtitle":"La guerra espiritual—A la carga","syl":{"n1":["¡Sol","i"],"n2":["da","m"],"n3":["dos,","t"],"n4":"a","n5":"la","n7":["car","i"],"n8":["ga!","t"],"n9":"La","n10":["gue","i"],"n11":["rra","t"],"n13":["co","i"],"n14":["men","m"],"n15":["zó;","t"],"n16":"Con","n17":"la","n18":["can","i"],"n19":["ción","t"],"n20":["triun","i"],"n22":["fan","m"],"n23":["te:","t"],"n24":["¡Vic","i"],"n25":["to","m"],"n26":["ria","t"],"n27":"se","n28":["ga","i"],"n29":["nó!","t"],"n30":["Des","i"],"n31":["tri","m"],"n32":["u","m"],"n33":["do","t"],"n34":"el","n35":["Ha","i"],"n37":["des;","t"],"n38":["Ven","i"],"n39":["ci","m"],"n40":["do,","t"],"n41":["Sa","i"],"n42":["ta","m"],"n43":["nás.","t"],"n44":"El","n46":["Ca","i"],"n47":["pi","m"],"n48":["tán","t"],"n49":"muy","n50":["pron","i"],"n52":["to","t"],"n53":["Triun","i"],"n54":["fan","m"],"n55":["te","t"],"n57":["vol","i"],"n58":["ve","m"],"n59":["rá.","t"]},"verses":[{"label":"2.","lines":["¡Soldados, a la carga!","En el Señor confiad;","Pelea en Su batalla","Y el trono Él te dará.","Pelea en espíritu,","No es guerra terrenal;","Sabe el Señor que el diablo","Rodeándonos está."]},{"label":"3.","lines":["¡Soldados, a la carga!","El trono listo está.","Su resurrección puede","Tu espíritu librar.","Por Cristo, fuerzas tienes","Para al diablo aplastar;","Por Él, canta victoria;","Él te coronará."]},{"label":"4.","lines":["¡Soldados, a la carga!","Al trono has de ascender;","Banquete Él te prepara,","Feliz tú lo haces ser.","Con Él, resucitado,","La guerra abajo está;","Trascendiendo todo,","Con Él libre serás."]},{"label":"5.","lines":["¡Soldados, a la carga!","Noble heredero, tú;","Te escogió del polvo","A Su reino, Jesús.","Brillante es tu futuro,","Nada de oscuridad;","Morando tú con Cristo,","Su amor disfrutarás."]},{"label":"6.","lines":["¡Con júbilo a la carga!","Delante el reino está;","Ganada la batalla,","En Sion se cantará.","¡Triunfante es el Cordero!","¡Entronizado está!","Con gritos lo alabamos,","Pues siempre vencerá."]}]}