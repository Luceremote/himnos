{"hymn":"S359","parent":"E473","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Ningún mortal podrá narrar","subtitle":"Consagración—Poseerlo todo en el Señor","syl":{"n1":["Nin","i"],"n2":["gún","t"],"n3":["mor","i"],"n4":["tal","t"],"n6":["po","i"],"n7":["drá","t"],"n8":["na","i"],"n9":["rrar","t"],"n10":"La","n11":["li","i"],"n12":["ber","m"],"n13":["tad","t"],"n15":["de‿a","i"],"n16":["quel","t"],"n18":"Que","n19":["ven","i"],"n20":["ce‿el","t"],"n21":["ce","i"],"n23":["bo","t"],"n24":["te","i"],"n25":["rre","m"],"n26":["nal","t"],"n27":"Y‿a","n28":"Dios","n29":["se‿en","i"],"n30":["tre","m"],"n31":["ga","t"],"n32":"fiel;","n34":["To","i"],"n35":["das","t"],"n36":"las","n37":["co","i"],"n39":["sas","t"],"n40":"son","n41":"de","n42":"él,","n43":["Pre","i"],"n44":["sen","m"],"n45":["te‿o","t"],"n46":"por","n48":["ve","i"],"n49":["nir;","t"],"n51":"Es","n52":["Cris","i"],"n53":["to","t"],"n55":"su","n56":["per","i"],"n57":["fec","m"],"n58":["ta","t"],"n59":"paz,","n60":"Y","n61":["Cris","i"],"n62":["to","t"],"n63":"es","n64":"su","n65":"fin."},"verses":[{"label":"2.","lines":["Ya que podemos escoger","Regir con nuestro Rey,","Sería extraño rehusar","Ser sólo para El.","De sacrificios, ni hablar;","Es gozo sin igual","A todo costo componer","La armada celestial."]},{"label":"3.","lines":["¡Qué ganga tu parte entregar","Por la totalidad!","Todo hombre y todo evento así","Al fiel le servirán.","Lo Suyo, todo tuyo es,","Si tú a Él te das;","Vida abudante hallarás,","Y un reino que vendrá."]}]}