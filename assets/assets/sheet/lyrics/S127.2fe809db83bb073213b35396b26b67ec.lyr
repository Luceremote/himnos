{"hymn":"S127","parent":"E158","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh Señor, antes vagamos","subtitle":"Alabanza al Señor—Su amor","syl":{"n1":"Oh","n2":["Se","i"],"n3":["ñor,","t"],"n4":["an","i"],"n5":["tes","t"],"n6":["va","i"],"n8":["ga","m"],"n9":["mos,","t"],"n10":"Mas","n11":["Tu‿a","i"],"n12":["mor","t"],"n13":"nos","n14":["en","i"],"n15":["con","m"],"n16":["tró;","t"],"n17":"Nos","n18":["ro","i"],"n19":["deas","m"],"n20":["te","t"],"n21":"con","n22":"Tus","n23":["bra","i"],"n24":["zos,","t"],"n25":"Y","n26":["mo","i"],"n27":["ris","m"],"n28":["te,‿oh","t"],"n29":["Sal","i"],"n30":["va","m"],"n31":["dor.","t"],"n32":["¡Can","i"],"n33":["ta,","t"],"n34":["al","i"],"n35":["ma!","t"],"n36":"Él","n37":["te‿a","i"],"n39":["mó.","t"],"n40":"Por","n41":"mi","n42":["Cris","i"],"n43":["to","t"],"n44":["se‿en","i"],"n45":["tre","m"],"n46":["gó.","t"]},"verses":[{"label":"2.","lines":["Oh, qué llanto tan amargo","Desde el Getsemaní;","El Señor guarda vigilia","Mientras Pedro duerme‿allí.","Alma mía, Él te‿amó,","Sí, por mi Jesús se dio."]},{"label":"3.","lines":["Él está hablando‿al Padre,","Se rindió para tomar","De‿esa copa tan amarga","Para podernos salvar.","¡Oh, qué‿amor: Él me amó!","Mi‿alma, Él por ti se dio."]},{"label":"4.","lines":["¡Oh, qué‿escena de angustia!","Cuando las olas de Dios","Contra Él arremetieron","Y‿en la cruz Él me salvó.","¡Qué inmenso‿es tal amor!","Por mi Cristo se‿entregó."]},{"label":"5.","lines":["¡Otra vez oíd el llanto","Que‿en Calvario resonó!","Dios, mi Dios, ¿desamparaste‿a","Quien Tu voluntad cumplió?","¡Oh mi alma! fue por ti,","¡Sí! Se dio así por mí."]},{"label":"6.","lines":["Oh Señor, hoy nos gozamos;","Ya no sufres más pesar.","Hasta‿el trono ascendiste;","Vives y no mueres más.","¡Mi alma! Vive Él por ti,","Sí, Él se‿entregó por mí."]},{"label":"7.","lines":["Te honramos y‿adoramos","Por tu gracia‿y gran valor;","Cara‿a cara te veremos","Ya perfectos, fiel Señor.","Mientras tanto canto‿así:","Cristo se‿entregó por mí."]}]}