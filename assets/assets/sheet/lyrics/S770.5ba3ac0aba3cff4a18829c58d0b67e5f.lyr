{"hymn":"S770","parent":"E1351","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"¡Oh, qué piedad! Al verdadero Dios vi","subtitle":"Predicar el evangelio—La salvación de la familia","syl":{"n1":"¡Oh,","n2":"qué","n3":["pie","i"],"n4":["dad!","t"],"n5":"Al","n6":["ver","i"],"n7":["da","m"],"n8":["de","m"],"n9":["ro","t"],"n10":"Dios","n11":"vi,","n12":["¡Fe","i"],"n14":["liz","t"],"n15":"de","n16":["pa","i"],"n17":["sar","t"],"n18":["de‿os","i"],"n19":["cu","m"],"n20":["ri","m"],"n21":["dad‿a","t"],"n22":"luz!","n23":"¡Qué","n24":["gra","i"],"n25":["cia","t"],"n26":"ser","n27":["gra","i"],"n28":["tui","m"],"n29":["ta","m"],"n30":["men","m"],"n31":["te","t"],"n32":["sal","i"],"n33":["vo!","t"],"n34":"¡No‿hay","n35":["que‿o","i"],"n36":["brar","t"],"n37":"ni‿en","n38":["nues","i"],"n39":["tras","t"],"n40":["fuer","i"],"n41":["zas","t"],"n42":["con","i"],"n44":["fiar!","t"]},"verses":[{"label":"2.","lines":["Señor, acuérdate de mi familia,","Sus pecados ya llevaste a la cruz;","Cumple este día Tu promesa dada;","\"En Cristo cree; tu casa salva será\"."]},{"label":"3.","lines":["Gana Señor, te ruego, a mi familia!","En mi corazón arde este voto a Ti:","\"¡Mi casa y yo, al Señor serviremos!\"","¡Load a Dios! Sólo Él es viviente y real."]}]}