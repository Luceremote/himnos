{"hymn":"S331","parent":"E431","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tu fuerte amor me constriñe, Señor","subtitle":"Consagración—Constreñidos por el amor del Señor","syl":{"n1":"Tu","n2":["fuer","i"],"n3":["te‿a","m"],"n4":["mor","t"],"n5":"me","n6":["cons","i"],"n7":["tri","m"],"n8":["ñe,","t"],"n9":["Se","i"],"n10":["ñor,","t"],"n11":["Co","i"],"n12":["mo","t"],"n13":["co","i"],"n14":["rrien","m"],"n15":["te","t"],"n16":["pre","i"],"n17":["sio","m"],"n18":["nan","m"],"n19":["do‿es","m"],"n20":["tá,","t"],"n21":["Bus","i"],"n22":["can","m"],"n23":["do‿a","m"],"n24":["brir","t"],"n25":"en","n26":["mi‿al","i"],"n27":["ma","t"],"n28":"un","n29":["ca","i"],"n30":["nal,","t"],"n32":["An","i"],"n33":["he","m"],"n34":["la","t"],"n35":["to","i"],"n36":["do‿es","m"],"n37":["tor","m"],"n38":["bo‿en","t"],"n39":"mí","n40":["qui","i"],"n41":["tar.","t"]},"verses":[{"label":"2.","lines":["¿No debo yo abrirme a tal poder?","¿Y a la corriente de Tu amor ceder?","Mi Dios, Tu gentileza me ganó,","Mi vida ya igual no puede ser."]},{"label":"3.","lines":["Quebrántame con Tu divino amor;","Mi mente limpia y todo mi querer,","Fluye y depura toda mi afección;","Que sólo quede Tu vida en mí ser."]},{"label":"4.","lines":["Así posesionado por mi Dios,","Ha de fluir desde mi corazón,","Un tierno arroyo en espontaneidad,","Lleno de gracia y el amor de Dios."]}]}