{"hymn":"S548","parent":"E708","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Fresco tal como el rocío","subtitle":"Consuelo en las pruebas—Por el Señor de esperanza","syl":{"n1":["Fres","i"],"n2":["co","t"],"n3":"tal","n4":["co","i"],"n5":["mo‿el","t"],"n6":["ro","i"],"n7":["cí","m"],"n8":["o,","t"],"n10":["Brin","i"],"n11":["da","t"],"n12":["des","i"],"n13":["can","m"],"n14":["so","t"],"n15":"sin","n16":"par;","n19":["Cris","i"],"n20":["to‿en","t"],"n21":["ter","i"],"n22":["nu","m"],"n23":["ra","t"],"n24":"me","n25":["un","i"],"n26":["ge,","t"],"n28":"Me","n29":["re","i"],"n30":["con","m"],"n31":["for","m"],"n32":["ta","t"],"n33":["Su‿ha","i"],"n34":["blar.","t"],"n37":["Fir","i"],"n38":["me","t"],"n39":["du","i"],"n40":["ran","m"],"n41":["te","t"],"n42":"la","n43":["prue","i"],"n44":["ba,","t"],"n45":["Fir","i"],"n46":["me","t"],"n47":"en","n48":"la","n49":["tem","i"],"n50":["pes","m"],"n51":["tad,","t"],"n54":["Fir","i"],"n55":["me","t"],"n56":"por","n57":["Cris","i"],"n58":["to‿y","t"],"n59":"Su","n60":["glo","i"],"n61":["ria,","t"],"n63":["Fir","i"],"n64":["me‿has","m"],"n65":["ta‿el","t"],"n66":["rei","i"],"n67":["no","t"],"n68":["ga","i"],"n69":["nar.","t"],"n72":["¡Dul","i"],"n74":["ce‿es","t"],"n75":"Tu","n76":"voz,","n78":"Oh","n79":"Se‿ñor","n80":["de‿es","i"],"n82":["pe","m"],"n83":["ran","m"],"n84":["za!","t"],"n86":"En","n88":"Tu","n89":["pre","i"],"n90":["sen","m"],"n92":["ci","m"],"n93":["a,","t"],"n94":"Tu","n95":["go","i"],"n96":["zo‿me","t"],"n97":"das."},"verses":[{"label":"2.","lines":["Si al pasar por problemas,","Débil mi espíritu está,","Toda mi fe y esperanza","Sin duda se esfumarán,","¡Oh, que Tu fe y Tu vida","Puedan mi ser dominar!","Que tus riquezas de gloria","Hoy pueda yo disfrutar."]},{"label":"3.","lines":["Como la luz de la aurora,","Disipa la oscuridad;","Con sanidad en Tus alas,","Mi noche, día harás.","Ven, oh, ven a consolarme;","Ven hoy a mi corazón;","Ven, Esperanza de gloria;","Nunca me dejes, Señor."]}]}