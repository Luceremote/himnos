{"hymn":"S537","parent":"E1206","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Hay una carrera hoy, ¡Aleluya","subtitle":"Aliento—Para correr la carrera","syl":{"n1":"Hay","n2":["u","i"],"n3":["na","t"],"n4":["ca","i"],"n5":["rre","m"],"n6":["ra","t"],"n7":"hoy,","n8":["¡A","i"],"n9":["le","m"],"n10":["lu","m"],"n11":["ya!","t"],"n12":"Y","n13":"la","n14":["for","i"],"n15":["ma","t"],"n16":"de","n17":["po","i"],"n18":["der","t"],"n19":["ga","i"],"n20":["nar.","t"],"n21":"A","n22":"los","n23":"que","n24":["em","i"],"n25":["pe","m"],"n26":["za","m"],"n27":["ron","t"],"n28":["ya,‿¡A","i"],"n29":["le","m"],"n30":["lu","m"],"n31":["ya!","t"],"n32":"Dios","n33":"ha","n34":["di","i"],"n35":["cho:","t"],"n36":["¡Só","i"],"n37":["lo‿a","t"],"n38":"Él","n39":["mi","i"],"n40":["rad!","t"],"n41":"¡Sí,","n42":["mi","i"],"n43":["rad!","t"],"n45":"¡A","n46":"Él","n47":["mi","i"],"n48":["rad!","t"],"n49":"¡A","n50":["Je","i"],"n51":["sús","t"],"n52":["só","i"],"n53":["lo‿hoy","t"],"n54":["mi","i"],"n55":["rad!","t"],"n56":"Y","n57":["a","i"],"n58":["trás","t"],"n59":"no","n60":["mi","i"],"n61":["res","t"],"n62":"más,","n63":["¡A","i"],"n64":["le","m"],"n65":["lu","m"],"n66":["ya!","t"],"n67":["¡De","i"],"n68":["ja","t"],"n69":["to","i"],"n70":["do‿y","t"],"n71":["mi","i"],"n72":["ra","t"],"n73":["só","i"],"n74":["lo‿a","t"],"n75":"Él!"},"verses":[{"label":"2.","lines":["Deja todo alrededor, ¡Aleluya!","Toda lucha y distracción de hoy.","Deja todo y paz tendrás, ¡Aleluya!","Deja todo y mira sólo a Él."]},{"label":"3.","lines":["Deja el alma vacilante, ¡Aleluya!","Deja el yo que te hace fallecer.","Deja todo y mira al blanco, ¡Aleluya!","Deja todo y mira sólo a Él."]},{"label":"4.","lines":["Deja todo el pasado, ¡Aleluya!","Deja todo el bien y el mal atrás,","Y asido del Viviente, ¡Aleluya!","Deja todo y mira sólo a Él."]},{"label":"5.","lines":["Mira sólo a Su rostro ¡Aleluya!","Lo empezado, Él lo acabará.","Gracia da para correr, ¡Aleluya!","Y se obtiene al mirarlo a Él."]}]}