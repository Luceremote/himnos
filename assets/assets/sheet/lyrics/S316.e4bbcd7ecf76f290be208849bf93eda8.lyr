{"hymn":"S316","parent":"E406","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tu senda, oh Señor","subtitle":"Anhelos—Del camino del Señor","syl":{"n1":"Tu","n2":["sen","i"],"n3":["da,","t"],"n4":"oh","n5":["Se","i"],"n6":["ñor,","t"],"n7":["¡Ház","i"],"n8":["me","m"],"n9":["la","t"],"n10":"ver!","n11":"Tu","n12":["gra","i"],"n13":["cia‿a","m"],"n14":["por","m"],"n15":["ta","t"],"n16":"hoy,","n17":"¡Oh,","n18":["haz","i"],"n19":["me","t"],"n20":"ver!","n22":["Da","i"],"n23":["me","t"],"n24":"luz","n25":["ce","i"],"n26":["les","m"],"n27":["tial,","t"],"n28":"No","n29":"por","n30":"mi","n31":["vis","i"],"n32":["ta‿an","m"],"n33":["dar,","t"],"n34":"Mas","n35":"por","n36":"fe","n37":["ca","i"],"n38":["mi","m"],"n39":["nar,","t"],"n40":["¡Ház","i"],"n41":["me","m"],"n42":["la","t"],"n43":"ver!"},"verses":[{"label":"2.","lines":["En dudas y temor,","¡Házmela ver!","Si‿hay nubes y turbión,","¡Oh, hazme ver!","Brilla‿en mi cielo gris,","Cuando‿esté triste‿aquí;","Tu senda‿haz clara‿a mí,","¡Házmela ver!"]},{"label":"3.","lines":["Mientras viva, Señor,","¡Házmela ver!","Cualquiera mi porción,","¡Oh, hazme ver!","Hasta‿el premio ganar","En mi peregrinar,","Y Tu senda‿acabar.","¡Házmela ver!"]}]}