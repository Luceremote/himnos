{"hymn":"S44","parent":"E1081","quality":"adapted","adjust":{"hold":1,"merge":4},"title":"Tú la Fuente eres, Padre Dios","subtitle":"Adoración al Padre—Su nombre, su palabra, su gloria","syl":{"n1":"Tú","n2":"la","n3":["Fuen","i"],"n4":["te","t"],"n5":["e","i"],"n6":["res,","t"],"n7":["Pa","i"],"n8":["dre","t"],"n9":"Dios,","n11":"De","n12":"la","n13":["vi","i"],"n14":["da","t"],"n15":["que‿ex","i"],"n16":["pre","m"],"n17":["sa","m"],"n18":["mos,","t"],"n20":"Que‿en","n21":"Tu","n22":["nom","i"],"n23":["bre","t"],"n24":["dis","i"],"n25":["fru","m"],"n26":["ta","m"],"n27":["mos;","t"],"n29":"Tú","n30":"la","n31":["Fuen","i"],"n32":["te","t"],"n33":["e","i"],"n34":["res,","t"],"n35":["Pa","i"],"n36":["dre","t"],"n37":"Dios,","n38":"En","n39":["Tu‿glo","i"],"n40":["ria,‿en","t"],"n43":"Tu","n44":["glo","i"],"n45":["ria,","t"],"n47":"En","n48":["Tu‿glo","i"],"n49":["ria‿es","t"],"n50":["nues","i"],"n51":["tra‿u","m"],"n53":["ni","m"],"n55":["dad.","t"],"n56":"En","n57":["Tu‿glo","i"],"n58":["ria,‿en","t"],"n61":"Tu","n62":["glo","i"],"n63":["ria,","t"],"n65":"En","n66":["Tu",null,"u"],"n67":0,"n68":["glo","i"],"n69":["ria","t"],"n70":"se","n71":"ve","n72":["la‿u‿ni","i"],"n73":["dad.","t"]},"verses":[{"label":"2.","lines":["Tu Palabra santa‿es rico don,","Nos satura con Tu esencia,","Del mundo nos da‿abstinencia;","Tu Palabra, Padre, es rico don."]},{"label":"3.","lines":["¡Oh, la gloria del Triuno Dios!","¡Sus benditos hijos somos!","Y Su gloria aquí‿expresamos;","¡Oh, la gloria del Triuno Dios!"]}]}