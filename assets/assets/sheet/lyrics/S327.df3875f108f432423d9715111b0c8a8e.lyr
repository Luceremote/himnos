{"hymn":"S327","parent":"E1134","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Oh, dale a mi espíritu fuerza","subtitle":"Anhelos—De santificación","syl":{"n1":"Oh,","n2":["da","i"],"n3":["le‿a","t"],"n4":["mi‿es","i"],"n5":["pí","m"],"n6":["ri","m"],"n7":["tu","t"],"n8":["fuer","i"],"n9":["za,","t"],"n10":"Oh,","n11":["da","i"],"n12":["le","t"],"n13":["po","i"],"n14":["der,","t"],"n15":"mi","n16":["Se","i"],"n17":["ñor;","t"],"n19":"Oh,","n20":["da","i"],"n21":["le‿a","t"],"n22":["mi‿es","i"],"n23":["pí","m"],"n24":["ri","m"],"n25":["tu","t"],"n26":["vi","i"],"n27":["da,","t"],"n28":["Y‿ex","i"],"n29":["tién","m"],"n30":["de‿te‿a","t"],"n31":"mi","n32":["co","i"],"n33":["ra","m"],"n34":["zón.","t"],"n37":"Al","n38":["co","i"],"n39":["ra","m"],"n40":["zón,","t"],"n41":"al","n42":["co","i"],"n43":["ra","m"],"n44":["zón,","t"],"n45":["Ex","i"],"n46":["tién","m"],"n47":["de","m"],"n48":["te‿a","m"],"n49":["llí,","t"],"n50":"oh","n51":["Cris","i"],"n52":["to,","t"],"n53":"Y","n54":"haz","n55":"en","n56":"él","n57":["Tu‿ha","i"],"n58":["bi","m"],"n59":["ta","m"],"n60":["ción","t"],"n61":"En","n62":"mi","n63":["co","i"],"n64":["ra","m"],"n65":["zón,","t"],"n66":"oh","n67":["Cris","i"],"n68":["to.","t"]},"verses":[{"label":"2.","lines":["Extiéndete, Cristo te pido,","Extiéndete‿en mi interior;","Extiéndete y‿abre el camino","De mi‿espíritu‿al corazón."]},{"label":"3.","lines":["En mi corazón haz morada,","En él haz Tu‿hogar, mi Jesús,","Hasta que contigo rebose","Mi alma con Tu plenitud."]},{"label":"4.","lines":["A‿Aquel que es capaz de hacerlo,","Por Su eminente poder.","Hará más de lo que pedimos","Si abrimos a El nuestro ser."]}]}