{"hymn":"S658","parent":"E846","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, que mi espíritu","subtitle":"La iglesia—Su edificación","syl":{"n1":"¡Oh,","n2":"que","n3":["mi‿es","i"],"n4":["pí","m"],"n5":["ri","m"],"n6":["tu","t"],"n7":["Pue","i"],"n8":["da","t"],"n9":["flu","i"],"n10":["ir!","t"],"n11":"Te","n12":["rue","i"],"n13":["ga‿a","t"],"n14":"Ti,","n15":["Se","i"],"n16":["ñor,","t"],"n17":["¡Man","i"],"n18":["da","t"],"n19":"el","n20":"fluir!","n21":["De","i"],"n22":["jan","m"],"n23":["do","t"],"n24":["to","i"],"n25":["do‿a","m"],"n26":["trás","t"],"n27":"Los","n28":["mu","i"],"n29":["ros","t"],"n30":["ca","i"],"n31":["e","m"],"n32":["rán,","t"],"n33":["Mi‿es","i"],"n34":["pí","m"],"n35":["ri","m"],"n36":["tu","t"],"n37":["po","i"],"n38":["drá","t"],"n39":["A","i"],"n40":["sí","t"],"n41":["flu","i"],"n42":["ir.","t"]},"verses":[{"label":"2.","lines":["¡Oh, que mi espíritu","Pueda fluir!","Te imploro a Ti, Señor,","¡Manda el fluir!","No en mi orgullo estar,","O en presunción andar,","Ni mi espíritu atar;","¡Hazlo fluir!"]},{"label":"3.","lines":["¡Oh, que mi espíritu","Pueda fluir!","Te pido a Ti, Señor,","¡Manda el fluir!","No inflado por el yo,","O atado en su prisión,","Tenga emancipación","Mi espíritu."]},{"label":"4.","lines":["¡Oh, que mi espíritu","Pueda fluir!","Te busco a Ti, Señor,","¡Manda el fluir!","No debo aislado estar,","Ni mi ego elevar,","Que fluya sin cesar","Mi espíritu."]},{"label":"5.","lines":["¡Oh, que mi espíritu","Pueda fluir!","Te ruego a Ti, Señor,","¡Manda el fluir!","Del trono haz caer,","Hoy mi confiado ser,","Que fluya agua de","Mi espíritu"]},{"label":"6.","lines":["¡Oh, que mi espíritu","Pueda fluir!","Respóndeme, Señor,","¡Manda el fluir!","No sólo Tú y yo,","Mas mi edificación","Con otros en amor","Y espíritu."]}]}