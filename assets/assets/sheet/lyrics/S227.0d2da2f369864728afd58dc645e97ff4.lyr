{"hymn":"S227","parent":"E280","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, haz que Tu sangre","subtitle":"La plenitud del Espíritu—Por la cruz","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":"haz","n4":"que","n5":"Tu","n6":["san","i"],"n7":["gre","t"],"n9":"Me","n10":["lim","i"],"n11":["pie","t"],"n12":"de","n13":"mi","n14":"mal,","n15":"Que","n16":["Tu‿Es","i"],"n17":["pí","m"],"n18":["ri","m"],"n19":["tu","t"],"n20":["San","i"],"n21":["to","t"],"n23":"Me","n24":["un","i"],"n25":["ja","t"],"n26":"sin","n27":["ce","i"],"n28":["sar.","t"],"n29":["Con","i"],"n30":["fie","m"],"n31":["so","t"],"n32":"que","n33":"muy","n34":["po","i"],"n35":["bre","t"],"n37":"Es","n38":"mi","n39":["ser","i"],"n40":["vi","m"],"n41":["cio‿a","t"],"n42":"Ti;","n43":["Pe","i"],"n44":["ro","t"],"n45":"si","n46":"Tú","n47":"me","n48":["lle","i"],"n49":["nas,","t"],"n51":"Por","n52":"Tí","n53":["po","i"],"n54":["dré","t"],"n55":["vi","i"],"n56":["vir.","t"],"n57":"Que","n58":"de","n59":"mi","n60":"yo","n61":["li","i"],"n62":["bres,","t"],"n63":"De","n64":"su","n65":["mi","i"],"n66":["se","m"],"n67":["ri","m"],"n68":["a","t"],"n69":"vil,","n71":["Pa","i"],"n72":["ra","t"],"n73":["que‿a","i"],"n74":["sí","t"],"n75":"por","n76":["siem","i"],"n77":["pre","t"],"n78":"Yo","n79":["lle","i"],"n80":["no‿es","m"],"n81":["té","t"],"n82":"de","n83":"Ti."},"verses":[{"label":"2.","lines":["Por Ti añora‿y clama","Mi seco corazón;","Te ruego que me llene","Tu‿Espíritu, Señor.","En Ti, la Peña‿hendida,","Me quiero refugiar;","Derrama‿el agua viva","Hasta mi sed saciar."]},{"label":"3.","lines":["Mi corazón es frío;","Rehúsa‿obedecer;","Tu‿Espíritu me llene,","Rebelde no seré.","Sobre Tu‿altar me pongo","Y no me moveré;","Consuma hoy Tu fuego,","Señor, todo mi ser."]},{"label":"4.","lines":["Oh, que Tu cruz por dentro","Muy hondo arda‿en mí.","Ensancha Tu medida;","Cenizas hazme‿al fin.","Tu Espíritu me llene","Hoy mucho más que‿ayer,","Para que‿el agua viva","Por mí puedas verter."]}]}