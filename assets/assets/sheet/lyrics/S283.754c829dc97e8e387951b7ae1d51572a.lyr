{"hymn":"S283","parent":"E351","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Vida increada, poderoso Dios","subtitle":"Anhelos—De Dios como vida","syl":{"n1":["Vi","i"],"n2":["da‿in","m"],"n3":["cre","m"],"n4":["a","m"],"n5":["da,","t"],"n6":["po","i"],"n7":["de","m"],"n8":["ro","m"],"n9":["so","t"],"n10":"Dios,","n12":["In","i"],"n13":["cli","m"],"n14":["na","t"],"n15":"Tu","n16":["o","i"],"n17":["í","m"],"n18":["do‿a","t"],"n19":"mi","n20":["cla","i"],"n21":["mor;","t"],"n23":["Glo","i"],"n24":["ria‿in","m"],"n25":["de","m"],"n26":["ci","m"],"n27":["ble","t"],"n28":"a","n29":["tu‿al","i"],"n30":["re","m"],"n31":["de","m"],"n32":["dor;","t"],"n34":["Ten","i"],"n35":["go","t"],"n36":"que","n37":["co","i"],"n38":["no","m"],"n39":["cer","m"],"n40":["te,","t"],"n41":"mi","n42":["Cre","i"],"n43":["a","m"],"n44":["dor.","t"]},"verses":[{"label":"2.","lines":["Oh, por la cruz que mi Cristo sufrió,","Oh, por la muerte de mi Redentor,","De las tinieblas, sálvame Señor,","Al reino de Tu luz, mi Salvador."]},{"label":"3.","lines":["Desde el centro, lléname Señor,","Oh, lléname y hazme rebosar;","Tu gloria‿irradie de Tu mismo ser","Y me rodee por completo ya."]},{"label":"4.","lines":["Vida‿increada, Santísimo Dios,","Vivificante‿Espíritu en mí,","Crea en mi Tu misma expresión,","Algo que‿atraiga‿a otros hacia Tí."]},{"label":"5.","lines":["¡Padre, mi búsqueda al fin cesó!","Reinando‿en vida con Cristo estoy.","En Él yo triunfo, ¡qué satisfacción!","Es por Su misma cruz que Suyo soy."]}]}