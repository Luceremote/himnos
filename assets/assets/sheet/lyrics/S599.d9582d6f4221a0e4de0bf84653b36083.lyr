{"hymn":"S599","parent":"E777","quality":"adapted","adjust":{"hold":0,"merge":3},"title":"A este monte dile","subtitle":"Oración—En fe","syl":{"n1":["A‿es","i"],"n2":["te","t"],"n3":["mon","i"],"n4":["te","t"],"n5":["di","i"],"n6":["le:","t"],"n9":"\"¡Al","n10":"mar","n11":["pro","i"],"n12":["fun","m"],"n13":["do","t"],"n14":"ve‿te!\";","n17":"Tu","n18":["co","i"],"n19":["ra","m"],"n20":["zón","t"],"n21":"no","n22":"du‿de","n25":"Y","n26":"tú","n27":["ve","i"],"n28":["rás","t"],"n29":["el‿he","i"],"n30":["cho.","t"],"n33":"No","n34":["du","i"],"n35":["des","t"],"n36":"Su","n37":["pa","i"],"n38":["la","m"],"n39":["bra","t"],"n40":"hoy,","n41":"¡Al","n42":["mon","i"],"n43":["te","t"],"n44":["man","i"],"n46":["da‿en","t"],"n47":"el","n48":["Se","i"],"n49":["ñor!","t"]},"verses":[{"label":"2.","lines":["Reclama tu derecho,","Pues fuiste redimido;","La Trinidad unida","Lo hace verdadero.","Acata Su Palabra fiel,","¡Al monte manda‿en el Señor!"]},{"label":"3.","lines":["La enfermedad, el ego,","Tristezas y el pecado:","Todo llevó el Amado,","Y tú fuiste librado.","Descansa en Su Palabra hoy,","¡Al monte manda‿en el Señor!"]},{"label":"4.","lines":["Rodea el fuerte muro,","Orando en silencio,","Y antes que caiga,","Da el grito victorioso,","Firme en la fe se logrará,","¡Al monte manda‿en el Señor!"]},{"label":"5.","lines":["De hierro son las harras","De bronce son las puertas,","Las los conquistadores","Las vencen con gran fuerza,","Al enemigo hay que ignorar,","¡Al monte manda‿en el Señor!"]},{"label":"6.","lines":["La fe de Dios reclama,","No dudes ni un momento;","La milagrosa vara","Derriba argumentos,","En Su Palabra firme y fiel","¡Al monte manda‿en el Señor!"]}]}