{"hymn":"S116","parent":"E141","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Jesús, de espinas coronado","subtitle":"Alabanza al Señor—Su gloria","syl":{"n1":"Je‿sús,","n3":["de‿es","i"],"n4":["pi","m"],"n5":["nas","t"],"n6":["co","i"],"n7":["ro","m"],"n8":["na","m"],"n10":["do,","t"],"n11":"Con","n12":["glo","i"],"n13":["ria‿a","m"],"n14":["ho","m"],"n15":["ra‿es","m"],"n16":["tás;","t"],"n18":"Tú","n19":["e","i"],"n20":["res","t"],"n21":"hoy","n22":"el","n23":["Vic","i"],"n24":["to","m"],"n25":["rio","m"],"n26":["so","t"],"n28":"En","n29":["ple","i"],"n30":["na","t"],"n31":["ma","i"],"n32":["jes","m"],"n33":["tad.","t"]},"verses":[{"label":"2.","lines":["Para los santos, luz Tú eres","Y gozo sin igual;","¡Oh, manifiéstanos Tu‿amor","En su profundidad!"]},{"label":"3.","lines":["Tu cruz con toda su vergüenza","Y gracia se nos dio;","Tu nombre‿aquí fue renegado,","Mas Dios lo exaltó."]},{"label":"4.","lines":["Señor, quien sufra hoy contigo,","Contigo reinará;","Por eso‿el precio pagaremos","Hasta‿en Tu gozo entrar."]},{"label":"5.","lines":["La cruz que fue Tu muerte y pena,","Nos es vida y salud;","Nuestro presente gozo y gloria","Es por su gran virtud."]}]}