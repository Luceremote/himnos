{"hymn":"S152","parent":"E193","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, el todo en todo Tú","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":"el","n4":["to","i"],"n6":["do‿en","t"],"n7":["to","i"],"n8":["do","t"],"n9":"Tú,","n10":"¡Lo","n11":["má","i"],"n13":["xi","m"],"n14":["mo‿en","t"],"n16":["ver","i"],"n17":["dad!","t"],"n19":"Lo","n20":["que‿e","i"],"n21":["res","t"],"n22":"nos","n24":["sa","i"],"n25":["tis","m"],"n26":["fa","m"],"n27":["rá,","t"],"n28":["Cual","i"],"n29":["quier","t"],"n30":["ne","i"],"n31":["ce","m"],"n33":["si","m"],"n34":["dad.","t"],"n36":["Te‿a","i"],"n37":["do","m"],"n38":["ra","t"],"n39":["nues","i"],"n41":["tro‿es","m"],"n42":["pí","m"],"n43":["ri","m"],"n44":["tu,","t"],"n45":["Te‿a","i"],"n46":["pre","m"],"n48":["cia‿el","t"],"n49":["co","i"],"n51":["ra","m"],"n52":["zón;","t"],"n54":"Al","n55":["con","i"],"n56":["tem","m"],"n57":["plar","t"],"n59":"Tu","n60":["ri","i"],"n61":["co","t"],"n62":"ser","n63":"Te","n64":["da","i"],"n65":["mos","t"],"n66":["ben","i"],"n68":["di","m"],"n69":["ción.","t"]},"verses":[{"label":"2.","lines":["Tú, el Profeta‿eres de Dios","Que hablas con poder;","Como Moisés, nos diste‿el plan","De Dios a conocer.","Como Jonás, Dios te envió,","De muerte‿a vida‿entrar,","Para poder creer en Ti","Por esta gran señal."]},{"label":"3.","lines":["Como‿hombre, Dios te levantó,","Profeta con gran luz,","Como‿Eliseo en amor","Milagros haces Tú.","Como Isaías, haces ver","Al Cristo sin igual;","Nos das Tu misma vida‿así,","Tan rica‿y tan real."]},{"label":"4.","lines":["El santo Sacerdote, Tú,","Que lleva el hombre a Dios;","Tal como‿Aarón, quien Dios llamó,","Nos sirves con amor.","Oh, Sumo Sacerdote fiel,","Intercediendo estás,","Y nos preservas con poder,","Guardándonos en paz."]},{"label":"5.","lines":["Tu eres Sacerdote real,","Nuestro Melquisedec,","A quien Dios manda‿a ministrar","Como‿el Rey de Salem.","Tú sacias con el vino‿y pan","Nuestra necesidad;","Nos traes a Dios para que de‿Él","Podamos disfrutar."]},{"label":"6.","lines":["Tú eres Rey, como David,","Que busca sólo‿a Dios;","Luchando por Su interés,","Tú cumples Su‿intención.","Hoy entronado con poder,","Divina‿autoridad,","Reinando‿estás en pro de Dios","Y de la‿humanidad."]},{"label":"7.","lines":["Igual que Salomón el Rey,","Tu reino es de paz;","Y con sabiduría‿harás","Su casa eternal.","Entre los santos reina ya","Aquel que no se ve,","Mas cuando reinemos con Él","Su reino se‿ha de ver."]},{"label":"8.","lines":["Profeta, Sacerdote‿y Rey,","¡Qué digno‿eres, Señor!","Valioso para‿el hombre‿y Dios;","Te‿honramos con amor.","Lo que‿eres apreciamos hoy;","Nos mueve‿el corazón;","Te‿alabaremos sin cesar","Con gracias y loor."]}]}