{"hymn":"S255","parent":"E311","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Nada he logrado, mas bien, recibí","subtitle":"La certeza y el gozo de la salvación—Liberados por el Señor","syl":{"n1":["Na","i"],"n2":["da‿he","t"],"n3":["lo","i"],"n4":["gra","m"],"n5":["do,","t"],"n6":"mas","n7":"bien,","n8":["re","i"],"n9":["ci","m"],"n10":["bí;","t"],"n11":["Gra","i"],"n12":["cia","t"],"n13":["ob","i"],"n14":["tu","m"],"n15":["ve","t"],"n16":["des","i"],"n17":["de","t"],"n18":"que","n19":["cre","i"],"n20":["í.","t"],"n21":["Fue","i"],"n22":["ra","t"],"n23":["jac","i"],"n24":["tan","m"],"n25":["cia","t"],"n26":"y","n27":["pre","i"],"n28":["sun","m"],"n29":["ción,","t"],"n30":"¡Soy","n31":"un","n32":["pe","i"],"n33":["ca","m"],"n34":["dor","t"],"n35":"que","n36":["gra","i"],"n37":["cia‿ha","m"],"n38":["lló!","t"],"n39":"¡Un","n40":["pe","i"],"n41":["ca","m"],"n42":["dor","t"],"n43":"que","n44":["gra","i"],"n45":["cia‿ha","m"],"n46":["lló!","t"],"n47":"¡Un","n48":["pe","i"],"n49":["ca","m"],"n50":["dor","t"],"n51":"que","n52":["gra","i"],"n53":["cia‿ha","m"],"n54":["lló!","t"],"n55":["Es","i"],"n56":["ta‿es","t"],"n57":["mi‿his","i"],"n58":["to","m"],"n59":["ria,‿a","t"],"n60":"Dios","n61":["se","i"],"n62":["a","t"],"n63":"la","n64":["glo","i"],"n65":["ria:","t"],"n66":"¡Soy","n67":"un","n68":["pe","i"],"n69":["ca","m"],"n70":["dor","t"],"n71":"que","n72":["gra","i"],"n73":["cia‿ha","m"],"n74":["lló!","t"]},"verses":[{"label":"2.","lines":["Por el pecado que me dominó","Fui separado muy lejos de Dios.","Jesús me‿halló y gozo me dio,","¡Soy un pecador que gracia‿halló!"]},{"label":"3.","lines":["El llanto nunca logró ayudar,","Misericordia me pudo salvar;","Por mi pecado temí a Dios;","¡Soy un pecador que gracia‿halló!"]},{"label":"4.","lines":["Hoy yo reboso en mi corazón","Al compartir de mi‿amado Señor;","Quiero decirlo con gran fervor:","¡Soy un pecador que gracia‿halló!"]}]}