{"hymn":"S231","parent":"E285","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Conmigo alégrate","subtitle":"La certeza y el gozo de la salvación—Amados por el Señor","syl":{"n1":["¡Con","i"],"n2":["mi","m"],"n3":["go‿a","m"],"n4":["lé","m"],"n5":["gra","m"],"n6":["te!","t"],"n7":"Mi","n8":["po","i"],"n9":["bre","t"],"n10":["co","i"],"n11":["ra","m"],"n12":["zón","t"],"n13":"Un","n14":"gran","n15":["te","i"],"n16":["so","m"],"n17":["ro‿un","t"],"n18":["dí","i"],"n19":["a‿ha","m"],"n20":["lló;","t"],"n21":"Hoy","n22":["lle","i"],"n24":["no‿es","m"],"n25":["tá","t"],"n26":["de‿a","i"],"n27":["mor.","t"]},"verses":[{"label":"2.","lines":["¡Conmigo‿alégrate!","Enfermo estaba yo;","Él, con Su arte de sanar,","Mi corazón curó."]},{"label":"3.","lines":["¡Conmigo‿alégrate!","Cansado estaba yo,","Pero un brazo fuerte‿hallé","Que me sostiene hoy."]},{"label":"4.","lines":["¡Conmigo‿alégrate!","Vagaba sin parar.","Él dirigió mis pies aquí;","En Él hallé mi‿hogar."]},{"label":"5.","lines":["¡Conmigo‿alégrate!","Pues un amigo hallé","Que‿escudriñó mi corazón,","Y‿aún me ama Él."]},{"label":"6.","lines":["¡No supe de Su‿amor","Que por siempre existió;","Tierno, profundo y tan fiel,","Cuán fuerte‿es este amor!"]},{"label":"7.","lines":["Todo lo‿entiendo hoy;","Reconozco Su‿hablar;","Lo‿escucho cada día‿en mí,","¿Qué más puedo desear?"]}]}