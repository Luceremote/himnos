{"hymn":"S129","parent":"E162","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Alabanzas y gracias canta la multitud","subtitle":"Alabanza al Señor—Su salvación","syl":{"n1":["A‿la","i"],"n3":["ban","m"],"n4":["zas","t"],"n5":["y‿gra","i"],"n7":["cias","t"],"n8":["can","i"],"n9":["ta","t"],"n11":"la","n12":["mul","i"],"n13":["ti","m"],"n14":["tud","t"],"n15":"En","n16":["pre","i"],"n17":["sen","m"],"n18":["cia","t"],"n19":"de","n20":["Cris","i"],"n21":["to","t"],"n22":"con","n23":["glo","i"],"n24":["ria‿en","t"],"n25":"Su","n26":"luz.","n27":"A","n28":["A","i"],"n29":["quel","t"],"n30":"que","n31":"nos","n33":["a","i"],"n34":["ma","t"],"n35":"y","n36":"nos","n37":["per","i"],"n38":["do","m"],"n39":["nó,","t"],"n40":"A","n41":"Él","n42":["se","i"],"n43":["a","t"],"n44":"la","n45":["glo","i"],"n46":["ria","t"],"n47":"y","n48":["to","i"],"n49":["do‿el","t"],"n50":["ho","i"],"n51":["nor.","t"]},"verses":[{"label":"2.","lines":["Pecadores tan sucios a los ojos de Dios","Hoy vestidos de lino tan blanco, en unión."]},{"label":"3.","lines":["Del rebelde Él hace‿un sacerdote y rey;","Nos compró con Su sangre‿y nos trajo a Su grey."]},{"label":"4.","lines":["Miserables, sin fuerzas, en pecado‿y temor","Nos buscó y nos lava mostrando Su‿amor."]},{"label":"5.","lines":["Nuestras voces con fuerzas alabanzas darán,","Así otros creyendo también cantarán."]}]}