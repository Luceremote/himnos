{"hymn":"S799","parent":"E966","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Qué esperanza, Cristo volverá","subtitle":"Esperanza de gloria—Ser salvos por completo","syl":{"n1":"¡Qué","n2":["es","i"],"n3":["pe","m"],"n4":["ran","m"],"n5":["za,","t"],"n6":["Cris","i"],"n7":["to","t"],"n8":["vol","i"],"n9":["ve","m"],"n10":["rá!","t"],"n11":["A","i"],"n12":["rre","m"],"n13":["ba","m"],"n14":["ta","m"],"n15":["dos,","t"],"n16":"¡nos","n17":["trans","i"],"n18":["for","m"],"n19":["ma","m"],"n20":["rá!","t"],"n21":["Glo","i"],"n22":["ri","m"],"n23":["fi","m"],"n24":["ca","m"],"n25":["dos","t"],"n26":"con","n27":"Él,","n28":["go","i"],"n29":["zo‿ha","m"],"n30":["brá;","t"],"n31":"A","n32":"Su","n33":["i","i"],"n34":["ma","m"],"n35":["gen","t"],"n36":"Él","n37":"nos","n38":["cam","i"],"n39":["bia","m"],"n40":["rá.","t"],"n41":["¡Glo","i"],"n42":["ria","t"],"n43":"sin","n44":"par!","n45":["¡Cris","i"],"n46":["to","t"],"n47":["ven","i"],"n48":["drá!","t"],"n49":["¡Glo","i"],"n50":["ria","t"],"n51":"sin","n52":"par!","n53":["¡Cris","i"],"n54":["to","t"],"n55":["ven","i"],"n56":["drá!","t"],"n57":["A","i"],"n58":["rre","m"],"n59":["ba","m"],"n60":["ta","m"],"n61":["dos,","t"],"n62":"¡nos","n63":["trans","i"],"n64":["for","m"],"n65":["ma","m"],"n66":["rá!","t"],"n67":"¡Qué","n68":["es","i"],"n69":["pe","m"],"n70":["ran","m"],"n71":["za!","t"],"n72":["¡Cris","i"],"n73":["to","t"],"n74":["vol","i"],"n75":["ve","m"],"n76":["rá!","t"]},"verses":[{"label":"2.","lines":["¡Qué esperanza, Cristo volverá!","Se esfumará ya la vieja creación;","No gemiremos, habrá libertad,","Disfrutaremos total salvación."]},{"label":"3.","lines":["¡Qué esperanza, Cristo volverá!","Sobre los pueblos podremos reinar;","Juntos con Él, sacerdocio real,","Su plena salvación nuestra será."]},{"label":"4.","lines":["¡Qué esperanza, Cristo volverá!","Fieles sirviendo velamos con fe,","Corriendo hasta la meta final","Para que el premio del reino nos dé."]}]}