{"hymn":"S396","parent":"E1144","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En la Biblia se ve con claridad","subtitle":"Experiencia de Cristo—Como comida y bebida","syl":{"n1":"En","n2":"la","n3":["Bi","i"],"n4":["blia","t"],"n5":"se","n6":"ve","n7":"con","n8":["cla","i"],"n9":["ri","m"],"n10":["dad","t"],"n11":"Que","n12":"Dios","n13":"a","n14":["Su‿i","i"],"n15":["ma","m"],"n16":["gen","t"],"n17":"nos","n18":["cre","i"],"n19":["ó","t"],"n20":["Pa","i"],"n21":["ra","t"],"n22":["so","i"],"n23":["juz","m"],"n24":["gar,","t"],"n25":["do","i"],"n26":["mi","m"],"n27":["nio‿ex","m"],"n28":["pre","m"],"n29":["sar","t"],"n30":"Y","n31":["lle","i"],"n32":["var","t"],"n33":"a","n34":["ca","i"],"n35":["bo‿el","t"],"n36":"plan","n37":"de","n38":"Dios.","n39":["Co","i"],"n40":["me,","t"],"n41":["co","i"],"n42":["me,","t"],"n43":"El","n44":["co","i"],"n45":["mer","t"],"n46":["nun","i"],"n47":["ca","t"],"n48":"ha","n49":"de","n50":["fal","i"],"n51":["tar.","t"],"n52":["Co","i"],"n53":["me,","t"],"n54":["co","i"],"n55":["me,","t"],"n56":["De‿es","i"],"n57":["ta","t"],"n58":["for","i"],"n59":["ma‿el","t"],"n60":["No","i"],"n61":["vio","t"],"n62":["vol","i"],"n63":["ve","m"],"n64":["rá.","t"]},"verses":[{"label":"2.","lines":["No dio instrucción, sólo dijo que","\"Todo árbol es para comer,","Pero‿el de la ciencia del bien y‿el mal","Lleva‿a muerte, ¡no comas de él!"]},{"label":"3.","lines":["Bello‿el huerto es y allí se ve","Dios como‿árbol de la vida‿en él;","Pero Satanás entra a tentar,","Y al hombre‿el otro árbol da."]},{"label":"4.","lines":["Mas vino Jesús con brillante luz;","Cristo‿el árbol de la vida es.","Lo que Dios mandó, Cristo lo cumplió;","Nos compró y se nos dio‿a comer."]},{"label":"5.","lines":["Nunca fue su fin la mente nutrir;","Toda ciencia envanecerá.","Vino para ser nuestra cena Él,","¡Come‿a Cristo sin analizar!"]},{"label":"6.","lines":["Comer al Señor en la comunión","Nos trae vida‿y multiplicación.","Hay que entender que‿el recobro es","Un banquete, no‿una religión."]},{"label":"7.","lines":["Al comer de Él, nuestra vida es;","El comer nunca ha de faltar.","La‿iglesia,‿al comer, completa‿ha de ser;","De‿esta forma‿el Novio volverá."]}]}