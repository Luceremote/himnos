{"hymn":"S542","parent":"E679","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Salvo en Jesús, mi Amado","subtitle":"Consuelo en las pruebas—En los brazos del Señor","syl":{"n1":["Sal","i"],"n2":["vo‿en","t"],"n3":["Je","i"],"n4":["sús,","t"],"n5":["mi‿A","i"],"n6":["ma","m"],"n8":["do;","t"],"n9":["Sal","i"],"n10":["vo‿en","t"],"n11":"Su","n12":["se","i"],"n13":["no‿es","m"],"n14":["toy;","t"],"n16":"Por","n17":"Su","n18":["a","i"],"n19":["mor","t"],"n20":"que","n21":["cu","i"],"n23":["bre,","t"],"n24":["Des","i"],"n26":["can","m"],"n27":["sa","t"],"n28":["mi‿al","i"],"n29":["ma","t"],"n30":"hoy.","n32":["¡O","i"],"n33":["ye,‿el","t"],"n34":["can","i"],"n35":["tar","t"],"n36":["re","i"],"n37":["sue","m"],"n38":["na!","t"],"n39":["Dul","i"],"n40":["ce","t"],"n41":"voz","n42":["ce","i"],"n43":["les","m"],"n44":["tial;","t"],"n47":"Los","n48":["san","i"],"n49":["tos","t"],"n50":["ha","i"],"n51":["cen","t"],"n52":["e","i"],"n53":["co","t"],"n54":"Con","n55":["go","i"],"n56":["zo‿es","m"],"n57":["pi","m"],"n58":["ri","m"],"n59":["tual.","t"],"n61":["Sal","i"],"n62":["vo‿en","t"],"n63":["Je","i"],"n64":["sús,","t"],"n65":["mi‿A","i"],"n66":["ma","m"],"n68":["do;","t"],"n69":["Sal","i"],"n70":["vo‿en","t"],"n71":"Su","n72":["se","i"],"n73":["no‿es","m"],"n74":["toy;","t"],"n76":"Por","n77":"Su","n78":["a","i"],"n79":["mor","t"],"n80":"que","n81":["cu","i"],"n83":["bre,","t"],"n85":["Des","i"],"n86":["can","m"],"n87":["sa","t"],"n88":["mi‿al","i"],"n89":["ma","t"],"n90":"hoy."},"verses":[{"label":"2.","lines":["Salvo soy, en Sus brazos,","De ansiedad mordaz,","De tentación mundana,","De muerte y de pecar.","Libre del llanto en penas,","Del miedo y el dudar;","Sólo unas pruebas quedan,","Y un poco más llorar."]},{"label":"3.","lines":["Es mi Jesús, Refugio;","Por mí Jesús murió;","Firme en la Roca eterna","Siempre me hallaré.","Esperaré, paciente,","Hasta que salga el sol,","Hasta que desvanezca","La densa noche atróz."]}]}