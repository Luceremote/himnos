{"hymn":"S378","parent":"E493","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Señor, el Espíritu eres hoy","subtitle":"Experiencia de Cristo—Como Espíritu","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":["el‿Es","i"],"n4":["pí","m"],"n6":["ri","m"],"n7":["tu‿e","m"],"n9":["res","t"],"n10":"hoy","n11":"Que","n12":["vi","i"],"n13":["vi","m"],"n14":["fi","m"],"n15":["ca‿y","t"],"n16":["vi","i"],"n17":["da","t"],"n18":"da;","n19":"Nos","n20":["for","i"],"n21":["ta","m"],"n22":["le","m"],"n23":["ce","t"],"n24":"Tu","n25":["cau","i"],"n26":["dal,","t"],"n27":"¡Oh,","n28":"qué","n30":["glo","i"],"n31":["rio","m"],"n33":["so‿y","t"],"n34":["di","i"],"n36":["vi","m"],"n37":["nal!","t"]},"verses":[{"label":"2.","lines":["Señor, el Espíritu eres hoy","Que nos libera con poder;","Nos trae Tu gran liberación","La ley de vida a nuestro ser."]},{"label":"3.","lines":["Señor, el Espíritu eres hoy","Que transformándonos esta,","Y a Tu imagen con Tu luz","A Ti Él nos conformara."]},{"label":"4.","lines":["Señor, el Espíritu eres hoy","Que habita en mi espíritu;","Mi espíritu se une a Él,","Y uno así los haces Tú."]},{"label":"5.","lines":["Señor, enséñame‿a ejercitar","Mi espíritu y en él andar,","A contactar Tu Espíritu","Y así vivir Tu realidad."]}]}