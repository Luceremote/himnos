{"hymn":"S511","parent":"E1201","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Desde el norte viene el viento","subtitle":"Experiencia de Dios—Como viento, nube, fuego y electro","syl":{"n1":["Des","i"],"n2":["de‿el","t"],"n3":["nor","i"],"n4":["te","t"],"n5":["vie","i"],"n6":["ne‿el","t"],"n7":["vien","i"],"n8":["to,","t"],"n9":["Des","i"],"n10":["de","t"],"n11":["don","i"],"n12":["de‿ha","m"],"n13":["bi","m"],"n14":["ta","t"],"n15":"Dios.","n16":["Nues","i"],"n17":["tro","t"],"n18":"ser","n19":"es","n20":["cap","i"],"n21":["tu","m"],"n22":["ra","m"],"n23":["do:","t"],"n24":"¡El","n25":["Es","i"],"n26":["pí","m"],"n27":["ri","m"],"n28":["tu","t"],"n29":["so","i"],"n30":["pló!","t"],"n31":["Es","i"],"n32":["te","t"],"n33":["vien","i"],"n34":["to","t"],"n35":"nos","n36":["des","i"],"n37":["pier","m"],"n38":["ta,","t"],"n39":"Nos","n40":["con","i"],"n41":["mue","m"],"n42":["ve‿en","t"],"n43":["lo‿in","i"],"n44":["te","m"],"n45":["rior.","t"],"n46":"Hoy","n47":"la","n48":["nu","i"],"n49":["be‿a","m"],"n50":["sí","t"],"n51":["des","i"],"n52":["cien","m"],"n53":["de,","t"],"n54":"Nos","n55":["a","i"],"n56":["bri","m"],"n57":["mos","t"],"n58":"ya","n59":"a","n60":"Dios."},"verses":[{"label":"2.","lines":["Es la nube Su presencia:","Permanece y cubre Dios;","Hoy confiamos plenamente,","Pues cercano está el Señor.","Mas la nube trae fuego","Que consume nuestro yo;","Y lo celestial podemos","Recibir en lo interior."]},{"label":"3.","lines":["En el fuego algo brilla","Es electro en su esplendor.","¡Dios es oro, el hombre, plata:","Hoy mezclados en unión!","El metal tan refulgente","Es nuestro Cordero-Dios.","Como electro, resplandece,","Fórjate en nuestro interior."]},{"label":"4.","lines":["Al pasar por este ciclo,","Expresamos a Jesús,","Siendo los seres vivientes;","Con Él, uno en plenitud.","Lo expresamos como hombre","Fino en Su humanidad,","Tan normal y equilibrado,","Mas también tan divinal."]},{"label":"5.","lines":["Cual león, lo expresamos,","Conquistando al rival;","Y cual buey en obediencia","Para siempre ministrar.","Como águila expresamos","Este trascendente Dios,","Quien se eleva sin temores","Sobre todo en ascensión."]},{"label":"6.","lines":["¡Aleluya! ¡Qué figura","De los tratos hoy con Dios!","Viento, nube, fuego, electro","Y criaturas en unión;","Hoy los cuatro: buey y hombre,","Águila, también león,","Lo expresan plenamente","Al comer más del Señor."]}]}