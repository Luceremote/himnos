{"hymn":"S326","parent":"E1132","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Enseñanos a orar","subtitle":"Anhelos—De crecer en vida","syl":{"n1":["En","i"],"n2":["se","m"],"n3":["ña","m"],"n4":["nos","t"],"n5":["a‿o","i"],"n6":["rar,","t"],"n8":"No","n9":["co","i"],"n10":["mo","t"],"n11":"las","n12":["na","i"],"n13":["cio","m"],"n14":["nes","t"],"n15":"hoy;","n17":["¡Per","i"],"n18":["mí","m"],"n19":["te","m"],"n20":["nos","t"],"n21":["cam","i"],"n22":["biar!","t"],"n24":"Que","n25":["te‿in","i"],"n26":["vo","m"],"n27":["que","m"],"n28":["mos","t"],"n29":["ca","i"],"n30":["da","t"],"n31":["dí","i"],"n32":["a","t"],"n33":"más:","n35":["Cre","i"],"n36":["ce‿en","t"],"n37":["no","i"],"n38":["so","m"],"n40":["tros,","t"],"n41":"Se‿ñor."},"verses":[{"label":"2.","lines":["Simiente viva, Tú,","Sembrada‿en nuestro corazón;","Ya puedes comenzar","A impartir tu vida más y más:","Crece‿en nosotros, Señor."]},{"label":"3.","lines":["Señor, ablándanos;","Conoces nuestro‿origen bien.","Señor, al invocar","Tu nombre, toda piedra‿has de quitar:","Crece‿en nosotros, Señor."]},{"label":"4.","lines":["Tu luz nos hace ver","Que sólo vamos a fallar.","Más un mensaje hay;","La simiente de vida triunfará:","Crece‿en nosotros, Señor."]},{"label":"5.","lines":["En nuestro espíritu","Deseamos pobres siempre ser;","Tomamos el fluir","De vida, que nos hace‿así crecer:","Crece‿en nosotros, Señor."]},{"label":"6.","lines":["Puros de corazón,","Te buscaremos hasta ver","Que llenes nuestro ser;","Mente,‿emoción y voluntad ganad:","Crece‿en nosotros, Señor."]},{"label":"7.","lines":["¡Oh, haznos entender","Que la simiente‿ha de vencer!","Tomarte‿es menester;","Tu crecimiento,‿el reino‿ha de traer:","Crece‿en nosotros, Señor."]},{"label":"8.","lines":["Crece la vida,‿¡amén!","Tu vida, todo puede‿hacer;","La vida triunfará,","Y todo nuestro ser renovará:","Crece‿en nosotros, Señor.","Crece‿en nosotros, Señor."]}]}