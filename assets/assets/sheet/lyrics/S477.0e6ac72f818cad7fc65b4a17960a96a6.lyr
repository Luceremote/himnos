n","n136":["siem","i"],"n137":["pre","t"],"n138":"me‿han","n139":"de","n140":["se","i"],"n141":["guir.","t"]},"verses":[{"label":"2.","lines":["El mismo Pastor es mis pastos,","Aguas de reposó a la vez;","Le como y mi espíritu nutre,","Le bebo y Él calma mi sed."]},{"label":"3.","lines":["Mi alma el Pastor me restaura:","Mente, voluntad, emoción,","Y aunque en el valle yo ande,","Conmigo camina el Señor."]},{"label":"4.","lines":["Prepara el Pastor una mesa;","Yo ceno y sufre‿el rival;","Me unge con óleo de gozo,","Mi copa rebosando está."]},{"label":"5.","lines":["Ahora yo moro en Su casa,","Disfruto el bien de mi Dios;","Encuentro placer sin medida,","Pues es mi placer mi Señor."]}]}