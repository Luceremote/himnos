{"hymn":"S196","parent":"E249","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Fluye de mí, Señor, un váso frágil","subtitle":"La plenitud del Espíritu—Como agua viva","syl":{"n1":["Flu","i"],"n2":["ye","t"],"n3":"de","n4":"mí,","n6":["Se","i"],"n7":["ñor,","t"],"n8":"un","n9":["vá","i"],"n10":["so","t"],"n11":["frá","i"],"n12":["gil,","t"],"n13":"Que","n14":["re","i"],"n15":["di","m"],"n16":["mis","m"],"n17":["te","t"],"n18":["pa","i"],"n19":["ra‿en","t"],"n20":"Ti","n21":["ser","i"],"n22":["vir.","t"],"n23":["Flu","i"],"n24":["ye","t"],"n25":"de","n26":"mi,","n27":"yo","n28":"me","n29":"he","n30":["con","i"],"n31":["sa","m"],"n32":["gra","m"],"n33":["do","t"],"n34":"A","n35":"Tu","n36":["ser","i"],"n37":["vi","m"],"n38":["cio","t"],"n39":"tan","n40":["que","i"],"n41":["ri","m"],"n42":["do‿a","t"],"n43":"mi."},"verses":[{"label":"2.","lines":["Fluye de mí, Señor, en abundancia,","Hazme sentir hoy Tu profundo‿amor.","Forja en mí la fe que mueve montes,","Como‿el poder que salva‿al pecador."]},{"label":"3.","lines":["Fluye de mí hasta que los cautivos","Sean librados de su‿esclavitud;","Fluye de mí hasta que, en Tu fuente,","Encuentren sanidad y plenitud."]},{"label":"4.","lines":["Fluye de mí hasta que, en victoria,","Canten los derrotados su canción;","Y esos labios mudos te alaben","Junto con los que gozan salvación."]},{"label":"5.","lines":["Fluye de mí, hasta que broten aguas","Que sacien almas de su‿intensa sed.","Fluye de mí hasta que los desiertos","De rosas frescas puedan florecer."]},{"label":"6.","lines":["Fluye de mí, hasta que toda mi alma","Resuene con Tu inefable‿amor.","Fluye de mí hasta que nada pueda","Saciar mi ser, más sólo Tú, Señor."]}]}