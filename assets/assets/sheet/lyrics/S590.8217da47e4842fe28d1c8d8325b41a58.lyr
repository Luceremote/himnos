{"hymn":"S590","parent":"E766","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Enséñame, Señor, a orar","subtitle":"Oración—La enseñanza","syl":{"n1":["En","i"],"n2":["sé","m"],"n3":["ña","m"],"n4":["me,","t"],"n5":["Se","i"],"n6":["ñor,","t"],"n7":"a","n8":["o","i"],"n9":["rar;","t"],"n11":"Mi","n12":["co","i"],"n13":["ra","m"],"n14":["zón","t"],"n15":["lo‿an","i"],"n16":["he","m"],"n17":["la‿en","t"],"n18":["ver","i"],"n19":["dad;","t"],"n21":["En","i"],"n22":["sé","m"],"n23":["ña","m"],"n24":["me,","t"],"n25":"Dios,","n26":"Tu","n27":["vo","i"],"n28":["lun","m"],"n29":["tad;","t"],"n31":["En","i"],"n32":["sé","m"],"n33":["ña","m"],"n34":["me,","t"],"n35":["Se","i"],"n36":["ñor,","t"],"n37":"a","n38":["o","i"],"n39":["rar.","t"],"n41":["Vi","i"],"n42":["vir","t"],"n43":"en","n44":"Ti,","n45":["Se","i"],"n46":["ñor,","t"],"n47":"y","n48":"Tú‿en","n49":"mí,","n51":"Mi","n52":["rue","i"],"n53":["go","t"],"n54":"es","n55":"que","n56":"yo","n57":["mo","i"],"n58":["re‿a","m"],"n59":["sí;","t"],"n61":["Da","i"],"n62":["me‿el","t"],"n63":["po","i"],"n64":["der","t"],"n65":["que‿a","i"],"n66":["bun","m"],"n67":["da","t"],"n68":"sin","n69":"fin","n71":["An","i"],"n72":["te","t"],"n73":"los","n74":["hom","i"],"n75":["bres","t"],"n76":"y","n77":["an","i"],"n78":["te","t"],"n79":"Ti."},"verses":[{"label":"2.","lines":["¡Dame la fuerza para orar!","Toda la tierra en angustia está;","Almas muriendo en su afán,","¡Dame el poder que viene al orar!"]},{"label":"3.","lines":["Mi voluntad puedes renovar,","Y el pecado en mí subyugar;","¡Con Tu poder hoy llena mi ser","Para orar y para hacer!"]},{"label":"4.","lines":["Enséñame, Señor, a orar;","Tú, mi modelo diario serás;","Por siempre en Ti yo he de confiar;","Enséñame, Señor, a orar."]}]}