{"hymn":"S636","parent":"E819","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Como el cuerpo nuestra vida","subtitle":"La iglesia—El aumento de Cristo","syl":{"n1":["Co","i"],"n3":["mo‿el","t"],"n4":["cuer","i"],"n5":["po","t"],"n6":["nues","i"],"n7":["tra","t"],"n8":["vi","i"],"n9":["da","t"],"n10":["Ex","i"],"n12":["pre","m"],"n13":["san","m"],"n14":["do‿es","m"],"n15":["tá,","t"],"n16":"Por","n18":["la‿i","i"],"n19":["gle","m"],"n20":["sia","t"],"n22":["pue","i"],"n23":["de","t"],"n24":["Cris","i"],"n25":["to","t"],"n26":"Su","n28":["vi","i"],"n29":["da‿ex","m"],"n30":["pre","m"],"n31":["sar.","t"]},"verses":[{"label":"2.","lines":["Como Eva fue sacada","Del primer Adán,","El aumento hoy de Cristo","En la iglesia está."]},{"label":"3.","lines":["Como al enterrar un grano,","Muchos más saldrán,","Y los granos bien molidos","Formarán un pan;"]},{"label":"4.","lines":["Es la iglesia para Cristo","Su duplicación;","Y expresa como el Cuerpo","La gloria de Dios."]},{"label":"5.","lines":["Por los pámpanos obtiene","La vid su extensión,","Permanecen y dan fruto","Para su expresión."]},{"label":"6.","lines":["Son los miembros de la iglesia","La viva expansión","Del Señor, y a Él unidos","Su amplificación."]},{"label":"7.","lines":["Para Cristo es la iglesia","Su continuación,","Plenitud, agrandamiento,","Y Su expresión."]},{"label":"8.","lines":["Dios en Cristo por la iglesia","Gloria obtendrá","En Sus muchos redimidos","Por la eternidad."]},{"label":"9.","lines":["Gran misterio es la iglesia","Con Cristo‿en unión:","Dios mezclado con los hombres","Para Su expresión."]}]}