{"hymn":"S42","parent":"E53","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tu nombre adoramos, Padre Dios","subtitle":"Adoración al Padre—Alabanza a Él de parte de sus muchos hijos","syl":{"n1":"Tu","n2":["nom","i"],"n3":["bre","t"],"n4":["a","i"],"n5":["do","m"],"n6":["ra","m"],"n7":["mos,","t"],"n8":["Pa","i"],"n9":["dre","t"],"n10":"Dios,","n12":["Tu‿a","i"],"n13":["mor","t"],"n14":"en","n15":["Cris","i"],"n16":["to","t"],"n17":"se","n18":"nos","n19":["re","i"],"n20":["ve","m"],"n21":["ló.","t"],"n23":"Tu","n24":["vo","i"],"n25":["lun","m"],"n26":["tad","t"],"n27":"con","n28":["go","i"],"n29":["zo‿Él","t"],"n30":["rea","i"],"n31":["li","m"],"n32":["zó,","t"],"n34":["Cuan","i"],"n35":["do‿el","t"],"n36":["o","i"],"n37":["pro","m"],"n38":["bio","t"],"n39":"en","n40":"la","n41":"cruz","n43":["su","i"],"n44":["frió.","t"]},"verses":[{"label":"2.","lines":["Aquí Él canta alabanza a Tí;","Al escucharlo, bulle nuestro ser.","Junto‿a Su voz alzamos hoy loor","Con nuestro espíritu unido‿a Él."]},{"label":"3.","lines":["En Tu Hijo‿amado fue Tu elección","Para que‿estemos ante Ti‿en amor,","Predestinándonos para estar","Donde Tu gracia‿abunda‿y Tu favor."]},{"label":"4.","lines":["Tus hijos llenas con Tu‿Espíritu;","Cristo‿en nosotros es nuestra porción;","Sus rasgos en nosotros hoy están,","Para Tu gozo y deleite son."]}]}