{"hymn":"S728","parent":"E882","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Soldados, hijos de la luz, ¡banderas levantad","subtitle":"La guerra espiritual—En fe","syl":{"n1":["Sol","i"],"n2":["da","m"],"n3":["dos,","t"],"n4":["hi","i"],"n5":["jos","t"],"n6":"de","n7":"la","n8":"luz,","n9":["¡ban","i"],"n10":["de","m"],"n11":["ras","t"],"n12":["le","i"],"n13":["van","m"],"n14":["tad!","t"],"n16":["De","i"],"n17":["vo","m"],"n18":["tos","t"],"n19":"del","n20":["Se","i"],"n21":["ñor","t"],"n22":["Je","i"],"n23":["sús,","t"],"n24":"la","n25":["gue","i"],"n26":["rra‿a","m"],"n27":["pre","m"],"n28":["su","m"],"n29":["rad;","t"],"n31":["Pa","i"],"n32":["ra","t"],"n33":"que","n34":["e","i"],"n35":["se","t"],"n36":"vil","n37":["ri","i"],"n38":["val","t"],"n39":"se","n40":["pue","i"],"n41":["da","t"],"n42":["sub","i"],"n43":["yu","m"],"n44":["gar;","t"],"n46":"Ten","n47":"fe‿en","n48":["A","i"],"n49":["quel","t"],"n50":"que","n51":"ya","n52":["ven","i"],"n53":["ció,","t"],"n54":["vic","i"],"n55":["to","m"],"n56":["ria‿a","m"],"n57":["sí","t"],"n58":["lo","i"],"n59":["grad.","t"],"n62":"¡Fe","n64":"la","n65":["vic","i"],"n66":["to","m"],"n67":["ria","t"],"n68":"es!","n69":"¡Fe","n71":"la","n72":["vic","i"],"n73":["to","m"],"n74":["ria","t"],"n75":"es!","n76":["Glo","i"],"n77":["rio","m"],"n78":["sa","t"],"n79":["vic","i"],"n80":["to","m"],"n81":["ria","t"],"n82":"que","n83":"Al","n84":["mun","i"],"n85":["do","t"],"n86":["ven","i"],"n87":["ce","t"],"n88":"ya."},"verses":[{"label":"2.","lines":["Hoy Su bandera de amor es para batallar,","Y la Palabra fiel de Dios, la espada, hay que emplear;","Marchemos por la senda en que los santos del ayer","Triunfantes fueron por la fe, la muerte aun al vencer."]},{"label":"3.","lines":["Dejemos toda languidez, ¡cerca el peligró está!","Tomemos \"yelmo de salud\", \"ceñidos ... de verdad\"","\"Del evangelio de la paz\" calcémonos los pies,","En \"cota de justicia\" andar, y \"escudo\" alzar \"de fe\"."]},{"label":"4.","lines":["\"Al que venciere\" se dará ropaje blanco en luz;","¡Qué galardón! Confesará su nombre allí, Jesús;","Resueltos, adelante hoy id y a Cristo ensalzad;","Su encargo de amor cumplid, victoria así lograd."]}]}