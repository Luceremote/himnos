{"hymn":"S692","parent":"E1237","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Oh, qué espléndida es la iglesia como el huerto del Señor","subtitle":"La iglesia—Como nuestro hogar y descanso","syl":{"n1":"¡Oh,","n2":["qué‿es","i"],"n3":["plén","m"],"n4":["di","m"],"n5":["da‿es","t"],"n6":["la‿i","i"],"n7":["gle","m"],"n8":["sia","t"],"n9":["co","i"],"n10":["mo‿el","t"],"n11":["huer","i"],"n12":["to","t"],"n13":"del","n14":["Se","i"],"n15":["ñor!","t"],"n16":"Él","n17":"nos","n18":["tra","i"],"n19":["jo‿a","m"],"n20":["quí","t"],"n21":["pa","i"],"n22":["ra‿ex","m"],"n23":["pe","m"],"n24":["ri","m"],"n25":["men","m"],"n26":["tar","t"],"n27":["A‿es","i"],"n28":["te","t"],"n29":["Cris","i"],"n30":["to","t"],"n31":["dis","i"],"n32":["fru","m"],"n33":["ta","m"],"n34":["ble","t"],"n35":"con","n36":"los","n37":["san","i"],"n38":["tos","t"],"n39":"en","n40":["u","i"],"n41":["nión,","t"],"n42":"Quien","n43":"es","n44":["fres","i"],"n45":["co,","t"],"n46":["dis","i"],"n47":["po","m"],"n48":["ni","m"],"n49":["ble,‿y","t"],"n50":"sin","n51":["i","i"],"n52":["gual.","t"],"n54":"¡Qué","n55":["con","i"],"n56":["ten","m"],"n58":["to","t"],"n59":"en","n60":"Su","n61":["huer","i"],"n62":["to‿es","m"],"n63":["toy,","t"],"n64":["Don","i"],"n65":["de","t"],"n66":"por","n67":"Su","n68":["gra","i"],"n69":["cia","t"],"n70":["crez","i"],"n71":["co","t"],"n72":"hoy!","n73":"Del","n74":["ár","i"],"n75":["bol","t"],"n76":"de","n77":"la","n78":["vi","i"],"n79":["da","t"],"n80":["pue","i"],"n81":["do‿a","t"],"n82":["dia","i"],"n83":["rio‿a","m"],"n84":["quí","t"],"n85":["co","i"],"n86":["mer","t"],"n87":"Y","n88":"del","n89":["rí","i"],"n90":["o","t"],"n91":["de‿a","i"],"n92":["gua","t"],"n93":["vi","i"],"n94":["va‿es","t"],"n95":"mi","n96":["be","i"],"n97":["ber.","t"]},"verses":[{"label":"2.","lines":["No es escuela ni una fábrica o capilla celestial,","Sino un huerto en que el Señor puede sembrar.","Pues, por eso, Él nos hizo hoy Su huerto encantador,","Donde en vida Él nos puede cultivar."]},{"label":"3.","lines":["En la vida de la iglesia hay un árbol para ti","Con el fruto de la vida a granel.","No te enreden tus conceptos, de ese árbol come, así;","Toma a Jesús, ¡es dulce cada vez!"]},{"label":"4.","lines":["Con el árbol fluye el agua: Dios en Cristo a nuestro ser,","Apagando toda nuestra sequedad.","¡Aleluya por la vida que nos hace así crecer,","Por el agua que el Espíritu nos da!"]},{"label":"5.","lines":["¿No te sientes satisfecho que el Señor te trajo aquí,","Donde fluyen las riquezas de Su ser?","Sé contento y en tu espíritu disfruta de Él allí","Para que Su huerto pueda florecer."]}]}