{"hymn":"S321","parent":"E418","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh, líbrame, mi fiel Señor","subtitle":"Anhelos—De ser librados del yo","syl":{"n1":"Oh,","n2":["lí","i"],"n3":["bra","m"],"n5":["me,","t"],"n6":"mi","n7":"fiel","n8":["Se","i"],"n9":["ñor,","t"],"n10":["De‿o","i"],"n11":["rar","t"],"n12":"por","n14":"no","n15":["su","i"],"n16":["frir","t"],"n17":["do","i"],"n18":["lor,","t"],"n19":"Del","n20":["mie","i"],"n21":["do‿en","t"],"n22":"vez","n23":"de","n24":["as","i"],"n25":["pi","m"],"n26":["rar,","t"],"n27":"De","n28":["du","i"],"n29":["das","t"],"n30":"en","n31":"vez","n32":["de‿es","i"],"n33":["ca","m"],"n34":["lar;","t"],"n35":["Li","i"],"n36":["bé","m"],"n37":["ra","m"],"n38":["me","t"],"n39":"del","n40":["blan","i"],"n41":["do","t"],"n42":"yo,","n43":["Haz","i"],"n44":["me‿un","t"],"n45":["sol","i"],"n46":["da","m"],"n47":["do,","t"],"n48":"oh","n49":["Se","i"],"n50":["ñor.","t"]},"verses":[{"label":"2.","lines":["De‿amor por cosas, líbrame,","De lo que débil me‿hace ser,","(Ese camino no tomó","El crucificado Señor),","¡Haz que‿el Calvario pueda ver!","Cordero de Dios, líbrame."]},{"label":"3.","lines":["Dame Tu amor y dirección,","La fe que vence la‿aflicción,","Dame‿esperanza firme‿y fiel,","Pasión que arda por doquier;","Tu combustible, hazme hoy,","Que ardas Tú, Fuego de Dios."]}]}