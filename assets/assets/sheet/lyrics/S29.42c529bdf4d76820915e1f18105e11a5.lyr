{"hymn":"S29","parent":"E34","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Padre, en amor nos viste","subtitle":"Adoración al Padre—Su elección","syl":{"n1":["Pa","i"],"n2":["dre,","t"],"n3":"en","n4":["a","i"],"n5":["mor","t"],"n6":"nos","n7":["vis","i"],"n8":["te","t"],"n9":["An","i"],"n10":["tes","t"],"n11":"de","n12":"la","n13":["cre","i"],"n14":["a","m"],"n15":["ción;","t"],"n16":"A","n17":["Je","i"],"n18":["sús","t"],"n19":"nos","n20":["ha‿a","i"],"n21":["cer","m"],"n22":["ca","m"],"n23":["do","t"],"n24":"Tal","n25":["a","i"],"n26":["mor","t"],"n27":["cons","i"],"n28":["tre","m"],"n29":["ñi","m"],"n30":["dor,","t"],"n31":"Y","n32":"nos","n33":["guar","i"],"n34":["da,","t"],"n35":"y","n36":"nos","n37":["guar","i"],"n38":["da","t"],"n39":"Hoy","n40":"y","n41":"por","n42":["siem","i"],"n43":["pre","t"],"n44":["ja","i"],"n45":["más,","t"],"n48":"Hoy","n49":"y","n50":"por","n51":["siem","i"],"n52":["pre","t"],"n53":["ja","i"],"n54":["más.","t"]},"verses":[{"label":"2.","lines":["Ese‿amor que nos envuelve,","Nos otorga si caudal;","Y su fuerza nos mantiene","En reposo celestial.","Dios y Padre, Dios y Padre,","Fluye a Ti la‿adoración,","Fluye a Ti la‿adoración."]},{"label":"3.","lines":["¡Dios de amor, nuestra‿alma adora!","Pues Tu gracia se verá,","Hasta‿hechar nuestras coronas","Y Tu nombre en gloria‿honrar.","Alabanzas, alabanzas!","A Dios y al Cordero dad!","A Dios y al Cordero dad!"]}]}