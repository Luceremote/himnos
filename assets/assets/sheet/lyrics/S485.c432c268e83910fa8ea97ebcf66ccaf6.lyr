{"hymn":"S485","parent":"E1179","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Mi viejo hombre con Jesús murió","subtitle":"Experiencia de Cristo—Como nuestra persona","syl":{"n1":"Mi","n2":["vie","i"],"n3":["jo","t"],"n4":["hom","i"],"n5":["bre","t"],"n6":"con","n7":["Je","i"],"n8":["sús","t"],"n9":["mu","i"],"n10":["rió,","t"],"n11":"Con","n12":"sus","n13":["pe","i"],"n14":["ca","m"],"n15":["dos","t"],"n16":["y‿hon","i"],"n17":["da","t"],"n18":["co","i"],"n19":["rrup","m"],"n20":["ción;","t"],"n21":"Lo","n22":["ser","i"],"n23":["pen","m"],"n24":["ti","m"],"n25":["no","t"],"n26":["en","i"],"n27":["te","m"],"n28":["rra","m"],"n29":["do","t"],"n30":"fue","n31":["Lle","i"],"n32":["gó‿a","t"],"n33":"su","n34":"fin,","n35":"y‿a","n36":["es","i"],"n37":["te‿he","m"],"n38":["cho","t"],"n39":["re","i"],"n40":["al","t"],"n41":["Me‿a","i"],"n42":["fe","m"],"n43":["rro","t"],"n44":"yo."},"verses":[{"label":"2.","lines":["Una Persona hay en mi‿espíritu,","Nació como‿un bebé en mí: Jesús,","Quien con la leche pura crecerá,","Y como el interno Vencedor","Conquistará."]},{"label":"3.","lines":["Tú eres mi persona, oh Señor;","Posee Tú todo mi corazón;","El viejo yo murió, mas sigue‿allí.","¡Extiéndete, Señor, te pido, haz","Tu‿hogar en mí!"]},{"label":"4.","lines":["Un solo espíritu con el Señor;","Lo humano y lo divino uno son;","Mas Él mi alma tiene que ganar","Para expresar hoy Su gloriosa","Personalidad."]},{"label":"5.","lines":["Por tanto a Ti te doy mi corazón,","Para que sea Tu hogar, Señor,","Lugar donde te puedas asentar","Y recobrar un solo y nuevo hombre","Para Dios."]}]}