{"hymn":"S416","parent":"E526","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Señor, hoy eres en verdad","subtitle":"Experiencia de Cristo—Como aquel que es el todo","syl":{"n1":["Se","i"],"n2":["ñor,","t"],"n3":"hoy","n4":["e","i"],"n6":["res","t"],"n7":"en","n9":["ver","i"],"n10":["dad","t"],"n11":["U","i"],"n12":["na","t"],"n13":["vi","i"],"n14":["vien","m"],"n15":["te","t"],"n16":["rea","i"],"n18":["li","m"],"n19":["dad;","t"],"n20":"Por","n21":"fe","n22":"hoy","n23":"te","n25":["per","i"],"n26":["ci","m"],"n28":["bo","t"],"n29":"más","n30":"Que","n31":["to","i"],"n32":["do‿ob","m"],"n33":["je","m"],"n34":["to","t"],"n35":["te","i"],"n37":["rre","m"],"n38":["nal;","t"],"n39":["E","i"],"n40":["res","t"],"n41":"más","n42":["ín","i"],"n43":["ti","m"],"n44":["mo","t"],"n45":"a","n46":"mí","n47":"Que‿el","n48":"más","n49":["cer","i"],"n50":["ca","m"],"n51":["no","t"],"n52":["la","i"],"n53":["zo‿a","m"],"n54":["quí.","t"]},"verses":[{"label":"2.","lines":["Tú, que mi alma contempló,","Me restauraste en amor;","Purificaste mi‿intención;","¡Santa‿y ferviente‿es mi pasión!","Has elevado Tú mi ser;","Gloriosa mi esperanza es."]},{"label":"3.","lines":["Más cerca‿y más querido sé,","Mi Salvador, mi‿amado Rey;","Más quiero yo Tu rostro ver,","Gracia‿en Tu‿hablar impárteme;","Vida transformas en amor;","Gracia y piedad hoy mías son."]}]}