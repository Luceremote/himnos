{"hymn":"S328","parent":"E1135","quality":"check","adjust":{"hold":0,"merge":0},"title":"Oh, santifícanos con más de Ti, Señor","subtitle":"Anhelos—De santificación","syl":{"n1":"Oh,","n2":["san","i"],"n3":["ti","m"],"n4":["fí","m"],"n5":["ca","m"],"n6":["nos","t"],"n7":"con","n8":"más","n9":"de","n10":"Ti,","n11":["Se","i"],"n12":["ñor,","t"],"n13":"Que","n14":"Tu","n15":["per","i"],"n16":["so","m"],"n17":["na","t"],"n18":"hoy","n19":["se‿ex","i"],"n20":["tien","m"],"n21":["da‿en","t"],"n22":["lo‿in","i"],"n23":["te","m"],"n24":["rior.","t"],"n25":["La‿i","i"],"n26":["gle","m"],"n27":["sia‿a","m"],"n28":["sí","t"],"n29":["se","i"],"n30":["rá","t"],"n31":["glo","i"],"n32":["rio","m"],"n33":["sa‿en","t"],"n34":["rea","i"],"n35":["li","m"],"n36":["dad,","t"],"n37":"¡Oh,","n38":["da","i"],"n39":["nos","t"],"n40":"más","n41":"de","n42":"Ti,","n43":["Se","i"],"n44":["ñor!","t"],"n46":["¡O","i"],"n47":["bra","t"],"n48":"en","n49":["nues","i"],"n51":["tro","t"],"n52":"ser,","n53":["Se","i"],"n54":["ñor!","t"],"n56":["Glo","i"],"n57":["rio","m"],"n58":["sa","t"],"n59":"haz","n60":"Tu","n61":["i","i"],"n62":["gle","m"],"n63":["sia‿hoy.","t"],"n65":["Ex","i"],"n66":["tién","m"],"n67":["de","m"],"n68":["te,","t"],"n69":["Se","i"],"n70":["ñor,","t"],"n71":"En","n72":["to","i"],"n73":["do","t"],"n74":["nues","i"],"n75":["tro","t"],"n76":"ser;","n77":["¡Haz","i"],"n78":["nos","t"],"n79":["glo","i"],"n80":["rio","m"],"n81":["sos","t"],"n82":"hoy,","n83":["Se","i"],"n84":["ñor!","t"]},"verses":[{"label":"2.","lines":["Oh, purifícanos hablando al corazón,","Pues Tu viviente hablar nos lavará, Señor","Por Tu palabra viva en nuestro interior,","¡Oh, purifícanos, Señor!"]},{"label":"3.","lines":["Oh, aliméntanos, Señor, susténtanos,","Pues al comer de Tí se sacia el corazón,","Y en nuestra vida así habrá transformación,","¡Oh, aliméntanos, Señor!"]},{"label":"4.","lines":["Oh, con Tu tierno amor hoy cuídanos, Señor,","Al darnos de comer, ablanda el corazón.","Así nos ganarás como Tu posesión.","¡Oh, cuídanos, tierno Señor!"]},{"label":"5.","lines":["Al Tú obrar así en nuestro interior,","La iglesia ha de ser gloriosa en Tí, Señor;","Por fin Tú obtendrás la novia de Tu amor.","¡Obra en nuestro ser, Señor!"]}]}