{"hymn":"S148","parent":"E189","quality":"exact","adjust":{"hold":0,"merge":0},"title":"El Hijo amado eres","subtitle":"Alabanza al Señor—Lo todo-inclusivo que es Él","syl":{"n1":"El","n2":["Hi","i"],"n3":["jo","t"],"n4":["a","i"],"n5":["ma","m"],"n6":["do‿e","m"],"n7":["res,","t"],"n8":["La‿i","i"],"n9":["ma","m"],"n10":["gen","t"],"n11":"del","n12":"gran","n13":"Dios;","n14":["Por","i"],"n15":["ción","t"],"n16":["pa","i"],"n17":["ra","t"],"n18":"los","n19":["san","i"],"n20":["tos,","t"],"n21":"Tu","n22":["san","i"],"n23":["gre","t"],"n24":"la","n25":["ga","i"],"n26":["nó.","t"],"n27":"El","n28":["Pri","i"],"n29":["mo","m"],"n30":["gé","m"],"n31":["ni","m"],"n32":["to‿e","m"],"n33":["res","t"],"n34":"De","n35":["to","i"],"n36":["da","t"],"n37":["cre","i"],"n38":["a","m"],"n39":["ción,","t"],"n40":"Por","n42":"Ti","n43":"fue","n44":["crea","i"],"n45":["do","t"],"n46":["to","i"],"n47":["do","t"],"n48":["Pa","i"],"n49":["ra","t"],"n50":"Tu","n51":["po","i"],"n52":["se","m"],"n53":["sión.","t"]},"verses":[{"label":"2.","lines":["A todo Tú precedes","Y todo existe en Ti;","De todo eres el centro,","Subsiste todo así.","El Primogénito eres","De entre los muertos, Tú,","Y de la iglesia, el Cuerpo,","Cabeza y virtud."]},{"label":"3.","lines":["La plenitud completa","En Ti morando está,","Tienes la preeminencia","Que‿en todo se verá.","Reconciliaste todo","Por Tu sangre, Señor,","Para santificados","Llevarnos ante Dios."]},{"label":"4.","lines":["De Dios, misterio eres,","Y‿en Ti Su plenitud","Está con los tesoros:","Sabiduría y luz.","Tú eres la esperanza","De gloria‿en nuestro ser,","En Ti perfectos somos","Y‿a Dios Su gran placer."]},{"label":"5.","lines":["Todo‿en verdad es sombra","Que nos da‿a conocer","La realidad del Cristo","Que vive‿en nuestro ser.","Nos llenan Tus riquezas","Hasta Tu plenitud,","Tu Cuerpo va creciendo","Con Dios en magnitud."]},{"label":"6.","lines":["Contigo nuestra vida","Está‿escondida‿en Dios;","Tu paz preside‿ahora","En nuestro corazón.","En el nuevo‿hombre eres,","El todo‿en todos Tú;","El Salvador del Cuerpo,","Tu novia y plenitud."]}]}