{"hymn":"S169","parent":"E213","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús, en esa noche","subtitle":"Alabanza al Señor—En memoria de Él","syl":{"n1":["Je","i"],"n3":["sús,","t"],"n4":"en","n5":["e","i"],"n6":["sa","t"],"n7":["no","i"],"n8":["che","t"],"n9":"Do","n10":["to","i"],"n11":["do","t"],"n12":"se","n13":["jun","i"],"n14":["tó","t"],"n15":["Pa","i"],"n17":["ra‿a","m"],"n18":["rro","m"],"n19":["jar","t"],"n20":"sus","n21":["som","i"],"n22":["bras","t"],"n23":"En","n24":"Tu","n25":["men","i"],"n26":["te,","t"],"n27":["Se","i"],"n28":["ñor,","t"],"n29":["Di","i"],"n30":["jis","m"],"n31":["te:","t"],"n32":["\"Ha","i"],"n33":["ced","t"],"n34":["es","i"],"n35":["to","t"],"n36":"En","n37":["me","i"],"n38":["mo","m"],"n40":["ria","t"],"n41":"de","n42":"Mí\";","n43":["Je","i"],"n44":["sús,","t"],"n45":"hoy","n46":"nos","n47":["reu","i"],"n48":["ni","m"],"n49":["mos:","t"],"n50":"En","n51":["me","i"],"n52":["mo","m"],"n53":["ria","t"],"n54":"de","n55":"Ti."},"verses":[{"label":"2.","lines":["Tu hondo sufrimiento","¿Quién podrá concebir?","La copa de la ira","Tomaste Tú por mí.","Por Dios abandonado","En el madero vil;","Con gratitud hacemos","Memoria hoy de Ti."]},{"label":"3.","lines":["Tu‿espíritu rodeado","Fue por la‿oscuridad;","También golpeó Tu alma","La‿horrenda tempestad.","Allí se vio Tu gracia","Y Tu perfecto amor;","Con gratitud y gozo","Te recordamos hoy."]},{"label":"4.","lines":["El Primogénito eres,","A quien Dios levantó;","Cabeza de la iglesia,","Estás en ascensión.","Por gracia aceptados,","Y libre‿el corazón,","Pensando‿en Tus dolores","Te recordamos hoy."]},{"label":"5.","lines":["Señor, para llevarnos","En gloria Tú vendrás;","En ese día radiante,","Descanso nos darás.","Tu muerte‿anunciaremos","Mientras buscamos ser","A ella conformados,","Aún recordándote."]}]}