{"hymn":"S585","parent":"E1216","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Nuestra vida interior es Cristo el Señor","subtitle":"Varios aspectos de la vida interior—La vida interior, la vida diaria, la vida de reuniones","syl":{"n2":["Nues","i"],"n3":["tra","t"],"n4":["vi","i"],"n5":["da‿in","m"],"n6":["te","m"],"n7":["rior","t"],"n9":"es","n10":["Cris","i"],"n11":["to","t"],"n12":"el","n13":["Se","i"],"n14":["ñor,","t"],"n16":"Que","n17":["ri","i"],"n18":["ge","t"],"n19":["nues","i"],"n20":["tro‿an","m"],"n21":["dar","t"],"n22":"y","n23":"la","n27":["reu","i"],"n28":["nión;","t"],"n29":["Vi","i"],"n30":["vién","m"],"n31":["do","m"],"n32":["lo‿a‿Él","t"],"n34":"en","n35":["nues","i"],"n36":["tro","t"],"n37":["dia","i"],"n38":["rio‿an","m"],"n39":["dar,","t"],"n41":["La‿i","i"],"n42":["gle","m"],"n43":["sia","t"],"n44":"se","n45":["ve","i"],"n46":["rá","t"],"n47":"en","n48":"la","n49":["reu","i"],"n51":["nión.","t"]},"verses":[{"label":"2.","lines":["Nuestra vida‿interior es Cristo el Señor,","En nuestro espíritu, ¡cuán cerca está!","Volviéndonos a Él, tomándolo por fe,","Nuestra vida interior Cristo será."]},{"label":"3.","lines":["De la vida interior procede nuestro andar,","Y Cristo llena así nuestro vivir;","Y al vivir por Él, Él vive en nuestro ser","Para que Su vivir se pueda ver."]},{"label":"4.","lines":["Tal experiencia real de Cristo en nuestro andar,","De Cristo llenará nuestra reunión;","No formas sin valor, mas Cristo en Su expresión","Se manifestará en nuestra reunión."]},{"label":"5.","lines":["Sin la vida interior no existe un vivir,","Tampoco la reunión ni iglesia real;","Mas Cristo en lo interior vivido a diario","Hará que la reunión gloriosa esté."]}]}