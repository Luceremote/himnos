{"hymn":"S168","parent":"E209","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jesús, me endulza el corazón","subtitle":"Alabanza al Señor—Satisfacción con Él","syl":{"n1":["Je","i"],"n2":["sús,","t"],"n3":["me‿en","i"],"n4":["dul","m"],"n5":["za‿el","t"],"n6":["co","i"],"n7":["ra","m"],"n8":["zón","t"],"n9":["Só","i"],"n10":["lo","t"],"n11":["pen","i"],"n12":["sar","t"],"n13":"en","n14":"Ti;","n15":["Pe","i"],"n16":["ro","t"],"n17":"más","n18":["dul","i"],"n19":["ce‿es","t"],"n20":"ver","n21":"Tu","n22":"faz","n23":"Y","n24":["des","i"],"n25":["can","m"],"n26":["sar","t"],"n27":["a","i"],"n28":["sí.","t"]},"verses":[{"label":"2.","lines":["Ni voz, ni mente‿o corazón","Podrán cantar o‿hallar","Tan dulce nombre sin igual","Que pueda‿aun salvar."]},{"label":"3.","lines":["Tú, la‿esperanza‿al triste ser,","Al manso, gozo das;","¡Para‿el caído‿eres bondad!","Y al que busca, paz."]},{"label":"4.","lines":["¿Y qué de‿aquél que encontró","Tu gran amor, Jesús?","Nadie podrá‿entender Tu‿amor,","Sólo‿el que amas Tú."]},{"label":"5.","lines":["Fuego y vida‿eres, Jesús,","Y para‿el mundo, luz;","Excedes todo gozo‿aquí,","Y todo‿anhelo, Tú."]},{"label":"6.","lines":["La fuente única‿eres Tú,","Que calma nuestra sed.","¡Inagotable manantial","Que sacia nuestro ser!"]},{"label":"7.","lines":["Sé nuestro Gozo‿ahora Tú,","Y‿el Galardón serás;","Sé nuestra Gloria hoy, Jesús,","Y por la‿eternidad."]}]}