{"hymn":"S98","parent":"E1095","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cantando alabanzas","subtitle":"Alabanza al Señor—Su victoria y exaltación","syl":{"n1":["Can","i"],"n2":["tan","m"],"n3":["do","t"],"n4":["a","i"],"n5":["la","m"],"n6":["ban","m"],"n7":["zas","t"],"n8":"De","n9":["glo","i"],"n10":["ria","t"],"n11":"al","n12":["Se","i"],"n13":["ñor,","t"],"n15":["Se‿a","i"],"n17":["le","m"],"n18":["gra","m"],"n19":["rán","t"],"n20":"los","n21":["cie","i"],"n22":["los","t"],"n23":["O","i"],"n24":["yen","m"],"n25":["do","t"],"n26":["nues","i"],"n27":["tra","t"],"n29":"voz;","n31":["Si‿es","i"],"n32":["cu","m"],"n33":["cha","t"],"n34":["to","i"],"n35":["do‿el","t"],"n37":["mun","i"],"n38":["do","t"],"n39":"Que","n40":["da","i"],"n41":["mos","t"],"n42":["glo","i"],"n43":["ria‿a","t"],"n45":"Dios,","n47":["Sa","i"],"n49":["tán","t"],"n50":"y","n51":"sus","n52":["le","i"],"n53":["gio","m"],"n54":["nes","t"],"n55":["Hui","i"],"n56":["rán","t"],"n57":"con","n58":"gran","n60":["pa","i"],"n61":["vor.","t"]},"verses":[{"label":"2.","lines":["Cerrando nuestras bocas,","El diablo sonreirá;","¿Por qué no abrir batalla","Y‿hacerlo claudicar?","Con gritos de alabanzas,","Victoria y loor,","Hay que perder la cara,","Ser necios para Dios."]},{"label":"3.","lines":["El mundo nunca‿ayuda","Para‿adorar a Dios,","Ni‿a darle‿a‿El las gracias,","O gloria‿al Salvador.","No hay que pedir permiso","Para‿alabar a Dios,","Tu‿espíritu libera,","Recibe Su favor."]},{"label":"4.","lines":["Hermanos, ¡no se callen!","Hermanas, ¡griten más!","El triunfo resonante","De Dios se‿escuchará.","Es tiempo de‿alabarlo,","A cualquier precio hoy,","Por Su misericordia","Y plena salvación."]}]}