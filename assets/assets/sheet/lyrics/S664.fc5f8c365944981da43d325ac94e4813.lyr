{"hymn":"S664","parent":"E853","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Tu reino amo, oh Dios","subtitle":"La iglesia—Su atracción","syl":{"n1":"¡Tu","n2":["rei","i"],"n3":["no","t"],"n4":["a","i"],"n5":["mo,‿oh","t"],"n7":"Dios!","n8":"Tu","n10":["ca","i"],"n11":["sa","t"],"n13":["y‿ex","i"],"n14":["pre","m"],"n15":["sión,","t"],"n16":["La‿i","i"],"n17":["gle","m"],"n18":["sia","t"],"n19":"que","n20":["com","i"],"n21":["pras","m"],"n22":["te","t"],"n23":"Tú","n24":"Con","n25":["san","i"],"n26":["gre,‿oh","t"],"n28":["Re","i"],"n29":["den","m"],"n30":["tor.","t"]},"verses":[{"label":"2.","lines":["¡Tu iglesia amo, oh Dios!","Sus muros Tuyos son;","La niña de Tus ojos es,","Y está en Tu mano hoy."]},{"label":"3.","lines":["Por ella es mi oración,","Mis lágrimas, mi amor,","Solicitud, cuidado, afán,","Por ella son, Señor."]},{"label":"4.","lines":["Tesoro sin igual","Hoy sus caminos son:","Sus votos, dulce comunión","E himnos de amor."]},{"label":"5.","lines":["Ella perdurará,","Oh Dios, cual Tu verdad,","Y victoriosa llegará","Hasta la eternidad."]}]}