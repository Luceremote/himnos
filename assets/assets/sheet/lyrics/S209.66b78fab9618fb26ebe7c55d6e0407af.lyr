{"hymn":"S209","parent":"E1119","quality":"exact","adjust":{"hold":0,"merge":0},"title":"La encontré en la Palabra","subtitle":"La plenitud del Espíritu—La unción, el sello y las arras","syl":{"n1":"La","n2":["en","i"],"n3":["con","m"],"n4":["tré‿en","t"],"n5":"la","n6":["Pa","i"],"n7":["la","m"],"n8":["bra,","t"],"n9":"¡Qué","n10":["ma","i"],"n11":["ra","m"],"n12":["vi","m"],"n13":["llo","m"],"n14":["sa","t"],"n15":"es!","n16":"No","n17":["quie","i"],"n18":["ro‿en","m"],"n19":["se","m"],"n20":["ñan","m"],"n21":["za‿hu","m"],"n22":["ma","m"],"n23":["na,","t"],"n24":"Pues","n25":["la‿un","i"],"n26":["ción","t"],"n27":["vi","i"],"n28":["ve‿en","t"],"n29":"mi","n30":"ser.","n31":"¡Sí,","n32":"en","n33":"mi","n34":["es","i"],"n35":["pí","m"],"n36":["ri","m"],"n37":["tu‿Él","t"],"n38":"se","n39":["mue","i"],"n40":["ve!","t"],"n41":"¡Sí,","n42":["es","i"],"n43":["ta‿un","m"],"n44":["ción","t"],"n45":["me‿un","i"],"n46":["ge!","t"],"n48":"Es","n49":"el","n50":"Dios","n51":["vi","i"],"n52":["vien","m"],"n53":["te!","t"],"n54":"Por","n56":"Su","n57":["Pa","i"],"n58":["la","m"],"n59":["bra","t"],"n60":"Dios","n61":"Me","n62":"la","n63":["re","i"],"n64":["ve","m"],"n65":["ló","t"],"n66":["Pa","i"],"n67":["ra","t"],"n68":"que","n69":"yo","n70":["a","i"],"n71":["pli","m"],"n73":["que","t"],"n74":["Es","i"],"n75":["tá‿un","m"],"n76":["ción","t"],"n77":"que","n78":["vi","i"],"n79":["ve‿en","t"],"n80":"mí."},"verses":[{"label":"2.","lines":["Hace‿a Cristo mi‿experiencia,","Creo‿en Su Palabra fiel;","Como‿Espíritu se une","Y se mezcla con mi ser."]},{"label":"3.","lines":["Por Su sangre que nos limpia","Nuestra‿unión perdurará;","Cristo, como‿unción, se mueve","En aquel que limpio‿está."]},{"label":"4.","lines":["Dios en Cristo es la vida","Del Espíritu‿en mi ser;","Como‿el Santo Él nos unge","Hasta‿hacernos como El."]},{"label":"5.","lines":["En mi‿espíritu yo toco","Este‿ungüento de valor;","Rico, ancho, lleno, hondo.","¡Oh, conozco al mismo Dios!"]},{"label":"6.","lines":["Mientras sigo Su ungimiento","Permaneceré en Él;","Él me‿enseña, Él me alcanza","Y se adueña de mi ser."]}]}