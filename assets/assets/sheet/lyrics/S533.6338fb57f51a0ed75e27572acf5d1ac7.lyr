{"hymn":"S533","parent":"E662","quality":"exact","adjust":{"hold":0,"merge":0},"title":"\"¡La meta alcanzad!\"","subtitle":"Aliento—Para proseguir","syl":{"n1":"\"¡La","n2":["me","i"],"n3":["ta","t"],"n4":["al","i"],"n6":["can","m"],"n7":["zad!\",","t"],"n9":"Id","n10":"sin","n11":["mos","i"],"n12":["trar","t"],"n14":["te","i"],"n15":["mor;","t"],"n17":"Quien","n18":"te","n19":["lla","i"],"n20":["mó,‿el","t"],"n22":["ca","i"],"n23":["mi","m"],"n24":["no‿a","m"],"n25":["brió,","t"],"n26":"Por","n27":["tan","i"],"n29":["to,","t"],"n30":["fir","i"],"n31":["me,","t"],"n32":"¡id!."},"verses":[{"label":"2.","lines":["\"¡La meta alcanzad!\",","Ojos, que fuego son,","Te observan; ¿qué el hombre es?","¿Qué importa su opinión?"]},{"label":"3.","lines":["\"¡La meta alcanzad!\",","Atrás no mires más;","Al frente está Su aprobación,","Y te coronará,"]},{"label":"4.","lines":["\"¡La meta alcanzad!\",","Sin ver, ni oir, ni hablar,","Seguid la senda que Él subió,","\"¡A Cristo alcanzad!\"."]}]}