{"hymn":"S194","parent":"E245","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Doquiera el hombre esté, las nuevas anunciad","subtitle":"La plenitud del Espíritu—Como consolador","syl":{"n1":["Do","i"],"n2":["quie","m"],"n3":["ra‿el","t"],"n4":["hom","i"],"n5":["bre‿es","m"],"n6":["té,","t"],"n7":"las","n8":["nue","i"],"n9":["vas","t"],"n10":["a","i"],"n11":["nun","m"],"n12":["ciad","t"],"n13":"A","n14":["to","i"],"n15":["do","t"],"n16":["co","i"],"n17":["ra","m"],"n18":["zón","t"],"n19":"que","n20":["su","i"],"n21":["fra","t"],"n22":["a","i"],"n23":["flic","m"],"n24":["ción;","t"],"n25":"Con","n26":["go","i"],"n27":["zo","t"],"n28":"y","n29":["fer","i"],"n30":["vor,","t"],"n31":["cris","i"],"n32":["tia","m"],"n33":["nos","t"],"n34":["pro","i"],"n35":["cla","m"],"n36":["mad:","t"],"n37":["¡Lle","i"],"n38":["gó‿el","t"],"n39":["Con","i"],"n40":["so","m"],"n41":["la","m"],"n42":["dor!","t"],"n43":["¡Lle","i"],"n44":["gó‿el","t"],"n45":["Con","i"],"n46":["so","m"],"n47":["la","m"],"n48":["dor!","t"],"n49":["¡Lle","i"],"n50":["gó‿el","t"],"n51":["Con","i"],"n52":["so","m"],"n53":["la","m"],"n54":["dor!","t"],"n55":"El","n56":["San","i"],"n57":["to‿Es","m"],"n58":["pí","m"],"n59":["ri","m"],"n60":["tu:","t"],"n61":["Pro","i"],"n62":["me","m"],"n63":["sa","t"],"n64":"del","n65":["Se","i"],"n66":["ñor.","t"],"n67":"Las","n68":["nue","i"],"n69":["vas","t"],"n70":["a","i"],"n71":["nun","m"],"n72":["ciad,","t"],"n73":["Do","i"],"n74":["quie","m"],"n75":["ra‿el","t"],"n76":["hom","i"],"n77":["bre‿es","m"],"n78":["té:","t"],"n79":["¡Lle","i"],"n80":["gó‿el","t"],"n81":["Con","i"],"n82":["so","m"],"n83":["la","m"],"n84":["dor!","t"]},"verses":[{"label":"2.","lines":["Quedó la noche atrás, va‿el alba‿a despuntar,","Se calma el gemir, pasó la tempestad;","El día‿avanza ya, dorado‿el monte‿está:","¡Llegó el Consolador!"]},{"label":"3.","lines":["¡Oh Rey de reyes, traen Tus alas sanidad!","Cautivas almas hoy reciben libertad;","Vacías celdas dan un cántico triunfal:","¡Llegó el Consolador!"]},{"label":"4.","lines":["¡Divino‿inmenso amor! ¿Cómo podré contar","A todo pecador la gracia divinal?","Que un hijo infernal ¡Su‿imagen lleve hoy!","¡Llegó el Consolador!"]}]}