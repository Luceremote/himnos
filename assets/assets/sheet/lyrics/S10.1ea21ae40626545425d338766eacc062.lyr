{"hymn":"S10","parent":"E14","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh, sabio, invisible y Dios inmortal","subtitle":"Adoración al Padre—Su inmortalidad","syl":{"n1":"Oh,","n2":["sa","i"],"n3":["bio,‿in","m"],"n4":["vi","m"],"n5":["si","m"],"n6":["ble","t"],"n7":"y","n9":"Dios","n10":["in","i"],"n11":["mor","m"],"n12":["tal,","t"],"n13":"Luz","n14":["i","i"],"n15":["nac","m"],"n16":["ce","m"],"n17":["si","m"],"n18":["ble","t"],"n19":["ro","i"],"n21":["déan","m"],"n22":["do","m"],"n23":["te‿es","m"],"n24":["tá.","t"],"n25":["An","i"],"n26":["cia","m"],"n27":["no","t"],"n28":"de","n29":["Dí","i"],"n30":["as,","t"],"n31":["ben","i"],"n32":["di","m"],"n33":["to‿en","t"],"n34":["ho","i"],"n35":["nor,","t"],"n36":"Por","n37":"Tu","n38":["mag","i"],"n39":["no","t"],"n40":["nom","i"],"n41":["bre","t"],"n42":"te","n44":["da","i"],"n45":["mos","t"],"n46":["lo","i"],"n47":["or.","t"]},"verses":[{"label":"2.","lines":["Sin pausa, sin prisa, silente cual luz,","Sin falta ni exceso, así reinas Tú.","Tu justicia‿excelsa, cual cumbre sin par;","Tus nubes son fuentes de‿amor y bondad."]},{"label":"3.","lines":["Sin excepción, vida a todos Tú das;","De todas las vidas eres realidad.","Brotamos cual hojas con vida fugáz;","Morimos, más Tú nunca has de cambiar."]},{"label":"4.","lines":["Gran Padre de gloria y luz celestial,","Tus ángeles cantan cubriendo su faz.","Loor te rendimos, mas hoy haznos ver","Que‿oculto Tu‿estás en la luz de Tu ser."]},{"label":"5.","lines":["Oh, sabio,‿invisible y Dios inmortal,","Luz inaccesible rodéandote‿está.","Anciano de Días, bendito‿en honor,","Por Tu magno nombre te damos loor."]}]}