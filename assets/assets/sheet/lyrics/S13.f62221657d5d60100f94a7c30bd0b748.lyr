{"hymn":"S13","parent":"E17","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Mi Padre Dios, al contemplar Tus obras","subtitle":"Adoración al Padre—Su grandeza","syl":{"n1":"Mi","n2":["Pa","i"],"n3":["dre","t"],"n4":"Dios,","n5":"al","n6":["con","i"],"n7":["tem","m"],"n8":["plar","t"],"n9":"Tus","n10":["o","i"],"n11":["bras,","t"],"n13":"La","n14":["tie","i"],"n15":["rra,‿el","t"],"n16":["cie","i"],"n17":["lo,","t"],"n18":["ma","i"],"n19":["ra","m"],"n20":["vi","m"],"n21":["llas","t"],"n22":"son;","n24":["Co","i"],"n25":["sas","t"],"n26":["pe","i"],"n27":["que","m"],"n28":["ñas,","t"],"n29":["gran","i"],"n30":["des","t"],"n31":["e‿in","i"],"n32":["con","m"],"n33":["ta","m"],"n34":["bles,","t"],"n36":"De","n37":"Tu","n38":["po","i"],"n39":["der","t"],"n40":"son","n41":["ma","i"],"n42":["ni","m"],"n43":["fes","m"],"n44":["ta","m"],"n45":["ción.","t"],"n47":["To","i"],"n48":["do","t"],"n49":"mi","n50":"ser","n51":["can","i"],"n52":["ta‿a","m"],"n53":["la","m"],"n54":["ban","m"],"n55":["za‿a","t"],"n56":"Ti,","n58":["¡Gran","i"],"n59":["de‿e","m"],"n60":["res","t"],"n61":"Tú!","n63":["¡Gran","i"],"n64":["de‿e","m"],"n65":["res","t"],"n66":"Tú!","n68":"Y","n69":"por","n70":["la‿e","i"],"n71":["ter","m"],"n72":["ni","m"],"n73":["dad","t"],"n74":"yo","n75":["can","i"],"n76":["ta","m"],"n77":["ré,","t"],"n79":["¡Gran","i"],"n80":["de‿e","m"],"n81":["res","t"],"n82":"Tú!","n84":["¡Gran","i"],"n85":["de‿e","m"],"n86":["res","t"],"n87":"Tú!"},"verses":[{"label":"2.","lines":["La gracia de Tu salvación disfruto,","Al ver al Hijo que enviaste Tú,","Quien al morir nueva creación nos hizo,","Para expresar Tu vida‿en plenitud."]},{"label":"3.","lines":["Cuando en la iglesia en comunión bendita,","Veo millones con Tu vida hoy;","Edificados como Tu morada","Para expresar Tu plenitud, mi Dios."]},{"label":"4.","lines":["Mientras espero el siglo venidero,","Anhelo la Nueva Jerusalén,","Con cielos nuevos y una tierra nueva,","Que expresarán la gloria de Tu ser."]}]}