{"hymn":"S523","parent":"E637","quality":"exact","adjust":{"hold":0,"merge":0},"title":"\"Naufragado en Jesús\"","subtitle":"El camino de la cruz—El camino de reposo","syl":{"n2":["\"Nau","i"],"n3":["fra","m"],"n4":["ga","m"],"n5":["do","t"],"n6":"en","n8":["Je","i"],"n9":["sús\",","t"],"n10":"¡Qué","n12":["vic","i"],"n13":["to","m"],"n14":["ria‿a","m"],"n15":["sí","t"],"n17":["can","i"],"n18":["tar!","t"],"n19":["Bo","i"],"n21":["tes","t"],"n22":"que","n23":["te","i"],"n24":["men","t"],"n26":["zar","i"],"n27":["par","t"],"n28":"Por","n30":["te","i"],"n31":["mor","t"],"n32":"al","n33":["hon","i"],"n35":["do","t"],"n36":"mar,","n37":["Nun","i"],"n38":["ca","t"],"n39":"en","n40":["Je","i"],"n41":["sús","t"],"n43":["ten","i"],"n45":["drán","t"],"n46":"La","n48":"paz","n49":"que‿en","n50":"Su","n51":["se","i"],"n52":["no‿es","m"],"n53":["tá.","t"]},"verses":[{"label":"2.","lines":["\"¡Naufragar!\" es un clamor","Que nos hace lamentar;","Mas al alma, viva aún","En los brazos del Señor,","No la mueve lo peor,","Abrazada en Su amor."]},{"label":"3.","lines":["\"¡Naufragado!\", al no tener","Ya ni un barco en que viajar;","El viajero ahora está","Anclado a la infinidad,","Deseschando la inquietud","Y asiéndose a Jesús."]},{"label":"4.","lines":["\"Naufragar\" ganancia fue;","Otros barcos ya verán","Que en tormenta hay bendición,","Y, aunque agitado el mar,","Dios vigila siempre, iel;","En \"naufragios\", guarda Él."]}]}