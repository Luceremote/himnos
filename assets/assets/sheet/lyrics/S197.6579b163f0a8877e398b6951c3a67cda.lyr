{"hymn":"S197","parent":"E250","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Sube, oh pozo, de agua","subtitle":"La plenitud del Espíritu—Como agua viva","syl":{"n1":["Su","i"],"n2":["be,‿oh","t"],"n3":["po","i"],"n4":["zo,","t"],"n5":["de‿a","i"],"n6":["gua,","t"],"n7":["Se","i"],"n8":["ñor,","t"],"n9":["ca","i"],"n10":["va‿en","t"],"n11":["mi‿al","i"],"n12":["ma;","t"],"n13":["Qui","i"],"n14":["ta","t"],"n15":"las","n16":["ba","i"],"n17":["rre","m"],"n18":["ras,","t"],"n19":["Pa","i"],"n20":["ra","t"],"n21":"que‿en","n22":"mí","n23":["flu","i"],"n24":["yas.","t"]},"verses":[{"label":"2.","lines":["Cristo, Roca hendida,","Agua viva bulle;","Pero en mi alma","Algo la obstruye."]},{"label":"3.","lines":["Cavaré orando,","Sacaré la tierra,","¡Oh que libremente","Tu Espíritu fluya!"]},{"label":"4.","lines":["Hoy golpear la Roca","No es necesario;","Basta con que cave","En mi ser a diario."]},{"label":"5.","lines":["Mi profundo anhelo","Es que Tú me llenes,","Hasta que‿agua viva","De mi alma salte."]},{"label":"6.","lines":["Cava hasta que quites","Todo lo que obstruya;","Cava‿hasta que el agua","Tu mensaje fluya."]},{"label":"7.","lines":["Sube, oh pozo, de agua,","Señor, cava‿en mi alma;","Quita las barreras,","Para que‿en mí fluyas."]}]}