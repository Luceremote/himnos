{"hymn":"S824","parent":"E975","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En el principio un huerto se vio","subtitle":"La máxima manifestación—La ciudad santa","syl":{"n1":"En","n2":"el","n3":["prin","i"],"n4":["ci","m"],"n5":["pio","t"],"n6":"un","n7":["huer","i"],"n8":["to","t"],"n9":"se","n10":"vio,","n11":"Mas","n12":"al","n13":["fi","i"],"n14":["nal","t"],"n15":"es","n16":"la","n17":["ciu","i"],"n18":["dad","t"],"n19":"de","n20":"Dios;","n21":"Fue‿el","n22":["huer","i"],"n23":["to","t"],"n24":["cen","i"],"n25":["tro","t"],"n26":"de","n27":"Su","n28":["cre","i"],"n29":["a","m"],"n30":["ción,","t"],"n31":"Mas","n32":"la","n33":["Ciu","i"],"n34":["dad","t"],"n35":"es","n36":["Su‿e","i"],"n37":["di","m"],"n38":["fi","m"],"n39":["ca","m"],"n40":["ción.","t"]},"verses":[{"label":"2.","lines":["Tanto en el huerto como en la Ciudad","El río y árbol de la vida están;","Tipos de Cristo, suministro real,","Y del Espíritu, el manantial."]},{"label":"3.","lines":["En ese huerto y en esa ciudad","Tres materiales preciosos se ven:","El oro, perlas y piedras sin par,","Para que Dios Su obra pueda hacer."]},{"label":"4.","lines":["Mas en el huerto por la tierra están","Los materiales, sin utilidad;","Pero se ven en la santa ciudad","Edificados en glorioso hogar."]},{"label":"5.","lines":["Dios en el huerto al hombre formó,","De barro su naturaleza fue;","No disfrutaba vida en su interior,","No estaba el árbol de la vida en él."]},{"label":"6.","lines":["Pero el árbol crece en la ciudad","En este hombre colectivo está;","Es Cristo mismo para el hombre allí,","La provisión de vida divinal."]},{"label":"7.","lines":["Dios en el hombre forjándose está;","Dios por Su vida lo transformará","En oro, perlas y piedras sin par","Un Cuerpo conformado a Cristo hará."]},{"label":"8.","lines":["En ese huerto recibió Adán","La ayuda idónea que Dios proveyó;","Mas al final habrá una ciudad","La misma novia que el Señor deseó."]},{"label":"9.","lines":["Esta Ciudad es la edificación","De todos los que Dios justificó;","Ella es la amada Novia del Señor,","Y para Dios, Su misma habitación."]},{"label":"10.","lines":["Es la completa expresión de Dios,","Corporativa y universal;","Es complemento para el Señor","Que en gloria Dios ha de manifestar."]}]}