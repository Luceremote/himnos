{"hymn":"S126","parent":"E154","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Tu amor, Jesús, excede mi pensar","subtitle":"Alabanza al Señor—Su amor","syl":{"n1":["Tu‿a","i"],"n2":["mor,","t"],"n3":["Je","i"],"n4":["sús,","t"],"n5":["ex","i"],"n6":["ce","m"],"n7":["de","t"],"n8":"mi","n9":["pen","i"],"n10":["sar,","t"],"n11":["Pe","i"],"n12":["ro","t"],"n13":"mi","n14":["al","i"],"n15":["ma","t"],"n16":["quie","i"],"n17":["re","t"],"n18":["com","i"],"n19":["pro","m"],"n20":["bar,","t"],"n21":"El","n22":["lar","i"],"n23":["go,‿el","t"],"n24":["an","i"],"n25":["cho‿y","t"],"n26":"la","n27":["pro","i"],"n28":["fun","m"],"n29":["di","m"],"n30":["dad,","t"],"n31":["Su‿al","i"],"n32":["tu","m"],"n33":["ra‿y","t"],"n34":["fuer","i"],"n35":["za","t"],"n36":["quie","i"],"n37":["re","t"],"n38":["dis","i"],"n39":["fru","m"],"n40":["tar","t"],"n41":"A‿ún","n42":"más","n43":"y","n44":"más."},"verses":[{"label":"2.","lines":["Tu amor, Jesús, excede todo hablar,","Mi Salvador, mas quiero proclamar,","A pecadores en cualquier lugar","Tu amor que puede el temor echar","Con su poder."]},{"label":"3.","lines":["Tu amor, Jesús, excede todo honor,","Pero mi corazón, oh Salvador,","Quiere cantar Tu rico y tierno amor","Que trae a este pobre pecador","Cerca de Dios."]},{"label":"4.","lines":["Aunque Tu amor no pueda comprender,","Hablar, cantar, o‿a fondo conocer,","Mi vaso traigo libremente yo","Para que Tú, Fuente de vida, lo","Puedas llenar."]},{"label":"5.","lines":["Un vaso soy, vacío y sin calor,","Jamás te di ni‿un rasgo de mi amor,","Mas puedo una y otra vez venir","Con la certeza de saber que‿aún","Me amas Tú."]},{"label":"6.","lines":["¡Oh, lléname, Jesús, mi Salvador!","Al manantial me guíes con Tu amor;","Con fe sencilla allí acudiré,","Jamás a otra fuente yo iré,","Mas sólo a Ti."]},{"label":"7.","lines":["Señor, cuando Tu rostro pueda ver","Y en Tu trono pueda comprender","El largo, el ancho‿y la profundidad,","La altura y fuerza de Tu amor leal,","Yo cantaré."]}]}