{"hymn":"S703","parent":"E1271","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"Somos los hebreos —Éufrates atrás—","subtitle":"La iglesia—Los vencedores","syl":{"n1":["So","i"],"n2":["mos","t"],"n3":"los","n4":["he","i"],"n5":["bre","m"],"n6":["os","t"],"n7":["—Éu","i"],"n8":["fra","m"],"n9":["tes","t"],"n10":["a","i"],"n11":["trás—","t"],"n12":["I","i"],"n13":["do","m"],"n14":["la","m"],"n15":["trí","m"],"n16":["a","t"],"n17":"no","n18":["que","i"],"n19":["re","m"],"n20":["mos","t"],"n21":"más;","n23":"Ya","n24":["cru","i"],"n25":["za","m"],"n26":["do‿el","t"],"n27":["rí","i"],"n28":["o,‿en","m"],"n29":["tra","m"],"n30":["mos","t"],"n31":["en‿Ca","i"],"n32":["na","m"],"n33":["͡án;","t"],"n34":["Bus","i"],"n35":["ca","m"],"n36":["mos","t"],"n37":"la","n38":["ciu","i"],"n39":["dad","t"],"n40":"que‿es","n41":["e","i"],"n42":["ter","m"],"n43":["nal.","t"],"n44":"Los","n45":["ven","i"],"n46":["ce","m"],"n47":["do","m"],"n48":["res","t"],"n49":["ven","i"],"n50":["cen","t"],"n51":"a","n52":["Sa","i"],"n53":["tán,","t"],"n54":"Dios","n55":"ha","n56":["ga","i"],"n57":["na","m"],"n58":["do","t"],"n59":"Su","n60":["san","i"],"n61":["ta","t"],"n62":["ciu","i"],"n63":["dad.","t"],"n64":["Nues","i"],"n65":["tra","t"],"n66":["por","i"],"n67":["ción","t"],"n68":["e","i"],"n69":["ter","m"],"n70":["na‿es","t"],"n71":["nues","i"],"n72":["tro","t"],"n73":"Dios,","n74":["Nues","i"],"n75":["tra","t"],"n76":["por","i"],"n77":["ción","t"],"n78":["e","i"],"n79":["ter","m"],"n80":["na‿es","t"],"n81":["nues","i"],"n82":["tro","t"],"n83":"Dios."},"verses":[{"label":"2.","lines":["En Egipto‿esclavos bajo Satanás,","Mas dijo Dios: “A Mi pueblo soltad”.","Cruzando‿el mar Rojo, vimos salvación","Cuando el mar tragó a Faraón."]},{"label":"3.","lines":["Hoy edificamos para Dios Su‿hogar;","Su tienda es nuestra morada re͡al.","La vejez dejamos bajo el Jordán;","Ah͡ora pele͡amos por ganar Canaán."]},{"label":"4.","lines":["Lo que ordenó Dios se hizo‿un ritual;","Juan el Bautista vino‿a proclamar:","El río cruzad, pues Dios delante va,","Y‿el judaísmo ya quedó atrás."]},{"label":"5.","lines":["Vencedores sobre‿el mar de vidrio‿están;","Sobre‿este mar será‿el cruce final;","Alabad, cantando‿el canto de Moisés,","¡Todo‿enemigo bajo nuestros pies!"]}]}