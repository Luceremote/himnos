{"hymn":"S828","parent":"E980","quality":"exact","adjust":{"hold":0,"merge":0},"title":"En la Escritura Santa ved","subtitle":"La máxima manifestación—La novia y el tabernáculo","syl":{"n1":"En","n2":["la‿Es","i"],"n3":["cri","m"],"n4":["tu","m"],"n5":["ra","t"],"n6":["San","i"],"n7":["ta","t"],"n8":"ved","n9":"Los","n10":["ti","i"],"n11":["pos","t"],"n12":"de","n13":"la","n14":"grey","n15":"de","n16":"Dios:","n17":"Su","n18":["e","i"],"n19":["di","m"],"n20":["fi","m"],"n21":["cio‿y","t"],"n23":["No","i"],"n24":["via","t"],"n26":"son,","n27":["Re","i"],"n28":["po","m"],"n29":["so","t"],"n30":"y","n31":["sa","i"],"n32":["tis","m"],"n33":["fac","m"],"n34":["ción.","t"]},"verses":[{"label":"2.","lines":["Los tipos de la iglesia en","El Testamento Antiguo están:","La ayuda idónea para Adán","Y el edificio en majestad."]},{"label":"3.","lines":["Al pueblo antiguo de Israel,","Su misma esposa Dios llamó;","Con ellos Él se edificó","Su casa real, ciudad de Dios."]},{"label":"4.","lines":["El encarnado Dios, Jesús,","El Novio de la Novia es;","Su misma vida Él le dio,","Su complemento así logró."]},{"label":"5.","lines":["Como el Hijo de David,","Cristo edifica para Dios","Un templo para Su solaz,","Do pueda ejecutar Su plan."]},{"label":"6.","lines":["Para el Señor Su iglesia es","La Novia, Su consolación;","Es la morada para Dios","En Su vivir y expresión."]},{"label":"7.","lines":["Jerusalén, la nueva, es","La más completa perfección,","Eterno hogar, esposa fiel,","La máxima consumación."]},{"label":"8.","lines":["Ella es la Novia del Señor,","El tabernáculo de Dios;","Es para Él, Su habitación,","Y para Cristo, Su expresión."]},{"label":"9.","lines":["Es la máxima compleción","Del incesante obrar de Dios,","Que en la electa humanidad","Su gloria eterna expresará."]}]}