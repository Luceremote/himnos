{"hymn":"S11","parent":"E15","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Oh Dios, tan trascendente","subtitle":"Adoración al Padre—Su trascendencia","syl":{"n1":"Oh","n2":"Dios,","n3":"tan","n4":["tras","i"],"n5":["cen","m"],"n6":["den","m"],"n7":["te,","t"],"n8":"Tan","n9":["san","i"],"n10":["to","t"],"n11":["e","i"],"n12":["res","t"],"n13":"Tú;","n15":["Na","i"],"n16":["die","t"],"n17":["pue","i"],"n18":["de‿i","m"],"n19":["gua","m"],"n20":["lar","m"],"n21":["te,","t"],"n22":["In","i"],"n23":["com","m"],"n24":["pa","m"],"n25":["ra","m"],"n26":["ble,","t"],"n27":"Tú.","n28":"En","n29":["to","i"],"n30":["do‿el","t"],"n31":["u","i"],"n32":["ni","m"],"n33":["ver","m"],"n34":["so","t"],"n35":"Lo","n36":"más","n37":["san","i"],"n38":["to‿e","m"],"n40":["res","t"],"n41":"Tú,","n43":"Por","n44":"Tu","n45":["na","i"],"n46":["tu","m"],"n47":["ra","m"],"n48":["le","m"],"n49":["za","t"],"n50":["Im","i"],"n51":["pe","m"],"n52":["rio","t"],"n53":"y","n54":["vir","i"],"n55":["tud.","t"]},"verses":[{"label":"2.","lines":["Tan único Y distinto,","No sólo justo y puro,","No sólo sin defectos,","Mas Tú eres perfección.","No‿hay nada que Te alcance,","O que sea Tu‿igual;","Si algo te reemplaza","Insulto te será."]},{"label":"3.","lines":["Excedes la excelencia,","Pues eres superior;","No sólo eres fino,","Mas sin comparación.","Difieres de los justos","No hay justo como Tú;","Excelsa es Tu belleza,","Tu fama y virtud."]},{"label":"4.","lines":["Tu santidad excelsa","Es nuestro eterno bien;","Pues Tu esencia santa","Legaste a nuestro ser.","Aun Tu trascendencia","Es nuestra por la fe.","Mas santos por Tu vida","Seremos al crecer."]},{"label":"5.","lines":["Te adoramos, Padre","Hoy por Tu santidad,","Por Tu naturaleza","Trascendente y sin par.","Santa naturaleza","Distinta y sin igual,","Por siempre será nuestra","Nos santificará."]}]}