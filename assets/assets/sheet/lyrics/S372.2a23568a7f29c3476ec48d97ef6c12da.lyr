{"hymn":"S372","parent":"E488","quality":"exact","adjust":{"hold":0,"merge":0},"title":"¡Qué gran misterio, mi Señor","subtitle":"Unión con Cristo—Identificados con su muerte y resurrección","syl":{"n1":"¡Qué","n2":"gran","n3":["mis","i"],"n4":["te","m"],"n5":["rio,","t"],"n7":"mi","n8":["Se","i"],"n10":["ñor!","t"],"n11":["Pue","i"],"n12":["do","t"],"n13":["a","i"],"n14":["ho","m"],"n15":["ra","t"],"n17":["com","i"],"n18":["pren","m"],"n20":["der:","t"],"n21":["Mo","i"],"n22":["rí","t"],"n23":["con","i"],"n24":["ti","m"],"n25":["go","t"],"n27":"en","n28":"la","n30":"cruz,","n31":["Pa","i"],"n32":["ra","t"],"n33":["triun","i"],"n34":["far","t"],"n35":"en","n36":"su","n37":["po","i"],"n39":["der.","t"]},"verses":[{"label":"2.","lines":["Tu cruz, Señor, es mía hoy;","Cuando acepto que morí,","Brilla en mi vida su fulgor,","Y el mundo deja de existir."]},{"label":"3.","lines":["Ya que en la cruz contigo estoy,","No busco más la vanidad;","Del yo y pecado libre soy,","No puedo al mundo disfrutar."]},{"label":"4.","lines":["Sobre la cruz, mi buen Señor,","Tomo contigo mi lugar;","Entrelazados Tú y yo,","Tu vida es mía en verdad."]},{"label":"5.","lines":["Ya que heriste a Tu rival,","Y derribaste su poder,","Por Tu poder obrando en mí","Yo puedo en Ti también vencer."]},{"label":"6.","lines":["Mas mi victoria yace en Ti,","Y en Tu muerte eficaz;","Yo en Tu senda quiero andar,","Hasta la meta en Dios llegar."]},{"label":"7.","lines":["Señor, contigo muerto fui,","¡Qué beneficio recibí!","Más de Tu muerte hazme ver,","Para mi carne así vencer."]},{"label":"8.","lines":["Tal como Tú quiero vencer,","Para así reinar también,","Pues si la cruz llevamos hoy,","Tendremos gloria en Ti, Señor."]}]}