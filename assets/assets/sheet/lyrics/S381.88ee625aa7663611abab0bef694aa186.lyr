{"hymn":"S381","parent":"E495","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cristo la centralidad","subtitle":"Experiencia de Cristo—Como centralidad y universalidad de Dios","syl":{"n1":["Cris","i"],"n2":["to","t"],"n3":"la","n4":["cen","i"],"n5":["tra","m"],"n6":["li","m"],"n7":["dad","t"],"n8":"Y","n9":"la","n10":["u","i"],"n11":["ni","m"],"n12":["ver","m"],"n13":["sa","m"],"n14":["li","m"],"n15":["dad;","t"],"n16":["Pa","i"],"n17":["ra","t"],"n18":"Dios,","n20":"Su","n21":["go","i"],"n22":["zo","t"],"n23":"es,","n24":"Su","n25":["de","i"],"n26":["lei","m"],"n28":["te","t"],"n29":["e","i"],"n30":["ter","m"],"n31":["nal.","t"]},"verses":[{"label":"2.","lines":["Hoy la plenitud de Dios","Mora‿en Él, en Cristo está;","Y respecto a la Deidad,","Es supremo y sin igual."]},{"label":"3.","lines":["Se propuso el mismo Dios","Todo en todo de Él hacer;","Lo terreno o celestial","Todo lo‿hizo Dios por Él."]},{"label":"4.","lines":["Todo existe para El,","Todo en El creado fue;","Todo en El subsiste, así","Eje y arco hoy es Él."]},{"label":"5.","lines":["Él es todo en redención,","Todo El reconcilió;","Por Su sangre lo logró,","Trajo todo a paz con Dios."]},{"label":"6.","lines":["Cristo a la iglesia hoy","La Cabeza viva es;","Como Primogénito","De los muertos nació Él."]},{"label":"7.","lines":["En el reino Cristo es Rey,","Él con gloria regirá;","Se le dio todo poder,","Sobre todo reinará."]},{"label":"8.","lines":["Cristo el centro en todo es","Del nuevo orden celestial,","Para el hombre y para Dios,","Por toda la eternidad."]},{"label":"9.","lines":["Preeminencia y todo honor","Quiere Dios a Cristo dar,","Para que Él llegue a ser","Nuestra plena realidad."]}]}